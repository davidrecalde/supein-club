---
interface Props {
  level?: 'a1' | 'a2' | 'b1' | 'b2' | 'c1' | 'c2';
  categoryLabel?: string;
}

const { level, categoryLabel } = Astro.props;

const LEVEL_STYLES: Record<string, { bg: string; text: string; label: string }> = {
  a1: { bg: '#C8203D', text: '#FFFFFF', label: 'Nivel A1' },
  a2: { bg: '#F2867E', text: '#002147', label: 'Nivel A2' },
  b1: { bg: '#D97B3F', text: '#FFFFFF', label: 'Nivel B1' },
  b2: { bg: '#E8BB5C', text: '#002147', label: 'Nivel B2' },
  c1: { bg: '#5C7A29', text: '#FFFFFF', label: 'Nivel C1' },
  c2: { bg: '#A4C177', text: '#002147', label: 'Nivel C2' },
};

const levelStyle = level ? LEVEL_STYLES[level] : undefined;
const showCategory = !levelStyle && !!categoryLabel;
---

{levelStyle && (
  <span
    style={`position:absolute;top:16px;right:16px;z-index:2;font-family:'Poppins','Noto Sans JP',system-ui,sans-serif;font-weight:700;font-size:13px;letter-spacing:0.02em;padding:6px 14px;border-radius:999px;background:${levelStyle.bg};color:${levelStyle.text};box-shadow:0 2px 8px rgba(0,0,0,0.25);`}
  >
    {levelStyle.label}
  </span>
)}

{showCategory && (
  <span
    style="position:absolute;top:16px;right:16px;z-index:2;font-family:'Poppins','Noto Sans JP',system-ui,sans-serif;font-weight:700;font-size:13px;letter-spacing:0.02em;padding:6px 14px;border-radius:999px;background:#002147;color:#F5A623;border:1px solid #F5A623;box-shadow:0 2px 8px rgba(0,0,0,0.25);"
  >
    {categoryLabel}
  </span>
)}
