---
// Invitación a elegir supein.club como «優先ソース» (preferred source) de Google: enlace directo a
// https://www.google.com/preferences/source?q=supein.club con diseño propio, como permite la guía de
// Google (https://developers.google.com/search/docs/appearance/preferred-sources). Sin JavaScript externo.
// Efecto según Google: el sitio aparece más en 「トップニュース」 (y en AI Overviews / AI Mode) para
// quien lo elige; no dice que cambie el posicionamiento normal. El clic se mide en GA4
// (preferred_source_clicked, BaseLayout).
interface Props {
  /** Pregunta de cabecera: por defecto la de los artículos. */
  eyebrow?: string;
}

const { eyebrow = 'この記事は役に立ちましたか？' } = Astro.props;
---
<a
  href="https://www.google.com/preferences/source?q=supein.club"
  target="_blank"
  rel="noopener noreferrer"
  class="preferred-source-cta"
  data-preferred-source
>
  <span class="psc-logo" aria-hidden="true">
    <svg width="26" height="26" viewBox="0 0 24 24">
      <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
      <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
      <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z"/>
      <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
    </svg>
  </span>
  <span class="psc-body">
    <span class="psc-eyebrow">{eyebrow}</span>
    <span class="psc-title">Googleでスペイン倶楽部を「優先ソース」に追加</span>
    <span class="psc-text">ニュース性のある検索で、スペイン倶楽部の記事が「トップニュース」に表示されやすくなります。Googleアカウントで選ぶだけ、無料です。</span>
    <span class="psc-btn">Googleで追加する
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
    </span>
  </span>
</a>

<style>
  .preferred-source-cta {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    margin: 36px 0;
    padding: 18px 20px 20px;
    border: 1px solid #DADCE0;
    border-left: 4px solid #4285F4;
    border-radius: 14px;
    background: #fff;
    color: inherit;
    text-decoration: none;
    box-shadow: 0 6px 18px -12px rgba(0, 33, 71, .35);
    transition: box-shadow .15s, border-color .15s;
  }
  .preferred-source-cta:hover { border-color: #B6BEC9; border-left-color: #4285F4; box-shadow: 0 10px 24px -12px rgba(0, 33, 71, .45); }
  .preferred-source-cta:focus-visible { outline: 3px solid #4285F4; outline-offset: 2px; }
  .psc-logo { display: grid; place-items: center; flex: none; width: 44px; height: 44px; border-radius: 50%; background: #F1F3F4; }
  .psc-body { display: flex; flex-direction: column; align-items: flex-start; min-width: 0; }
  .psc-eyebrow { font-size: 12px; font-weight: 700; letter-spacing: .04em; color: #5A6B80; }
  .psc-title { margin-top: 2px; font-size: 16px; font-weight: 700; line-height: 1.5; color: #002147; word-break: auto-phrase; }
  .psc-text { margin-top: 6px; font-size: 13px; line-height: 1.75; color: #4b5563; }
  .psc-btn { display: inline-flex; align-items: center; gap: 8px; margin-top: 12px; min-height: 42px; padding: 0 18px; border-radius: 999px; background: #1A73E8; color: #fff; font-size: 14px; font-weight: 700; }
  .preferred-source-cta:hover .psc-btn { background: #1765CC; }
  @media (max-width: 480px) {
    .preferred-source-cta { padding: 16px; gap: 12px; }
    .psc-logo { width: 38px; height: 38px; }
    .psc-btn { align-self: stretch; justify-content: center; }
  }
</style>
