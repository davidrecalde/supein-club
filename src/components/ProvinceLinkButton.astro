---
// Enlace individual a una página de provincia, con la bandera de su
// comunidad autónoma y el color oficial de esa bandera en el borde —
// mismo lenguaje visual que FoodRouteProvinceButtons.astro, pero para
// un único enlace suelto dentro del cuerpo de un artículo (en vez de
// una cuadrícula agrupada por comunidad).
import { communityColorMap } from '../data/spainCommunities';

interface Props {
  communitySlug: string;
  provinceSlug: string;
  provinceLabel: string;
}

const { communitySlug, provinceSlug, provinceLabel } = Astro.props;
const community = communityColorMap[communitySlug];
---

<a
  href={`/food/spain-map/${provinceSlug}/`}
  class="plb-link"
  style={`border-left-color: ${community?.flagColor ?? '#C8102E'};`}
>
  <img
    src={`/images/flags/${communitySlug}.webp`}
    alt={`${community?.name ?? communitySlug}の旗`}
    class="plb-flag"
    width="28"
    height="28"
    loading="lazy"
  />
  <span class="plb-label">{provinceLabel}のグルメガイド</span>
</a>

<style>
  .plb-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 16px 8px 12px;
    background: white;
    border: 1px solid #E8E8E6;
    border-left-width: 3px;
    border-radius: 8px;
    text-decoration: none;
    color: #002147;
    font-size: 13px;
    font-weight: 700;
    transition: border-color 0.2s;
  }

  .plb-link:hover {
    border-color: #C8102E;
  }

  .plb-flag {
    width: 28px;
    height: 28px;
    object-fit: cover;
    border-radius: 4px;
    border: 1px solid #E8E8E6;
    flex-shrink: 0;
    display: block;
  }
</style>
