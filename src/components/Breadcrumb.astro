---
interface Props {
  items: Array<{ name: string; url: string }>;
  dark?: boolean;
}

const { items, dark = false } = Astro.props;
const baseClass = dark ? 'text-white/70' : 'text-muted';
const linkClass = dark ? 'hover:text-white' : 'hover:text-primary';
const currentClass = dark ? 'text-white' : 'text-ink';
---
<nav aria-label="breadcrumb" class={`flex items-center flex-wrap gap-1 max-w-full text-[11px] md:text-[13px] leading-[1.4] ${baseClass}`}>
  {items.map((item, i) => (
    <>
      {i > 0 && (
        <span aria-hidden="true" class="flex-shrink-0">›</span>
      )}
      {i < items.length - 1 ? (
        <a href={item.url} class={`hover:underline flex-shrink-0 whitespace-nowrap ${linkClass}`}>{item.name}</a>
      ) : (
        <span class={`${currentClass} overflow-hidden text-ellipsis whitespace-nowrap max-w-[120px] md:max-w-[180px]`} aria-current="page">{item.name}</span>
      )}
    </>
  ))}
</nav>
