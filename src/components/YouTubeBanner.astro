---
interface Props {
  compact?: boolean;
  slim?: boolean;
}
const { compact = false, slim = false } = Astro.props;
const channelUrl = 'https://youtube.com/@supeinclub';
---
{compact ? (
  <a
    href={channelUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="flex items-center gap-3 bg-[#FF0000] hover:bg-[#e00000] text-white rounded-xl p-4 transition-colors"
  >
    <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor" class="shrink-0"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814ZM9.545 15.568V8.432L15.818 12l-6.273 3.568Z"/></svg>
    <div>
      <p class="font-bold text-sm">YouTubeで登録する</p>
      <p class="text-sm text-white/80">@supeinclub</p>
    </div>
  </a>
) : slim ? (
  <section class="bg-[#FF0000] py-6 px-5">
    <div class="max-w-6xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4 text-center sm:text-left text-white">
      <div class="flex items-center gap-3">
        <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor" class="shrink-0"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814ZM9.545 15.568V8.432L15.818 12l-6.273 3.568Z"/></svg>
        <div>
          <p class="font-bold text-base leading-snug">YouTubeチャンネルを登録しよう！</p>
          <p class="text-white/80 text-sm">「I need Spain 在スペイン日本人」など、スペイン倶楽部の動画コンテンツを公式チャンネルでもっと見られます。</p>
        </div>
      </div>
      <a
        href={channelUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="shrink-0 inline-flex items-center gap-2 bg-white text-[#FF0000] font-bold text-sm px-6 py-2.5 rounded-full hover:bg-white/90 transition-colors whitespace-nowrap"
      >
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" class="shrink-0"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814ZM9.545 15.568V8.432L15.818 12l-6.273 3.568Z"/></svg>
        チャンネル登録する（@supeinclub）
      </a>
    </div>
  </section>
) : (
  <section class="bg-[#FF0000] py-12 px-4">
    <div class="max-w-3xl mx-auto text-center text-white">
      <svg viewBox="0 0 24 24" width="40" height="40" fill="currentColor" class="mx-auto mb-3"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814ZM9.545 15.568V8.432L15.818 12l-6.273 3.568Z"/></svg>
      <h2 class="font-bold text-2xl mb-2">YouTubeチャンネルを登録しよう！</h2>
      <p class="text-white/90 mb-6">
        スペイン倶楽部の公式YouTubeチャンネルでは、「I need Spain 在スペイン日本人」をはじめとする動画コンテンツを配信しています。
      </p>
      <a
        href={channelUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block bg-white text-[#FF0000] font-bold text-sm px-8 py-3 rounded-full hover:bg-white/90 transition-colors"
      >
        チャンネル登録する（@supeinclub）
      </a>
    </div>
  </section>
)}
