---
import type { CollectionEntry } from 'astro:content';
import { getRegion } from '../config/regions';

interface Props {
  title: string;
  description: string;
  canonical: string;
  image?: string;
  type?: 'website' | 'article';
  article?: CollectionEntry<'articles'>;
  author?: CollectionEntry<'authors'>;
  breadcrumbs?: Array<{ name: string; url: string }>;
  keywords?: string[];
  authorName?: string;
  authorUrl?: string;
  robots?: string;
}

const {
  title,
  description,
  canonical,
  image,
  type = 'website',
  article,
  author,
  breadcrumbs,
  keywords,
  authorName,
  authorUrl,
  robots = 'index, follow',
} = Astro.props;

const siteUrl = 'https://supein.club';
const resolvedImage = image ? (image.startsWith('http') ? image : `${siteUrl}${image}`) : `${siteUrl}/logo-og.png`;
const lang = article?.data.lang ?? 'ja';

const graph: object[] = [];

// 1. Organization (always)
graph.push({
  '@type': ['Organization', 'NewsMediaOrganization'],
  '@id': `${siteUrl}/#organization`,
  name: 'Club Español en Japón スペイン倶楽部',
  alternateName: ['スペイン倶楽部', 'Supein Club', 'supein.club'],
  url: siteUrl,
  logo: {
    '@type': 'ImageObject',
    url: `${siteUrl}/logo-og.png`,
    width: 600,
    height: 60,
  },
  foundingDate: '2018-01-01',
  founder: {
    '@type': 'Person',
    name: 'David Recalde',
    url: `${siteUrl}/about-us/team/david-recalde/`,
  },
  description: 'スペインの旅行・料理・文化・語学を日本語で伝えるカルチャーメディア。2018年東京創設。',
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'customer support',
    email: 'info@supein.club',
    areaServed: 'JP',
    availableLanguage: ['ja', 'es'],
  },
  address: {
    '@type': 'PostalAddress',
    streetAddress: '41-8 Yamatochō, Itabashi City',
    addressLocality: 'Tokyo',
    postalCode: '173-0012',
    addressCountry: 'JP',
  },
  location: {
    '@type': 'Place',
    name: 'Tokyo, Japan',
  },
  areaServed: {
    '@type': 'Country',
    name: 'Japan',
  },
  knowsAbout: [
    'スペイン旅行',
    'スペイン料理',
    'スペイン語',
    'スペイン文化',
    '日西文化交流',
  ],
  publishingPrinciples: `${siteUrl}/about-us/`,
  sameAs: [
    'https://www.instagram.com/supeinclub/',
    'https://www.linkedin.com/company/supeinclub/',
    'https://www.facebook.com/supeinclub/',
    'https://twitter.com/supeinclub',
    'https://lin.ee/vx6jpud',
    'https://www.wikidata.org/wiki/Q141058118',
  ],
});

// 2. WebSite (always)
graph.push({
  '@type': 'WebSite',
  '@id': `${siteUrl}/#website`,
  name: 'スペイン倶楽部',
  description: 'スペインの旅行・料理・文化・語学を日本語で伝えるカルチャーメディア',
  url: siteUrl,
  inLanguage: 'ja',
  about: { '@type': 'Country', name: 'スペイン', sameAs: 'https://www.wikidata.org/wiki/Q29' },
  publisher: { '@id': `${siteUrl}/#organization` },
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: `${siteUrl}/?s={search_term_string}`,
    },
    'query-input': 'required name=search_term_string',
  },
});

// 3. WebPage (always)
const webPage: Record<string, unknown> = {
  '@type': 'WebPage',
  '@id': `${canonical}#webpage`,
  url: canonical,
  name: title,
  description,
  isPartOf: { '@id': `${siteUrl}/#website` },
  publisher: { '@id': `${siteUrl}/#organization` },
  inLanguage: lang === 'es' ? 'es' : 'ja',
};
if (breadcrumbs && breadcrumbs.length > 0) {
  webPage.breadcrumb = { '@id': `${canonical}#breadcrumb` };
}
graph.push(webPage);

// 4. BreadcrumbList (if breadcrumbs)
if (breadcrumbs && breadcrumbs.length > 0) {
  graph.push({
    '@type': 'BreadcrumbList',
    '@id': `${canonical}#breadcrumb`,
    itemListElement: breadcrumbs.map((item, i) => {
      const itemUrl = item.url.startsWith('http') ? item.url : `${siteUrl}${item.url}`;
      return {
        '@type': 'ListItem',
        position: i + 1,
        name: item.name,
        item: { '@id': itemUrl, name: item.name },
      };
    }),
  });
}

// 5. Article / schema-specific (if type === 'article' && article)
if (type === 'article' && article) {
  const schemaType = article.data.schemaType ?? 'article';
  const authorName = author?.data.name ?? 'スペイン倶楽部編集部';
  const authorSlug = author ? (author.data.slug ?? author.id.replace(/\.(md|mdx)$/, '')) : 'supeinclub-henshubu';
  const authorUrl = `${siteUrl}/about-us/team/${authorSlug}/`;
  const primaryImagePath = article.data.heroImage?.src ?? article.data.image;
  const imageId = `${canonical}#primaryimage`;
  const articleImage = primaryImagePath
    ? { '@id': imageId }
    : { '@type': 'ImageObject', url: `${siteUrl}/logo-og.png` };
  if (primaryImagePath) {
    graph.push({
      '@type': 'ImageObject',
      '@id': imageId,
      url: `${siteUrl}${primaryImagePath}`,
      contentUrl: `${siteUrl}${primaryImagePath}`,
      name: article.data.heroImageAlt ?? title,
      description: article.data.heroImageAlt ?? title,
      width: 1200,
      height: 630,
      creditText: 'supein.club',
      creator: { '@id': `${siteUrl}/#organization` },
      copyrightNotice: '© Club Español en Japón スペイン倶楽部 supein.club',
      license: siteUrl,
      acquireLicensePage: `${siteUrl}/contact/`,
    });
  }

  const regionConfig = article.data.region ? getRegion(article.data.region) : undefined;
  const contentLocation = regionConfig
    ? { '@type': 'AdministrativeArea', name: regionConfig.label }
    : undefined;

  const rawLinkedin = author?.data.linkedin;
  const rawInstagram = author?.data.instagram;
  const normalizeUrl = (raw: string | undefined, base: string) =>
    raw ? (raw.startsWith('http') ? raw : `${base}${raw}`) : undefined;
  const authorLinkedIn = normalizeUrl(rawLinkedin, 'https://linkedin.com/in/');
  const authorInstagram = normalizeUrl(rawInstagram, 'https://instagram.com/');
  const authorWebsite = author?.data.website;
  const authorSameAs = [authorLinkedIn, authorInstagram, authorWebsite].filter(Boolean) as string[];
  const authorAvatar = author?.data.avatar ? `${siteUrl}${author.data.avatar}` : undefined;
  const authorJobTitle = author?.data.jobTitle ?? author?.data.role;
  const authorTopics = author?.data.specialties ?? author?.data.knowsAbout;

  const articleAuthor: Record<string, unknown> = {
    '@type': 'Person',
    '@id': `${authorUrl}#person`,
    name: authorName,
    url: authorUrl,
  };
  if (authorAvatar) articleAuthor.image = authorAvatar;
  if (authorJobTitle) articleAuthor.jobTitle = authorJobTitle;
  if (author?.data.bio) articleAuthor.description = author.data.bio;
  if (authorTopics && authorTopics.length > 0) articleAuthor.knowsAbout = authorTopics;
  if (authorSameAs.length > 0) articleAuthor.sameAs = authorSameAs;
  articleAuthor.worksFor = { '@id': `${siteUrl}/#organization` };

  // SportsTeam (si el artículo es de un club/selección de fútbol)
  const teamData = article.data.sportsTeam;
  const teamId = `${canonical}#team`;
  const memberOfOrgs: Record<string, Record<string, unknown>> = {
    LaLiga: {
      '@type': 'SportsOrganization',
      '@id': `${siteUrl}/#laliga`,
      name: 'ラ・リーガ',
      alternateName: ['LaLiga', 'La Liga'],
      sport: 'サッカー',
      url: 'https://www.laliga.com/',
      sameAs: 'https://www.wikidata.org/wiki/Q324867',
    },
    RFEF: {
      '@type': 'SportsOrganization',
      '@id': `${siteUrl}/#rfef`,
      name: 'スペインサッカー連盟',
      alternateName: ['RFEF', 'Real Federación Española de Fútbol'],
      sport: 'サッカー',
      url: 'https://rfef.es/es',
      sameAs: 'https://www.wikidata.org/wiki/Q207615',
    },
  };
  if (teamData) {
    graph.push({
      '@type': 'SportsTeam',
      '@id': teamId,
      name: teamData.name,
      sport: 'Football',
      foundingDate: teamData.foundingDate,
      url: canonical,
      ...(teamData.alternateName && teamData.alternateName.length > 0 && { alternateName: teamData.alternateName }),
      ...(teamData.city && {
        location: {
          '@type': 'Place',
          name: teamData.city,
          address: { '@type': 'PostalAddress', addressLocality: teamData.city, addressCountry: 'ES' },
        },
      }),
      ...(teamData.memberOf && { memberOf: { '@id': memberOfOrgs[teamData.memberOf]['@id'] } }),
    });
    if (teamData.memberOf) graph.push(memberOfOrgs[teamData.memberOf]);
  }

  if (schemaType === 'recipe') {
    graph.push({
      '@type': 'Recipe',
      '@id': `${canonical}#recipe`,
      name: title,
      description,
      image: articleImage,
      author: articleAuthor,
      publisher: { '@id': `${siteUrl}/#organization` },
      datePublished: article.data.pubDate.toISOString(),
      dateModified: (article.data.updatedDate ?? article.data.pubDate).toISOString(),
      recipeCategory: article.data.recipeData?.recipeCategory ?? 'スペイン料理',
      cookTime: article.data.recipeData?.cookTime ?? 'PT30M',
      prepTime: article.data.recipeData?.prepTime ?? 'PT15M',
      recipeYield: article.data.recipeData?.recipeYield ?? '2人分',
      recipeIngredient: article.data.recipeData?.recipeIngredient ?? [],
      recipeInstructions: article.data.recipeData?.recipeInstructions ?? [],
      inLanguage: 'ja',
    });
  } else if (schemaType === 'destination') {
    const destinationId = `${canonical}#destination`;
    const articleObj: Record<string, unknown> = {
      '@type': 'Article',
      '@id': `${canonical}#article`,
      headline: title.slice(0, 110),
      description,
      url: canonical,
      datePublished: article.data.pubDate.toISOString(),
      dateModified: (article.data.updatedDate ?? article.data.pubDate).toISOString(),
      author: articleAuthor,
      publisher: { '@id': `${siteUrl}/#organization` },
      image: articleImage,
      inLanguage: lang === 'es' ? 'es' : 'ja',
      isPartOf: { '@id': `${siteUrl}/#website` },
      mainEntityOfPage: `${canonical}#webpage`,
      about: { '@id': destinationId },
    };
    if (article.data.tags && article.data.tags.length > 0) {
      articleObj.keywords = article.data.tags.join(',');
    }
    if (contentLocation) {
      articleObj.contentLocation = contentLocation;
    }
    graph.push(articleObj);
    graph.push({
      '@type': 'TouristDestination',
      '@id': destinationId,
      name: article.data.destinationData?.locationName ?? title,
      description,
      url: canonical,
      touristType: { '@type': 'Audience', audienceType: '日本人旅行者' },
      address: {
        '@type': 'PostalAddress',
        addressCountry: article.data.destinationData?.country ?? 'ES',
      },
    });
  } else if (schemaType === 'course') {
    graph.push({
      '@type': 'Course',
      name: title,
      description,
      url: canonical,
      inLanguage: 'ja',
      educationalLevel: article.data.courseData?.educationalLevel ?? 'Beginner',
      provider: {
        '@type': 'EducationalOrganization',
        '@id': `${siteUrl}/#educational-organization`,
        name: article.data.courseData?.provider ?? 'スペイン倶楽部',
        url: siteUrl,
      },
    });
  } else if (schemaType === 'restaurant') {
    graph.push({
      '@type': ['Restaurant', 'LocalBusiness'],
      name: article.data.restaurantData?.restaurantName ?? title,
      description,
      url: canonical,
      servesCuisine: article.data.restaurantData?.cuisine ?? 'Spanish',
      priceRange: article.data.restaurantData?.priceRange ?? '¥¥¥',
      address: {
        '@type': 'PostalAddress',
        addressLocality: article.data.restaurantData?.addressLocality ?? '東京',
        addressCountry: 'JP',
      },
    });
  } else if (schemaType === 'sports') {
    graph.push({
      '@type': 'Article',
      '@id': `${canonical}#article`,
      headline: title.slice(0, 110),
      description,
      url: canonical,
      datePublished: article.data.pubDate.toISOString(),
      dateModified: (article.data.updatedDate ?? article.data.pubDate).toISOString(),
      author: articleAuthor,
      publisher: { '@id': `${siteUrl}/#organization` },
      image: articleImage,
      inLanguage: lang === 'es' ? 'es' : 'ja',
      isPartOf: { '@id': `${siteUrl}/#website` },
      mainEntityOfPage: `${canonical}#webpage`,
      about: { '@id': memberOfOrgs.LaLiga['@id'] },
      ...(contentLocation && { contentLocation }),
    });
    graph.push(memberOfOrgs.LaLiga);
  } else {
    const pillarSectionMap: Record<string, string> = {
      travel: 'スペイン旅行',
      food: 'スペイン料理',
      language: 'スペイン語',
      living: 'スペインに住む',
      culture: 'スペイン文化',
      football: 'スペインサッカー',
    };
    const articleObj: Record<string, unknown> = {
      '@type': 'Article',
      '@id': `${canonical}#article`,
      headline: title.slice(0, 110),
      description,
      url: canonical,
      datePublished: article.data.pubDate.toISOString(),
      dateModified: (article.data.updatedDate ?? article.data.pubDate).toISOString(),
      author: articleAuthor,
      publisher: { '@id': `${siteUrl}/#organization` },
      image: articleImage,
      inLanguage: lang === 'es' ? 'es' : 'ja',
      isPartOf: { '@id': `${siteUrl}/#website` },
      mainEntityOfPage: `${canonical}#webpage`,
      about: teamData ? { '@id': teamId } : { '@type': 'Thing', name: 'スペイン' },
      articleSection: pillarSectionMap[article.data.pillar] ?? article.data.pillar,
    };
    if (article.data.tags && article.data.tags.length > 0) {
      articleObj.keywords = article.data.tags.join(',');
    }
    if (contentLocation) {
      articleObj.contentLocation = contentLocation;
    }
    graph.push(articleObj);
  }

  // VideoObject（記事に埋め込まれたYouTube動画がある場合）— このページが
  // 動画の「視聴ページ」であることをGoogleに明示するための構造化データ。
  if (article.data.video) {
    const { youtubeId } = article.data.video;
    graph.push({
      '@type': 'VideoObject',
      '@id': `${canonical}#video`,
      name: title,
      description,
      thumbnailUrl: [`https://i.ytimg.com/vi/${youtubeId}/maxresdefault.jpg`],
      uploadDate: (article.data.video.uploadDate ?? article.data.pubDate).toISOString(),
      embedUrl: `https://www.youtube.com/embed/${youtubeId}`,
      contentUrl: `https://www.youtube.com/watch?v=${youtubeId}`,
      isFamilyFriendly: true,
      publisher: { '@id': `${siteUrl}/#organization` },
      mainEntityOfPage: `${canonical}#webpage`,
    });
  }
}

// 6. FAQPage (if article has faq)
const faqItems = article?.data.faq;
if (faqItems && faqItems.length > 0) {
  graph.push({
    '@type': 'FAQPage',
    '@id': `${canonical}#faq`,
    mainEntity: faqItems.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  });
}

// 7. SiteNavigationElement (home page only)
if (canonical === `${siteUrl}/`) {
  graph.push({
    '@type': 'SiteNavigationElement',
    name: [
      'スペイン旅行',
      'スペイン料理',
      'スペイン語',
      'スペインに住む',
      'スペイン文化',
      'スペインサッカー',
    ],
    url: [
      `${siteUrl}/travel/`,
      `${siteUrl}/food/`,
      `${siteUrl}/language/`,
      `${siteUrl}/living/`,
      `${siteUrl}/culture/`,
      `${siteUrl}/football/`,
    ],
  });
}

const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph });
---
<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content={robots} />
<link rel="canonical" href={canonical} />
<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={resolvedImage} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'ja_JP'} />
<meta property="og:site_name" content="supein.club" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={resolvedImage} />
<link rel="alternate" hreflang="ja" href={canonical} />
<link rel="alternate" hreflang="es" href={canonical} />
<link rel="alternate" hreflang="x-default" href={canonical} />
{keywords && keywords.length > 0 && (
  <meta name="keywords" content={keywords.join(',')} />
)}
{authorName && (
  <>
    <meta name="author" content={authorName} />
    <link rel="author" href={authorUrl || 'https://supein.club/about-us/team/'} />
  </>
)}
<link rel="publisher" href="https://supein.club/" />
<script type="application/ld+json" set:html={jsonLd} />
