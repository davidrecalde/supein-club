---
// FAQ de los hubs (acordeón con <details>, el primero abierto). El schema FAQPage lo pone cada página.
import { ChevronDown } from 'lucide-astro';

interface Props {
  items: Array<{ question: string; answer: string }>;
  title: string;
  eyebrow?: string;
}

const { items, title, eyebrow = 'よくある質問' } = Astro.props;
---
<div class="hfaq">
  <p class="hub-block-eyebrow">{eyebrow}</p>
  <h2>{title}</h2>
  {items.map((f, i) => (
    <details open={i === 0}>
      <summary><span class="q" aria-hidden="true">Q</span><span>{f.question}</span><ChevronDown size={18} /></summary>
      <p set:html={f.answer} />
    </details>
  ))}
</div>

<style>
  .hfaq h2 { margin: 0 0 16px; font-size: clamp(22px, 3vw, 28px); font-weight: 700; color: #002147; }
  details { margin-bottom: 10px; border: 1px solid #E3E8EF; border-radius: 14px; background: #fff; }
  summary { display: flex; align-items: center; gap: 10px; padding: 15px 16px; font-size: 14.5px; font-weight: 700; line-height: 1.5; color: #002147; list-style: none; cursor: pointer; }
  summary::-webkit-details-marker { display: none; }
  .q { display: grid; place-items: center; flex: none; width: 24px; height: 24px; border-radius: 7px; background: #FCEBEE; color: #C8102E; font-size: 12px; }
  summary :global(svg) { flex: none; margin-left: auto; transition: transform .2s; }
  details[open] summary :global(svg) { transform: rotate(180deg); }
  details p { margin: 0; padding: 0 16px 16px 50px; font-size: 14px; line-height: 1.85; color: #3a4654; }
  details p :global(a) { color: #C8102E; text-decoration: underline; text-underline-offset: 3px; }
</style>
