---
// Mapa de ruta interactivo para los artículos de food-routes: colorea las
// provincias de la zona (sin que sean clicables) y superpone los puntos
// numerados de cada parada del itinerario. Cada punto enlaza con el ancla
// `#day-{n}` de la sección de ese día en el propio artículo.
//
// Diseño deliberadamente simple tras varias rondas de ajuste: el mapa en
// sí solo lleva los números (sin nombres ni líneas guía que puedan
// solaparse o cruzarse), y los nombres viven en una leyenda debajo del
// mapa, en el mismo orden que los días. Tanto los números del mapa como
// las entradas de la leyenda son clicables y llevan al mismo sitio.
// Igual en escritorio y en móvil — no hace falta ningún tratamiento
// distinto por tamaño de pantalla para los nombres.
//
// Los números se renderizan como HTML superpuesto (no como texto SVG):
// el mapa base se escala con el viewBox, y si el texto también fuera
// SVG se encogería en la misma proporción, quedando ilegible en
// pantallas estrechas. El HTML posicionado por porcentaje mantiene un
// tamaño de fuente fijo en cualquier ancho de pantalla.
//
// Reutiliza el mismo SVG base y recorte de viewBox que RegionHighlightMap.astro.
import { readFileSync } from 'node:fs';
import path from 'node:path';

const VIEW_W = 418.46;
const VIEW_H = 328;

interface HighlightProvince {
  code: string;  // Código ISO usado en el SVG, ej. "ES-HU"
  label: string; // Nombre en japonés (solo informativo, no hay tooltip de provincia)
}

interface RouteStop {
  day: number;
  nameJa: string;
  nameRoman: string;
  x: number;        // Coordenada del punto en el sistema del SVG (viewBox 0 0 418.46 328)
  y: number;
}

interface Props {
  provinces: HighlightProvince[];
  stops: RouteStop[];
  caption?: string;
  color?: string;
  // Para rutas insulares (Baleares, Canarias): omite el mapa de España
  // completo incluso en escritorio y muestra directamente el recorte
  // de zoom a las islas, a mayor tamaño, en cualquier ancho de pantalla.
  zoomOnly?: boolean;
  // Elimina del SVG las provincias no resaltadas (en vez de solo
  // dejarlas en gris). Necesario para Baleares y Canarias: como esas
  // islas comparten un rincón del lienzo con el recuadro insular del
  // mapa base (las Canarias están reposicionadas ahí, no en su lugar
  // geográfico real), el recorte automático de zoom puede alcanzar por
  // coincidencia esa zona del lienzo y mostrar la otra región insular
  // o un trozo de la península de fondo. Al quitar del todo esas
  // formas, el recorte solo puede mostrar la propia región resaltada.
  stripToRegion?: boolean;
  // Margen alrededor de la región en el recorte de zoom, como fracción
  // de su tamaño (por defecto 0.2). Las regiones grandes (Castilla y
  // León, Aragón, Castilla-La Mancha) necesitan menos para quedar bien
  // encuadradas en móvil.
  mobilePad?: number;
}

const { provinces, stops, caption, color = '#C8102E', zoomOnly = false, stripToRegion = false, mobilePad = 0.2 } = Astro.props;

const rawSvg = readFileSync(
  path.resolve(process.cwd(), 'public/spain-provinces.svg'),
  'utf-8'
);

const highlightCodes = new Set(provinces.map((p) => p.code));

// Calcula el bounding box real de una provincia (en coordenadas del
// lienzo) parseando su atributo `d` (comandos de trazado relativos
// m/l) y aplicando su `transform` si lo tiene (caso de Canarias/Ceuta,
// reposicionadas en un recuadro aparte del mapa base).
function getProvinceBBox(code: string) {
  const re = new RegExp(`<path[^>]*?d="([^"]+)"[^>]*?id="${code}"[^>]*/>`);
  const withTransform = new RegExp(`<path[^>]*?d="([^"]+)"[^>]*?transform="translate\\(([-\\d.]+),([-\\d.]+)\\) scale\\(([-\\d.]+)\\)"[^>]*?id="${code}"[^>]*/>`);
  let tMatch = rawSvg.match(withTransform);
  let m = tMatch ?? rawSvg.match(re);
  if (!m) return null;
  const d = m[1];
  const tx = tMatch ? parseFloat(tMatch[2]) : 0;
  const ty = tMatch ? parseFloat(tMatch[3]) : 0;
  const scale = tMatch ? parseFloat(tMatch[4]) : 1;
  const tokens = d.match(/[a-zA-Z]|-?\d*\.?\d+/g) ?? [];
  let x = 0, y = 0, cmd = '';
  let minX = Infinity, maxX = -Infinity, minY = Infinity, maxY = -Infinity;
  const upd = () => {
    const px = tx + x * scale;
    const py = ty + y * scale;
    minX = Math.min(minX, px); maxX = Math.max(maxX, px);
    minY = Math.min(minY, py); maxY = Math.max(maxY, py);
  };
  let i = 0;
  while (i < tokens.length) {
    const t = tokens[i];
    if (/^[a-zA-Z]$/.test(t)) { cmd = t; i++; continue; }
    if (cmd === 'm' || cmd === 'l') {
      x += parseFloat(tokens[i]); y += parseFloat(tokens[i + 1]); i += 2; upd();
      if (cmd === 'm') cmd = 'l';
    } else { i++; }
  }
  return { minX, maxX, minY, maxY };
}

function unionBBox(a: { minX: number; maxX: number; minY: number; maxY: number } | null, b: { minX: number; maxX: number; minY: number; maxY: number } | null) {
  if (!a) return b;
  if (!b) return a;
  return { minX: Math.min(a.minX, b.minX), maxX: Math.max(a.maxX, b.maxX), minY: Math.min(a.minY, b.minY), maxY: Math.max(a.maxY, b.maxY) };
}

function renderMap(viewBox: string, extraClass: string) {
  let svg = rawSvg
    .replace('width="418.45123"', `class="route-map-svg ${extraClass}" width="100%" viewBox="${viewBox}" preserveAspectRatio="xMidYMid meet"`)
    .replace('\n   height="468.63733"', '');
  svg = svg.replace(/id="(ES-[A-Z]+)"/g, (_match, id) => {
    return highlightCodes.has(id) ? `id="${id}" data-highlighted="true"` : `id="${id}"`;
  });
  if (stripToRegion) {
    svg = svg.replace(/<rect\b[^>]*id="offshore-frame"[^>]*\/>\s*/, '');
    svg = svg.replace(/<path\b[\s\S]*?\/>/g, (match) => (match.includes('data-highlighted="true"') ? match : ''));
  }
  return svg;
}

const desktopSvg = zoomOnly ? '' : renderMap(`0 0 ${VIEW_W} ${VIEW_H}`, 'is-desktop');

// Recorte automático (móvil, o única vista si zoomOnly): se centra en
// la geometría real de las provincias resaltadas (unida a la de los
// puntos), con un margen proporcional al tamaño de la región.
const regionBBox = provinces.reduce((acc, p) => unionBBox(acc, getProvinceBBox(p.code)), null as ReturnType<typeof getProvinceBBox>);
const baseBBox = stops.reduce(
  (acc, s) => unionBBox(acc, { minX: s.x, maxX: s.x, minY: s.y, maxY: s.y }),
  regionBBox
)!;
const PAD_FRAC = mobilePad;
const MIN_PAD = Math.min(15, 75 * mobilePad);
const padX = Math.max(MIN_PAD, (baseBBox.maxX - baseBBox.minX) * PAD_FRAC);
const padY = Math.max(MIN_PAD, (baseBBox.maxY - baseBBox.minY) * PAD_FRAC);

// Recorte centrado con compensación: si un lado topa con el borde del
// lienzo (regiones costeras como Galicia o Asturias, pegadas al borde
// real del mapa), se recorta el lado opuesto en la misma medida en vez
// de dejarlo con todo su margen, para que la región resaltada quede
// centrada dentro del recuadro en vez de desplazada hacia un lado.
function centeredClamp(idealMin: number, idealMax: number, hardMin: number, hardMax: number, contentMin: number, contentMax: number): [number, number] {
  let min = idealMin;
  let max = idealMax;
  if (min < hardMin) {
    const deficit = hardMin - min;
    min = hardMin;
    max = Math.max(contentMax, max - deficit);
  }
  if (max > hardMax) {
    const deficit = max - hardMax;
    max = hardMax;
    min = Math.min(contentMin, min + deficit);
  }
  return [min, max];
}

const [cropMinX, cropMaxX] = centeredClamp(baseBBox.minX - padX, baseBBox.maxX + padX, 0, VIEW_W, baseBBox.minX, baseBBox.maxX);
const [cropMinY, cropMaxY] = centeredClamp(baseBBox.minY - padY, baseBBox.maxY + padY, 0, VIEW_H, baseBBox.minY, baseBBox.maxY);
const cropW = cropMaxX - cropMinX;
const cropH = cropMaxY - cropMinY;

const mobileSvg = renderMap(`${cropMinX} ${cropMinY} ${cropW} ${cropH}`, 'is-mobile');

const pctFull = (v: number, total: number) => `${((v / total) * 100).toFixed(2)}%`;
const pctCrop = (v: number, min: number, size: number) => `${(((v - min) / size) * 100).toFixed(2)}%`;

const sortedStops = [...stops].sort((a, b) => a.day - b.day);
---

<div class="route-map" style={`--zone-color:${color}`}>
  {/* Versión de escritorio: España completa (omitida si zoomOnly) */}
  {!zoomOnly && (
  <div class="route-map-inner route-map-desktop">
    <Fragment set:html={desktopSvg} />

    {stops.map((s) => (
      <a href={`#day-${s.day}`} class="route-dot" style={`left:${pctFull(s.x, VIEW_W)}; top:${pctFull(s.y, VIEW_H)};`} aria-label={`${s.day}日目 ${s.nameJa}へ移動`}>
        <span class="route-dot-circle">{s.day}</span>
      </a>
    ))}
  </div>
  )}

  {/* Versión móvil, o única versión si zoomOnly: zoom automático a la zona de la ruta */}
  <div class={`route-map-inner route-map-mobile ${zoomOnly ? 'route-map-zoom-only' : ''}`}>
    <Fragment set:html={mobileSvg} />

    {stops.map((s) => (
      <a href={`#day-${s.day}`} class="route-dot" style={`left:${pctCrop(s.x, cropMinX, cropW)}; top:${pctCrop(s.y, cropMinY, cropH)};`} aria-label={`${s.day}日目 ${s.nameJa}へ移動`}>
        <span class="route-dot-circle">{s.day}</span>
      </a>
    ))}
  </div>

  {caption && <p class="route-map-caption">{caption}</p>}

  <ul class="route-legend">
    {sortedStops.map((s) => (
      <li>
        <a href={`#day-${s.day}`} class="route-legend-item">
          <span class="route-legend-num">{s.day}</span>
          <span class="route-legend-text">
            <span class="route-legend-name">{s.nameJa}</span>
            <span class="route-legend-roman">{s.nameRoman}</span>
          </span>
        </a>
      </li>
    ))}
  </ul>
</div>

<style is:global>
  .route-map-svg path {
    fill: #E5E7EB;
    stroke: #FAFAF8;
    stroke-width: 0.5;
  }

  .route-map-svg path[data-highlighted="true"] {
    fill: var(--zone-color, #C8102E);
  }
</style>

<style>
  .route-map {
    margin: 32px 0;
    padding: 20px 28px;
    background: #FAFAF8;
    border: 1px solid #E8E8E6;
    border-radius: 12px;
  }

  .route-map-inner {
    position: relative;
  }

  .route-map-mobile {
    display: none;
  }

  .route-map-zoom-only {
    display: block;
  }

  @media (max-width: 640px) {
    .route-map {
      padding: 16px 12px;
    }

    .route-map-desktop {
      display: none;
    }

    .route-map-mobile {
      display: block;
    }
  }

  .route-dot {
    position: absolute;
    transform: translate(-50%, -50%);
    text-decoration: none;
    z-index: 2;
  }

  .route-dot-circle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: #002147;
    border: 2px solid #FAFAF8;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.35);
    color: white;
    font-size: 13px;
    font-weight: 700;
    line-height: 1;
    transition: background 150ms ease, transform 150ms ease;
  }

  .route-dot:hover .route-dot-circle,
  .route-dot:focus-visible .route-dot-circle {
    background: #C8102E;
    transform: scale(1.15);
  }

  .route-map-caption {
    margin: 12px 0 0;
    font-size: 12px;
    color: #6b7280;
    text-align: center;
  }

  .route-legend {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 8px;
    margin: 20px 0 0;
    padding: 16px 0 0;
    border-top: 1px solid #E8E8E6;
  }

  .route-legend-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 10px;
    text-decoration: none;
    border-radius: 8px;
    transition: background 150ms ease;
  }

  .route-legend-item:hover,
  .route-legend-item:focus-visible {
    background: #F0EFEA;
  }

  .route-legend-num {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: #002147;
    color: white;
    font-size: 12px;
    font-weight: 700;
  }

  .route-legend-item:hover .route-legend-num,
  .route-legend-item:focus-visible .route-legend-num {
    background: #C8102E;
  }

  .route-legend-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .route-legend-name {
    font-size: 13px;
    font-weight: 700;
    color: #002147;
  }

  .route-legend-roman {
    font-size: 11px;
    color: #6b7280;
  }

  @media (max-width: 480px) {
    .route-legend {
      grid-template-columns: 1fr;
    }
  }

  @media (min-width: 641px) {
    .route-map-zoom-only .route-dot-circle {
      width: 30px;
      height: 30px;
      font-size: 15px;
    }
  }
</style>
