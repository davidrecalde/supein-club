---
interface QuizItem {
  question: string;
  options: string[];
  correctIndex: number;
  explanation: string;
}

interface Props {
  quiz: QuizItem[];
  title?: string;
}

const { quiz, title = "理解度チェック" } = Astro.props;

const widgetId = `quiz-${Math.random().toString(36).slice(2, 11)}`;
---

<div class="quiz-widget my-10 border border-ink/10 rounded-xl overflow-hidden" data-widget-id={widgetId}>
  <div class="bg-navy px-6 py-4">
    <h3 class="font-serif text-lg font-bold text-white">{title}</h3>
  </div>

  <div class="divide-y divide-ink/10">
    {quiz.map((item, qIndex) => (
      <div
        class="quiz-question p-6"
        data-question-index={qIndex}
        data-correct-index={item.correctIndex}
        data-answered="false"
        data-correct="false"
      >
        <p class="font-semibold text-navy mb-4">
          <span class="text-muted mr-2">{qIndex + 1}.</span>{item.question}
        </p>
        <div class="grid gap-2">
          {item.options.map((option, oIndex) => (
            <button
              type="button"
              class="quiz-option text-left px-4 py-3 rounded-lg border border-ink/10 text-sm text-navy hover:bg-navy/5 transition-colors disabled:cursor-not-allowed disabled:hover:bg-transparent"
              data-question-index={qIndex}
              data-option-index={oIndex}
              onclick={`checkQuizAnswer('${widgetId}', ${qIndex}, ${oIndex})`}
            >
              {option}
            </button>
          ))}
        </div>
        <div
          class="quiz-explanation mt-4 px-4 py-3 rounded-lg bg-navy/5 text-sm text-muted leading-relaxed"
          data-question-index={qIndex}
          aria-expanded="false"
          hidden
        >
          {item.explanation}
        </div>
      </div>
    ))}
  </div>

  <div class="quiz-summary px-6 py-8 border-t border-ink/10 text-center bg-canvas">
    <p class="font-serif text-navy leading-none text-6xl md:text-7xl font-bold">
      <span class="quiz-summary-score">0</span> / {quiz.length}
    </p>
    <p class="text-sm text-muted mt-3 mb-6">正解数</p>
    <button
      type="button"
      class="quiz-reset-btn inline-flex items-center justify-center px-6 py-3 rounded-lg bg-navy text-white text-sm font-semibold hover:bg-navy-deep transition-colors"
      onclick={`resetQuiz('${widgetId}')`}
    >
      もう一度挑戦する
    </button>
  </div>
</div>

<script>
function checkQuizAnswer(widgetId: string, questionIndex: number, selectedIndex: number) {
  const widget = document.querySelector(`[data-widget-id="${widgetId}"]`);
  if (!widget) return;

  const question = widget.querySelector(
    `.quiz-question[data-question-index="${questionIndex}"]`
  ) as HTMLElement;
  if (!question) return;

  // Pregunta ya respondida: no permitir cambios
  if (question.dataset.answered === 'true') return;

  const selectedBtn = question.querySelector(
    `.quiz-option[data-option-index="${selectedIndex}"]`
  ) as HTMLButtonElement;
  if (!selectedBtn) return;

  const correctIndex = Number(question.dataset.correctIndex);
  const isCorrect = selectedIndex === correctIndex;

  if (isCorrect) {
    selectedBtn.classList.add('bg-green-50', 'border-green-600', 'text-green-800');
  } else {
    selectedBtn.classList.add('bg-red-50', 'border-red-600', 'text-red-800');
  }

  question.querySelectorAll('.quiz-option').forEach((btn) => {
    (btn as HTMLButtonElement).disabled = true;
  });

  question.dataset.answered = 'true';
  question.dataset.correct = String(isCorrect);

  const explanation = question.querySelector(
    `.quiz-explanation[data-question-index="${questionIndex}"]`
  ) as HTMLElement;
  if (explanation) {
    explanation.hidden = false;
    explanation.setAttribute('aria-expanded', 'true');
  }

  // Resumen final escopado a este widget únicamente
  updateQuizSummary(widget);
}

function updateQuizSummary(widget: Element) {
  const scoreEl = widget.querySelector('.quiz-summary-score');
  if (!scoreEl) return;

  const correctCount = widget.querySelectorAll(
    '.quiz-question[data-correct="true"]'
  ).length;
  scoreEl.textContent = String(correctCount);
}

function resetQuiz(widgetId: string) {
  const widget = document.querySelector(`[data-widget-id="${widgetId}"]`);
  if (!widget) return;

  widget.querySelectorAll('.quiz-question').forEach((question) => {
    const q = question as HTMLElement;
    q.dataset.answered = 'false';
    q.dataset.correct = 'false';

    q.querySelectorAll('.quiz-option').forEach((btn) => {
      const b = btn as HTMLButtonElement;
      b.disabled = false;
      b.classList.remove(
        'bg-green-50', 'border-green-600', 'text-green-800',
        'bg-red-50', 'border-red-600', 'text-red-800'
      );
    });

    const explanation = q.querySelector('.quiz-explanation') as HTMLElement;
    if (explanation) {
      explanation.hidden = true;
      explanation.setAttribute('aria-expanded', 'false');
    }
  });

  updateQuizSummary(widget);

  const firstQuestion = widget.querySelector('.quiz-question');
  if (firstQuestion) {
    firstQuestion.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }
}

// Exponer globalmente
(window as any).checkQuizAnswer = checkQuizAnswer;
(window as any).resetQuiz = resetQuiz;
</script>
