---
import { resolveCourseSequencePosition } from '../utils/courseSequence';
import { getArticleUrl } from '../utils/articles';

const position = await resolveCourseSequencePosition(Astro.url.pathname);
---

{position && (position.prev || position.next) && (
  <section class="my-10 rounded-xl border-2 border-[#002147] bg-[#002147] px-5 py-6">
    <h3 class="toc-heading text-xs font-bold uppercase tracking-wider text-[#F5A623]" id="prev-next-nav">
      次のステップへ
    </h3>
    <div class="mt-4 flex flex-col gap-3 sm:flex-row sm:gap-4">
      {position.prev && (
        <a
          href={getArticleUrl(position.prev)}
          class="flex-1 rounded-lg border border-white/15 bg-white/5 px-4 py-3 text-white transition-colors hover:bg-white/10"
        >
          <span class="block text-xs font-semibold text-[#F5A623]">← 前のステップ</span>
          <span class="mt-1 block text-sm font-medium leading-snug">{position.prev.data.title}</span>
        </a>
      )}
      {position.next && (
        <a
          href={getArticleUrl(position.next)}
          class="flex-1 rounded-lg border border-white/15 bg-white/5 px-4 py-3 text-right text-white transition-colors hover:bg-white/10"
        >
          <span class="block text-xs font-semibold text-[#F5A623]">次のステップ →</span>
          <span class="mt-1 block text-sm font-medium leading-snug">{position.next.data.title}</span>
        </a>
      )}
    </div>
  </section>
)}
