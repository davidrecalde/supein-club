---
import { readFileSync } from 'node:fs';
import path from 'node:path';
import { communityColors, communityProvinceCodes } from '../data/spainCommunities';

const rawSvg = readFileSync(
  path.resolve(process.cwd(), 'public/spain-provinces.svg'),
  'utf-8'
);

const guideIds = new Set([
  'ES-A', 'ES-AB', 'ES-AL', 'ES-AV', 'ES-B', 'ES-BA', 'ES-BI', 'ES-BU', 'ES-C', 'ES-CA',
  'ES-CC', 'ES-CE', 'ES-CO', 'ES-CR', 'ES-CS', 'ES-CU', 'ES-GC', 'ES-GI', 'ES-GR', 'ES-GU',
  'ES-H', 'ES-HU', 'ES-J', 'ES-L', 'ES-LE', 'ES-LO', 'ES-LU', 'ES-M', 'ES-MA', 'ES-ML',
  'ES-MU', 'ES-NA', 'ES-O', 'ES-OR', 'ES-P', 'ES-PM', 'ES-PO', 'ES-S', 'ES-SA', 'ES-SE',
  'ES-SG', 'ES-SO', 'ES-SS', 'ES-TE', 'ES-TF', 'ES-TO', 'ES-T', 'ES-V', 'ES-VA', 'ES-VI',
  'ES-Z', 'ES-ZA',
]);

// SVG viewBox dimensions
const vbW = 418.46;
const vbH = 468.64;

// MapSVG geoViewBox: lon_left lat_top lon_right lat_bottom
const lonMin = -9.303180;
const lonMax =  4.312512;
const latMax = 43.793001;
const latMin = 31.732576;

function toSVG(lon: number, lat: number): [number, number] {
  const x = (lon - lonMin) / (lonMax - lonMin) * vbW;
  const y = (latMax - lat) / (latMax - latMin) * vbH;
  return [+x.toFixed(1), +y.toFixed(1)];
}

type Anchor = 'start' | 'middle' | 'end';
interface City {
  name: string;
  lat: number;
  lon: number;
  anchor: Anchor;
  dy: number;
  capital?: boolean;
}

const cities: City[] = [
  { name: "サンティアゴ・デ・コンポステーラ", lat: 42.88, lon: -8.54, anchor: "start",  dy: -8 },
  { name: "ビゴ",                             lat: 42.23, lon: -8.72, anchor: "start",  dy: -8 },
  { name: "レオン",                            lat: 42.60, lon: -5.57, anchor: "end",    dy: -8 },
  { name: "ビルバオ",                          lat: 43.26, lon: -2.92, anchor: "middle", dy: -8,  capital: true },
  { name: "サン・セバスティアン",               lat: 43.32, lon: -1.98, anchor: "start",  dy: -8,  capital: true },
  { name: "パンプローナ",                       lat: 42.82, lon: -1.64, anchor: "start",  dy: -10 },
  { name: "ログローニョ",                       lat: 42.47, lon: -2.44, anchor: "start",  dy: 12 },
  { name: "ブルゴス",                          lat: 42.35, lon: -3.70, anchor: "middle", dy: -8 },
  { name: "バジャドリー",                       lat: 41.65, lon: -4.72, anchor: "middle", dy: -8 },
  { name: "サラマンカ",                         lat: 40.97, lon: -5.66, anchor: "end",    dy: -8 },
  { name: "セゴビア",                          lat: 40.95, lon: -4.12, anchor: "start",  dy: -8 },
  { name: "マドリッド",                         lat: 40.42, lon: -3.70, anchor: "middle", dy: -8,  capital: true },
  { name: "サラゴサ",                          lat: 41.65, lon: -0.89, anchor: "middle", dy: -8 },
  { name: "バルセロナ",                         lat: 41.39, lon:  2.16, anchor: "start",  dy: -10, capital: true },
  { name: "タラゴナ",                          lat: 41.12, lon:  1.25, anchor: "start",  dy: 12 },
  { name: "トレド",                            lat: 39.86, lon: -4.03, anchor: "middle", dy: -8 },
  { name: "シウダーレアル",                     lat: 38.99, lon: -3.92, anchor: "middle", dy: -8 },
  { name: "コルドバ",                          lat: 37.89, lon: -4.78, anchor: "middle", dy: -8 },
  { name: "グラナダ",                          lat: 37.18, lon: -3.60, anchor: "middle", dy: -10 },
  { name: "マラガ",                            lat: 36.72, lon: -4.42, anchor: "middle", dy: 12 },
  { name: "アリカンテ",                         lat: 38.35, lon: -0.48, anchor: "start",  dy: -8 },
  { name: "バレンシア",                         lat: 39.47, lon: -0.38, anchor: "start",  dy: -8,  capital: true },
  { name: "セビージャ",                         lat: 37.39, lon: -5.99, anchor: "middle", dy: -8,  capital: true },
  { name: "カディス",                          lat: 36.53, lon: -6.30, anchor: "start",  dy: 12 },
  { name: "ヘレス・デ・ラ・フロンテーラ",         lat: 36.69, lon: -6.14, anchor: "start",  dy: -10 },
];

function buildCityMarkers(list: City[]): string {
  let g = '<g class="city-layer" pointer-events="none">\n';

  for (const city of list) {
    const [x, y] = toSVG(city.lon, city.lat);
    const labelX = city.anchor === 'end' ? x - 6 : city.anchor === 'start' ? x + 6 : x;
    const r          = city.capital ? 3.5 : 2.5;
    const dotFill    = city.capital ? '#002147' : '#1a1a1a';
    const dotOpacity = city.capital ? '0.9' : '0.75';
    const fontSize   = city.capital ? 8.5 : 7.5;
    const fontWeight = city.capital ? '700' : '500';
    const textOpacity = city.capital ? '1' : '0.85';
    const textFill   = city.capital ? '#002147' : '#1a1a1a';

    const line = city.anchor !== 'middle'
      ? `  <line x1="${x}" y1="${y}" x2="${labelX}" y2="${y + city.dy}" stroke="rgba(26,26,26,0.25)" stroke-width="0.5"/>\n`
      : '';

    g += `<g class="city-marker">\n`;
    g += line;
    g += `  <circle cx="${x}" cy="${y}" r="${r}" fill="${dotFill}" opacity="${dotOpacity}"/>\n`;
    g += `  <circle cx="${x}" cy="${y}" r="${r}" fill="none" stroke="white" stroke-width="1.5" opacity="0.9"/>\n`;
    g += `  <text x="${labelX}" y="${y + city.dy}" text-anchor="${city.anchor}" font-family="'Noto Sans JP','Hiragino Sans',sans-serif" font-size="${fontSize}" font-weight="${fontWeight}" fill="${textFill}" opacity="${textOpacity}" paint-order="stroke fill" stroke="rgba(255,255,255,0.95)" stroke-width="2.5" stroke-linejoin="round">${city.name}</text>\n`;
    g += `</g>\n`;
  }

  g += '</g>';
  return g;
}

const cityMarkersStr = buildCityMarkers(cities);

// Patrones geométricos para las comunidades cuyo color de bandera es casi
// idéntico al de otra (los 5 dorados, los 6 rojos): un relleno base pastel
// (mapColor) más una trama sutil en un tono más oscuro de la misma familia.
function buildPatternDefs(): string {
  let defs = '<defs>\n';
  for (const c of communityColors) {
    if (!c.pattern) continue;
    const id = `pat-${c.slug}`;
    if (c.pattern === 'dots') {
      defs += `<pattern id="${id}" patternUnits="userSpaceOnUse" width="4.5" height="4.5">
  <rect width="4.5" height="4.5" fill="${c.mapColor}"/>
  <circle cx="1.2" cy="1.2" r="0.7" fill="${c.lineColor}" opacity="0.55"/>
</pattern>\n`;
    } else {
      const angle = c.pattern === 'hatch1' ? 45 : 135;
      defs += `<pattern id="${id}" patternUnits="userSpaceOnUse" width="4" height="4" patternTransform="rotate(${angle})">
  <rect width="4" height="4" fill="${c.mapColor}"/>
  <line x1="0" y1="0" x2="0" y2="4" stroke="${c.lineColor}" stroke-width="1.3" opacity="0.55"/>
</pattern>\n`;
    }
  }
  defs += '</defs>';
  return defs;
}
const patternDefsStr = buildPatternDefs();

// CSS de relleno por provincia, generado desde la paleta compartida
// (src/data/spainCommunities.ts) — misma fuente que los botones de
// provincia y la leyenda de /food/spain-map/. Se inyecta como <style>
// nativo dentro del propio SVG (en vez de un <style> de Astro) para poder
// interpolar valores dinámicos sin pelear con la extracción estática de
// CSS de Astro.
const fillRulesStr = communityColors
  .map((c) => {
    const codes = communityProvinceCodes[c.slug] ?? [];
    if (codes.length === 0) return '';
    const selector = codes.map((code) => `#${code}`).join(', ');
    const fill = c.pattern ? `url(#pat-${c.slug})` : c.mapColor;
    return `${selector} { fill: ${fill}; }`;
  })
  .filter(Boolean)
  .join('\n');
const fillStyleStr = `<style>${fillRulesStr}</style>`;

// El viewBox visible se recorta a 328 unidades de alto (frente a las 468.64
// originales): Canarias, Ceuta y Melilla se reposicionaron (ver
// public/spain-provinces.svg) en el mar al SE de Baleares, dentro del área
// que ya ocupa la España peninsular (que llega hasta y≈311), así que la
// franja inferior vacía que antes las alojaba en una fila aparte ya no hace
// falta. vbW/vbH (usados por toSVG() para las ciudades) NO cambian: siguen
// siendo el lienzo completo original, ya que ese es el sistema de
// coordenadas en el que están dibujadas las provincias — el viewBox solo
// decide qué porción de ese lienzo se muestra, sin reescalar nada.
let svgContent = rawSvg
  .replace('width="418.45123"', 'class="spain-map-svg" width="100%" viewBox="0 0 418.46 328" preserveAspectRatio="xMidYMid meet"')
  .replace('\n   height="468.63733"', '')
  .replace('</svg>', patternDefsStr + '\n' + fillStyleStr + '\n' + cityMarkersStr + '\n</svg>');

svgContent = svgContent.replace(/id="(ES-[A-Z]+)"/g, (_match, id) => {
  const hasGuide = guideIds.has(id);
  return `id="${id}" data-province="${id}"${hasGuide ? ' data-has-guide="true"' : ''}`;
});
---

<div class="map-container">
  <Fragment set:html={svgContent} />
</div>

<div class="map-legend">
  <div class="legend-grid">
    {communityColors.map((c) => (
      <>
        <span class="legend-dot" style={`background:${c.legendColor};`}></span><span class="legend-label">{c.name}</span>
      </>
    ))}
  </div>
  <p style="font-size:12px; color:#6b7280; margin-top:12px;">
    クリックすると、各県のレストラン・バルマップと詳細ガイドが開きます。プロヴィンスボタンの左枠の色とリンクしています。
  </p>
</div>

<div id="spain-tooltip" class="province-tooltip" aria-hidden="true"></div>

<style is:global>
  path[data-province] {
    transition: fill 200ms ease;
    cursor: pointer;
    stroke: rgba(255, 255, 255, 0.6);
    stroke-width: 0.5;
  }

  path[data-province]:hover {
    filter: brightness(1.15);
  }

  path[data-has-guide="true"]:hover {
    fill: #C8102E !important;
    filter: none;
  }

  .province-tooltip {
    position: fixed;
    z-index: 9999;
    background: #002147;
    border: 1.5px solid #C8102E;
    border-radius: 8px;
    padding: 10px 14px;
    pointer-events: none;
    opacity: 0;
    transition: opacity 150ms ease;
    min-width: 140px;
    box-shadow: 0 4px 16px rgba(0,0,0,0.25);
  }
  .province-tooltip.visible { opacity: 1; }
  .tooltip-name {
    font-weight: 700;
    font-size: 14px;
    color: white;
    margin: 0 0 6px;
  }
  .tooltip-badge {
    display: inline-block;
    font-size: 11px;
    font-weight: 600;
    border-radius: 4px;
    padding: 2px 8px;
  }
  .tooltip-badge--guide { background: #C8102E; color: white; }
  .tooltip-badge--map   { background: rgba(255,255,255,0.15); color: rgba(255,255,255,0.85); }
  .tooltip-action {
    display: block;
    font-size: 11px;
    margin-top: 6px;
    color: rgba(255,255,255,0.6);
  }

  @media (max-width: 600px) {
    .city-marker text {
      font-size: 9px;
    }
  }
</style>

<style>
  .map-container {
    background: #FAFAF8;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    padding: 16px;
    max-width: 800px;
    margin: 0 auto;
  }
  .map-legend {
    margin-top: 20px;
    max-width: 800px;
    margin-left: auto;
    margin-right: auto;
  }
  .legend-grid {
    display: grid;
    grid-template-columns: auto 1fr auto 1fr auto 1fr;
    gap: 8px 16px;
    align-items: center;
  }
  .legend-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    display: inline-block;
    flex-shrink: 0;
  }
  .legend-label { font-size: 13px; color: #4b5563; }
  @media (max-width: 600px) {
    .legend-grid { grid-template-columns: auto 1fr auto 1fr; }
  }
</style>

<script>
(function () {
  var provinceMap = {
    'ES-A':  { ja: 'アリカンテ',     url: '/food/spain-map/alicante/',   hasGuide: true },
    'ES-AB': { ja: 'アルバセテ',     url: '/food/spain-map/albacete/',  hasGuide: true },
    'ES-AL': { ja: 'アルメリア',     url: '/food/spain-map/almeria/',  hasGuide: true },
    'ES-AV': { ja: 'アビラ',         url: '/food/spain-map/avila/',  hasGuide: true },
    'ES-B':  { ja: 'バルセロナ',     url: '/food/spain-map/barcelona/',                 hasGuide: true  },
    'ES-BA': { ja: 'バダホス',       url: '/food/spain-map/badajoz/',  hasGuide: true },
    'ES-BI': { ja: 'ビスカヤ',       url: '/food/spain-map/vizcaya/',  hasGuide: true },
    'ES-BU': { ja: 'ブルゴス',       url: '/food/spain-map/burgos/',  hasGuide: true },
    'ES-C':  { ja: 'ア・コルーニャ', url: '/food/spain-map/la-coruna/',  hasGuide: true },
    'ES-CA': { ja: 'カディス',       url: '/food/spain-map/cadiz/',  hasGuide: true },
    'ES-CC': { ja: 'カセレス',       url: '/food/spain-map/caceres/',  hasGuide: true },
    'ES-CE': { ja: 'セウタ',         url: '/food/spain-map/ceuta/',  hasGuide: true },
    'ES-CO': { ja: 'コルドバ',       url: '/food/spain-map/cordoba/',  hasGuide: true },
    'ES-CR': { ja: 'シウダ・レアル', url: '/food/spain-map/ciudad-real/',  hasGuide: true },
    'ES-CS': { ja: 'カステジョン',   url: '/food/spain-map/castellon/',  hasGuide: true },
    'ES-CU': { ja: 'クエンカ',       url: '/food/spain-map/cuenca/',  hasGuide: true },
    'ES-GC': { ja: 'ラス・パルマス', url: '/food/spain-map/las-palmas/',  hasGuide: true },
    'ES-GI': { ja: 'ヘローナ',       url: '/food/spain-map/gerona/',  hasGuide: true },
    'ES-GR': { ja: 'グラナダ',       url: '/food/spain-map/granada/',  hasGuide: true },
    'ES-GU': { ja: 'グアダラハラ',   url: '/food/spain-map/guadalajara/',  hasGuide: true },
    'ES-H':  { ja: 'ウエルバ',       url: '/food/spain-map/huelva/',  hasGuide: true },
    'ES-HU': { ja: 'ウエスカ',       url: '/food/spain-map/huesca/',  hasGuide: true },
    'ES-J':  { ja: 'ハエン',         url: '/food/spain-map/jaen/',  hasGuide: true },
    'ES-L':  { ja: 'リェイダ',       url: '/food/spain-map/lerida/',  hasGuide: true },
    'ES-LE': { ja: 'レオン',         url: '/food/spain-map/leon/',  hasGuide: true },
    'ES-LO': { ja: 'ラ・リオハ',     url: '/food/spain-map/la-rioja/',  hasGuide: true },
    'ES-LU': { ja: 'ルーゴ',         url: '/food/spain-map/lugo/',  hasGuide: true },
    'ES-M':  { ja: 'マドリード',     url: '/food/spain-map/madrid/',                   hasGuide: true  },
    'ES-MA': { ja: 'マラガ',         url: '/food/spain-map/malaga/',  hasGuide: true },
    'ES-ML': { ja: 'メリリャ',       url: '/food/spain-map/melilla/',  hasGuide: true },
    'ES-MU': { ja: 'ムルシア',       url: '/food/spain-map/murcia/',  hasGuide: true },
    'ES-NA': { ja: 'ナバラ',         url: '/food/spain-map/navarra/',  hasGuide: true },
    'ES-O':  { ja: 'アストゥリアス', url: '/food/spain-map/asturias/',  hasGuide: true },
    'ES-OR': { ja: 'オウレンセ',     url: '/food/spain-map/orense/',  hasGuide: true },
    'ES-P':  { ja: 'パレンシア',     url: '/food/spain-map/palencia/',  hasGuide: true },
    'ES-PM': { ja: 'バレアレス諸島', url: '/food/spain-map/islas-baleares/',  hasGuide: true },
    'ES-PO': { ja: 'ポンテベドラ',   url: '/food/spain-map/pontevedra/',  hasGuide: true },
    'ES-S':  { ja: 'カンタブリア',   url: '/food/spain-map/cantabria/',  hasGuide: true },
    'ES-SA': { ja: 'サラマンカ',     url: '/food/spain-map/salamanca/',  hasGuide: true },
    'ES-SE': { ja: 'セビリア',       url: '/food/spain-map/sevilla/',                  hasGuide: true  },
    'ES-SG': { ja: 'セゴビア',       url: '/food/spain-map/segovia/',  hasGuide: true },
    'ES-SO': { ja: 'ソリア',         url: '/food/spain-map/soria/',  hasGuide: true },
    'ES-SS': { ja: 'ギプスコア',     url: '/food/spain-map/guipuzcoa/',  hasGuide: true },
    'ES-TE': { ja: 'テルエル',       url: '/food/spain-map/teruel/',  hasGuide: true },
    'ES-TF': { ja: 'テネリフェ',     url: '/food/spain-map/santa-cruz-de-tenerife/',  hasGuide: true },
    'ES-TO': { ja: 'トレド',         url: '/food/spain-map/toledo/',  hasGuide: true },
    'ES-T':  { ja: 'タラゴナ',       url: '/food/spain-map/tarragona/',  hasGuide: true },
    'ES-V':  { ja: 'バレンシア',     url: '/food/spain-map/valencia/',                 hasGuide: true  },
    'ES-VA': { ja: 'バリャドリード', url: '/food/spain-map/valladolid/',  hasGuide: true },
    'ES-VI': { ja: 'アラバ',         url: '/food/spain-map/alava/',  hasGuide: true },
    'ES-Z':  { ja: 'サラゴサ',       url: '/food/spain-map/zaragoza/',  hasGuide: true },
    'ES-ZA': { ja: 'サモラ',         url: '/food/spain-map/zamora/',  hasGuide: true },
  };

  var tooltip = document.getElementById('spain-tooltip');
  if (!tooltip) return;

  function showTooltip(e, data) {
    tooltip.innerHTML =
      '<p class="tooltip-name">' + data.ja + '</p>' +
      (data.hasGuide
        ? '<span class="tooltip-badge tooltip-badge--guide">グルメガイドあり</span><span class="tooltip-action">クリックして読む →</span>'
        : '<span class="tooltip-badge tooltip-badge--map">マップを見る →</span>');
    tooltip.classList.add('visible');
    moveTooltip(e);
  }

  function moveTooltip(e) {
    var x = e.clientX + 14;
    var y = e.clientY - 36;
    var tw = tooltip.offsetWidth || 160;
    if (x + tw > window.innerWidth - 8) { x = e.clientX - tw - 8; }
    tooltip.style.left = x + 'px';
    tooltip.style.top = y + 'px';
  }

  function hideTooltip() { tooltip.classList.remove('visible'); }

  document.querySelectorAll('[data-province]').forEach(function (path) {
    var id = path.id;
    var data = provinceMap[id];
    if (!data) return;
    path.addEventListener('mouseenter', function (e) { showTooltip(e, data); });
    path.addEventListener('mousemove', moveTooltip);
    path.addEventListener('mouseleave', hideTooltip);
    path.addEventListener('click', function () {
      hideTooltip();
      if (data.url.startsWith('http')) {
        window.open(data.url, '_blank', 'noopener noreferrer');
      } else {
        window.location.href = data.url;
      }
    });
  });
})();
</script>
