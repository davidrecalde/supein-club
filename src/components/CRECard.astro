.cre-dim-title {
  font-size: 12px;
  font-weight: 700;
  color: #6b7280;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  margin: 0 0 14px;
}

.cre-dim-row {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 10px;
}

.cre-dim-row:last-child { margin-bottom: 0; }

.cre-dim-label {
  font-size: 12px;
  color: #6b7280;
  min-width: 160px;
  flex-shrink: 0;
}

.cre-dim-bar-wrap {
