  font-weight: 700;
  color: #6b7280;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  margin: 0 0 12px;
}

.cre-review-card {
  background: white;
  border: 1px solid #e5e7eb;
  border-radius: 10px;
  padding: 14px 16px;
  margin-bottom: 8px;
}

.cre-review-card:last-child { margin-bottom: 0; }

.cre-review-header {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 8px;
}

.cre-review-date {
  font-size: 11px;
  color: #9ca3af;
}

.cre-review-text {
  font-size: 13px;
  color: #4b5563;
  line-height: 1.7;
  margin: 0;
}

/* Links */
.cre-detail-links {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
}

.cre-link-official,
.cre-link-maps {
  font-size: 13px;
  font-weight: 600;
  padding: 8px 16px;
  border-radius: 8px;
  text-decoration: none;
  transition: opacity 200ms;
}

.cre-link-official {
  background: #002147;
  color: white;
}

.cre-link-maps {
  background: #e5e7eb;
  color: #374151;
}

.cre-link-official:hover,
.cre-link-maps:hover { opacity: 0.85; }

.cre-link-trends {
  font-size: 13px;
  font-weight: 600;
  padding: 8px 16px;
  border-radius: 8px;
  text-decoration: none;
  transition: opacity 200ms;
  background: #f0fdf4;
  color: #166534;
  border: 1px solid #86efac;
}

.cre-link-trends:hover { opacity: 0.85; }

/* Footer */
.cre-footer {
  font-size: 11px;
  color: #9ca3af;
  text-align: center;
  padding: 12px;
  background: #f9fafb;
  border-top: 1px solid #e5e7eb;
