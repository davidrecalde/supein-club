  font-weight: 700;
  color: white;
  margin: 0;
  font-family: 'Noto Sans JP', sans-serif;
  line-height: 1.3;
}

.cre-widget-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  font-size: 12px;
  color: rgba(255,255,255,0.6);
  margin-bottom: 10px;
}

.cre-widget-desc {
  font-size: 11px;
  color: rgba(255,255,255,0.45);
  margin: 0;
  line-height: 1.6;
}

.cre-widget-list {
  list-style: none;
  padding: 0;
  margin: 0;
