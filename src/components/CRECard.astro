  overflow: hidden;
  text-overflow: ellipsis;
}

.cre-row-sub {
  display: flex;
  align-items: center;
  gap: 5px;
}

.cre-stars-small { color: #f59e0b; font-size: 12px; }
.cre-rating-val {
