}

/* Mobile */
@media (max-width: 767px) {
  .cre-widget-row { padding: 12px 16px; gap: 10px; }
  .cre-score-badge { width: 40px; height: 40px; font-size: 15px; }
  .cre-pos { font-size: 16px; min-width: 22px; }
  .cre-row-name { font-size: 14px; }
  .cre-detail { padding: 16px; }
  .cre-dim-label { min-width: 120px; font-size: 11px; }
  .cre-google-info { flex-direction: column; gap: 10px; }
  .cre-cri-value { font-size: 22px; }
}
</style>

<script>
function toggleCRE(id: string) {
  const item = document.querySelector(
    `[data-id="${id}"]`
  );
  if (!item) return;

  const btn = item.querySelector(
    '.cre-widget-row'
  ) as HTMLButtonElement;
  const detail = item.querySelector(
    '.cre-detail'
  ) as HTMLElement;

  if (!btn || !detail) return;

  const isOpen = btn.getAttribute('aria-expanded') === 'true';

  // Cerrar todos los otros
  document.querySelectorAll('.cre-widget-row').forEach(b => {
    b.setAttribute('aria-expanded', 'false');
  });
  document.querySelectorAll('.cre-detail').forEach(d => {
    (d as HTMLElement).hidden = true;
  });

  // Abrir este si estaba cerrado
  if (!isOpen) {
    btn.setAttribute('aria-expanded', 'true');
    detail.hidden = false;

    // Scroll suave al item
    setTimeout(() => {
      item.scrollIntoView({
        behavior: 'smooth',
        block: 'nearest'
      });
    }, 50);
  }
}

// Exponer globalmente
(window as any).toggleCRE = toggleCRE;
</script>
