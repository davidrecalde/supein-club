  padding: 14px 16px;
  background: white;
  border: 1px solid #e5e7eb;
  border-radius: 10px;
}

.cre-google-row {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.cre-google-label {
  font-size: 11px;
  color: #9ca3af;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  font-weight: 600;
}

.cre-google-val {
