---
interface CREItem {
  position: number;
  name: string;
  nameJa: string;
  url: string;
  mapsUrl: string;
  criScore: number;
  criLevel: string;
  rating: number;
  reviewCount: number;
  description: string;
  dimensions: {
    reputacion: number;
    volumen: number;
    sentimiento: number;
    perfil_gmb: number;
    visibilidad: number;
  };
  reviews: Array<{
    rating: number;
    text: string;
    date: string;
  }>;
}

interface Props {
  items: CREItem[];
  title?: string;
  date?: string;
  location?: string;
}

const {
  items,
  title = "人気観光スポット ランキング",
  date = "",
  location = ""
} = Astro.props;

function criColor(score: number): string {
  if (score >= 90) return '#16a34a';
  if (score >= 70) return '#f59e0b';
  return '#dc2626';
}

function stars(rating: number): string {
  const full = Math.floor(rating);
  const half = rating % 1 >= 0.5 ? 1 : 0;
  const empty = 5 - full - half;
  return '★'.repeat(full) + (half ? '½' : '') + '☆'.repeat(empty);
}

const slug = `cre-${title.toLowerCase()
  .replace(/\s+/g, '-')
  .replace(/[^\w　-鿿゠-ヿ぀-ゟ-]/g, '')
  .slice(0, 50)}`;
---

<div class="cre-widget">

  <!-- Header del widget -->
  <div class="cre-widget-header">
    <div class="cre-widget-title">
      <span class="cre-badge">CRE</span>
      <h3 class="cre-widget-name toc-heading" id={slug}>{title}</h3>
    </div>
    <div class="cre-widget-meta">
      {location && <span>📍 {location}</span>}
      {date && <span>🗓 {date}</span>}
      <span>{items.length}件分析済み</span>
    </div>
    <p class="cre-widget-desc">
      Competitive Reputation Engine by supein.club —
      Googleレビュー・評価・センチメント・オンライン可視性を
      独自アルゴリズムで分析したランキングです。
    </p>
  </div>

  <!-- Lista de items -->
  <ol class="cre-widget-list" itemscope
      itemtype="https://schema.org/ItemList">

    {items.map((item) => (
      <li
        itemprop="itemListElement"
        itemscope
        itemtype="https://schema.org/ListItem"
        class="cre-widget-item"
        data-id={`cre-${item.position}`}
      >
        <meta itemprop="position" content={String(item.position)}/>

        <!-- Fila principal — clickable -->
        <button
          class="cre-widget-row"
          aria-expanded="false"
          aria-controls={`cre-detail-${item.position}`}
          onclick={`toggleCRE('cre-${item.position}')`}
          type="button"
        >
          <!-- Número de posición -->
          <span class={`cre-pos ${item.position <= 3 ? 'cre-pos-top' : ''}`}>
            {item.position}
          </span>

          <!-- Info principal -->
          <span class="cre-row-info">
            <span class="cre-row-name" itemprop="name">
              {item.nameJa}
            </span>
            <span class="cre-row-sub">
              <span class="cre-stars-small">
                {'★'.repeat(Math.floor(item.rating))}
              </span>
              <span class="cre-rating-val">{item.rating}</span>
              <span class="cre-review-count">
                ({item.reviewCount.toLocaleString('ja-JP')}件)
              </span>
            </span>
          </span>

          <!-- CRI Score + barra -->
          <span class="cre-score-wrap">
            <span
              class="cre-score-badge"
              style={`background:${criColor(item.criScore)}`}
            >
              {item.criScore}
            </span>
            <span class="cre-score-level">{item.criLevel}</span>
          </span>

          <!-- Chevron -->
          <span class="cre-chevron" aria-hidden="true">›</span>
        </button>

        <!-- Panel expandible -->
        <div
          class="cre-detail"
          id={`cre-detail-${item.position}`}
          hidden
          itemprop="item"
          itemscope
          itemtype="https://schema.org/TouristAttraction"
        >
          <meta itemprop="name" content={item.nameJa}/>
          <meta itemprop="url" content={item.url}/>

          <!-- aggregateRating — obligatorio para TouristAttraction con reviews -->
          <div itemprop="aggregateRating"
               itemscope
               itemtype="https://schema.org/AggregateRating"
               style="display:none">
            <meta itemprop="ratingValue" content={String(item.rating)}/>
            <meta itemprop="reviewCount" content={String(item.reviewCount)}/>
            <meta itemprop="bestRating" content="5"/>
            <meta itemprop="worstRating" content="1"/>
          </div>

          <!-- Descripción -->
          <p class="cre-detail-desc" itemprop="description">
            {item.description}
          </p>

          <!-- CRI Score grande + barra -->
          <div class="cre-cri-main">
            <div class="cre-cri-header">
              <span class="cre-cri-label">CRI スコア</span>
              <span
                class="cre-cri-value"
                style={`color:${criColor(item.criScore)}`}
              >
                {item.criScore}
              </span>
              <span
                class="cre-cri-chip"
                style={`background:${criColor(item.criScore)}`}
              >
                {item.criLevel}
              </span>
            </div>
            <div class="cre-bar-track">
              <div
                class="cre-bar-fill"
                style={`width:${item.criScore}%;background:${criColor(item.criScore)}`}
              ></div>
            </div>
          </div>

          <!-- 5 dimensiones -->
          <div class="cre-dimensions">
            <h5 class="cre-dim-title">CRI 5次元スコア</h5>
            {[
              { label: '評判 (25%)', key: 'reputacion' },
              { label: 'レビュー数 (20%)', key: 'volumen' },
              { label: 'センチメント (20%)', key: 'sentimiento' },
              { label: 'Googleプロフィール (20%)', key: 'perfil_gmb' },
              { label: 'オンライン可視性 (15%)', key: 'visibilidad' },
            ].map(dim => {
              const score = item.dimensions[dim.key as keyof typeof item.dimensions];
              return (
                <div class="cre-dim-row">
                  <span class="cre-dim-label">{dim.label}</span>
                  <div class="cre-dim-bar-wrap">
                    <div class="cre-dim-bar-track">
                      <div
                        class="cre-dim-bar-fill"
                        style={`width:${score}%;background:${criColor(score)}`}
                      ></div>
                    </div>
                    <span
                      class="cre-dim-score"
                      style={`color:${criColor(score)}`}
                    >
                      {score}
                    </span>
                  </div>
                </div>
              );
            })}
          </div>

          <!-- Google Info -->
          <div class="cre-google-info">
            <div class="cre-google-row">
              <span class="cre-google-label">Google評価</span>
              <span class="cre-google-val">
                <span style="color:#f59e0b;">
                  {'★'.repeat(Math.floor(item.rating))}
                </span>
                <strong>{item.rating}</strong>
                / 5.0
              </span>
            </div>
            <div class="cre-google-row">
              <span class="cre-google-label">レビュー総数</span>
              <span class="cre-google-val">
                {item.reviewCount.toLocaleString('ja-JP')}件
              </span>
            </div>
          </div>

          <!-- Reseñas traducidas -->
          {item.reviews && item.reviews.length > 0 && (
            <div class="cre-reviews-block">
              <h5 class="cre-reviews-title">
                訪問者のレビュー（日本語訳）
              </h5>
              {item.reviews.slice(0, 3).map(review => (
                <div class="cre-review-card"
                     itemprop="review"
                     itemscope
                     itemtype="https://schema.org/Review">

                  <!-- author — obligatorio -->
                  <div itemprop="author"
                       itemscope
                       itemtype="https://schema.org/Person"
                       style="display:none">
                    <meta itemprop="name" content="訪問者"/>
                  </div>

                  <!-- reviewRating — obligatorio -->
                  <div itemprop="reviewRating"
                       itemscope
                       itemtype="https://schema.org/Rating"
                       style="display:none">
                    <meta itemprop="ratingValue" content={String(review.rating)}/>
                    <meta itemprop="bestRating" content="5"/>
                    <meta itemprop="worstRating" content="1"/>
                  </div>

                  <!-- itemReviewed — referencia al padre -->
                  <div itemprop="itemReviewed"
                       itemscope
                       itemtype="https://schema.org/TouristAttraction"
                       style="display:none">
                    <meta itemprop="name" content={item.nameJa}/>
                  </div>

                  <div class="cre-review-header">
                    <span class="cre-review-stars"
                          style="color:#f59e0b;">
                      {'★'.repeat(review.rating)}
                    </span>
                    <span class="cre-review-date">
                      {review.date}
                    </span>
                  </div>
                  <p class="cre-review-text" itemprop="reviewBody">
                    {review.text}
                  </p>
                </div>
              ))}
            </div>
          )}

          <!-- Links -->
          <div class="cre-detail-links">
            <a
              href={item.url}
              target="_blank"
              rel="nofollow noopener noreferrer"
              class="cre-link-official"
              itemprop="url"
            >
              🌐 公式サイト
            </a>
            <a
              href={item.mapsUrl}
              target="_blank"
              rel="nofollow noopener noreferrer"
              class="cre-link-maps"
            >
              📍 Googleマップ
            </a>
            <a
              href={`https://trends.google.com/trends/explore?q=${encodeURIComponent(item.name)}`}
              target="_blank"
              rel="nofollow noopener noreferrer"
              class="cre-link-trends"
            >
              📈 Google Trends
            </a>
          </div>

        </div><!-- /.cre-detail -->
      </li>
    ))}
  </ol>

  <p class="cre-footer">
    Powered by
    <strong>CRE — Competitive Reputation Engine v8</strong>
    · supein.club · {date}
  </p>

</div>

<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": title,
  "description": `CRE — Competitive Reputation Engine by supein.club. ${location} ${date}`,
  "numberOfItems": items.length,
  "itemListElement": items.map((item) => ({
    "@type": "ListItem",
    "position": item.position,
    "item": {
      "@type": "TouristAttraction",
      "name": item.nameJa,
      "url": item.url,
      "description": item.description,
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": item.rating,
        "reviewCount": item.reviewCount,
        "bestRating": 5,
        "worstRating": 1
      },
      "review": item.reviews.slice(0, 3).map(r => ({
        "@type": "Review",
        "reviewRating": {
          "@type": "Rating",
          "ratingValue": r.rating,
          "bestRating": 5,
          "worstRating": 1
        },
        "author": {
          "@type": "Person",
          "name": "訪問者"
        },
        "reviewBody": r.text
      }))
    }
  }))
}).replace(/</g, '\\u003c')} />

<style>
/* ━━━ CRE Widget ━━━ */
