---
// Hub DELE /language/dele/ (petición de David, 13 de noviembre de 2026): la misma organización que el hub
// /language/. Va a todo el ancho entre la cabecera y el texto del artículo (ArticleLayout, articleRole
// hub-dele): はじめる con dos botones grandes y los bloques 01 レベル別ガイド, 02 模擬試験,
// 03 対策と勉強法 y 04 日程と費用. Debajo sigue el texto de 「DELEとは」.
import { getCollection, type CollectionEntry } from 'astro:content';
import { getImage } from 'astro:assets';
import { ClipboardCheck, Map as MapIcon } from 'lucide-astro';
import HubCard from './HubCard.astro';
import { COURSE_LEVELS, COURSE_URL } from '../data/course';
import { getArticleUrl } from '../utils/articles';
import { getAllUnits, isCourseVisible } from '../utils/units';

type Article = CollectionEntry<'articles'>;
const idNoExt = (a: Article) => a.id.replace(/\.(md|mdx)$/, '');
const articles = await getCollection('articles', ({ data }) => !data.draft && data.pillar === 'language');
const byId = (id: string) => articles.find((a) => idNoExt(a) === `language/learn-spanish/${id}`);

// Imágenes de los botones grandes: las de sus artículos (480 y 800 px).
const cardImage = async (a?: Article) => {
  const src = a?.data.heroImage;
  if (!a || !src || typeof src === 'string') return undefined;
  const [small, large] = await Promise.all([480, 800].map((width) => getImage({ src, width, format: 'webp', quality: 75 })));
  return { src: large.src, srcset: `${small.src} 480w, ${large.src} 800w`, width: Number(large.attributes.width), height: Number(large.attributes.height), alt: a.data.heroImageAlt ?? '' };
};
const levelTest = byId('level-test');
const roadmap = byId('index');
const dates = byId('dele/dates-and-fees');
const [levelTestImg, roadmapImg, datesImg] = await Promise.all([cardImage(levelTest), cardImage(roadmap), cardImage(dates)]);

// 01: guía de cada nivel, en el color del nivel.
const LEVEL_JA: Record<string, string> = { A1: '入門', A2: '初級', B1: '中級', B2: '中上級', C1: '上級', C2: '最上級' };
const levelGuides = COURSE_LEVELS.map((l) => ({ ...l, ja: LEVEL_JA[l.code], article: byId(`dele/${l.code.toLowerCase()}`) })).filter((l) => l.article);

// 02: simulacros del curso (la última unidad de cada nivel).
const mockExams = (await isCourseVisible())
  ? (await getAllUnits())
      .filter((u) => u.data.slug.startsWith('review-dele'))
      .map((u) => ({ unit: u.data.unit, level: u.data.level, url: u.data.url, shortTitle: u.data.shortTitle, img: u.data.image?.src.replace(/\.webp$/, '-480.webp'), alt: u.data.image?.alt ?? '' }))
  : [];

// 03: guías de estudio.
const studyGuides = ['dele-difficulty-guide', 'dele-self-study', 'dele-oral-interview-guide', 'dele-vs-seiken'].map(byId).filter((a): a is Article => !!a);

const anchors = [
  { href: '#dele-start', label: 'はじめる' },
  { href: '#dele-levels', label: 'レベル別ガイド' },
  ...(mockExams.length ? [{ href: '#dele-mock', label: '模擬試験' }] : []),
  { href: '#dele-study', label: '対策と勉強法' },
  { href: '#dele-dates', label: '日程と費用' },
  { href: '#dele-about', label: 'DELEとは' },
];
---
<div class="dele-hub" data-pagefind-ignore>
  <section class="max-w-6xl mx-auto px-5 pt-12 pb-12">
    <nav aria-label="このページの内容" class="grid grid-cols-2 md:grid-cols-6 gap-3 mb-12">
      {anchors.map(({ href, label }) => (
        <a href={href} class="bg-white rounded-lg px-3 py-3 min-h-[44px] flex items-center justify-center text-center border border-[#E8E8E6] hover:border-primary/30 hover:shadow-sm transition-all">
          <span class="font-semibold text-navy text-sm leading-snug block">{label}</span>
        </a>
      ))}
    </nav>

    <h2 id="dele-start" class="font-sans font-bold text-xl text-navy mb-5">はじめる</h2>
    <div class="hub-start-grid">
      {levelTest && (
        <a href={getArticleUrl(levelTest)} class="hub-start-card has-image is-primary">
          {levelTestImg && (
            <span class="hub-start-img"><img src={levelTestImg.src} srcset={levelTestImg.srcset} sizes="(min-width: 768px) 560px, 100vw" width={levelTestImg.width} height={levelTestImg.height} alt={levelTestImg.alt} decoding="async" /></span>
          )}
          <span class="hub-start-body">
            <span class="hub-start-head">
              <span class="hub-start-icon"><ClipboardCheck size={24} aria-hidden="true" /></span>
              <span class="hub-start-title">自分のレベルをチェック</span>
            </span>
            <span class="hub-start-desc">どのレベルのDELEを受けるか迷ったら、まずは無料のレベルチェックで今のレベルを確かめましょう。A1〜C2・登録不要。</span>
            <span class="hub-start-cta">レベルチェックを受ける →</span>
          </span>
        </a>
      )}
      {roadmap && (
        <a href={COURSE_URL} class="hub-start-card has-image is-primary">
          {roadmapImg && (
            <span class="hub-start-img"><img src={roadmapImg.src} srcset={roadmapImg.srcset} sizes="(min-width: 768px) 560px, 100vw" width={roadmapImg.width} height={roadmapImg.height} alt={roadmapImg.alt} decoding="async" /></span>
          )}
          <span class="hub-start-body">
            <span class="hub-start-head">
              <span class="hub-start-icon"><MapIcon size={24} aria-hidden="true" /></span>
              <span class="hub-start-title">無料コースでDELEの準備</span>
            </span>
            <span class="hub-start-desc">A1〜C2の無料コースは、各レベルが同じレベルのDELEにつながっています。最後のユニットはDELE形式の模擬試験です。</span>
            <span class="hub-start-cta">ロードマップを見る →</span>
          </span>
        </a>
      )}
    </div>
  </section>

  <section class="hub-block" id="dele-levels" aria-labelledby="dele-levels-title">
    <div class="max-w-6xl mx-auto px-5">
      <div class="hub-block-head">
        <p class="hub-block-eyebrow"><span class="hub-block-num">01</span>レベル別ガイド</p>
        <h2 id="dele-levels-title">DELE A1〜C2：レベル別の試験内容と対策</h2>
        <p class="hub-block-lead">各レベルの試験の構成、タスク、合格に必要な力と勉強法をまとめています。色は無料コースのレベルと同じです。</p>
      </div>
      <ol class="dele-level-grid">
        {levelGuides.map((l) => (
          <li class={`lv-${l.code}`}>
            <a class="dele-level-card" href={getArticleUrl(l.article!)}>
              <span class="dele-level-code">DELE {l.code}</span>
              <span class="dele-level-name">{l.name}・{l.ja}</span>
              <span class="dele-level-cta">試験内容と対策を見る →</span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {mockExams.length > 0 && (
    <section class="hub-block is-dele" id="dele-mock" aria-labelledby="dele-mock-title">
      <div class="max-w-6xl mx-auto px-5">
        <div class="hub-block-head">
          <p class="hub-block-eyebrow"><span class="hub-block-num">02</span>模擬試験</p>
          <h2 id="dele-mock-title">DELE形式の模擬試験（無料・解答つき）</h2>
          <p class="hub-block-lead">無料コースの各レベルの最後のユニットは、DELEと同じ形式の模擬試験です。読解・聴解（音声つき）・作文・会話を、解答と解説で確かめられます。</p>
        </div>
        <ol class="hub-mock-grid is-large">
          {mockExams.map((u) => (
            <li class={`lv-${u.level}`}>
              <a class="unit-tile" href={u.url}>
                <span class="unit-tile-img">{u.img && <img src={u.img} width="480" height="270" alt={u.alt} loading="lazy" decoding="async" />}</span>
                <span class="unit-tile-num">ユニット{u.unit}</span>
                <span class="unit-tile-title">{u.shortTitle}</span>
              </a>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )}

  <section class="hub-block" id="dele-study" aria-labelledby="dele-study-title">
    <div class="max-w-6xl mx-auto px-5">
      <div class="hub-block-head">
        <p class="hub-block-eyebrow"><span class="hub-block-num">{mockExams.length ? '03' : '02'}</span>対策と勉強法</p>
        <h2 id="dele-study-title">DELEの対策と勉強法</h2>
        <p class="hub-block-lead">難易度の目安、独学での準備、面接（口頭試験）の対策、西検との違い。受験の前に読んでおきたいガイドです。</p>
      </div>
      <div class="hub-card-grid">
        {studyGuides.map((a) => (
          <HubCard title={a.data.title} href={getArticleUrl(a)} heroImage={a.data.heroImage} heroImageAlt={a.data.heroImageAlt} image={a.data.image} imageAlt={a.data.imageAlt} badge="DELE" />
        ))}
      </div>
    </div>
  </section>

  {dates && (
    <section class="hub-block is-dele" id="dele-dates" aria-labelledby="dele-dates-title">
      <div class="max-w-6xl mx-auto px-5">
        <div class="hub-block-head">
          <p class="hub-block-eyebrow"><span class="hub-block-num">{mockExams.length ? '04' : '03'}</span>日程と費用</p>
          <h2 id="dele-dates-title">DELEの日程・費用・申込方法</h2>
        </div>
        <a href={getArticleUrl(dates)} class="hub-feature">
          {datesImg && (
            <span class="hub-feature-img"><img src={datesImg.src} srcset={datesImg.srcset} sizes="(min-width: 768px) 600px, 100vw" width={datesImg.width} height={datesImg.height} alt={datesImg.alt} loading="lazy" decoding="async" /></span>
          )}
          <span class="hub-feature-body">
            <span class="hub-feature-badge">DELE</span>
            <span class="hub-feature-title">東京で受けるDELEの日程・費用・申込方法</span>
            <span class="hub-feature-desc">試験日、受験料、東京の会場、申込の手順と結果発表までの期間を、セルバンテス文化センターの情報をもとにまとめています。</span>
            <span class="hub-feature-cta">日程と費用を見る →</span>
          </span>
        </a>
      </div>
    </section>
  )}

  <div id="dele-about" class="dele-hub-about-anchor"></div>
</div>
