---
interface Props {
  target?: string;
}
const { target = 'categories' } = Astro.props;
---
<button
  type="button"
  class="back-to-categories"
  id="backToCategoriesBtn"
  data-target={target}
  aria-label="カテゴリへ戻る"
>
  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5"/><path d="m6 11 6-6 6 6"/></svg>
  <span>カテゴリへ</span>
</button>

<style>
  .back-to-categories {
    position: fixed;
    right: 22px;
    bottom: 22px;
    z-index: 40;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #002147;
    color: #fff;
    border: none;
    border-radius: 999px;
    padding: 13px 18px 13px 14px;
    font-family: "Poppins", "Noto Sans JP", system-ui, sans-serif;
    font-size: 13.5px;
    font-weight: 600;
    box-shadow: 0 8px 22px rgba(0, 33, 71, 0.28);
    cursor: pointer;
    opacity: 0;
    transform: translateY(10px) scale(0.96);
    pointer-events: none;
    transition: opacity 220ms ease, transform 220ms ease, background 160ms ease;
  }
  .back-to-categories.is-visible {
    opacity: 1;
    transform: translateY(0) scale(1);
    pointer-events: auto;
  }
  .back-to-categories:hover {
    background: #c8102e;
  }
  .back-to-categories svg {
    flex-shrink: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .back-to-categories {
      transition: opacity 160ms ease;
    }
  }
  @media (max-width: 480px) {
    .back-to-categories span {
      display: none;
    }
    .back-to-categories {
      padding: 14px;
    }
  }
</style>

<script>
  const btn = document.getElementById('backToCategoriesBtn');
  if (btn) {
    const targetId = btn.dataset.target || 'categories';
    const targetEl = document.getElementById(targetId);

    if (targetEl) {
      const threshold = () => window.innerHeight * 0.9;

      function onScroll() {
        if (window.scrollY > threshold()) {
          btn.classList.add('is-visible');
        } else {
          btn.classList.remove('is-visible');
        }
      }
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();

      btn.addEventListener('click', () => {
        const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        targetEl.scrollIntoView({ behavior: prefersReduced ? 'auto' : 'smooth', block: 'start' });
      });
    }
  }
</script>
