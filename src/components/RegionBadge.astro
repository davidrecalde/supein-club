---
import { getRegion } from '../config/regions';
import { communityColorMap } from '../data/spainCommunities';

interface Props {
  region: string;
}

const { region } = Astro.props;
const config = getRegion(region);
const color = config ? communityColorMap[config.communitySlug]?.flagColor ?? '#C8102E' : '#C8102E';
---
{config && (
  <a class="region-badge" href={`/regions/${config.slug}/`} style={`--region-color: ${color};`}>
    <img
      src={`/images/flags/${config.communitySlug}.webp`}
      alt=""
      width="14"
      height="14"
      loading="lazy"
    />
    {config.label}地方
  </a>
)}

<style>
  .region-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: color-mix(in srgb, var(--region-color) 18%, transparent);
    border: 1px solid color-mix(in srgb, var(--region-color) 45%, transparent);
    color: #fff;
    font-family: "Poppins", "Noto Sans JP", system-ui, sans-serif;
    font-size: 12px;
    font-weight: 600;
    padding: 4px 11px 4px 7px;
    border-radius: 999px;
    text-decoration: none;
    transition: background 160ms ease;
  }
  .region-badge:hover {
    background: var(--region-color);
  }
  .region-badge img {
    width: 14px;
    height: 14px;
    border-radius: 3px;
    object-fit: cover;
    flex-shrink: 0;
  }
  @media (max-width: 480px) {
    .region-badge {
      order: 99;
      width: 100%;
      justify-content: center;
      margin-top: 4px;
    }
  }
</style>
