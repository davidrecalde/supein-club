---
import { ABOUT_COURSE_URL, CAST_URL, COURSE_LEVELS, TOTAL_UNITS, WELCOME_URL, levelUrl } from '../../data/course';
import { getAllUnits, isCourseVisible, isRoutable } from '../../utils/units';

// Páginas de apoyo de cada nivel (resumen de gramática, vocabulario, plan) y su guía DELE.
const spokes = (code: string) => {
  const base = levelUrl(code);
  return [
    { href: `${base}grammar/`, label: '文法まとめ' },
    { href: `${base}vocabulary/`, label: '単語' },
    { href: `${base}study-plan/`, label: '学習計画' },
    { href: `/language/learn-spanish/dele/${code.toLowerCase()}/`, label: `DELE ${code}` },
  ];
};

const visible = await isCourseVisible();
const units = await getAllUnits();
const levels = COURSE_LEVELS.map((level) => {
  const levelUnits = units.filter((u) => u.data.level === level.code);
  return {
    ...level,
    total: levelUnits.length,
    unitNumbers: levelUnits.map((u) => u.data.unit),
    live: levelUnits.filter(isRoutable).map((u) => ({ unit: u.data.unit, url: u.data.url, shortTitle: u.data.shortTitle })),
  };
});
---
{visible && (
<section class="course-levels" id="course" data-pagefind-ignore>
  <h2>スペイン語コース（A1〜C2・全{TOTAL_UNITS}ユニット）</h2>
  <p>無料・登録不要で、自分のペースで進められるコースです。進み具合はこのブラウザに保存されます。</p>
  <p class="course-links">
    <a href={WELCOME_URL}>学習設定（地域・ペース・例文の数）</a>
    <a href={CAST_URL}>登場人物</a>
    <a href={ABOUT_COURSE_URL}>このコースの作り方</a>
  </p>
  <ol class="course-levels-grid">
    {levels.map((l) => (
      <li class={`course-level lv-${l.code}`} data-units={JSON.stringify(l.unitNumbers)} data-live-units={JSON.stringify(l.live)}>
        <a href={levelUrl(l.code)} class="course-level-name">
          <span class="level-chip">{l.code}</span> {l.name}
        </a>
        <span class="course-level-range">ユニット{l.first}〜{l.last}（全{l.total}ユニット）</span>
        <div class="course-level-bar" hidden><div class="course-level-fill"></div></div>
        <span class="course-level-percent" hidden>0%</span>
        <span class="course-level-next" hidden></span>
        <span class="course-level-spokes">
          {spokes(l.code).map((s) => <a href={s.href}>{s.label}</a>)}
        </span>
      </li>
    ))}
  </ol>
</section>
)}

<script>
  import { PROGRESS_EVENT, isCompleted, loadProgress } from '../../utils/courseProgress';

  function render() {
    const progress = loadProgress();
    document.querySelectorAll<HTMLElement>('.course-level').forEach((card) => {
      const units: number[] = JSON.parse(card.dataset.units ?? '[]');
      const live: Array<{ unit: number; url: string; shortTitle: string }> = JSON.parse(card.dataset.liveUnits ?? '[]');
      const done = units.filter((u) => isCompleted(progress, u)).length;
      const percent = units.length ? Math.round((done / units.length) * 100) : 0;
      card.querySelector<HTMLElement>('.course-level-fill')!.style.width = `${percent}%`;
      card.querySelector<HTMLElement>('.course-level-bar')!.hidden = false;
      const percentEl = card.querySelector<HTMLElement>('.course-level-percent')!;
      percentEl.textContent = `${percent}% 完了`;
      percentEl.hidden = false;
      const next = live.find((u) => !isCompleted(progress, u.unit));
      const nextEl = card.querySelector<HTMLElement>('.course-level-next')!;
      if (next) {
        nextEl.innerHTML = '';
        const link = document.createElement('a');
        link.href = next.url;
        link.textContent = `次：ユニット${next.unit} ${next.shortTitle}`;
        nextEl.append(link);
        nextEl.hidden = false;
      } else {
        nextEl.hidden = true;
      }
    });
  }

  window.addEventListener(PROGRESS_EVENT, render);
  render();
</script>
