---
// Índice del curso en el hub /language/ (rediseño del 13 de noviembre de 2026, petición de David):
// una fila por nivel. A la izquierda, la tarjeta 「A1レベルの目次」 en el color del nivel, que lleva a
// la página del nivel; a la derecha, las miniaturas de todas sus unidades con su número, para que quien
// vuelve reconozca de un vistazo por dónde iba. Con JavaScript se marcan las unidades completadas y
// la última abierta (「前回のユニット」, courseProgress.lastVisited). Sin JavaScript todo funciona igual.
import { Check } from 'lucide-astro';
import { COURSE_LEVELS, levelUrl } from '../../data/course';
import { getAllUnits, hasPage, isCourseVisible } from '../../utils/units';

// Páginas de apoyo de cada nivel (resumen de gramática, vocabulario, plan) y su guía DELE.
const spokes = (code: string) => {
  const base = levelUrl(code);
  return [
    { href: `${base}grammar/`, label: '文法まとめ' },
    { href: `${base}vocabulary/`, label: '単語' },
    { href: `${base}study-plan/`, label: '学習計画' },
    { href: `/language/learn-spanish/dele/${code.toLowerCase()}/`, label: `DELE ${code}` },
  ];
};

// Miniatura de 480 px de la ilustración de la unidad (la genera npm run course:images).
const thumb = (src?: string) => src?.replace(/\.webp$/, '-480.webp');

const visible = await isCourseVisible();
const units = (await getAllUnits()).filter(hasPage);
const levels = COURSE_LEVELS.map((level) => ({
  ...level,
  units: units
    .filter((u) => u.data.level === level.code)
    .map((u) => ({ unit: u.data.unit, url: u.data.url, shortTitle: u.data.shortTitle, img: thumb(u.data.image?.src), alt: u.data.image?.alt ?? '' })),
}));
---
{visible && (
<ol class="course-index" data-pagefind-ignore>
  {levels.map((l) => (
    <li class={`course-row lv-${l.code}`} data-units={JSON.stringify(l.units.map((u) => u.unit))}>
      <div class="course-row-side">
        <a href={levelUrl(l.code)} class="course-row-index">
          <span class="course-row-eyebrow">{`${l.code} ${l.name}`}</span>
          <span class="course-row-title">{l.code}レベルの目次</span>
          <span class="course-row-range">ユニット{l.first}〜{l.last}・全{l.units.length}ユニット</span>
          <span class="course-row-progress" hidden>
            <span class="course-row-bar"><span class="course-row-fill"></span></span>
            <span class="course-row-percent">0% 完了</span>
          </span>
          <span class="course-row-cta">{l.code}の目次を見る →</span>
        </a>
        <p class="course-row-spokes">
          {spokes(l.code).map((s) => <a href={s.href}>{s.label}</a>)}
        </p>
      </div>
      <ol class="course-row-units" aria-label={`${l.code} ${l.name}のユニット`}>
        {l.units.map((u) => (
          <li>
            <a class="unit-tile" href={u.url} data-unit={u.unit}>
              <span class="unit-tile-img">
                {u.img && <img src={u.img} width="480" height="270" alt={u.alt} loading="lazy" decoding="async" />}
                <span class="unit-tile-done" aria-hidden="true"><Check size={14} /></span>
              </span>
              <span class="unit-tile-num">ユニット{u.unit}</span>
              <span class="unit-tile-title">{u.shortTitle}</span>
              <span class="unit-tile-last">前回のユニット</span>
            </a>
          </li>
        ))}
      </ol>
    </li>
  ))}
</ol>
)}

<script>
  import { PROGRESS_EVENT, isCompleted, loadProgress } from '../../utils/courseProgress';

  function render() {
    const progress = loadProgress();
    const last = progress.lastVisited?.unit;
    document.querySelectorAll<HTMLElement>('.course-row').forEach((row) => {
      const units: number[] = JSON.parse(row.dataset.units ?? '[]');
      const done = units.filter((u) => isCompleted(progress, u)).length;
      const percent = units.length ? Math.round((done / units.length) * 100) : 0;
      if (done > 0 || last !== undefined) {
        row.querySelector<HTMLElement>('.course-row-fill')!.style.width = `${percent}%`;
        row.querySelector<HTMLElement>('.course-row-percent')!.textContent = `${percent}% 完了（${done}/${units.length}）`;
        row.querySelector<HTMLElement>('.course-row-progress')!.hidden = false;
      }
      row.querySelectorAll<HTMLElement>('.unit-tile').forEach((tile) => {
        const unit = Number(tile.dataset.unit);
        tile.classList.toggle('is-done', isCompleted(progress, unit));
        tile.classList.toggle('is-last', unit === last);
        if (unit === last) {
          // En móvil la fila es un carrusel horizontal: se desplaza hasta la última unidad abierta.
          const strip = tile.closest<HTMLElement>('.course-row-units');
          if (strip && strip.scrollWidth > strip.clientWidth) strip.scrollLeft = (tile.parentElement as HTMLElement).offsetLeft - 16;
        }
      });
    });
  }

  render();
  window.addEventListener(PROGRESS_EVENT, render);
</script>
