---
import { levelUrl, getCourseLevel, COURSE_LEVELS } from '../../data/course';

interface NavItem {
  unit: number;
  shortTitle: string;
  url: string;
  linkable: boolean;
}

interface Props {
  prev?: NavItem;
  next?: NavItem;
  related: NavItem[];
  level: string;
}

const { prev, next, related, level: levelCode } = Astro.props;
const level = getCourseLevel(levelCode)!;
// Nivel de la unidad de destino (la anterior o la siguiente puede ser de otro nivel: 12 → 13).
const levelOf = (unit: number) => COURSE_LEVELS.find((l) => unit >= l.first && unit <= l.last) ?? level;
---
<nav class="unit-nav" aria-label="ユニットナビゲーション" data-pagefind-ignore>
  <div class="unit-nav-steps">
    {prev ? (() => {
      const lv = levelOf(prev.unit);
      const inner = (
        <>
          <span class="unit-nav-label">← 前のユニット</span>
          <span class="unit-nav-unit"><span class="level-chip">{lv.code}</span>ユニット{prev.unit}</span>
          <span class="unit-nav-title">{prev.shortTitle}{!prev.linkable && '（準備中）'}</span>
        </>
      );
      return prev.linkable
        ? <a class={`unit-nav-step lv-${lv.code}`} href={prev.url}>{inner}</a>
        : <span class={`unit-nav-step is-pending lv-${lv.code}`}>{inner}</span>;
    })() : <span></span>}
    {next ? (() => {
      const lv = levelOf(next.unit);
      const inner = (
        <>
          <span class="unit-nav-label">{next.linkable ? '次のユニットへ →' : '次のユニット'}</span>
          <span class="unit-nav-unit"><span class="level-chip">{lv.code}</span>ユニット{next.unit}</span>
          <span class="unit-nav-title">{next.shortTitle}{!next.linkable && '（準備中）'}</span>
        </>
      );
      return next.linkable
        ? <a class={`unit-nav-step is-next lv-${lv.code}`} href={next.url}>{inner}</a>
        : <span class={`unit-nav-step is-next is-pending lv-${lv.code}`}>{inner}</span>;
    })() : (
      <a class={`unit-nav-step is-next lv-${level.code}`} href="/language/learn-spanish/">
        <span class="unit-nav-label">コース修了 →</span>
        <span class="unit-nav-title">コースのトップへ</span>
      </a>
    )}
  </div>

  {related.length > 0 && (
    <div class="unit-nav-related">
      <h2>関連ユニット</h2>
      <ul>
        {related.map((r) => (
          <li>
            {r.linkable ? <a href={r.url}>ユニット{r.unit} {r.shortTitle}</a> : <span>ユニット{r.unit} {r.shortTitle}（準備中）</span>}
          </li>
        ))}
      </ul>
    </div>
  )}

  <p class="unit-nav-level"><a href={levelUrl(level.code)}>{level.code} {level.name}のユニット一覧</a></p>
</nav>
