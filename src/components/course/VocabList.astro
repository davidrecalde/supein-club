---
interface Props {
  items?: Array<{ es: string; ja: string; la?: string; rank?: number; example?: string }>;
  level: string;
}

const { items = [], level } = Astro.props;
// Primero las palabras con puesto de frecuencia real (rank), en orden; las expresiones sin puesto, al final.
const sorted = [...items].sort((a, b) => (a.rank ?? Infinity) - (b.rank ?? Infinity));
const hasExamples = sorted.some((i) => i.example);
const ranked = sorted.some((i) => i.rank);
const levelCode = level.toUpperCase();
---
{sorted.length > 0 ? (
  <>
    <table class="vocab-list">
      <thead>
        <tr>
          <th>スペイン語</th>
          <th>日本語</th>
          {hasExamples && <th>例</th>}
        </tr>
      </thead>
      <tbody>
        {sorted.map((item) => (
          <tr>
            <td lang="es">
              {item.la ? (
                <span class="vocab-pair">
                  <span class="v-es">{item.es}<small class="v-tag">スペイン</small></span>
                  <span class="v-la">{item.la}<small class="v-tag">中南米</small></span>
                </span>
              ) : item.es}
            </td>
            <td>{item.ja}</td>
            {hasExamples && <td lang="es">{item.example}</td>}
          </tr>
        ))}
      </tbody>
    </table>
    {ranked && (
      <p class="vocab-note">
        単語は、スペイン語圏の新聞・雑誌の文章で使われる頻度の高い順に並べています（RAE の CORPES XXI 頻度辞典による）。辞典に見出しのない表現（la semana pasada など）は、最後にまとめています。
      </p>
    )}
    <p>
      {levelCode} の単語一覧全体は<a href={`/language/learn-spanish/${level.toLowerCase()}/vocabulary/`}>{levelCode} 単語リスト</a>で確認できます。
    </p>
  </>
) : (
  <p class="unit-pending">語彙リストは準備中です。</p>
)}
