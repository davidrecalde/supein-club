---
import { CAST_URL } from '../../data/course';

interface Member {
  id: string;
  name: string;
  nameEs: string;
  tagline: string;
  color: string;
}

interface Props {
  members: Member[];
}

const { members } = Astro.props;
---
<ul class="cast-badges" aria-label="このユニットの登場人物">
  {members.map((m) => (
    <li>
      <a class="cast-badge" href={`${CAST_URL}#${m.id}`}>
        <img class="cast-avatar" src={`/images/course/cast/${m.id}-96.webp`} width="40" height="40" alt="" style={`background:${m.color}`} loading="lazy" decoding="async" />
        <span class="cast-badge-line"><strong>{m.name}</strong>・{m.tagline}</span>
      </a>
    </li>
  ))}
</ul>
