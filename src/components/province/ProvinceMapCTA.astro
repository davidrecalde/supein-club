---
import { MapPin, ArrowRight } from 'lucide-astro';

interface Props {
  mapUrl: string;
  provinceJa: string;
  /** true: ProvinceMapEmbed（州の madre ページ）と同じ見出し付きで表示する。
   * 記事本文の .prose 幅に収まる、フルブリード無しのバージョン。 */
  withHeading?: boolean;
}

const { mapUrl, provinceJa, withHeading } = Astro.props;
---
{withHeading && <hr style="border:none; border-top:1px solid #E8E8E6; margin:40px 0;" />}
{withHeading && (
  <>
    <p class="text-primary font-bold tracking-widest" style="font-size:11px; text-transform:uppercase; margin-bottom:8px;">INTERACTIVE MAP</p>
    <h2 style="font-size:clamp(22px,3vw,28px); font-weight:700; margin-bottom:12px; color:var(--color-navy, #002147);">{provinceJa}レストランマップ</h2>
    <p style="font-size:15px; margin-bottom:20px; color:#6b7280;">
      スペイン倶楽部がキュレーションした{provinceJa}のレストラン・バルを地図で確認できます。
    </p>
  </>
)}
<a
  href={mapUrl}
  target="_blank"
  rel="noopener noreferrer"
  class="map-cta-card"
>
  <div class="map-cta-icon">
    <MapPin size={28} color="#C8102E" />
  </div>
  <div style="flex:1;">
    <p style="font-weight:700; font-size:16px; margin:0; color:white;">{provinceJa}のレストランマップを開く</p>
    <p style="opacity:0.7; font-size:13px; margin:4px 0 0; color:white;">Google マップで全レストラン・バルを確認</p>
  </div>
  <ArrowRight size={20} color="white" />
</a>
{withHeading && (
  <>
    <p style="font-size:13px; margin-top:20px; line-height:1.6; color:#6b7280;">
      マップはスペイン倶楽部が独自にキュレーションしています。
      全47都道府県・スペイン全省のマップは
      <a href="https://linktr.ee/supeinclub" target="_blank" rel="noopener nofollow noreferrer" class="text-primary hover:underline">こちら →</a>
    </p>
    <hr style="border:none; border-top:1px solid #E8E8E6; margin:40px 0;" />
  </>
)}

<style>
  .map-cta-card {
    display: flex;
    align-items: center;
    gap: 16px;
    background: var(--color-navy, #002147);
    color: white;
    padding: 20px 24px;
    border-radius: 12px;
    text-decoration: none;
    border: 1px solid rgba(255,255,255,0.2);
    margin: 32px 0;
    transition: border-color 0.2s;
  }
  .map-cta-card:hover {
    border-color: var(--color-primary, #C8102E);
  }
  .map-cta-icon {
    flex-shrink: 0;
  }
</style>
