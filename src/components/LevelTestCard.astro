---
// Test de nivel v3 (16 de noviembre de 2026; docs/language/plan-hub-embudo.md, punto 19).
// 60 preguntas, 10 por nivel, de menos a más difíciles; no se muestra el nivel de cada pregunta ni si
// la respuesta es correcta. Al final: barras por nivel, nivel estimado (último nivel alcanzado de forma
// consecutiva con el 70 % de aciertos), destrezas, unidad de inicio y enlace a la página de soluciones.
// Todo el contenido está en el HTML; sin JavaScript se ven las preguntas en lista. El JavaScript
// muestra las fichas de una en una, guarda el progreso en localStorage y calcula el resultado.
import { Check, Clock, ExternalLink, Flag, Headphones, CircleHelp, Info, List, Pause, Play, RotateCcw, Save, TrendingUp, UserX, Volume2, ArrowLeft, ArrowRight } from 'lucide-astro';
import AiAudioLabel from './course/AiAudioLabel.astro';
import { COURSE_LEVELS, WELCOME_URL, levelUrl } from '../data/course';
import { getAllUnits, isCourseVisible, isRoutable } from '../utils/units';
import { PASS_RATIO, SKILL_LABEL, SOLUTIONS_URL, activeQuestions, audioOf, testVersion, type LevelTestItem } from '../utils/level-test';

interface Props {
  levelTest: LevelTestItem[];
}

const items = activeQuestions(Astro.props.levelTest);
const version = testVersion(items);
const total = items.length;
const listeningCount = items.filter((q) => q.skill === 'listening').length;
const minutes = Math.max(5, Math.round((total * 20) / 60 / 5) * 5);

const courseVisible = await isCourseVisible();
const units = await getAllUnits();
const unitInfo = Object.fromEntries(
  units.map((u) => [u.data.unit, { title: u.data.shortTitle, url: courseVisible && isRoutable(u) ? u.data.url : null }]),
);

const LEVEL_DESC: Record<string, string> = {
  A1: '自己紹介や身近なことを、簡単な表現で伝えられる段階です。',
  A2: '日常の場面や過去の出来事を話せる段階です。',
  B1: '旅行や生活で困らず、自分の意見を言える段階です。',
  B2: '仮定や譲歩を使い、ネイティブと自然にやりとりできる段階です。',
  C1: 'ニュアンスや文体を使い分け、仕事や学業でスペイン語を使える段階です。',
  C2: 'ことわざや専門的な文章まで理解できる、最上級の段階です。',
};
const levelsInTest = COURSE_LEVELS.filter((l) => items.some((q) => q.level.toUpperCase() === l.code));
const levels = levelsInTest.map((l) => ({ code: l.code, name: l.name, first: l.first, last: l.last, url: levelUrl(l.code), desc: LEVEL_DESC[l.code] }));
const skills = (['grammar', 'vocabulary', 'reading', 'listening'] as const).filter((s) => items.some((q) => q.skill === s));

const isEs = (s: string) => !/[぀-ヿ㐀-鿿]/.test(s);
const bars = (seed: number) => Array.from({ length: 40 }, (_, i) => Math.round(22 + 68 * Math.abs(Math.sin((i + seed) * 1.7) * Math.cos((i + seed) * 0.45))));
---

<script is:inline>document.documentElement.classList.add('lt3-js');</script>
<div class="lt3" id="level-test" data-level-test data-version={version} data-pass={PASS_RATIO} data-solutions={SOLUTIONS_URL}
  data-units={JSON.stringify(unitInfo)} data-levels={JSON.stringify(levels)} data-pagefind-ignore>
  <div class="lt3-bar">
    <p class="lt3-title"><span class="lt3-dot" aria-hidden="true"></span>スペイン語レベル診断テスト</p>
    <p class="lt3-counter" aria-live="polite"><b data-counter>0</b> / {total}<small data-remaining>約{minutes}分</small></p>
  </div>
  <div class="lt3-prog" role="progressbar" aria-label="回答した問題" aria-valuemin="0" aria-valuemax={total} aria-valuenow="0">
    <span data-progress></span><i style="left:25%"></i><i style="left:50%"></i><i style="left:75%"></i>
  </div>

  <div class="lt3-stage">
    <div class="lt3-toast" data-toast role="status"><Flag size={18} /><span></span></div>
    <div class="lt3-deck" data-deck>
      <div class="lt3-ghost g2" aria-hidden="true"></div>
      <div class="lt3-ghost g1" aria-hidden="true"></div>

      <section class="lt3-card lt3-screen is-current" data-screen="start" aria-label="テストの説明">
        <p class="lt3-eyebrow">無料・登録不要</p>
        <h3 class="lt3-h">あなたのスペイン語は、<br />今どのレベル？</h3>
        <p class="lt3-sub">{total}問に答えると、A1〜C2のどのあたりにいるかがわかります。問題は少しずつ難しくなります。正解は最後にまとめてわかります。</p>
        <ul class="lt3-feats">
          <li><span class="lt3-ic"><List size={18} /></span>全{total}問</li>
          <li><span class="lt3-ic"><Clock size={18} /></span>約{minutes}分</li>
          {listeningCount > 0 && <li><span class="lt3-ic"><Volume2 size={18} /></span>音声問題あり</li>}
          <li><span class="lt3-ic"><Save size={18} /></span>途中保存OK</li>
          <li><span class="lt3-ic"><UserX size={18} /></span>登録不要</li>
        </ul>
        {listeningCount > 0 && (
          <p class="lt3-notice"><Headphones size={18} /><span>音声問題が{listeningCount}問あります。イヤホンがあると安心です。今は音を出せない場合は、テスト中に「最後に回す」を選べます。</span></p>
        )}
        <div class="lt3-go">
          <button type="button" class="lt3-btn lt3-btn-red lt3-btn-big" data-act="begin">テストを始める <ArrowRight size={20} /></button>
          <p class="lt3-fine">わからない問題は「わからない」を選んでください。当てずっぽうで答えるより、正確な結果が出ます。</p>
        </div>
      </section>

      <section class="lt3-card lt3-screen" data-screen="resume" aria-label="前回の続き">
        <p class="lt3-eyebrow">おかえりなさい</p>
        <h3 class="lt3-h">前回の続きがあります</h3>
        <div class="lt3-resume">
          <div class="lt3-ring" data-ring><span data-ring-n>0</span></div>
          <p><b data-resume-title></b><br /><span data-resume-sub></span></p>
        </div>
        <div class="lt3-btns">
          <button type="button" class="lt3-btn lt3-btn-red lt3-btn-big" data-act="continue">続きから <ArrowRight size={20} /></button>
          <button type="button" class="lt3-btn lt3-btn-out lt3-btn-big" data-act="fresh">最初から</button>
        </div>
      </section>

      <ol class="lt3-list">
        {items.map((q, i) => {
          const audio = audioOf(q.audio);
          const parts = q.question.split('___');
          return (
            <li class="lt3-card lt3-q" data-q={i} data-level={q.level.toUpperCase()} data-skill={q.skill} data-unit={q.unit} data-correct={q.correctIndex}>
              <p class="lt3-qhead"><span class="lt3-tag">{SKILL_LABEL[q.skill]}</span><span class="lt3-qnum">問題{i + 1}</span></p>
              {audio && (
                <div class="lt3-audio">
                  <p class="lt3-inst">音声を聞いて、質問に答えてください。</p>
                  <div class="lt3-player">
                    <button type="button" class="lt3-play" data-act="play" aria-label="音声を再生">
                      <span class="i-play"><Play size={22} /></span><span class="i-pause"><Pause size={22} /></span>
                    </button>
                    <div class="lt3-wave" aria-hidden="true">{bars(i).map((h) => <b style={`height:${h}%`}></b>)}</div>
                    <audio preload="none" src={audio.src}></audio>
                  </div>
                  <p class="lt3-plays"><Volume2 size={16} /><span data-plays>あと<b>2</b>回再生できます</span><AiAudioLabel /></p>
                </div>
              )}
              {q.passage && <blockquote class="lt3-passage" lang="es">{q.passage}</blockquote>}
              <p class:list={['lt3-qtext', { es: isEs(q.question) }]} lang={isEs(q.question) ? 'es' : undefined} tabindex="-1">
                {parts.map((p, k) => <>{k > 0 && <span class="lt3-blank" role="img" aria-label="空欄"></span>}{p}</>)}
              </p>
              <div class="lt3-opts">
                {q.options.map((o, oi) => (
                  <button type="button" class="lt3-opt" data-act="answer" data-i={oi}>
                    <span class="lt3-key" aria-hidden="true">{oi + 1}</span>
                    <span class:list={['lt3-o', { es: isEs(o) }]} lang={isEs(o) ? 'es' : undefined}>{o}</span>
                  </button>
                ))}
              </div>
              <div class="lt3-alt">
                <button type="button" data-act="answer" data-i="-1"><CircleHelp size={17} />わからない</button>
                {audio && (
                  <button type="button" data-act="defer">
                    <Clock size={17} /><span class="d-first">今は音声を聞けない（最後に回す）</span><span class="d-again">音声を聞けないので、この問題を飛ばす</span>
                  </button>
                )}
              </div>
            </li>
          );
        })}
      </ol>

      <section class="lt3-card lt3-screen lt3-result" data-screen="result" aria-label="診断結果" aria-live="polite">
        <p class="lt3-eyebrow">診断結果</p>
        <h3 class="lt3-h lt3-h-sm">レベル別の正答数</h3>
        <div class="lt3-rows">
          {levels.map((l) => (
            <div class={`lt3-row lv-${l.code}`} data-row={l.code}>
              <span class="lt3-lv"><span class="level-chip">{l.code}</span><span class="lt3-lvname">{l.name}</span></span>
              <span class="lt3-track"><span class="lt3-fill" data-fill></span></span>
              <span class="lt3-sc"><b data-ok>0</b><small> / <span data-total>0</span></small></span>
            </div>
          ))}
        </div>
        <div class="lt3-estimate">
          <p class="lt3-est-lbl">あなたの推定レベル</p>
          <p class="lt3-est-big" data-est-code></p>
          <p class="lt3-est-name" data-est-name></p>
          <p class="lt3-est-desc" data-est-desc></p>
          <p class="lt3-near" data-near hidden><TrendingUp size={17} /><span></span></p>
        </div>
        <p class="lt3-disc"><Info size={18} /><span>この結果は、{total}問の回答から推定した<b>目安</b>です。公式のレベル認定試験ではありません。スペイン語力を公式に証明するには、セルバンテス文化センターの<b>DELE</b>が必要です。</span></p>
        <div class="lt3-skills">
          {skills.map((s) => (
            <div class="lt3-sk" data-skill-box={s}><p>{SKILL_LABEL[s]}</p><b><span data-ok>0</span><small> / <span data-total>0</span></small></b><i><u data-fill></u></i></div>
          ))}
        </div>
        <p class="lt3-skipnote" data-skipnote hidden></p>
        <div class="lt3-next" data-next>
          <p class="lt3-eyebrow">次の一歩</p>
          <p class="lt3-next-title" data-next-title></p>
          <div class="lt3-next-links" data-next-links></div>
        </div>
        <div class="lt3-more">
          <a class="lt3-btn lt3-btn-out" data-solutions-link target="_blank" rel="noopener nofollow"><ExternalLink size={18} />全{total}問の解説を見る（新しいタブ）</a>
          <span class="lt3-cmp" data-compare hidden><TrendingUp size={17} /><span></span></span>
        </div>
        <div class="lt3-line" data-line-source="level-test" hidden>
          <p>新しいユニットや学習のヒントを、LINEでお知らせしています。</p>
          <a class="lt3-line-btn" href="https://lin.ee/vx6jpud" target="_blank" rel="noopener noreferrer">LINEで友だち追加</a>
          <button type="button" class="lt3-line-close" data-act="line-close" aria-label="閉じる">×</button>
        </div>
        {courseVisible && <p class="lt3-welcome"><a href={WELCOME_URL}>結果に合わせて学習設定をする（ペース・例文の数など）→</a></p>}
        <p class="lt3-again"><button type="button" class="lt3-btn lt3-btn-ghost" data-act="restart"><RotateCcw size={18} />もう一度挑戦する</button></p>
      </section>
    </div>

    <div class="lt3-confirm" data-confirm hidden>
      <div class="lt3-confirm-box" role="dialog" aria-modal="true" aria-labelledby="lt3-confirm-title">
        <p class="lt3-confirm-title" id="lt3-confirm-title">最初からやり直しますか？</p>
        <p data-confirm-text>これまでの回答は消えます。</p>
        <div class="lt3-btns lt3-btns-center">
          <button type="button" class="lt3-btn lt3-btn-red" data-act="reset-yes">やり直す</button>
          <button type="button" class="lt3-btn lt3-btn-out" data-act="reset-no">テストを続ける</button>
        </div>
      </div>
    </div>
  </div>

  <div class="lt3-foot" data-foot hidden>
    <button type="button" data-act="back"><ArrowLeft size={18} />戻る</button>
    <span class="lt3-save"><Check size={14} />回答は自動で保存されます</span>
    <button type="button" data-act="reset"><RotateCcw size={18} />最初からやり直す</button>
  </div>
  <noscript><p class="lt3-nojs">このテストを受けるには、JavaScript を有効にしてください。問題は上に一覧で表示しています。</p></noscript>
</div>
<p class="lt3-disclaimer">このレベル診断テストは公式の試験ではなく、DELE などの公式試験をまねたものでもありません。結果は、学習の参考にしていただくための目安です。</p>

<script>
  const PROGRESS_KEY = 'supein.levelTest.v3.progress';
  // Mismo nombre que la v2: CourseContinue.astro lee de aquí el nivel y la unidad de inicio.
  const RESULT_KEY = 'supein.levelTest.v2';
  const LINE_KEY = 'supein.lineCard.levelTest';
  const store = {
    get(k: string) { try { return localStorage.getItem(k); } catch { return null; } },
    set(k: string, v: string) { try { localStorage.setItem(k, v); } catch { /* sin almacenamiento: el test funciona sin guardar */ } },
    del(k: string) { try { localStorage.removeItem(k); } catch { /* idem */ } },
  };
  const gtag = (...args: unknown[]) => (window as any).gtag?.(...args);
  const SKIP = -2; // pregunta de audio que no se pudo escuchar
  const UNKNOWN = -1; // わからない

  type UnitInfo = { title: string; url: string | null };
  type LevelInfo = { code: string; name: string; first: number; last: number; url: string; desc: string };
  type Progress = { v: string; order: number[]; cursor: number; answers: Record<string, number>; deferred: number[]; date: string };

  document.querySelectorAll<HTMLElement>('[data-level-test]').forEach((root) => {
    const PASS = Number(root.dataset.pass);
    const VERSION = root.dataset.version ?? '';
    const units: Record<string, UnitInfo> = JSON.parse(root.dataset.units ?? '{}');
    const levels: LevelInfo[] = JSON.parse(root.dataset.levels ?? '[]');
    const $ = <T extends HTMLElement = HTMLElement>(sel: string, el: ParentNode = root) => el.querySelector<T>(sel)!;
    const cards = [...root.querySelectorAll<HTMLElement>('.lt3-q')];
    const total = cards.length;
    const deck = $('[data-deck]');
    const foot = $('[data-foot]');
    const confirmBox = $('[data-confirm]');
    const screens = {
      start: $('[data-screen="start"]'),
      resume: $('[data-screen="resume"]'),
      result: $('[data-screen="result"]'),
    };
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const fresh = (): Progress => ({ v: VERSION, order: cards.map((_, i) => i), cursor: 0, answers: {}, deferred: [], date: new Date().toISOString() });
    let state = fresh();
    let view: 'start' | 'resume' | 'question' | 'result' = 'start';
    const plays = new Map<number, number>();

    const answered = () => Object.keys(state.answers).length;
    const save = () => { state.date = new Date().toISOString(); store.set(PROGRESS_KEY, JSON.stringify(state)); };
    function loadSaved(): Progress | null {
      try {
        const p = JSON.parse(store.get(PROGRESS_KEY) ?? 'null') as Progress | null;
        if (!p || p.v !== VERSION || !Array.isArray(p.order) || p.order.length !== total) return null;
        return Object.keys(p.answers).length > 0 && Object.keys(p.answers).length < total ? p : null;
      } catch { return null; }
    }

    // ── Cabecera: contador y barra de progreso ──
    function header() {
      const n = answered();
      const pct = (n / total) * 100;
      $('[data-progress]').style.width = `${pct}%`;
      $('.lt3-prog').setAttribute('aria-valuenow', String(n));
      $('[data-counter]').textContent = String(view === 'question' ? state.cursor + 1 : view === 'result' ? total : n);
      const left = Math.max(1, Math.round((total - n) / 3));
      $('[data-remaining]').textContent = view === 'result' ? '回答完了' : n === 0 ? `約${Math.max(5, Math.round(total / 3 / 5) * 5)}分` : `残り約${left}分`;
    }

    // ── Fichas: la actual sale hacia un lado y la nueva entra por el otro ──
    function current() { return deck.querySelector<HTMLElement>('.lt3-card.is-current:not(.is-leaving)'); }
    // Mientras pasa una ficha no se aceptan respuestas: un doble toque no responde dos preguntas.
    let busy = false;
    const activeCard = () => (view === 'question' ? cards[state.order[state.cursor]] : null);
    function swap(next: HTMLElement, dir: 'next' | 'prev' | null, flat = false) {
      const old = current();
      deck.classList.toggle('is-flat', flat);
      root.querySelectorAll('audio').forEach((a) => a.pause());
      if (old === next) return;
      if (old && dir && !reduceMotion) {
        old.classList.add('is-leaving');
        requestAnimationFrame(() => old.classList.add(dir === 'next' ? 'out-left' : 'out-right'));
        setTimeout(() => old.classList.remove('is-current', 'is-leaving', 'out-left', 'out-right'), 420);
        next.classList.add(dir === 'next' ? 'from-right' : 'from-left', 'is-current');
        void next.offsetWidth;
        requestAnimationFrame(() => next.classList.remove('from-right', 'from-left'));
      } else {
        old?.classList.remove('is-current');
        next.classList.add('is-current');
      }
    }
    function keepInView() {
      const r = root.getBoundingClientRect();
      if (r.top < -40 || r.top > window.innerHeight * 0.5) root.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'start' });
    }

    function showScreen(name: 'start' | 'resume', dir: 'next' | 'prev' | null = null) {
      view = name;
      foot.hidden = true;
      swap(screens[name], dir);
      header();
    }

    function showQuestion(dir: 'next' | 'prev' | null) {
      view = 'question';
      const qi = state.order[state.cursor];
      const card = cards[qi];
      card.querySelectorAll('.lt3-opt').forEach((b) => b.classList.toggle('is-picked', Number((b as HTMLElement).dataset.i) === state.answers[qi]));
      card.classList.toggle('is-deferred', state.deferred.includes(qi));
      foot.hidden = false;
      $('[data-act="back"]', foot).toggleAttribute('disabled', state.cursor === 0);
      swap(card, dir);
      header();
      keepInView();
      $('.lt3-qtext', card).focus({ preventScroll: true });
    }

    function toast(text: string) {
      const t = $('[data-toast]');
      $('span', t).textContent = text;
      t.classList.add('is-on');
      setTimeout(() => t.classList.remove('is-on'), 2800);
    }

    function answer(i: number, btn?: HTMLElement) {
      if (busy) return;
      busy = true;
      const qi = state.order[state.cursor];
      const first = !(String(qi) in state.answers);
      state.answers[qi] = i;
      btn?.classList.add('is-chosen');
      state.cursor++;
      save();
      const n = answered();
      if (first && n % 10 === 0) gtag('event', 'level_test_progress', { answered: n });
      setTimeout(() => {
        btn?.classList.remove('is-chosen');
        busy = false;
        if (state.cursor >= state.order.length) return finish();
        showQuestion('next');
        if (first) {
          const msg = { [Math.round(total / 4)]: `4分の1が終わりました。残り${total - Math.round(total / 4)}問`, [Math.round(total / 2)]: `半分まで来ました。残り${total - Math.round(total / 2)}問`, [Math.round((total * 3) / 4)]: `あと${total - Math.round((total * 3) / 4)}問。もう少しです` }[n];
          if (msg) toast(msg);
        }
      }, 180);
    }

    function defer() {
      if (busy) return;
      const qi = state.order[state.cursor];
      if (state.deferred.includes(qi)) return answer(SKIP);
      state.order.splice(state.cursor, 1);
      state.order.push(qi);
      state.deferred.push(qi);
      save();
      gtag('event', 'level_test_audio_deferred');
      showQuestion('next');
      toast('音声問題を最後に回しました');
    }

    // ── Audio: dos reproducciones por pregunta, como en el examen ──
    function play(btn: HTMLElement) {
      const card = btn.closest<HTMLElement>('.lt3-q')!;
      const qi = Number(card.dataset.q);
      const audio = $<HTMLAudioElement>('audio', card);
      const label = $('[data-plays]', card);
      const bars = [...card.querySelectorAll<HTMLElement>('.lt3-wave b')];
      if (!audio.paused) return audio.pause();
      const left = plays.get(qi) ?? 2;
      const restart = audio.currentTime === 0 || audio.ended;
      if (restart && left <= 0) return;
      if (restart) {
        plays.set(qi, left - 1);
        audio.currentTime = 0;
      }
      if (!audio.dataset.wired) {
        audio.dataset.wired = '1';
        audio.addEventListener('play', () => card.classList.add('is-playing'));
        audio.addEventListener('pause', () => card.classList.remove('is-playing'));
        audio.addEventListener('timeupdate', () => {
          const on = audio.duration ? Math.round((audio.currentTime / audio.duration) * bars.length) : 0;
          bars.forEach((b, k) => b.classList.toggle('on', k < on));
        });
        audio.addEventListener('ended', () => {
          audio.currentTime = 0;
          bars.forEach((b) => b.classList.remove('on'));
          const rest = plays.get(qi) ?? 0;
          if (rest <= 0) { label.textContent = '再生回数の上限（2回）に達しました'; btn.setAttribute('disabled', ''); }
          else label.innerHTML = `あと<b>${rest}</b>回再生できます`;
        });
        audio.addEventListener('error', () => { label.textContent = '音声を読み込めませんでした。「最後に回す」を選んでください。'; });
      }
      audio.play().catch(() => { /* el navegador bloqueó la reproducción */ });
    }

    // ── Resultado ──
    function finish() {
      view = 'result';
      foot.hidden = true;
      const prev = (() => { try { return JSON.parse(store.get(RESULT_KEY) ?? 'null'); } catch { return null; } })();
      const isOk = (c: HTMLElement) => state.answers[Number(c.dataset.q)] === Number(c.dataset.correct);
      const byLevel = levels.map((l) => {
        const qs = cards.filter((c) => c.dataset.level === l.code);
        return { ...l, ok: qs.filter(isOk).length, all: qs.length, wrong: qs.filter((c) => !isOk(c)).map((c) => Number(c.dataset.unit)) };
      });
      let passed = 0;
      for (const x of byLevel) { if (x.ok / x.all >= PASS) passed++; else break; }
      const reached = passed > 0 ? byLevel[passed - 1] : null;
      const next = byLevel[passed];

      // Por dónde empezar: en el primer nivel no alcanzado, su principio si hubo pocos aciertos o la
      // primera unidad con error; si se alcanzaron todos, la primera unidad con error del último.
      let startUnit: number;
      if (next) startUnit = next.ok / next.all <= 0.4 ? next.first : Math.min(...next.wrong);
      else { const last = byLevel[byLevel.length - 1]; startUnit = last.wrong.length ? Math.min(...last.wrong) : last.last; }
      const startLevel = levels.find((l) => startUnit >= l.first && startUnit <= l.last) ?? levels[0];

      // Barras por nivel
      byLevel.forEach((x) => {
        const row = $(`[data-row="${x.code}"]`);
        $('[data-ok]', row).textContent = String(x.ok);
        $('[data-total]', row).textContent = String(x.all);
        $('[data-fill]', row).style.width = '0';
      });

      // Nivel estimado
      const code = reached?.code ?? 'A1';
      const big = $('[data-est-code]');
      big.textContent = code;
      big.className = `lt3-est-big lv-${code}`;
      $('[data-est-name]').textContent = reached ? reached.name : 'Acceso（前半）';
      $('[data-est-desc]').textContent = reached ? reached.desc : 'スペイン語はこれから。発音と基本の文から、一歩ずつ始めましょう。';
      const near = $('[data-near]');
      near.hidden = !(reached && next && next.ok / next.all >= 0.5);
      if (next) $('span', near).textContent = `${next.code} に近づいています`;

      // Destrezas
      root.querySelectorAll<HTMLElement>('[data-skill-box]').forEach((box) => {
        const qs = cards.filter((c) => c.dataset.skill === box.dataset.skillBox);
        const ok = qs.filter(isOk).length;
        $('[data-ok]', box).textContent = String(ok);
        $('[data-total]', box).textContent = String(qs.length);
        $('[data-fill]', box).style.width = `${Math.round((ok / qs.length) * 100)}%`;
      });
      const skipped = Object.values(state.answers).filter((a) => a === SKIP).length;
      const skipNote = $('[data-skipnote]');
      skipNote.hidden = skipped === 0;
      skipNote.textContent = `音声問題を${skipped}問飛ばしたため、聴解の結果は参考程度に見てください。`;

      // Siguiente paso
      const info = units[String(startUnit)];
      const links = $('[data-next-links]');
      links.replaceChildren();
      const link = (cls: string, href: string, text: string) => Object.assign(document.createElement('a'), { className: cls, href, textContent: text });
      if (info?.url) {
        $('[data-next-title]').textContent = `ユニット${startUnit}「${info.title}」から始めましょう`;
        links.append(link('lt3-btn lt3-btn-red', info.url, `ユニット${startUnit}へ進む →`), link('lt3-next-sub', startLevel.url, `${startLevel.code} ${startLevel.name}のユニット一覧`));
      } else {
        $('[data-next-title]').textContent = `${startLevel.code} ${startLevel.name}の学習ページから始めましょう`;
        links.append(link('lt3-btn lt3-btn-red', startLevel.url, `${startLevel.code} の学習ページへ →`));
      }

      // Soluciones (solo se enlazan desde aquí) y comparación con el intento anterior
      const sol = $<HTMLAnchorElement>('[data-solutions-link]');
      sol.href = root.dataset.solutions ?? '#';
      const levelCode = reached?.code ?? 'pre-A1';
      const cmp = $('[data-compare]');
      cmp.hidden = !prev?.level;
      if (prev?.level) $('span', cmp).textContent = `前回 ${prev.level === 'pre-A1' ? 'A1前半' : prev.level} → 今回 ${reached ? code : 'A1前半'}`;

      const line = root.querySelector<HTMLElement>('.lt3-line');
      if (line) line.hidden = store.get(LINE_KEY) === 'closed';

      swap(screens.result, 'next', true);
      header();
      keepInView();
      byLevel.forEach((x, k) => setTimeout(() => { $('[data-fill]', $(`[data-row="${x.code}"]`)).style.width = `${(x.ok / x.all) * 100}%`; }, 300 + k * 110));

      const correct = cards.filter(isOk).length;
      const scores = Object.fromEntries(byLevel.map((x) => [x.code, [x.ok, x.all]]));
      store.set(RESULT_KEY, JSON.stringify({ level: levelCode, startUnit, date: new Date().toISOString(), version: VERSION, scores, answers: state.answers }));
      store.del(PROGRESS_KEY);
      gtag('event', 'level_test_completed', { level: levelCode, start_unit: startUnit, answered: total, correct, unknown: Object.values(state.answers).filter((a) => a === UNKNOWN).length });
    }

    function start() {
      state = fresh();
      plays.clear();
      save();
      gtag('event', 'level_test_start');
      showQuestion('next');
    }

    function resetAll(dir: 'prev' | null = 'prev') {
      confirmBox.hidden = true;
      store.del(PROGRESS_KEY);
      state = fresh();
      plays.clear();
      root.querySelectorAll<HTMLButtonElement>('.lt3-play').forEach((b) => b.removeAttribute('disabled'));
      root.querySelectorAll<HTMLElement>('[data-plays]').forEach((l) => (l.innerHTML = 'あと<b>2</b>回再生できます'));
      showScreen('start', dir);
      keepInView();
    }

    root.addEventListener('click', (e) => {
      const t = (e.target as HTMLElement).closest<HTMLElement>('[data-act]');
      if (!t || t.hasAttribute('disabled')) return;
      const act = t.dataset.act;
      const inCard = t.closest('.lt3-q');
      if (inCard && inCard !== activeCard()) return;
      if (act === 'begin' || act === 'fresh') return start();
      if (act === 'continue') return showQuestion('next');
      if (act === 'answer' && view === 'question') return answer(Number(t.dataset.i), t.classList.contains('lt3-opt') ? t : undefined);
      if (act === 'defer') return defer();
      if (act === 'play') return play(t);
      if (act === 'back' && state.cursor > 0 && !busy) { state.cursor--; save(); return showQuestion('prev'); }
      if (act === 'reset') {
        $('[data-confirm-text]').textContent = `これまでの回答（${answered()}問）は消えます。`;
        confirmBox.hidden = false;
        return $<HTMLButtonElement>('[data-act="reset-no"]').focus();
      }
      if (act === 'reset-no') { confirmBox.hidden = true; return; }
      if (act === 'reset-yes' || act === 'restart') return resetAll();
      if (act === 'line-close') { store.set(LINE_KEY, 'closed'); t.closest<HTMLElement>('.lt3-line')!.hidden = true; }
    });
    $('[data-solutions-link]').addEventListener('click', () => gtag('event', 'level_test_solutions_opened'));

    document.addEventListener('keydown', (e) => {
      if (view !== 'question' || !confirmBox.hidden || e.altKey || e.ctrlKey || e.metaKey) return;
      const tag = (e.target as HTMLElement).tagName;
      if (tag === 'INPUT' || tag === 'TEXTAREA') return;
      if (!root.contains(document.activeElement) && document.activeElement !== document.body) return;
      if (e.key === 'Escape') return;
      const k = Number(e.key);
      if (!k) return;
      const btn = activeCard()?.querySelector<HTMLElement>(`.lt3-opt[data-i="${k - 1}"]`);
      if (btn) { e.preventDefault(); answer(k - 1, btn); }
    });
    confirmBox.addEventListener('keydown', (e) => { if (e.key === 'Escape') confirmBox.hidden = true; });

    // Arranque: si hay un test a medias en este navegador, se ofrece seguir.
    const saved = loadSaved();
    if (saved) {
      state = saved;
      const n = answered();
      $('[data-ring]').style.setProperty('--p', String(Math.round((n / total) * 100)));
      $('[data-ring-n]').textContent = String(n);
      $('[data-resume-title]').textContent = `${total}問中${n}問まで回答済み`;
      const d = new Date(saved.date);
      $('[data-resume-sub]').textContent = `${d.getMonth() + 1}月${d.getDate()}日に保存。残りは約${Math.max(1, Math.round((total - n) / 3))}分です。`;
      showScreen('resume');
    } else header();
  });
</script>

