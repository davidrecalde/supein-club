---
// Hub de cada provincia de /food/spain-map/{provincia}/ (rediseño del 17 de noviembre de 2026,
// mockup aprobado por David). Primero el móvil: cabecera compacta con minimapa, accesos rápidos
// fijos y bloques numerados como el hub /language/: 01 rankings CRE (top 3 de cada una, sacado del
// propio artículo), 02 名物料理, 03 エリア, 04 地図, 05 artículos de la comunidad, 06 provincias
// vecinas; después el texto de la provincia, la guía práctica común y las preguntas frecuentes.
// Los bloques sin datos no se muestran y la numeración se ajusta sola.
import type { CollectionEntry } from 'astro:content';
import { getCollection, getEntry } from 'astro:content';
import { ArrowRight, Award, BookOpen, Calendar, ChevronDown, ChevronRight, Euro, Info, Landmark, Map as MapIcon, MapPin, Utensils, Wallet, Wine } from 'lucide-astro';
import BaseLayout from './BaseLayout.astro';
import SEO from '../components/SEO.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Rail from '../components/Rail.astro';
import LineBanner from '../components/LineBanner.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import AuthorBox from '../components/AuthorBox.astro';
import PreferredSourceCTA from '../components/PreferredSourceCTA.astro';
import ArticleDisclaimer from '../components/ArticleDisclaimer.astro';
import FloatingActions from '../components/FloatingActions.astro';
import { regions } from '../config/regions';
import { PROVINCES } from '../data/provinces';
import { getArticleUrl, pillarLabels } from '../utils/articles';
import { creSummary } from '../utils/cre';
import { cardImage, discoverImage, schemaImages } from '../utils/images';
import { provinceMap } from '../utils/spainMap';

interface Props {
  entry: CollectionEntry<'spain-map'>;
}

const { entry } = Astro.props;
const d = entry.data;
const SITE = 'https://supein.club';
const canonical = `${SITE}/food/spain-map/${d.province}/`;
const discover = d.heroImage ? await discoverImage(d.heroImage) : undefined;
const heroSchemaImages = d.heroImage ? await schemaImages(d.heroImage) : undefined;
const heroCard = d.heroImage ? await cardImage(d.heroImage, d.heroImageAlt ?? `${d.provinceJa}の風景`) : undefined;
const { Content } = await entry.render();
const author = await getEntry(d.author);
const nameEs = PROVINCES[d.province]?.es ?? d.province;
const plain = (s: string) => s.replace(/（[^）]*）/g, '').trim();

const breadcrumbs = [
  { name: 'ホーム', url: '/' },
  { name: 'スペイン料理', url: '/food/' },
  { name: 'スペイン美食マップ', url: '/food/spain-map/' },
  { name: d.provinceJa, url: canonical },
];

// ── 01 Rankings CRE (cluster spain-map-{provincia}), en el orden de demanda de GA4 ──
const RANKINGS = [
  { slug: 'cheap-restaurants', kicker: 'コスパ篇', title: '安くて美味しいレストラン', theme: 'cheap' },
  { slug: 'tapas-bars', kicker: 'バル篇', title: 'おすすめタパスバル', theme: 'tapas' },
  { slug: 'the-best-restaurants', kicker: 'デラックス篇', title: 'おすすめ高級レストラン', theme: 'deluxe' },
] as const;
const provinceArticles = await getCollection('articles', (a) => !a.data.draft && a.data.cluster === `spain-map-${d.province}`);
const slugOf = (a: CollectionEntry<'articles'>) => a.id.replace(/\.(md|mdx)$/, '').split('/').pop();
const rankings = RANKINGS.flatMap((r) => {
  const article = provinceArticles.find((a) => slugOf(a) === r.slug);
  if (!article) return [];
  return [{ ...r, url: getArticleUrl(article), name: article.data.title, ...creSummary(article.body ?? '') }];
});

// ── 06 Provincias vecinas: la lista 「近隣県のグルメガイド」 de los rankings ──
const allProvinces = await getCollection('spain-map', ({ data }) => data.draft !== true);
const neighborSource = provinceArticles.map((a) => a.body ?? '').find((b) => b.includes('## 近隣県のグルメガイド')) ?? '';
const neighborList = neighborSource.split('## 近隣県のグルメガイド')[1]?.split(/\n## /)[0] ?? '';
const neighbors = await Promise.all(
  [...neighborList.matchAll(/^- \[[^\]]+\]\(\/food\/spain-map\/([a-z-]+)\/\)(?:[ \t]*[—–-][ \t]*([^\r\n]+))?[ \t]*\r?$/gm)]
    .map(([, slug, note]) => ({ slug, note: note?.trim(), p: allProvinces.find((x) => x.data.province === slug) }))
    .filter((n) => n.p && n.slug !== d.province)
    // Sin descripción en la lista: el plato estrella de esa provincia.
    .map((n) => ({ ...n, note: n.note || `名物：${plain(n.p!.data.mainDishJa)}` }))
    .map(async (n) => ({ ...n, url: `/food/spain-map/${n.slug}/`, img: n.p!.data.heroImage ? await cardImage(n.p!.data.heroImage, n.p!.data.heroImageAlt ?? n.p!.data.provinceJa) : undefined })),
);

// ── Minimapa ──
const code = PROVINCES[d.province]?.code ?? '';
const map = provinceMap(code, neighbors.map((n) => PROVINCES[n.slug]?.code).filter(Boolean));

// ── 05 Artículos de la comunidad autónoma (campo region de articles = slug de src/config/regions.ts) ──
const region = regions.find((r) => r.spainMapLabel === d.region);
const allArticles = await getCollection('articles', ({ data }) => !data.draft);
const regionArticles = region
  ? allArticles
      .filter((a) => a.data.region === region.slug && !a.data.cluster.startsWith('spain-map-'))
      .sort((a, b) => Number(b.data.title.includes(d.provinceJa)) - Number(a.data.title.includes(d.provinceJa)) || b.data.pubDate.getTime() - a.data.pubDate.getTime())
      .slice(0, 6)
  : [];
const travel = await Promise.all(regionArticles.map(async (a) => {
  const hero = a.data.heroImage && typeof a.data.heroImage !== 'string' ? a.data.heroImage : undefined;
  return { url: getArticleUrl(a), title: a.data.title, tag: pillarLabels[a.data.pillar] ?? a.data.pillar, img: hero ? await cardImage(hero, a.data.heroImageAlt ?? '') : undefined };
}));

// ── 02 y 03 ──
const specialties = await Promise.all((d.specialties ?? []).map(async (s) => ({ ...s, img: s.image ? await cardImage(s.image, s.imageAlt ?? s.nameJa) : undefined })));
const areas = d.neighborhoods ?? [];

const sections = [
  rankings.length > 0 && { id: 'ranking', label: 'ランキング' },
  specialties.length > 0 && { id: 'dishes', label: '名物料理' },
  areas.length > 0 && { id: 'areas', label: 'エリア' },
  { id: 'map', label: '地図' },
  travel.length > 0 && { id: 'travel', label: '旅と文化' },
  neighbors.length > 0 && { id: 'nearby', label: '近隣の県' },
].filter(Boolean) as Array<{ id: string; label: string }>;
const num = (id: string) => String(sections.findIndex((s) => s.id === id) + 1).padStart(2, '0');

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: d.h1 ?? d.title,
  description: d.description,
  url: canonical,
  inLanguage: 'ja',
  datePublished: d.pubDate.toISOString().slice(0, 10),
  about: { '@type': 'AdministrativeArea', name: d.provinceJa, alternateName: nameEs, containedInPlace: { '@type': 'Country', name: 'スペイン' } },
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: rankings.map((r, i) => ({ '@type': 'ListItem', position: i + 1, url: `${SITE}${r.url}`, name: r.name })),
  },
};
const faqSchema = d.faq.length > 0 && {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: d.faq.map((f) => ({ '@type': 'Question', name: f.question, acceptedAnswer: { '@type': 'Answer', text: f.answer.replace(/<[^>]+>/g, '') } })),
};
---
<BaseLayout title={d.title}>
  <SEO
    slot="seo"
    title={d.title}
    description={d.description}
    canonical={canonical}
    breadcrumbs={breadcrumbs}
    image={discover?.src}
    imageWidth={discover?.width}
    imageHeight={discover?.height}
    imageAlt={d.heroImageAlt || d.title}
    schemaImages={heroSchemaImages}
  />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(collectionSchema)} />
  {faqSchema && <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqSchema)} />}

  <section class="ph-hero">
    <div class="page-container ph-hero-grid">
      <div class="ph-hero-text">
        <Breadcrumb items={breadcrumbs} dark />
        <p class="ph-eyebrow">
          <span>スペイン美食マップ</span>
          {region ? <a href={`/regions/${region.slug}/`}>{d.region}<ChevronRight size={14} /></a> : <span>{d.region}</span>}
        </p>
        <h1 class="ph-h1">{d.provinceJa}<span>グルメガイド</span></h1>
        <p class="ph-es" lang="es">{nameEs}</p>
        <p class="ph-lead">{d.lead}</p>
      </div>
      <figure class="ph-map" aria-label={`スペインの地図：${d.provinceJa}の位置`}>
        <Fragment set:html={map.svg} />
        <span class="ph-map-label" style={`left:${map.label.x.toFixed(1)}%;top:${map.label.y.toFixed(1)}%`}>{d.provinceJa}</span>
      </figure>
      <ul class="ph-facts">
        <li><Utensils size={18} /><span><small>名物</small><b>{plain(d.mainDishJa)}</b></span></li>
        <li><Calendar size={18} /><span><small>ベストシーズン</small><b>{plain(d.bestSeason)}</b></span></li>
        <li><Euro size={18} /><span><small>予算</small><b>{d.priceRange}</b></span></li>
        <li><Landmark size={18} /><span><small>県都</small><b>{d.capital}</b></span></li>
      </ul>
    </div>
  </section>

  <nav class="ph-chips" aria-label="このページの内容">
    <div class="page-container">
      {sections.map((s) => <a href={`#${s.id}`} data-chip={s.id}><i>{num(s.id)}</i>{s.label}</a>)}
      {d.faq.length > 0 && <a href="#faq" data-chip="faq">FAQ</a>}
    </div>
  </nav>

  {rankings.length > 0 && (
    <section class="hub-block ph-block" id="ranking">
      <div class="page-container">
        <div class="hub-block-head">
          <p class="hub-block-eyebrow"><span class="hub-block-num">{num('ranking')}</span>目的別ランキング</p>
          <h2>{d.provinceJa}のレストランを、目的で選ぶ</h2>
          <p class="hub-block-lead">Googleの口コミ件数・評価・信頼性を分析したCREスコアで、{rankings.length}つのランキングを作りました。</p>
        </div>
        <div class="ph-ranks">
          {rankings.map((r) => (
            <a class={`ph-rank is-${r.theme}`} href={r.url}>
              <span class="ph-rank-top">
                <span class="ph-rank-ic">{r.theme === 'cheap' ? <Wallet size={22} /> : r.theme === 'tapas' ? <Wine size={22} /> : <Award size={22} />}</span>
                <span>
                  <span class="ph-rank-kicker">{r.kicker}</span>
                  <span class="ph-rank-title">{r.title}</span>
                  {r.count > 0 && <span class="ph-rank-meta">{r.count}店を分析・最高スコア {r.maxScore}</span>}
                </span>
              </span>
              {r.top.length > 0 && (
                <ol class="ph-rank-list">
                  {r.top.map((it, i) => (
                    <li><span class="n">{i + 1}</span><span class="nm">{it.nameJa}</span>{it.rating > 0 && <span class="st">★ {it.rating.toFixed(1)}</span>}<span class="sc">{it.criScore}</span></li>
                  ))}
                </ol>
              )}
              <span class="ph-rank-cta">ランキングを見る<ArrowRight size={18} /></span>
            </a>
          ))}
        </div>
        <p class="ph-note"><Info size={16} /><span>CRE（Competitive Reputation Engine）はスペイン倶楽部独自の分析です。広告やスポンサーシップは一切反映していません。</span></p>
      </div>
    </section>
  )}

  {specialties.length > 0 && (
    <section class="hub-block ph-block is-soft" id="dishes">
      <div class="page-container">
        <div class="hub-block-head">
          <p class="hub-block-eyebrow"><span class="hub-block-num">{num('dishes')}</span>名物料理</p>
          <h2>{d.provinceJa}で食べたい郷土料理</h2>
        </div>
        <Rail label={`${d.provinceJa}の名物料理`} hint="スワイプして他の料理を見る">
          {specialties.map((s) => (
            <article class="ph-card" role="listitem">
              {s.img
                ? <img src={s.img.src} srcset={s.img.srcset} sizes="(min-width: 860px) 340px, 78vw" width={s.img.width} height={s.img.height} alt={s.img.alt} loading="lazy" decoding="async" />
                : <span class="ph-card-noimg" aria-hidden="true"><Utensils size={34} /></span>}
              <div class="ph-card-body">
                <span class="ph-tag">{s.category}</span>
                <h3>{s.nameJa}</h3>
                <p class="ph-card-es" lang="es">{s.name}</p>
                <p class="ph-card-text">{s.description}</p>
              </div>
            </article>
          ))}
        </Rail>
      </div>
    </section>
  )}

  {areas.length > 0 && (
    <section class="hub-block ph-block" id="areas">
      <div class="page-container">
        <div class="hub-block-head">
          <p class="hub-block-eyebrow"><span class="hub-block-num">{num('areas')}</span>エリア別</p>
          <h2>どこで食べる？{d.provinceJa}のエリア別グルメガイド</h2>
        </div>
        <Rail label={`${d.provinceJa}のエリア`} hint="スワイプして他のエリアを見る">
          {areas.map((a, i) => (
            <article class="ph-card" role="listitem">
              {i === 0 && heroCard && <img src={heroCard.src} srcset={heroCard.srcset} sizes="(min-width: 860px) 340px, 78vw" width={heroCard.width} height={heroCard.height} alt={heroCard.alt} loading="lazy" decoding="async" data-pagefind-meta="image[src], image_alt[alt]" />}
              <div class="ph-card-body">
                <h3>{a.nameJa}</h3>
                <p class="ph-card-es" lang="es">{a.name}</p>
                <dl class="ph-dl">
                  <dt>雰囲気</dt><dd>{a.vibe}</dd>
                  <dt>名物</dt><dd>{a.specialty}</dd>
                  <dt>おすすめ</dt><dd>{a.bestTime}</dd>
                </dl>
              </div>
            </article>
          ))}
        </Rail>
      </div>
    </section>
  )}

  <section class="hub-block ph-block is-soft" id="map">
    <div class="page-container">
      <div class="hub-block-head">
        <p class="hub-block-eyebrow"><span class="hub-block-num">{num('map')}</span>レストランマップ</p>
        <h2>{d.provinceJa}のレストランを地図で見る</h2>
      </div>
      <a class="ph-mapcard" href={d.mapUrl} target="_blank" rel="noopener noreferrer">
        <span class="ph-mapcard-grid" aria-hidden="true">
          <MapPin size={26} style="left:22%;top:30%" /><MapPin size={26} style="left:48%;top:20%" /><MapPin size={26} style="left:63%;top:55%" /><MapPin size={26} style="left:34%;top:62%" /><MapPin size={26} style="left:77%;top:32%" />
        </span>
        <span class="ph-mapcard-btn"><MapIcon size={20} />Googleマップで開く</span>
      </a>
      <p class="ph-mapnote">スペイン倶楽部が選んだ{d.provinceJa}のレストラン・バルの一覧です（Googleマップが新しいタブで開きます）。</p>
    </div>
  </section>

  {travel.length > 0 && (
    <section class="hub-block ph-block" id="travel">
      <div class="page-container">
        <div class="hub-block-head">
          <p class="hub-block-eyebrow"><span class="hub-block-num">{num('travel')}</span>旅と文化</p>
          <h2>{d.region}を旅する</h2>
          <p class="hub-block-lead">旅行・文化・暮らしなど、{d.region}に関する記事です。</p>
        </div>
        <Rail label={`${d.region}の記事`} hint="スワイプして他の記事を見る">
          {travel.map((t) => (
            <a class="ph-card" href={t.url} role="listitem">
              {t.img
                ? <img src={t.img.src} srcset={t.img.srcset} sizes="(min-width: 860px) 340px, 78vw" width={t.img.width} height={t.img.height} alt={t.img.alt} loading="lazy" decoding="async" />
                : <span class="ph-card-noimg" aria-hidden="true"><BookOpen size={34} /></span>}
              <div class="ph-card-body"><span class="ph-tag">{t.tag}</span><h3>{t.title}</h3></div>
            </a>
          ))}
        </Rail>
        {region && <p class="ph-more"><a href={`/regions/${region.slug}/`}>{d.region}のガイドをすべて見る<ArrowRight size={16} /></a></p>}
      </div>
    </section>
  )}

  {neighbors.length > 0 && (
    <section class="hub-block ph-block is-soft" id="nearby">
      <div class="page-container">
        <div class="hub-block-head">
          <p class="hub-block-eyebrow"><span class="hub-block-num">{num('nearby')}</span>近隣の県</p>
          <h2>足を延ばして食べ歩き</h2>
        </div>
        <div class="ph-near">
          {neighbors.map((n) => (
            <a class="ph-near-card" href={n.url}>
              {n.img && <img src={n.img.src} srcset={n.img.srcset} sizes="(min-width: 860px) 260px, 45vw" width={n.img.width} height={n.img.height} alt={n.img.alt} loading="lazy" decoding="async" />}
              <span><b>{n.p!.data.provinceJa}</b><small>{n.note}</small></span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="hub-block ph-block" id="about">
    <div class="page-container ph-narrow">
      <div class="hub-block-head">
        <p class="hub-block-eyebrow">{nameEs}</p>
        <h2>{d.provinceJa}の食文化</h2>
      </div>
      {areas.length === 0 && heroCard && (
        <img class="ph-about-img" src={heroCard.src} srcset={heroCard.srcset} sizes="(min-width: 860px) 720px, 100vw" width={heroCard.width} height={heroCard.height} alt={heroCard.alt} loading="lazy" decoding="async" data-pagefind-meta="image[src], image_alt[alt]" />
      )}
      <div class="prose"><Content /></div>

      <a class="ph-guide" href="/food/spain-bar-restaurant/">
        <span class="ph-guide-ic"><BookOpen size={22} /></span>
        <span><b>スペインで食事をする前に</b><small>注文の流れ・マナー・チップの相場は「バル・レストラン活用ガイド」に、食事の時間帯は「スペインの食事時間ガイド」にまとめています。</small></span>
        <ChevronRight size={20} class="ph-guide-chev" />
      </a>
      <p class="ph-guide-sub"><a href="/food/spain-dining-times/">スペインの食事時間ガイド（朝食・昼食・夕食は何時？）→</a></p>

      {d.faq.length > 0 && (
        <div class="ph-faq" id="faq">
          <p class="hub-block-eyebrow">よくある質問</p>
          <h2>{d.provinceJa}のグルメFAQ</h2>
          {d.faq.map((f, i) => (
            <details open={i === 0}>
              <summary><span class="q" aria-hidden="true">Q</span><span>{f.question}</span><ChevronDown size={18} /></summary>
              <p set:html={f.answer} />
            </details>
          ))}
        </div>
      )}

      <PreferredSourceCTA eyebrow="このガイドは役に立ちましたか？" />
      <div data-pagefind-ignore class="ph-newsletter"><NewsletterForm variant="inline" /></div>
      <ArticleDisclaimer />
      {author && <AuthorBox author={author} />}
    </div>
  </section>

  <LineBanner slim />
  <FloatingActions shareUrl={canonical} shareTitle={d.title} />
</BaseLayout>

<script>
  // Accesos rápidos: marca la sección visible.
  const chips = [...document.querySelectorAll<HTMLAnchorElement>('.ph-chips a[data-chip]')];
  const io = new IntersectionObserver((entries) => entries.forEach((e) => {
    if (!e.isIntersecting) return;
    chips.forEach((c) => {
      const on = c.dataset.chip === e.target.id;
      c.classList.toggle('is-on', on);
      if (on) c.scrollIntoView({ block: 'nearest', inline: 'nearest' });
    });
  }), { rootMargin: '-35% 0px -60% 0px' });
  chips.forEach((c) => { const s = document.getElementById(c.dataset.chip!); if (s) io.observe(s); });
</script>

<style is:global>
  .ph-hero { position: relative; overflow: hidden; padding: 22px 0 28px; background: #002147; color: #fff; }
  .ph-hero::before { content: ''; position: absolute; inset: 0; background-image: radial-gradient(rgba(255, 255, 255, .07) 1px, transparent 1px); background-size: 22px 22px; pointer-events: none; }
  .ph-hero-grid { position: relative; display: grid; grid-template-columns: minmax(0, 1fr); gap: 16px; }
  .ph-hero-grid > * { min-width: 0; }
  .ph-eyebrow { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 12px; margin: 16px 0 0; font-size: 12px; font-weight: 700; letter-spacing: .06em; color: #ff8a9a; }
  .ph-eyebrow a { display: inline-flex; align-items: center; gap: 2px; color: #fff; text-decoration: underline; text-decoration-color: rgba(255, 255, 255, .35); text-underline-offset: 4px; }
  .ph-h1 { margin: 6px 0 0; font-family: 'Noto Serif JP', serif; font-size: 38px; font-weight: 700; line-height: 1.25; color: #fff; }
  .ph-h1 span { display: block; margin-top: 2px; font-family: 'Noto Sans JP', sans-serif; font-size: 16px; letter-spacing: .08em; color: rgba(255, 255, 255, .8); }
  .ph-es { margin: 4px 0 0; font-family: Georgia, serif; font-size: 15px; letter-spacing: .06em; color: rgba(255, 255, 255, .6); }
  .ph-lead { margin: 12px 0 0; font-size: 14.5px; line-height: 1.85; color: rgba(255, 255, 255, .86); }
  .ph-map { position: relative; width: 250px; max-width: 100%; margin: 0 auto; }
  .ph-map svg { display: block; width: 100%; height: auto; }
  .ph-map path { fill: rgba(255, 255, 255, .13); stroke: #002147; stroke-width: .7; }
  .ph-map rect { fill: none; stroke: rgba(255, 255, 255, .3); }
  .ph-map path[data-neighbor] { fill: rgba(255, 255, 255, .34); }
