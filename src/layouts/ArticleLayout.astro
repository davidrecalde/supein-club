---
import type { CollectionEntry } from 'astro:content';
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import SEO from '../components/SEO.astro';
import AuthorBox from '../components/AuthorBox.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import FAQSection from '../components/FAQSection.astro';
import TOC from '../components/TOC.astro';
import ArticleCard from '../components/ArticleCard.astro';
import AdSlot from '../components/AdSlot.astro';
import LineBanner from '../components/LineBanner.astro';
import PreferredSourceCTA from '../components/PreferredSourceCTA.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import ArticleDisclaimer from '../components/ArticleDisclaimer.astro';
import { slugToJa } from '../config/breadcrumbs';

interface Props {
  entry: CollectionEntry<'articles'>;
}

const { entry } = Astro.props;
const { title, description, pubDate, updatedDate, pillar, cluster, image, imageAlt, lead, faq, faqTitle, relatedArticles, readingTime, heroImage, heroImageAlt } = entry.data;

const { Content, headings } = await entry.render();

const author = await getEntry(entry.data.author);

const pillarLabels: Record<string, string> = {
  travel: 'スペイン旅行',
  food: 'スペイン料理',
  language: 'スペイン語',
  living: 'スペインに住む',
  culture: 'スペイン文化',
  football: 'スペインサッカー',
};

const idParts = entry.id.replace(/\.(md|mdx)$/, '').split('/');
const articleSlug = idParts[2] ?? cluster;
const canonical = `https://supein.club/${pillar}/${cluster}/${articleSlug}/`;
const pillarLabel = pillarLabels[pillar] ?? pillar;

const clusterLabel = slugToJa(cluster);

const visualBreadcrumbs = [
  { name: 'ホーム', url: '/' },
  { name: pillarLabel, url: `/${pillar}/` },
  { name: clusterLabel, url: `/${pillar}/${cluster}/` },
  { name: title, url: canonical },
];

const seoBreadcrumbs = [
  { name: 'ホーム', url: '/' },
  { name: pillarLabel, url: `/${pillar}/` },
  { name: clusterLabel, url: `/${pillar}/${cluster}/` },
];

// Build related articles: manual pins first, then auto-fill from same cluster → same pillar
const allArticles = await getCollection('articles', ({ data }) => !data.draft);

const pinned: CollectionEntry<'articles'>[] = relatedArticles?.length
  ? allArticles.filter((a) => relatedArticles.some((slug) => a.id.includes(slug)))
  : [];

const usedIds = new Set([entry.id, ...pinned.map((a) => a.id)]);

const byDate = (a: CollectionEntry<'articles'>, b: CollectionEntry<'articles'>) =>
  b.data.pubDate.getTime() - a.data.pubDate.getTime();

for (const candidate of allArticles.filter((a) => a.data.cluster === cluster && !usedIds.has(a.id)).sort(byDate)) {
  if (pinned.length >= 3) break;
  pinned.push(candidate);
  usedIds.add(candidate.id);
}

for (const candidate of allArticles.filter((a) => a.data.pillar === pillar && !usedIds.has(a.id)).sort(byDate)) {
  if (pinned.length >= 3) break;
  pinned.push(candidate);
  usedIds.add(candidate.id);
}

const related = pinned.slice(0, 3);

const authorSlug = author.data.slug ?? author.id.replace(/\.(md|mdx)$/, '');
const authorUrlForMeta = `https://supein.club/about-us/team/${authorSlug}/`;

---
<BaseLayout title={title}>
  <SEO
    slot="seo"
    title={`${title} | supein.club`}
    description={description}
    canonical={canonical}
    image={image}
    type="article"
    article={entry}
    author={author}
    breadcrumbs={seoBreadcrumbs}
    keywords={entry.data.tags}
    authorName={author.data.name}
    authorUrl={authorUrlForMeta}
  />

  <!-- Navy article header -->
  <header style={`background:#002147; padding:64px 0 ${heroImage ? '48px' : '64px'};`}>
    <div class="page-container">

      <Breadcrumb items={visualBreadcrumbs} dark />

      <h1 style="font-family:'Noto Serif JP',serif;font-size:clamp(24px,4vw,40px);font-weight:700;color:white;margin:20px 0 24px;line-height:1.35;max-width:820px;">
        {title}
      </h1>

      <div style="display:flex;align-items:center;flex-wrap:wrap;gap:16px;margin-bottom:40px;">
        <a
          href="#author-box"
          onclick="event.preventDefault();document.getElementById('author-box')?.scrollIntoView({behavior:'smooth'});"
          style="display:flex;align-items:center;gap:10px;text-decoration:none;"
        >
          {author.data.avatar && (
            <img
              src={author.data.avatar}
              alt={author.data.name}
              width="32"
              height="32"
              style="width:32px;height:32px;border-radius:50%;object-fit:cover;border:2px solid rgba(255,255,255,0.3);"
            />
          )}
          <span style="font-size:14px;font-weight:600;color:rgba(255,255,255,0.85);">
            {author.data.nameJa ?? author.data.name}
          </span>
        </a>
        <span style="color:rgba(255,255,255,0.25);">|</span>
        <time datetime={pubDate.toISOString()} style="font-size:13px;color:rgba(255,255,255,0.6);">
          {pubDate.toLocaleDateString('ja-JP', { year: 'numeric', month: 'long', day: 'numeric' })}
        </time>
        {readingTime && (
          <>
            <span style="color:rgba(255,255,255,0.25);">|</span>
            <span style="font-size:13px;color:rgba(255,255,255,0.6);">約{readingTime}分</span>
          </>
        )}
      </div>

      {heroImage && (
        <div class="article-hero-image" style="padding:0;max-width:860px;">
          <figure style="margin:0;border-radius:16px;overflow:hidden;border:3px solid #C8102E;box-shadow:0 0 0 1px rgba(200,16,46,0.15),0 8px 48px rgba(0,0,0,0.4);line-height:0;background:#001529;">
            <img
              src={heroImage}
              alt={heroImageAlt || title}
              width="1200"
              height="630"
              style="width:100%;height:420px;object-fit:cover;object-position:center;display:block;border-radius:13px;"
              fetchpriority="high"
              loading="eager"
            />
          </figure>
        </div>
      )}

    </div>
  </header>

  <!-- Article body -->
  <div class="page-container py-10">
    {lead && (
      <div class="border-l-4 border-navy bg-[#F0F4F8] px-5 py-4 mb-8 text-ink leading-relaxed font-medium rounded-r-lg max-w-3xl">
        {lead}
      </div>
    )}

    <div class="content-grid">
      <!-- Main content -->
      <div class="content-main">
        {headings.filter((h) => h.depth === 2).length > 0 && (
          <details class="toc-mobile-inline">
            <summary>
              <span>目次</span>
              <span class="tmi-chevron" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </summary>
            <ol class="tmi-list">
              {headings.filter((h) => h.depth === 2).map((h, i) => (
                <li>
                  <a href={'#' + h.slug}>
                    <span class="tmi-num">{i + 1}.</span>
                    {h.text}
                  </a>
                </li>
              ))}
            </ol>
          </details>
        )}

        <!-- AdSlot art-mid: before main content -->
        <div class="mb-8">
          <AdSlot position="art-mid" />
        </div>

        <div class="prose">
          <Content />
        </div>

        <NewsletterForm variant="inline" />

        <!-- AdSlot art-bottom: before FAQ -->
        <div class="my-8">
          <AdSlot position="art-bottom" />
        </div>

        {faq && faq.length > 0 && <FAQSection faq={faq} title={faqTitle} />}

        {author && <ArticleDisclaimer />}
        {author && <AuthorBox author={author} />}

        {related.length > 0 && (
          <section class="mt-12 border-t border-[#E8E8E6] pt-10">
            <h2 class="font-sans font-bold text-2xl text-navy mb-2">こちらの記事もおすすめ</h2>
            <p class="text-sm text-gray-500 mb-6">同じテーマのおすすめ記事です。</p>
            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
              {related.map((a) => {
                const parts = a.id.replace(/\.(md|mdx)$/, '').split('/');
                const slug = parts[2] ?? a.data.cluster;
                return (
                  <ArticleCard
                    title={a.data.title}
                    description={a.data.description}
                    href={`/${a.data.pillar}/${a.data.cluster}/${slug}/`}
                    pillar={a.data.pillar}
                    image={a.data.image}
                    imageAlt={a.data.imageAlt}
                    pubDate={a.data.pubDate}
                  />
                );
              })}
            </div>
          </section>
        )}

        <PreferredSourceCTA />
      </div>

      <!-- Sidebar: TOC only -->
      <aside class="content-sidebar">
        <TOC headings={headings} />
      </aside>
    </div>
  </div>

  <LineBanner />
</BaseLayout>

<style>
  @media (max-width: 767px) {
    :global(.article-hero-image img) {
      height: 220px !important;
    }
  }
</style>
