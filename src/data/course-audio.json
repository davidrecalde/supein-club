{
  "1": [
    {
      "index": 0,
      "text": "Buenas tardes. ¿Su nombre, por favor?",
      "speaker": "male-adult",
      "src": "/audio/units/u01/u01-01.mp3",
      "slow": "/audio/units/u01/u01-01-slow.mp3",
      "seconds": 2.31,
      "hash": "1ca24e39f9dfb816"
    },
    {
      "index": 1,
      "text": "Hola, me llamo Mina.",
      "speaker": "mina",
      "src": "/audio/units/u01/u01-02.mp3",
      "slow": "/audio/units/u01/u01-02-slow.mp3",
      "seconds": 2.62,
      "hash": "f6451a2e8e6468b1"
    },
    {
      "index": 2,
      "text": "¿Cómo se escribe?",
