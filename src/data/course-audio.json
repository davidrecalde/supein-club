      "text": "pero, perro",
      "speaker": "narrator",
      "src": "/audio/units/u01/u01-12.mp3",
      "slow": "/audio/units/u01/u01-12-slow.mp3",
      "seconds": 2.21,
      "hash": "b314fca08619ef04"
    },
    {
