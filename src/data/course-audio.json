      "src": "/audio/units/u01/u01-13.mp3",
      "slow": "/audio/units/u01/u01-13-slow.mp3",
      "seconds": 0.55,
      "hash": "25a048058676648f"
    },
    {
      "index": 13,
      "text": "música",
      "speaker": "narrator",
      "src": "/audio/units/u01/u01-14.mp3",
      "slow": "/audio/units/u01/u01-14-slow.mp3",
      "seconds": 0.77,
      "hash": "87b51d9e25df7551"
    },
    {
      "index": 14,
      "text": "¿Hablas español?",
      "speaker": "narrator",
      "src": "/audio/units/u01/u01-15.mp3",
      "slow": "/audio/units/u01/u01-15-slow.mp3",
      "seconds": 1.11,
      "hash": "0dd77b162da0bd97"
    },
    {
      "index": 15,
      "text": "¿Dónde está el hotel?",
      "speaker": "narrator",
      "src": "/audio/units/u01/u01-16.mp3",
      "slow": "/audio/units/u01/u01-16-slow.mp3",
      "seconds": 1.48,
      "hash": "4a09e1fa3c4d3378"
    }
  ],
  "2": [
    {
      "index": 0,
      "text": "Un café con leche, por favor.",
      "speaker": "narrator",
      "src": "/audio/units/u02/u02-01.mp3",
      "slow": "/audio/units/u02/u02-01-slow.mp3",
      "seconds": 2.59,
      "hash": "f81ccb54bd31644e"
    },
    {
      "index": 1,
      "text": "La cuenta, por favor.",
      "speaker": "narrator",
      "src": "/audio/units/u02/u02-02.mp3",
      "slow": "/audio/units/u02/u02-02-slow.mp3",
      "seconds": 1.7,
      "hash": "89386c598a3f3640"
    },
    {
      "index": 2,
      "text": "Mina tiene una maleta. La maleta es azul.",
      "speaker": "narrator",
      "src": "/audio/units/u02/u02-03.mp3",
      "slow": "/audio/units/u02/u02-03-slow.mp3",
      "seconds": 5.03,
      "hash": "cdfedf48088b6a83"
    },
    {
      "index": 3,
      "text": "Voy al museo.",
      "speaker": "narrator",
      "src": "/audio/units/u02/u02-04.mp3",
      "slow": "/audio/units/u02/u02-04-slow.mp3",
      "seconds": 1.25,
      "hash": "8d3d60d896deae35"
    },
    {
      "index": 4,
      "text": "la llave del hotel",
      "speaker": "narrator",
      "src": "/audio/units/u02/u02-05.mp3",
      "slow": "/audio/units/u02/u02-05-slow.mp3",
      "seconds": 1.79,
      "hash": "28150be5f33f8dec"
    },
    {
      "index": 5,
      "text": "estación",
      "speaker": "narrator",
      "src": "/audio/units/u02/u02-06.mp3",
      "slow": "/audio/units/u02/u02-06-slow.mp3",
      "seconds": 0.91,
      "hash": "9f2b05906e79ed87"
    },
    {
      "index": 6,
      "text": "estaciones",
      "speaker": "narrator",
      "src": "/audio/units/u02/u02-07.mp3",
      "slow": "/audio/units/u02/u02-07-slow.mp3",
      "seconds": 1.16,
      "hash": "abdb5958c30f3b43"
    }
  ],
  "3": [
    {
      "index": 0,
      "text": "Hola, ¿cómo te llamas?",
      "speaker": "daniel",
      "src": "/audio/units/u03/u03-01.mp3",
      "slow": "/audio/units/u03/u03-01-slow.mp3",
      "seconds": 1.62,
      "hash": "0c400ecc3be5c105"
    },
    {
      "index": 1,
      "text": "Me llamo Mina. ¿Y tú?",
      "speaker": "mina",
      "src": "/audio/units/u03/u03-02.mp3",
      "slow": "/audio/units/u03/u03-02-slow.mp3",
      "seconds": 3.24,
      "hash": "8a8f67c68099751b"
    },
    {
      "index": 2,
      "text": "Soy Daniel. Encantado.",
      "speaker": "daniel",
      "src": "/audio/units/u03/u03-03.mp3",
      "slow": "/audio/units/u03/u03-03-slow.mp3",
      "seconds": 1.77,
      "hash": "8d5859e0bbfbbebe"
    },
    {
      "index": 3,
      "text": "Encantada. ¿De dónde eres?",
      "speaker": "mina",
      "src": "/audio/units/u03/u03-04.mp3",
      "slow": "/audio/units/u03/u03-04-slow.mp3",
      "seconds": 3.27,
      "hash": "f91fdb74f8576fa3"
    },
    {
      "index": 4,
      "text": "Soy de Valencia, pero vivo en Tokio. ¿Y tú?",
      "speaker": "daniel",
      "src": "/audio/units/u03/u03-05.mp3",
      "slow": "/audio/units/u03/u03-05-slow.mp3",
      "seconds": 3.22,
      "hash": "7ae962c6a50d6a50"
    },
    {
      "index": 5,
      "text": "Soy de Tokio. Soy diseñadora.",
      "speaker": "mina",
      "src": "/audio/units/u03/u03-06.mp3",
      "slow": "/audio/units/u03/u03-06-slow.mp3",
      "seconds": 3.77,
      "hash": "03bd484dd68e3d44"
    },
    {
      "index": 6,
      "text": "¿Qué tal estás?",
      "speaker": "daniel",
      "src": "/audio/units/u03/u03-07.mp3",
      "slow": "/audio/units/u03/u03-07-slow.mp3",
      "seconds": 0.8,
      "hash": "426d9dcea4d8b605"
    },
    {
      "index": 7,
      "text": "Estoy un poco nerviosa, pero bien.",
      "speaker": "mina",
      "src": "/audio/units/u03/u03-08.mp3",
      "slow": "/audio/units/u03/u03-08-slow.mp3",
      "seconds": 3.76,
      "hash": "76821f6b2946a278"
    },
    {
      "index": 8,
      "text": "está",
      "speaker": "daniel",
      "src": "/audio/units/u03/u03-09.mp3",
      "slow": "/audio/units/u03/u03-09-slow.mp3",
      "seconds": 0.59,
      "hash": "9d28aa6a2a4c31cb"
    },
    {
      "index": 9,
      "text": "esta",
      "speaker": "narrator",
      "src": "/audio/units/u03/u03-10.mp3",
      "slow": "/audio/units/u03/u03-10-slow.mp3",
      "seconds": 1.04,
      "hash": "a729b03736277199"
    }
  ],
  "4": [
    {
      "index": 0,
      "text": "Mina vive en Tokio y trabaja en una oficina de diseño.",
      "speaker": "narrator",
      "src": "/audio/units/u04/u04-01.mp3",
      "slow": "/audio/units/u04/u04-01-slow.mp3",
      "seconds": 4.7,
      "hash": "288f15ec3ea8a990"
    },
    {
      "index": 1,
      "text": "Por la noche, estudia español.",
      "speaker": "narrator",
      "src": "/audio/units/u04/u04-02.mp3",
      "slow": "/audio/units/u04/u04-02-slow.mp3",
      "seconds": 2.43,
      "hash": "bd054d17a21be236"
    },
    {
      "index": 2,
      "text": "¿Hablas español?",
      "speaker": "narrator",
      "src": "/audio/units/u04/u04-03.mp3",
      "slow": "/audio/units/u04/u04-03-slow.mp3",
      "seconds": 1.11,
      "hash": "0dd77b162da0bd97"
    },
    {
      "index": 3,
      "text": "Sí, hablo un poco.",
      "speaker": "narrator",
      "src": "/audio/units/u04/u04-04.mp3",
      "slow": "/audio/units/u04/u04-04-slow.mp3",
      "seconds": 1.85,
      "hash": "067bcc28929896ff"
    },
    {
      "index": 4,
      "text": "No, no hablo francés.",
      "speaker": "narrator",
      "src": "/audio/units/u04/u04-05.mp3",
      "slow": "/audio/units/u04/u04-05-slow.mp3",
      "seconds": 1.95,
      "hash": "2f67daed237dfd7f"
    },
    {
      "index": 5,
      "text": "¿Usted habla inglés?",
      "speaker": "narrator",
      "src": "/audio/units/u04/u04-06.mp3",
      "slow": "/audio/units/u04/u04-06-slow.mp3",
      "seconds": 1.22,
      "hash": "2790fe9fd93548aa"
    },
    {
      "index": 6,
      "text": "Los domingos por la mañana, muchos madrileños visitan el Rastro.",
      "speaker": "narrator",
      "src": "/audio/units/u04/u04-07.mp3",
      "slow": "/audio/units/u04/u04-07-slow.mp3",
      "seconds": 4.66,
      "hash": "a9a24cab4e99f69f"
    },
    {
      "index": 7,
      "text": "Normalmente como en un bar cerca del hotel, a las dos y media.",
      "speaker": "mina",
      "src": "/audio/units/u04/u04-08.mp3",
      "slow": "/audio/units/u04/u04-08-slow.mp3",
      "seconds": 7.6,
      "hash": "ad024a80ac6d233e"
    },
    {
      "index": 8,
      "text": "Claro, en España comemos tarde.",
      "speaker": "daniel",
      "src": "/audio/units/u04/u04-09.mp3",
      "slow": "/audio/units/u04/u04-09-slow.mp3",
      "seconds": 3.04,
      "hash": "75ac8a09f8a2bffd"
    },
    {
      "index": 9,
      "text": "hablamos",
      "speaker": "narrator",
      "src": "/audio/units/u04/u04-10.mp3",
      "slow": "/audio/units/u04/u04-10-slow.mp3",
      "seconds": 0.77,
      "hash": "45548afe6f9c08e7"
    },
    {
      "index": 10,
      "text": "habláis",
      "speaker": "narrator",
      "src": "/audio/units/u04/u04-11.mp3",
      "slow": "/audio/units/u04/u04-11-slow.mp3",
      "seconds": 0.72,
      "hash": "7105a37847f8a5a1"
    }
  ],
  "5": [
    {
      "index": 0,
      "text": "Quiero un café con leche.",
      "speaker": "narrator",
      "src": "/audio/units/u05/u05-01.mp3",
      "slow": "/audio/units/u05/u05-01-slow.mp3",
      "seconds": 2.69,
      "hash": "76f6e6300ad322a0"
    },
    {
      "index": 1,
      "text": "¿Puedo pagar con tarjeta?",
      "speaker": "mina",
      "src": "/audio/units/u05/u05-02.mp3",
      "slow": "/audio/units/u05/u05-02-slow.mp3",
      "seconds": 2.37,
      "hash": "1895fe061e6dfb5a"
    },
    {
      "index": 2,
      "text": "Tengo veintiocho años.",
      "speaker": "narrator",
      "src": "/audio/units/u05/u05-03.mp3",
      "slow": "/audio/units/u05/u05-03-slow.mp3",
      "seconds": 2.52,
      "hash": "16aadff2e8012b1b"
    },
    {
      "index": 3,
      "text": "Tengo que comprar un billete.",
      "speaker": "narrator",
      "src": "/audio/units/u05/u05-04.mp3",
      "slow": "/audio/units/u05/u05-04-slow.mp3",
      "seconds": 2.21,
      "hash": "8795c9c5dd7b6015"
    },
    {
      "index": 4,
      "text": "Mañana voy al Museo del Prado.",
      "speaker": "narrator",
      "src": "/audio/units/u05/u05-05.mp3",
      "slow": "/audio/units/u05/u05-05-slow.mp3",
      "seconds": 3.12,
      "hash": "863c4caefc58708d"
    },
    {
      "index": 5,
      "text": "¿Me pones una caña, por favor?",
      "speaker": "narrator",
      "src": "/audio/units/u05/u05-06.mp3",
      "slow": "/audio/units/u05/u05-06-slow.mp3",
      "seconds": 2.33,
      "hash": "6872f2232168f514"
    },
    {
      "index": 6,
      "text": "Hola, buenos días. Quiero una entrada, por favor.",
      "speaker": "mina",
      "src": "/audio/units/u05/u05-07.mp3",
      "slow": "/audio/units/u05/u05-07-slow.mp3",
      "seconds": 5.7,
      "hash": "d9aef2156be559cd"
    },
    {
      "index": 7,
      "text": "¿A qué hora cierra el museo?",
      "speaker": "mina",
      "src": "/audio/units/u05/u05-08.mp3",
      "slow": "/audio/units/u05/u05-08-slow.mp3",
      "seconds": 2.79,
      "hash": "9f921e6d9483500e"
    },
    {
      "index": 8,
      "text": "quiero",
      "speaker": "narrator",
      "src": "/audio/units/u05/u05-09.mp3",
      "slow": "/audio/units/u05/u05-09-slow.mp3",
      "seconds": 0.6,
      "hash": "a449075cdacaa5a3"
    },
    {
      "index": 9,
      "text": "puedo",
      "speaker": "narrator",
      "src": "/audio/units/u05/u05-10.mp3",
      "slow": "/audio/units/u05/u05-10-slow.mp3",
      "seconds": 0.61,
      "hash": "189a1a4a84000976"
    }
  ],
  "6": [
    {
      "index": 0,
      "text": "Quiero aquel abanico rojo. ¿Cuánto cuesta?",
      "speaker": "narrator",
      "src": "/audio/units/u06/u06-01.mp3",
      "slow": "/audio/units/u06/u06-01-slow.mp3",
      "seconds": 3.9,
      "hash": "1d98f42c997d4436"
    },
    {
      "index": 1,
      "text": "¿Cuánto cuesta esta camiseta?",
      "speaker": "narrator",
      "src": "/audio/units/u06/u06-02.mp3",
      "slow": "/audio/units/u06/u06-02-slow.mp3",
      "seconds": 2.13,
      "hash": "e19c700c71622c51"
    },
    {
      "index": 2,
      "text": "Es un regalo para mi madre.",
      "speaker": "narrator",
      "src": "/audio/units/u06/u06-03.mp3",
      "slow": "/audio/units/u06/u06-03-slow.mp3",
      "seconds": 1.93,
      "hash": "8a6988cde47fe90c"
    },
    {
      "index": 3,
      "text": "¿Qué es esto?",
      "speaker": "narrator",
      "src": "/audio/units/u06/u06-04.mp3",
      "slow": "/audio/units/u06/u06-04-slow.mp3",
      "seconds": 0.88,
      "hash": "55b89342eb613c94"
    },
    {
      "index": 4,
      "text": "amarillo",
      "speaker": "narrator",
      "src": "/audio/units/u06/u06-05.mp3",
      "slow": "/audio/units/u06/u06-05-slow.mp3",
      "seconds": 0.82,
      "hash": "897d034a0b6d64e4"
    },
    {
      "index": 5,
      "text": "la calle",
      "speaker": "narrator",
      "src": "/audio/units/u06/u06-06.mp3",
      "slow": "/audio/units/u06/u06-06-slow.mp3",
      "seconds": 0.83,
      "hash": "d3ac90496b77493b"
    }
  ],
  "7": [
    {
      "index": 0,
      "text": "Perdone, ¿hay una farmacia cerca?",
      "speaker": "mina",
      "src": "/audio/units/u07/u07-01.mp3",
      "slow": "/audio/units/u07/u07-01-slow.mp3",
      "seconds": 4.44,
      "hash": "5f826265dcfe8998"
    },
    {
      "index": 1,
      "text": "Sí, hay una en la calle Mayor, al lado del banco.",
      "speaker": "male-senior",
      "src": "/audio/units/u07/u07-02.mp3",
      "slow": "/audio/units/u07/u07-02-slow.mp3",
      "seconds": 4.14,
      "hash": "3ba132b0df614fb5"
    },
    {
      "index": 2,
      "text": "¿Y dónde está la estación de metro?",
      "speaker": "mina",
      "src": "/audio/units/u07/u07-03.mp3",
      "slow": "/audio/units/u07/u07-03-slow.mp3",
      "seconds": 5.39,
      "hash": "cf5462bfa90119eb"
    },
    {
      "index": 3,
      "text": "Está enfrente de la farmacia.",
      "speaker": "male-senior",
      "src": "/audio/units/u07/u07-04.mp3",
      "slow": "/audio/units/u07/u07-04-slow.mp3",
      "seconds": 2.27,
      "hash": "68c05ce2da9ef606"
    },
    {
      "index": 4,
      "text": "No, está muy cerca. A cinco minutos a pie.",
      "speaker": "male-senior",
      "src": "/audio/units/u07/u07-05.mp3",
      "slow": "/audio/units/u07/u07-05-slow.mp3",
      "seconds": 3.52,
      "hash": "c3706c939cb19315"
    },
    {
      "index": 5,
      "text": "En Segovia, el acueducto está en la plaza del Azoguejo.",
      "speaker": "narrator",
      "src": "/audio/units/u07/u07-06.mp3",
      "slow": "/audio/units/u07/u07-06-slow.mp3",
      "seconds": 5.52,
      "hash": "de8953a1bd19419e"
    },
    {
      "index": 6,
      "text": "Hay una cama, una mesa y una ventana grande.",
      "speaker": "narrator",
      "src": "/audio/units/u07/u07-07.mp3",
      "slow": "/audio/units/u07/u07-07-slow.mp3",
      "seconds": 5.31,
      "hash": "cf8c811d0cf2446b"
    },
    {
      "index": 7,
      "text": "hay",
      "speaker": "narrator",
      "src": "/audio/units/u07/u07-08.mp3",
      "slow": "/audio/units/u07/u07-08-slow.mp3",
      "seconds": 0.41,
      "hash": "6c4ed30260b9d691"
    },
    {
      "index": 8,
      "text": "hotel",
      "speaker": "narrator",
      "src": "/audio/units/u07/u07-09.mp3",
      "slow": "/audio/units/u07/u07-09-slow.mp3",
      "seconds": 0.59,
      "hash": "5670390bede1c3aa"
    }
  ],
  "8": [
    {
      "index": 0,
      "text": "¿Te gusta la comida española?",
      "speaker": "daniel",
      "src": "/audio/units/u08/u08-01.mp3",
      "slow": "/audio/units/u08/u08-01-slow.mp3",
      "seconds": 1.49,
      "hash": "eecb95ead0b7475e"
    },
    {
      "index": 1,
      "text": "Sí, me encanta. Me gustan mucho las croquetas.",
      "speaker": "mina",
      "src": "/audio/units/u08/u08-02.mp3",
      "slow": "/audio/units/u08/u08-02-slow.mp3",
      "seconds": 5.57,
      "hash": "0b1628ccf28dc752"
    },
    {
      "index": 2,
      "text": "¿Y el flamenco?",
      "speaker": "daniel",
      "src": "/audio/units/u08/u08-03.mp3",
      "slow": "/audio/units/u08/u08-03-slow.mp3",
      "seconds": 0.85,
      "hash": "61b4f723526bb9ca"
    },
    {
      "index": 3,
      "text": "Me interesa mucho. ¿Y a ti?",
      "speaker": "mina",
      "src": "/audio/units/u08/u08-04.mp3",
      "slow": "/audio/units/u08/u08-04-slow.mp3",
      "seconds": 3.26,
      "hash": "74a420612c2e84d2"
    },
    {
      "index": 4,
      "text": "A mí también. Pero no me gusta el café solo.",
      "speaker": "daniel",
      "src": "/audio/units/u08/u08-05.mp3",
      "slow": "/audio/units/u08/u08-05-slow.mp3",
      "seconds": 2.99,
      "hash": "04e46f9e063edd4a"
    },
    {
      "index": 5,
      "text": "A mí tampoco.",
      "speaker": "mina",
      "src": "/audio/units/u08/u08-06.mp3",
      "slow": "/audio/units/u08/u08-06-slow.mp3",
      "seconds": 1.17,
      "hash": "a8081a503333a021"
    },
    {
      "index": 6,
      "text": "¿De qué equipo eres?",
      "speaker": "narrator",
      "src": "/audio/units/u08/u08-07.mp3",
      "slow": "/audio/units/u08/u08-07-slow.mp3",
      "seconds": 1.61,
      "hash": "c3f7ac08692dd544"
    },
    {
      "index": 7,
      "text": "¿Qué te gusta hacer los fines de semana?",
      "speaker": "narrator",
      "src": "/audio/units/u08/u08-08.mp3",
      "slow": "/audio/units/u08/u08-08-slow.mp3",
      "seconds": 2.53,
      "hash": "aa2362a974cc4b60"
    },
    {
      "index": 8,
      "text": "Me gusta mucho dibujar y ver películas.",
      "speaker": "narrator",
      "src": "/audio/units/u08/u08-09.mp3",
      "slow": "/audio/units/u08/u08-09-slow.mp3",
      "seconds": 3.5,
      "hash": "ed20020a7b869a68"
    },
    {
      "index": 9,
      "text": "guitarra",
      "speaker": "narrator",
      "src": "/audio/units/u08/u08-10.mp3",
      "slow": "/audio/units/u08/u08-10-slow.mp3",
      "seconds": 0.9,
      "hash": "5bdf6fa43eab8c4a"
    },
    {
      "index": 10,
      "text": "gente",
      "speaker": "narrator",
      "src": "/audio/units/u08/u08-11.mp3",
      "slow": "/audio/units/u08/u08-11-slow.mp3",
      "seconds": 0.79,
      "hash": "dd20bc13c2b17781"
    }
  ],
  "9": [
    {
      "index": 0,
      "text": "Me despierto a las siete, me levanto y me ducho.",
      "speaker": "narrator",
      "src": "/audio/units/u09/u09-01.mp3",
      "slow": "/audio/units/u09/u09-01-slow.mp3",
      "seconds": 5.1,
      "hash": "4f003caa1c6b8652"
    },
    {
      "index": 1,
      "text": "Luego me visto, desayuno y salgo de casa a las ocho.",
      "speaker": "narrator",
      "src": "/audio/units/u09/u09-02.mp3",
      "slow": "/audio/units/u09/u09-02-slow.mp3",
      "seconds": 6.12,
      "hash": "db93fcc4e508f628"
    },
    {
      "index": 2,
      "text": "Por la noche, ceno, me lavo los dientes y me acuesto a las doce.",
      "speaker": "narrator",
      "src": "/audio/units/u09/u09-03.mp3",
      "slow": "/audio/units/u09/u09-03-slow.mp3",
      "seconds": 6.71,
      "hash": "4c3f6083956cf6fe"
    },
    {
      "index": 3,
      "text": "En Madrid, me levanto a las nueve, desayuno en un bar y me acuesto a la una.",
      "speaker": "narrator",
      "src": "/audio/units/u09/u09-04.mp3",
      "slow": "/audio/units/u09/u09-04-slow.mp3",
      "seconds": 7.64,
      "hash": "923e7bfb89344b56"
    },
    {
      "index": 4,
      "text": "¿A qué hora te levantas?",
      "speaker": "narrator",
      "src": "/audio/units/u09/u09-05.mp3",
      "slow": "/audio/units/u09/u09-05-slow.mp3",
      "seconds": 1.58,
      "hash": "366405dfe0e477c5"
    },
    {
      "index": 5,
      "text": "Los fines de semana, a veces me echo la siesta.",
      "speaker": "narrator",
      "src": "/audio/units/u09/u09-06.mp3",
      "slow": "/audio/units/u09/u09-06-slow.mp3",
      "seconds": 4.1,
      "hash": "51ba220b5ce92d96"
    },
    {
      "index": 6,
      "text": "mañana",
      "speaker": "narrator",
      "src": "/audio/units/u09/u09-07.mp3",
      "slow": "/audio/units/u09/u09-07-slow.mp3",
      "seconds": 0.75,
      "hash": "ea4df8d869b29c77"
    },
    {
      "index": 7,
      "text": "España",
      "speaker": "narrator",
      "src": "/audio/units/u09/u09-08.mp3",
      "slow": "/audio/units/u09/u09-08-slow.mp3",
      "seconds": 0.78,
      "hash": "3e9cf70166c81b3f"
    }
  ],
  "10": [
    {
      "index": 0,
      "text": "Buenos días. ¿A qué hora sale el próximo tren a Toledo?",
      "speaker": "mina",
      "src": "/audio/units/u10/u10-01.mp3",
      "slow": "/audio/units/u10/u10-01-slow.mp3",
      "seconds": 6.78,
      "hash": "2ff8d760f6655396"
    },
    {
      "index": 1,
      "text": "A las diez y cuarto.",
      "speaker": "male-adult",
      "src": "/audio/units/u10/u10-02.mp3",
      "slow": "/audio/units/u10/u10-02-slow.mp3",
      "seconds": 1.14,
      "hash": "cea861269f8a676b"
    },
    {
      "index": 2,
      "text": "¿Cuánto cuesta el billete?",
      "speaker": "mina",
      "src": "/audio/units/u10/u10-03.mp3",
      "slow": "/audio/units/u10/u10-03-slow.mp3",
      "seconds": 2.45,
      "hash": "611912070ccfae3b"
    },
    {
      "index": 3,
      "text": "Doce euros con cincuenta.",
      "speaker": "male-adult",
      "src": "/audio/units/u10/u10-04.mp3",
      "slow": "/audio/units/u10/u10-04-slow.mp3",
      "seconds": 1.59,
      "hash": "17d982afc675793e"
    },
    {
      "index": 4,
      "text": "¿Y de qué andén sale?",
      "speaker": "mina",
      "src": "/audio/units/u10/u10-05.mp3",
      "slow": "/audio/units/u10/u10-05-slow.mp3",
      "seconds": 2.68,
      "hash": "19253368d10d0bf6"
    },
    {
      "index": 5,
      "text": "Del andén tres.",
      "speaker": "male-adult",
      "src": "/audio/units/u10/u10-06.mp3",
      "slow": "/audio/units/u10/u10-06-slow.mp3",
      "seconds": 1.11,
      "hash": "3c46a3676856f17c"
    },
    {
      "index": 6,
      "text": "Es la una. Son las dos y media. Son las nueve menos cuarto.",
      "speaker": "narrator",
      "src": "/audio/units/u10/u10-07.mp3",
      "slow": "/audio/units/u10/u10-07-slow.mp3",
      "seconds": 9.32,
      "hash": "db010e4862dec874"
    },
    {
      "index": 7,
      "text": "Hoy es lunes, dos de noviembre.",
      "speaker": "narrator",
      "src": "/audio/units/u10/u10-08.mp3",
      "slow": "/audio/units/u10/u10-08-slow.mp3",
      "seconds": 3.52,
      "hash": "1e003011bb5640c6"
    },
    {
      "index": 8,
      "text": "¿Cuál es tu número de teléfono?",
      "speaker": "narrator",
      "src": "/audio/units/u10/u10-09.mp3",
      "slow": "/audio/units/u10/u10-09-slow.mp3",
      "seconds": 2.03,
      "hash": "33466ff1e622001c"
    },
    {
      "index": 9,
      "text": "¿Cuántos años tienes? Tengo veintiocho años.",
      "speaker": "narrator",
      "src": "/audio/units/u10/u10-10.mp3",
      "slow": "/audio/units/u10/u10-10-slow.mp3",
      "seconds": 4.85,
      "hash": "ed7944882b43e801"
    },
    {
      "index": 10,
      "text": "cinco, doce, cien, zumo",
      "speaker": "narrator",
      "src": "/audio/units/u10/u10-11.mp3",
      "slow": "/audio/units/u10/u10-11-slow.mp3",
      "seconds": 5.23,
      "hash": "4f0d2bae299ea2d6"
    }
  ],
  "11": [
    {
      "index": 0,
      "text": "Mañana voy a ir a Toledo.",
      "speaker": "narrator",
      "src": "/audio/units/u11/u11-01.mp3",
      "slow": "/audio/units/u11/u11-01-slow.mp3",
      "seconds": 2.84,
      "hash": "6553fd811afbaabd"
    },
    {
      "index": 1,
      "text": "Mira las nubes. Va a llover.",
      "speaker": "narrator",
      "src": "/audio/units/u11/u11-02.mp3",
      "slow": "/audio/units/u11/u11-02-slow.mp3",
      "seconds": 3.03,
      "hash": "38280ddd1b68fe3b"
    },
    {
      "index": 2,
      "text": "¿Qué estás haciendo?",
      "speaker": "daniel",
      "src": "/audio/units/u11/u11-03.mp3",
      "slow": "/audio/units/u11/u11-03-slow.mp3",
      "seconds": 0.86,
      "hash": "0ef78e5c997b1a7e"
    },
    {
      "index": 3,
      "text": "Estoy tomando un café en la Plaza Mayor.",
      "speaker": "mina",
      "src": "/audio/units/u11/u11-04.mp3",
      "slow": "/audio/units/u11/u11-04-slow.mp3",
      "seconds": 4.47,
      "hash": "69e2fd793c590b39"
    },
    {
      "index": 4,
      "text": "¿Y qué vas a hacer mañana?",
      "speaker": "daniel",
      "src": "/audio/units/u11/u11-05.mp3",
      "slow": "/audio/units/u11/u11-05-slow.mp3",
      "seconds": 1.34,
      "hash": "d9c5ec4f603a1879"
    },
    {
      "index": 5,
      "text": "Voy a ir a Toledo. Voy a visitar la catedral y voy a comprar mazapán.",
      "speaker": "mina",
      "src": "/audio/units/u11/u11-06.mp3",
      "slow": "/audio/units/u11/u11-06-slow.mp3",
      "seconds": 8.65,
      "hash": "2e28de99438610e5"
    },
    {
      "index": 6,
      "text": "comiendo",
      "speaker": "narrator",
      "src": "/audio/units/u11/u11-07.mp3",
      "slow": "/audio/units/u11/u11-07-slow.mp3",
      "seconds": 0.95,
      "hash": "f05a14f9a700fe4c"
    },
    {
      "index": 7,
      "text": "duchándome",
      "speaker": "narrator",
      "src": "/audio/units/u11/u11-08.mp3",
      "slow": "/audio/units/u11/u11-08-slow.mp3",
      "seconds": 1.14,
      "hash": "f9d8f110f1ddeb21"
    }
  ],
  "12": [
    {
      "index": 0,
      "text": "Hola, ¿qué quieres?",
      "speaker": "male-adult",
      "src": "/audio/units/u12/u12-01.mp3",
      "slow": "/audio/units/u12/u12-01-slow.mp3",
      "seconds": 1.09,
      "hash": "684f9c80e9c29537"
    },
    {
      "index": 1,
      "text": "Un café con leche y un cruasán, por favor.",
      "speaker": "mina",
      "src": "/audio/units/u12/u12-02.mp3",
      "slow": "/audio/units/u12/u12-02-slow.mp3",
      "seconds": 5.53,
      "hash": "3d8768e14f38e223"
    },
    {
      "index": 2,
      "text": "¿Algo más?",
      "speaker": "male-adult",
      "src": "/audio/units/u12/u12-03.mp3",
      "slow": "/audio/units/u12/u12-03-slow.mp3",
      "seconds": 0.63,
      "hash": "ca1d99a212e83087"
    },
    {
      "index": 3,
      "text": "Sí, un zumo de naranja. ¿Cuánto es?",
      "speaker": "mina",
      "src": "/audio/units/u12/u12-04.mp3",
      "slow": "/audio/units/u12/u12-04-slow.mp3",
      "seconds": 4.57,
      "hash": "3d4c97c6f0999841"
    },
    {
      "index": 4,
      "text": "Son cinco euros con cincuenta.",
      "speaker": "male-adult",
      "src": "/audio/units/u12/u12-05.mp3",
      "slow": "/audio/units/u12/u12-05-slow.mp3",
      "seconds": 1.91,
      "hash": "4f82fcce231924ed"
    },
    {
      "index": 5,
      "text": "El tren con destino a Toledo sale a las diez y cuarto del andén tres.",
      "speaker": "narrator",
      "src": "/audio/units/u12/u12-06.mp3",
      "slow": "/audio/units/u12/u12-06-slow.mp3",
      "seconds": 7.04,
      "hash": "9d774075f49ed723"
    },
    {
      "index": 6,
      "text": "¿Hablas español?",
      "speaker": "narrator",
      "src": "/audio/units/u12/u12-07.mp3",
      "slow": "/audio/units/u12/u12-07-slow.mp3",
      "seconds": 1.18,
      "hash": "0dd77b162da0bd97"
    },
    {
      "index": 7,
      "text": "¿Dónde vives?",
      "speaker": "narrator",
      "src": "/audio/units/u12/u12-08.mp3",
      "slow": "/audio/units/u12/u12-08-slow.mp3",
      "seconds": 1.08,
      "hash": "2a97e4fc8929bb33"
    }
  ],
  "13": [
    {
      "index": 0,
      "text": "Esta mañana he tenido una reunión y he visitado la fábrica.",
      "speaker": "narrator",
      "src": "/audio/units/u13/u13-01.mp3",
      "slow": "/audio/units/u13/u13-01-slow.mp3",
      "seconds": 5.3,
      "hash": "b9613e6d1821cf98"
    },
    {
      "index": 1,
      "text": "¿Has estado alguna vez en Sevilla?",
      "speaker": "narrator",
      "src": "/audio/units/u13/u13-02.mp3",
      "slow": "/audio/units/u13/u13-02-slow.mp3",
      "seconds": 2.67,
      "hash": "b7fded41370c7161"
    },
    {
      "index": 2,
      "text": "No, nunca he estado en Sevilla.",
      "speaker": "narrator",
      "src": "/audio/units/u13/u13-03.mp3",
      "slow": "/audio/units/u13/u13-03-slow.mp3",
      "seconds": 2.96,
      "hash": "94610ac6d9f8e28a"
    },
    {
      "index": 3,
      "text": "¿Ya has comido? No, todavía no he comido.",
      "speaker": "narrator",
      "src": "/audio/units/u13/u13-04.mp3",
      "slow": "/audio/units/u13/u13-04-slow.mp3",
      "seconds": 4.63,
      "hash": "4ecfd2cdbc219424"
    },
    {
      "index": 4,
      "text": "Ayer visité la fábrica. Hoy he escrito el informe.",
      "speaker": "narrator",
      "src": "/audio/units/u13/u13-05.mp3",
      "slow": "/audio/units/u13/u13-05-slow.mp3",
      "seconds": 5.09,
      "hash": "f5b3635beac4280e"
    },
    {
      "index": 5,
      "text": "cansado",
      "speaker": "narrator",
      "src": "/audio/units/u13/u13-06.mp3",
      "slow": "/audio/units/u13/u13-06-slow.mp3",
      "seconds": 0.76,
      "hash": "65e6ddcde0402441"
    }
  ],
  "14": [
    {
      "index": 0,
      "text": "Ayer Mina visitó el Museo del Prado.",
      "speaker": "narrator",
      "src": "/audio/units/u14/u14-01.mp3",
      "slow": "/audio/units/u14/u14-01-slow.mp3",
      "seconds": 3.74,
      "hash": "b91e6bd49e366934"
    },
    {
      "index": 1,
      "text": "Anoche Kenta cenó con sus compañeros.",
      "speaker": "narrator",
      "src": "/audio/units/u14/u14-02.mp3",
      "slow": "/audio/units/u14/u14-02-slow.mp3",
      "seconds": 3.5,
      "hash": "f4e6298c30ad9da4"
    },
    {
      "index": 2,
      "text": "La semana pasada Kenta estuvo en Valencia.",
      "speaker": "narrator",
      "src": "/audio/units/u14/u14-03.mp3",
      "slow": "/audio/units/u14/u14-03-slow.mp3",
      "seconds": 3.74,
      "hash": "318921749f4b7e02"
    },
    {
      "index": 3,
      "text": "El año pasado Mina empezó a estudiar español.",
      "speaker": "narrator",
      "src": "/audio/units/u14/u14-04.mp3",
      "slow": "/audio/units/u14/u14-04-slow.mp3",
      "seconds": 4.08,
      "hash": "751b8cb55c6b8128"
    },
    {
      "index": 4,
      "text": "Kenta fue a Valencia por primera vez en 2019.",
      "speaker": "narrator",
      "src": "/audio/units/u14/u14-05.mp3",
      "slow": "/audio/units/u14/u14-05-slow.mp3",
      "seconds": 4.35,
      "hash": "a79deb2904e05ad3"
    },
    {
      "index": 5,
      "text": "Mina llegó a Madrid hace dos días.",
      "speaker": "narrator",
      "src": "/audio/units/u14/u14-06.mp3",
      "slow": "/audio/units/u14/u14-06-slow.mp3",
      "seconds": 3.05,
      "hash": "04fd47e9a5f25718"
    },
    {
      "index": 6,
      "text": "Primero fui al Palacio Real, después comí en la Plaza Mayor y al final volví al hotel en metro.",
      "speaker": "narrator",
      "src": "/audio/units/u14/u14-07.mp3",
      "slow": "/audio/units/u14/u14-07-slow.mp3",
      "seconds": 8.87,
      "hash": "bce028c32ef98b6a"
    },
    {
      "index": 7,
      "text": "El domingo fuimos a casa de mis padres, comimos paella y luego dormimos la siesta.",
      "speaker": "narrator",
      "src": "/audio/units/u14/u14-08.mp3",
      "slow": "/audio/units/u14/u14-08-slow.mp3",
      "seconds": 7.47,
      "hash": "4df249f9a60236d7"
    },
    {
      "index": 8,
      "text": "habló",
      "speaker": "narrator",
      "src": "/audio/units/u14/u14-09.mp3",
      "slow": "/audio/units/u14/u14-09-slow.mp3",
      "seconds": 0.53,
      "hash": "01a0545a37e231b3"
    },
    {
      "index": 9,
      "text": "hablo",
      "speaker": "narrator",
      "src": "/audio/units/u14/u14-10.mp3",
      "slow": "/audio/units/u14/u14-10-slow.mp3",
      "seconds": 0.56,
      "hash": "759032c0295dd674"
    }
  ],
  "15": [
    {
      "index": 0,
      "text": "De niña, Mina dibujaba todos los días.",
      "speaker": "narrator",
      "src": "/audio/units/u15/u15-01.mp3",
      "slow": "/audio/units/u15/u15-01-slow.mp3",
      "seconds": 4.12,
      "hash": "727acf2459802c36"
    },
    {
      "index": 1,
      "text": "Cada verano, Mina iba a casa de sus abuelos.",
      "speaker": "narrator",
      "src": "/audio/units/u15/u15-02.mp3",
      "slow": "/audio/units/u15/u15-02-slow.mp3",
      "seconds": 3.96,
      "hash": "504807336f7ed00b"
    },
    {
      "index": 2,
      "text": "Hacía sol y la plaza estaba llena de gente.",
      "speaker": "narrator",
      "src": "/audio/units/u15/u15-03.mp3",
      "slow": "/audio/units/u15/u15-03-slow.mp3",
      "seconds": 3.98,
      "hash": "f744c95c6c95f6b8"
    },
    {
      "index": 3,
      "text": "Eran las diez de la noche.",
      "speaker": "narrator",
      "src": "/audio/units/u15/u15-04.mp3",
      "slow": "/audio/units/u15/u15-04-slow.mp3",
      "seconds": 1.95,
      "hash": "9a79530940f9542e"
    },
    {
      "index": 4,
      "text": "Mina tenía siete años.",
      "speaker": "narrator",
      "src": "/audio/units/u15/u15-05.mp3",
      "slow": "/audio/units/u15/u15-05-slow.mp3",
      "seconds": 2.29,
      "hash": "bb145b0ffa35794e"
    },
    {
      "index": 5,
      "text": "A las nueve, Kenta todavía trabajaba.",
      "speaker": "narrator",
      "src": "/audio/units/u15/u15-06.mp3",
      "slow": "/audio/units/u15/u15-06-slow.mp3",
      "seconds": 3.49,
      "hash": "c8409b7a617c7cce"
    },
    {
      "index": 6,
      "text": "Antes, Kenta no entendía nada en las reuniones; ahora entiende casi todo.",
      "speaker": "narrator",
      "src": "/audio/units/u15/u15-07.mp3",
      "slow": "/audio/units/u15/u15-07-slow.mp3",
      "seconds": 7.49,
      "hash": "bfb5366971b3e4aa"
    },
    {
      "index": 7,
      "text": "Cuando era pequeño, merendaba un bocadillo en el parque y luego jugábamos al fútbol hasta la hora de cenar.",
      "speaker": "narrator",
      "src": "/audio/units/u15/u15-08.mp3",
      "slow": "/audio/units/u15/u15-08-slow.mp3",
      "seconds": 8.23,
      "hash": "7560954713db7360"
    },
    {
      "index": 8,
      "text": "comía",
      "speaker": "narrator",
      "src": "/audio/units/u15/u15-09.mp3",
      "slow": "/audio/units/u15/u15-09-slow.mp3",
      "seconds": 0.72,
      "hash": "f41d9490040369a9"
    },
    {
      "index": 9,
      "text": "vivía",
      "speaker": "narrator",
      "src": "/audio/units/u15/u15-10.mp3",
      "slow": "/audio/units/u15/u15-10-slow.mp3",
      "seconds": 0.83,
      "hash": "6fa51ca4b05435bc"
    },
    {
      "index": 10,
      "text": "veía",
      "speaker": "narrator",
      "src": "/audio/units/u15/u15-11.mp3",
      "slow": "/audio/units/u15/u15-11-slow.mp3",
      "seconds": 0.8,
      "hash": "154d73c607a64c67"
    }
  ],
  "16": [
    {
      "index": 0,
      "text": "Mina llegó a la Plaza Mayor a las doce. Hacía sol y había mucha gente.",
      "speaker": "narrator",
      "src": "/audio/units/u16/u16-01.mp3",
      "slow": "/audio/units/u16/u16-01-slow.mp3",
      "seconds": 7.63,
      "hash": "2cc44282e4f20bf2"
    },
    {
      "index": 1,
      "text": "Kenta presentaba el proyecto cuando se fue la luz.",
      "speaker": "narrator",
      "src": "/audio/units/u16/u16-02.mp3",
      "slow": "/audio/units/u16/u16-02-slow.mp3",
      "seconds": 3.94,
      "hash": "61cc69f916bd1a6d"
    },
    {
      "index": 2,
      "text": "Mina tomaba un café cuando empezó a llover.",
      "speaker": "narrator",
      "src": "/audio/units/u16/u16-03.mp3",
      "slow": "/audio/units/u16/u16-03-slow.mp3",
      "seconds": 3.83,
      "hash": "f62b9e02fe465b1a"
    },
    {
      "index": 3,
      "text": "Kenta estuvo cinco días en Valencia.",
      "speaker": "narrator",
      "src": "/audio/units/u16/u16-04.mp3",
      "slow": "/audio/units/u16/u16-04-slow.mp3",
      "seconds": 3.19,
      "hash": "609a8349641ae65a"
    },
    {
      "index": 4,
      "text": "Cuando estaba en Valencia, Kenta llamaba a su familia todas las noches.",
      "speaker": "narrator",
      "src": "/audio/units/u16/u16-05.mp3",
      "slow": "/audio/units/u16/u16-05-slow.mp3",
      "seconds": 5.3,
      "hash": "fafed25151329c10"
    },
    {
      "index": 5,
      "text": "El Valencia perdía uno a cero, pero en el último minuto marcó y todo el estadio se puso de pie.",
      "speaker": "narrator",
      "src": "/audio/units/u16/u16-06.mp3",
      "slow": "/audio/units/u16/u16-06-slow.mp3",
      "seconds": 7.99,
      "hash": "030ed09f233df94e"
    },
    {
      "index": 6,
      "text": "Mina habló.",
      "speaker": "narrator",
      "src": "/audio/units/u16/u16-07.mp3",
      "slow": "/audio/units/u16/u16-07-slow.mp3",
      "seconds": 1.26,
      "hash": "5621ee9347063cde"
    },
    {
      "index": 7,
      "text": "Mina hablaba.",
      "speaker": "narrator",
      "src": "/audio/units/u16/u16-08.mp3",
      "slow": "/audio/units/u16/u16-08-slow.mp3",
      "seconds": 1.49,
      "hash": "c7cc200eacdc7e48"
    }
  ],
  "17": [
    {
      "index": 0,
      "text": "Buenos días. Busco aceite de oliva para regalar.",
      "speaker": "kenta",
      "src": "/audio/units/u17/u17-01.mp3",
      "slow": "/audio/units/u17/u17-01-slow.mp3",
      "seconds": 4.94,
      "hash": "3489097073346588"
    },
    {
      "index": 1,
      "text": "Este aceite es muy bueno. ¿Lo quiere probar?",
      "speaker": "female-adult",
      "src": "/audio/units/u17/u17-02.mp3",
      "slow": "/audio/units/u17/u17-02-slow.mp3",
      "seconds": 2.67,
      "hash": "04f1d6dc66e90758"
    },
    {
      "index": 2,
      "text": "Me gusta mucho. Lo compro.",
      "speaker": "kenta",
      "src": "/audio/units/u17/u17-03.mp3",
      "slow": "/audio/units/u17/u17-03-slow.mp3",
      "seconds": 2.75,
      "hash": "575408c71e70494b"
    },
    {
      "index": 3,
      "text": "¿Se lo envuelvo?",
      "speaker": "female-adult",
      "src": "/audio/units/u17/u17-04.mp3",
      "slow": "/audio/units/u17/u17-04-slow.mp3",
      "seconds": 0.83,
      "hash": "69abeb1e3284d522"
    },
    {
      "index": 4,
      "text": "Sí, por favor. Se lo voy a regalar a mi jefe.",
      "speaker": "kenta",
      "src": "/audio/units/u17/u17-05.mp3",
      "slow": "/audio/units/u17/u17-05-slow.mp3",
      "seconds": 4.04,
      "hash": "e21a8d89b06772a1"
    },
    {
      "index": 5,
      "text": "regalárselo",
      "speaker": "narrator",
      "src": "/audio/units/u17/u17-06.mp3",
      "slow": "/audio/units/u17/u17-06-slow.mp3",
      "seconds": 2.04,
      "hash": "7cd8cdf49093d57f"
    }
  ],
  "18": [
    {
      "index": 0,
      "text": "Madrid es más grande que Barcelona.",
      "speaker": "narrator",
      "src": "/audio/units/u18/u18-01.mp3",
      "slow": "/audio/units/u18/u18-01-slow.mp3",
      "seconds": 3.34,
      "hash": "4d1dcb0603e08a4f"
    },
    {
      "index": 1,
      "text": "Este hotel es menos caro que el otro.",
      "speaker": "narrator",
      "src": "/audio/units/u18/u18-02.mp3",
      "slow": "/audio/units/u18/u18-02-slow.mp3",
      "seconds": 3.76,
      "hash": "3cfddc64c27390aa"
    },
    {
      "index": 2,
      "text": "Valencia es tan bonita como Sevilla.",
      "speaker": "narrator",
      "src": "/audio/units/u18/u18-03.mp3",
      "slow": "/audio/units/u18/u18-03-slow.mp3",
      "seconds": 4.06,
      "hash": "813332bdd625dd1b"
    },
    {
      "index": 3,
      "text": "Es el hotel más tranquilo de la zona.",
      "speaker": "narrator",
      "src": "/audio/units/u18/u18-04.mp3",
      "slow": "/audio/units/u18/u18-04-slow.mp3",
      "seconds": 3.13,
      "hash": "ceb95fe214267171"
    },
    {
      "index": 4,
      "text": "La paella está buenísima.",
      "speaker": "narrator",
      "src": "/audio/units/u18/u18-05.mp3",
      "slow": "/audio/units/u18/u18-05-slow.mp3",
      "seconds": 2.87,
      "hash": "6a4142f25ef602da"
    },
    {
      "index": 5,
      "text": "Barcelona tiene playa y Madrid no.",
      "speaker": "narrator",
      "src": "/audio/units/u18/u18-06.mp3",
      "slow": "/audio/units/u18/u18-06-slow.mp3",
      "seconds": 4.2,
      "hash": "0606c6a7fb1534fd"
    }
  ],
  "19": [
    {
      "index": 0,
      "text": "Perdone, ¿cómo voy a la catedral?",
      "speaker": "mina",
      "src": "/audio/units/u19/u19-01.mp3",
      "slow": "/audio/units/u19/u19-01-slow.mp3",
      "seconds": 4.44,
      "hash": "975ecaf253ce9dc9"
    },
    {
      "index": 1,
      "text": "Siga todo recto y gire a la derecha en el semáforo.",
      "speaker": "female-senior",
      "src": "/audio/units/u19/u19-02.mp3",
      "slow": "/audio/units/u19/u19-02-slow.mp3",
      "seconds": 4.68,
      "hash": "96d251f563cae9a0"
    },
    {
      "index": 2,
      "text": "Pasen, por favor. Pónganse el casco.",
      "speaker": "narrator",
      "src": "/audio/units/u19/u19-03.mp3",
      "slow": "/audio/units/u19/u19-03-slow.mp3",
      "seconds": 3.38,
      "hash": "8133340ea2a4b620"
    },
    {
      "index": 3,
      "text": "No toquen las máquinas.",
      "speaker": "narrator",
      "src": "/audio/units/u19/u19-04.mp3",
      "slow": "/audio/units/u19/u19-04-slow.mp3",
      "seconds": 1.91,
      "hash": "353c5f8453adfd5b"
    },
    {
      "index": 4,
      "text": "Pon el aceite en la paellera. No muevas el arroz.",
      "speaker": "narrator",
      "src": "/audio/units/u19/u19-05.mp3",
      "slow": "/audio/units/u19/u19-05-slow.mp3",
      "seconds": 4.25,
      "hash": "2994dd02405bcec3"
    },
    {
      "index": 5,
      "text": "dímelo",
      "speaker": "narrator",
      "src": "/audio/units/u19/u19-06.mp3",
      "slow": "/audio/units/u19/u19-06-slow.mp3",
      "seconds": 0.74,
      "hash": "864e8b6e9b7b0c95"
    }
  ],
  "20": [
    {
      "index": 0,
      "text": "El año que viene iré a Sevilla.",
      "speaker": "narrator",
      "src": "/audio/units/u20/u20-01.mp3",
      "slow": "/audio/units/u20/u20-01-slow.mp3",
      "seconds": 2.9,
      "hash": "d348496ccaa595e4"
    },
    {
      "index": 1,
      "text": "Dentro de dos meses, Kenta volverá a Valencia.",
      "speaker": "narrator",
      "src": "/audio/units/u20/u20-02.mp3",
      "slow": "/audio/units/u20/u20-02-slow.mp3",
      "seconds": 4.51,
      "hash": "b02aac3d5fc684e5"
    },
    {
      "index": 2,
      "text": "Mañana hará sol y no lloverá.",
      "speaker": "narrator",
      "src": "/audio/units/u20/u20-03.mp3",
      "slow": "/audio/units/u20/u20-03-slow.mp3",
      "seconds": 3.01,
      "hash": "0b60246afe8d8f52"
    },
    {
      "index": 3,
      "text": "¿Dónde está Daniel? Estará en la oficina.",
      "speaker": "narrator",
      "src": "/audio/units/u20/u20-04.mp3",
      "slow": "/audio/units/u20/u20-04-slow.mp3",
      "seconds": 3.99,
      "hash": "664f87aa4e4e30e5"
    },
    {
      "index": 4,
      "text": "¿Qué hora es? Serán las diez.",
      "speaker": "narrator",
      "src": "/audio/units/u20/u20-05.mp3",
      "slow": "/audio/units/u20/u20-05-slow.mp3",
      "seconds": 2.75,
      "hash": "08c3ee932a3d6908"
    },
    {
      "index": 5,
      "text": "haré, harás, hará",
      "speaker": "narrator",
      "src": "/audio/units/u20/u20-06.mp3",
      "slow": "/audio/units/u20/u20-06-slow.mp3",
      "seconds": 3.4,
      "hash": "0995b24457788c66"
    }
  ],
  "21": [
    {
      "index": 0,
      "text": "Buenas noches. Me gustaría reservar una mesa para dos.",
      "speaker": "kenta",
      "src": "/audio/units/u21/u21-01.mp3",
      "slow": "/audio/units/u21/u21-01-slow.mp3",
      "seconds": 5.59,
      "hash": "9af84a76c1dda25a"
    },
    {
      "index": 1,
      "text": "¿Podría traerme la carta, por favor?",
      "speaker": "narrator",
      "src": "/audio/units/u21/u21-02.mp3",
      "slow": "/audio/units/u21/u21-02-slow.mp3",
      "seconds": 3.25,
      "hash": "d82c1398829b387b"
    },
    {
      "index": 2,
      "text": "¿Qué vino me recomendaría?",
      "speaker": "kenta",
      "src": "/audio/units/u21/u21-03.mp3",
      "slow": "/audio/units/u21/u21-03-slow.mp3",
      "seconds": 2.72,
      "hash": "23619ba6777a6a13"
    },
    {
      "index": 3,
      "text": "Yo que tú, probaría este vino de Rioja.",
      "speaker": "narrator",
      "src": "/audio/units/u21/u21-04.mp3",
      "slow": "/audio/units/u21/u21-04-slow.mp3",
      "seconds": 3.88,
      "hash": "1984970268b13f23"
    },
    {
      "index": 4,
      "text": "Me encantaría vivir en España.",
      "speaker": "narrator",
      "src": "/audio/units/u21/u21-05.mp3",
      "slow": "/audio/units/u21/u21-05-slow.mp3",
      "seconds": 2.71,
      "hash": "06171ff5bf3e5bb1"
    },
    {
      "index": 5,
      "text": "podría, podríamos",
      "speaker": "narrator",
      "src": "/audio/units/u21/u21-06.mp3",
      "slow": "/audio/units/u21/u21-06-slow.mp3",
      "seconds": 3.08,
      "hash": "170fcd09319708c6"
    }
  ],
  "22": [
    {
      "index": 0,
      "text": "Tengo que terminar el informe hoy.",
      "speaker": "narrator",
      "src": "/audio/units/u22/u22-01.mp3",
      "slow": "/audio/units/u22/u22-01-slow.mp3",
      "seconds": 3.11,
      "hash": "04842517e13a9b72"
    },
    {
      "index": 1,
      "text": "Hay que practicar todos los días.",
      "speaker": "narrator",
      "src": "/audio/units/u22/u22-02.mp3",
      "slow": "/audio/units/u22/u22-02-slow.mp3",
      "seconds": 3.02,
      "hash": "680b52a9e37a63f4"
    },
    {
      "index": 2,
      "text": "Acabo de llegar a Valencia.",
      "speaker": "narrator",
      "src": "/audio/units/u22/u22-03.mp3",
      "slow": "/audio/units/u22/u22-03-slow.mp3",
      "seconds": 2.05,
      "hash": "c1739a44db2d3368"
    },
    {
      "index": 3,
      "text": "Hace siete años que trabajo con esta empresa.",
      "speaker": "narrator",
      "src": "/audio/units/u22/u22-04.mp3",
      "slow": "/audio/units/u22/u22-04-slow.mp3",
      "seconds": 3.75,
      "hash": "6889a67629982892"
    },
    {
      "index": 4,
      "text": "Llevo dos años estudiando español.",
      "speaker": "narrator",
      "src": "/audio/units/u22/u22-05.mp3",
      "slow": "/audio/units/u22/u22-05-slow.mp3",
      "seconds": 3.19,
      "hash": "9f0dd005f33f5b0b"
    },
    {
      "index": 5,
      "text": "El Real Madrid existe desde 1902.",
      "speaker": "narrator",
      "src": "/audio/units/u22/u22-06.mp3",
      "slow": "/audio/units/u22/u22-06-slow.mp3",
      "seconds": 4.31,
      "hash": "6274c13645284102"
    }
  ]
}
