      </div>
    </div>
  </section>

  <!-- SECCIÓN: コミュニティへの参加 -->
  <section class="py-16 px-4 bg-canvas">
    <div class="max-w-4xl mx-auto text-center">
      <p class="text-muted leading-relaxed max-w-2xl mx-auto">
