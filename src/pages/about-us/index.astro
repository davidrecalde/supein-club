      <h2 class="font-serif text-3xl font-bold text-navy mb-12">団体概要</h2>
      <dl class="key-facts-list">
        {keyFacts.map(({ label, value, isLink, links }) => (
          <div class="key-facts-row">
            <dt>{label}</dt>
            <dd>
              {links ? (
                <span>
                  {links.map((l, i) => (
                    <>
                      <a href={l.url} target="_blank" rel="noopener noreferrer nofollow">{l.label}</a>
                      {i < links.length - 1 && ' / '}
                    </>
                  ))}
                </span>
              ) : isLink ? (
                <a href={value} target="_blank" rel="noopener noreferrer">{value}</a>
              ) : (
                value
              )}
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

