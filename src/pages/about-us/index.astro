---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SEO from '../../components/SEO.astro';
import LineBanner from '../../components/LineBanner.astro';
import { Users, Lightbulb, Link2, Leaf, Type, Circle, Palette } from 'lucide-astro';

const allAuthors = await getCollection('authors', ({ data }) => data.active !== false);
const featuredAuthors = allAuthors
  .filter((a) => a.data.featured)
  .sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999));
function teamSlug(a: typeof allAuthors[number]) {
  return a.data.slug ?? a.id.replace(/\.(md|mdx)$/, '');
}

const breadcrumbs = [
  { name: 'ホーム', url: '/' },
  { name: 'スペイン倶楽部について', url: '/about-us/' },
];

const missionValues = [
  { Icon: Users, title: '文化交流', text: 'お互いの文化への理解を深め、スペインと日本の絆を育てます。' },
  { Icon: Lightbulb, title: 'アイデアで社会を動かす', text: 'コミュニティに役立つ質の高いコンテンツと体験を届けます。' },
  { Icon: Link2, title: 'つなぐ', text: 'スペイン語話者と日本人の交流の機会を創り出します。' },
  { Icon: Leaf, title: '持続可能な取り組み', text: 'すべての活動において環境と社会への配慮を大切にします。' },
];

const coreValues = [
  { title: 'オープン', text: '国籍・言語・バックグラウンドを問わず、誰でも歓迎します。' },
  { title: '本物志向', text: 'スペインの文化・食・言語を、現地の視点から正確に伝えます。' },
  { title: 'コミュニティファースト', text: 'メンバー一人ひとりの体験が、私たちの活動の中心です。' },
];

const whatWeDo = [
  { title: 'コミュニティ活動', text: '創設以来、文化交流イベント、スペイン料理を通じたガストロノミー企画、商業連携など、多岐にわたる活動を東京を拠点に展開してきました。' },
  { title: '公的機関・企業との連携', text: 'セルバンテス文化センター東京（Instituto Cervantes de Tokio）、在日スペイン大使館、ICEX（スペイン貿易投資庁）、Jリーグ、ラ・リーガ、NHKをはじめとする公的機関・企業と連携し、日本とスペインの文化交流を推進してきました。' },
  { title: 'メディア運営（supein.club）', text: 'これらの活動を基盤に、日本語メディア「supein.club」を運営し、スペインの旅行・料理・語学・生活・文化・サッカーに関する情報を、現地の視点と実体験に基づいて発信しています。' },
];

const differentiators = [
  { title: '公的機関からも信頼されるネットワーク', text: 'セルバンテス文化センター東京、在日スペイン大使館、ICEXなど、日本とスペインを結ぶ公的機関との連携実績を有しています。' },
  { title: 'コミュニティを基盤としたメディア運営', text: '一般的な旅行・カルチャーメディアとは異なり、発信する情報は実際のコミュニティ活動および公的機関・企業との連携を通じて得た知見に基づいています。' },
  { title: '語学・文化・食・スポーツを横断する活動領域', text: '特定の分野に限定せず、スペインの多面的な魅力をコミュニティとメディアの両輪で伝えています。' },
  { title: '東京を拠点とした全国的な情報発信', text: '東京での活動を起点としながら、オンラインメディアを通じて日本全国、および海外の読者にも情報を届けています。' },
];

const audience = [
  'スペイン語を学んでいる、または学習を検討している日本人',
  '日本に在住する、または訪れるスペイン語話者',
  'スペイン旅行を計画している方',
  'スペインへの留学・移住を検討している方',
  'スペインの料理・文化・サッカーに関心を持つ方',
];

const keyFacts = [
  { label: '団体名', value: 'Club Español en Japón スペイン倶楽部' },
  { label: '運営メディア', value: 'supein.club' },
  { label: '設立', value: '2018年（東京）' },
  { label: '創設者', value: 'David Recalde' },
  { label: '拠点', value: '東京都' },
  { label: '活動内容', value: '文化交流イベントの企画・運営、日本語メディア「supein.club」の運営' },
  { label: '主な連携先', value: 'セルバンテス文化センター東京、在日スペイン大使館、ICEX、Jリーグ、ラ・リーガ、NHK 等' },
  { label: '公式サイト', value: 'https://supein.club', isLink: true },
  { label: '公式SNS', value: 'Instagram / Facebook / X（旧Twitter） / LINE', links: [
    { label: 'Instagram', url: 'https://www.instagram.com/supeinclub/' },
    { label: 'Facebook', url: 'https://www.facebook.com/supeinclub/' },
    { label: 'X', url: 'https://twitter.com/supeinclub' },
    { label: 'LINE', url: 'https://lin.ee/vx6jpud' },
  ] },
];

const faqItems = [
  { q: 'Club Español en Japón スペイン倶楽部とは何ですか？', a: '2018年に東京で創設された、日本とスペインの文化交流団体です。文化交流イベントの企画・運営と、日本語メディア「supein.club」の運営を行っています。' },
  { q: 'supein.clubは誰が運営していますか？', a: 'Club Español en Japón スペイン倶楽部が運営する日本語メディアです。コミュニティでの活動や公的機関・企業との連携を通じて得た知見をもとに、記事を制作しています。' },
  { q: 'スペイン倶楽部のコミュニティに参加するにはどうすればよいですか？', a: '公式LINEにご登録いただくことで、東京での活動やコミュニティに関する最新情報を受け取ることができます。' },
  { q: 'supein.clubの記事はどのような体制で制作されていますか？', a: '編集チームが、現地取材・実体験・公的機関との連携を通じて得た知見に基づいて記事を制作しています。詳しくは「チームメンバー」ページをご覧ください。' },
  { q: 'スペイン倶楽部はいつ、どのような経緯で設立されましたか？', a: '2018年、東京に集まったスペイン語話者の交流から生まれました。詳しい経緯は本ページの「はじまりの物語」をご覧ください。' },
  { q: '活動拠点は東京のみですか？', a: 'リアルなイベントは東京を拠点に開催していますが、supein.clubを通じて日本全国、および海外の読者にも情報を届けています。' },
];

const timeline = [
  { year: '2016', text: '日本で出会った仲間たち。スペイン語を話す友人たちが東京に集まり、自然とコミュニティが生まれ始めました。' },
  { year: '2018', text: 'Club Español en Japón スペイン倶楽部を正式に創設。文化と料理への情熱から、イベントや活動を本格的にスタートしました。' },
  { year: '2019', text: '創設1年で46のイベントを開催。年末には日本とスペインで1,400名以上のメンバーが集まるコミュニティに成長しました。' },
  { year: '2020', text: '東京でのイベント活動を継続。クラブ2周年を仲間たちと祝いました。' },
  { year: '2022', text: 'パエリア・タパスフェスティバルをはじめ、レアル・マドリード財団との協力など、活動の幅をさらに広げました。' },
  { year: '2026', text: 'スペインに関する日本語ポータルサイト supein.club をリニューアル。コンテンツを通じて、より多くの日本人にスペインの魅力を届けます。' },
];

const tocHeadings = [
  { depth: 2, slug: 'what-is', text: 'スペイン倶楽部とは？' },
  { depth: 2, slug: 'what-we-do', text: '私たちについて' },
  { depth: 2, slug: 'mission', text: '私たちのミッション' },
  { depth: 2, slug: 'values', text: '大切にしていること' },
  { depth: 2, slug: 'features', text: 'スペイン倶楽部の特徴' },
  { depth: 2, slug: 'audience', text: '対象読者・参加者' },
  { depth: 2, slug: 'story', text: 'はじまりの物語' },
  { depth: 2, slug: 'logo', text: 'ロゴの由来' },
  { depth: 2, slug: 'key-facts', text: '団体概要' },
  { depth: 2, slug: 'faq', text: 'よくある質問' },
];

const aboutPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: 'スペイン倶楽部について | supein.club',
  url: 'https://supein.club/about-us/',
  description: 'Club Español en Japón スペイン倶楽部のミッション・活動・歴史について。',
  mainEntity: { '@id': 'https://supein.club/#organization' },
};

const faqPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<BaseLayout>
  <SEO
    slot="seo"
    title="スペイン倶楽部について｜Club Español en Japón"
    description="Club Español en Japón スペイン倶楽部は、2018年に東京で創設された日本とスペインの文化交流団体です。セルバンテス文化センター東京、在日スペイン大使館、ICEXなど公的機関・企業と連携しながら、文化交流イベントの開催と日本語メディアsupein.clubの運営を行っています。"
    canonical="https://supein.club/about-us/"
    breadcrumbs={breadcrumbs}
  />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(aboutPageSchema)} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(faqPageSchema)} />

  <!-- HERO -->
  <section class="bg-navy text-white py-20 px-4">
    <div class="max-w-4xl mx-auto">
      <p class="text-primary text-base font-semibold uppercase tracking-widest mb-4">スペイン倶楽部について</p>
      <h1 class="font-serif text-3xl md:text-5xl font-bold mb-6 leading-tight">
        日本とスペインをつなぐ、<br />東京発の文化交流団体。
      </h1>
      <p class="text-white/75 text-lg leading-relaxed max-w-2xl mb-12">
        2018年の創設以来、私たちはヒスパニックと日本のコミュニティの架け橋として、語学・文化・食・スポーツを通じた交流を続けています。
      </p>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
        {[
          { value: '2018年', label: '創設' },
          { value: '1,786+', label: 'メンバー' },
          { value: '東京', label: '拠点' },
          { value: '46+', label: 'イベント/年' },
        ].map(({ value, label }) => (
          <div class="border border-white/15 rounded-xl p-4 text-center">
            <p class="text-white font-bold text-2xl mb-1">{value}</p>
            <p class="text-white/50 text-xs uppercase tracking-wider">{label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- TOC mobile (accordion) — global CSS lo oculta en desktop -->
  <div class="max-w-4xl mx-auto px-4 pt-10">
    <details class="toc-mobile-inline">
      <summary>
        <span>目次</span>
        <span class="tmi-chevron" aria-hidden="true">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
      </summary>
      <ol class="tmi-list">
        {tocHeadings.map((h, i) => (
          <li>
            <a href={'#' + h.slug}>
              <span class="tmi-num">{i + 1}.</span>
              {h.text}
            </a>
          </li>
        ))}
      </ol>
    </details>
  </div>

  <!-- SECCIÓN 0: スペイン倶楽部とは？（respuesta directa a la query de marca） -->
  <section id="what-is" class="py-20 px-4 bg-canvas">
    <div class="max-w-4xl mx-auto">
      <p class="text-primary text-base font-semibold uppercase tracking-widest mb-2">スペイン倶楽部とは</p>
      <h2 class="font-serif text-3xl font-bold text-navy mb-6">スペイン倶楽部とは？</h2>
      <p class="text-muted leading-relaxed max-w-2xl">
        <strong>スペイン倶楽部（Club Español en Japón）</strong>は、2018年に東京で創設された、日本に住むスペイン語話者と日本人をつなぐコミュニティです。現在1,786名以上のメンバーが参加する日本最大級のスペインコミュニティとして、語学・文化交流・料理・スポーツなど幅広い活動を行っています。本サイト supein.club は、その活動から生まれた、日本語でスペインの旅行・料理・語学・生活・文化・サッカー情報を発信するメディアです。
      </p>
    </div>
  </section>

  <!-- SECCIÓN 0.5: 私たちについて（活動内容・連携実績・メディア運営） -->
  <section id="what-we-do" class="py-20 px-4" style="background-color:#f8f8f6;">
    <div class="max-w-4xl mx-auto">
      <p class="text-primary text-base font-semibold uppercase tracking-widest mb-2">ABOUT US</p>
      <h2 class="font-serif text-3xl font-bold text-navy mb-6">私たちについて</h2>
      <p class="text-muted leading-relaxed mb-12 max-w-2xl">
        Club Español en Japón スペイン倶楽部は、2018年の創設以来、日本におけるスペイン文化普及の主要な担い手として活動を続けています。
      </p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {whatWeDo.map(({ title, text }) => (
          <div class="bg-white rounded-2xl border border-ink/5 p-6 shadow-sm">
            <h3 class="font-semibold text-navy mb-3 text-sm leading-snug">{title}</h3>
            <p class="text-muted text-sm leading-relaxed">{text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SECCIÓN 1: ミッション -->
  <section id="mission" class="py-20 px-4 bg-canvas">
    <div class="max-w-4xl mx-auto">
      <p class="text-primary text-base font-semibold uppercase tracking-widest mb-2">OUR MISSION</p>
      <h2 class="font-serif text-3xl font-bold text-navy mb-6">私たちのミッション</h2>
      <p class="text-muted leading-relaxed mb-12 max-w-2xl">
        Club Español en Japón スペイン倶楽部は、日本に住むスペイン語話者と、スペインに興味を持つ日本人をつなぐコミュニティです。語学・文化交流・料理・スポーツ・アウトドアなど、多彩な活動を通じて、両コミュニティの相互理解を深めることを目指しています。
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        {missionValues.map(({ Icon, title, text }) => (
          <div class="bg-white rounded-2xl border border-ink/5 p-6 shadow-sm">
            <Icon size={32} class="text-primary mb-3" />
            <h3 class="font-semibold text-navy mb-2">{title}</h3>
            <p class="text-muted text-sm leading-relaxed">{text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SECCIÓN 2: 価値観 -->
  <section id="values" class="py-20 px-4 bg-navy text-white">
    <div class="max-w-4xl mx-auto">
      <p class="text-primary text-base font-semibold uppercase tracking-widest mb-2">OUR VALUES</p>
      <h2 class="font-serif text-3xl font-bold mb-12">私たちが大切にしていること</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {coreValues.map(({ title, text }) => (
          <div>
            <h3 class="font-semibold text-white text-lg mb-3 pb-3 border-b border-white/15">{title}</h3>
            <p class="text-white/65 text-sm leading-relaxed">{text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SECCIÓN 3: 特徴 -->
  <section id="features" class="py-20 px-4 bg-canvas">
    <div class="max-w-4xl mx-auto">
      <p class="text-primary text-base font-semibold uppercase tracking-widest mb-2">HOW WE'RE DIFFERENT</p>
      <h2 class="font-serif text-3xl font-bold text-navy mb-6">スペイン倶楽部の特徴</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {differentiators.map(({ title, text }) => (
          <div class="bg-white rounded-2xl border border-ink/5 p-6 shadow-sm">
            <h3 class="font-semibold text-navy mb-3 text-sm leading-snug">{title}</h3>
            <p class="text-muted text-sm leading-relaxed">{text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SECCIÓN 3.5: 対象読者・参加者 -->
  <section id="audience" class="py-20 px-4 bg-navy text-white">
    <div class="max-w-4xl mx-auto">
      <p class="text-primary text-base font-semibold uppercase tracking-widest mb-2">WHO WE SERVE</p>
      <h2 class="font-serif text-3xl font-bold mb-12">対象読者・参加者</h2>
      <ul class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {audience.map((item) => (
          <li class="flex items-start gap-3 text-white/80 text-sm leading-relaxed">
            <span class="text-primary mt-1">●</span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- SECCIÓN 4: はじまりの物語 -->
  <section id="story" class="py-20 px-4" style="background-color:#f8f8f6;">
    <div class="max-w-4xl mx-auto">
      <p class="text-primary text-base font-semibold uppercase tracking-widest mb-2">OUR STORY</p>
      <h2 class="font-serif text-3xl font-bold text-navy mb-12">はじまりの物語</h2>
      <div class="relative">
        <div class="absolute left-6 top-0 bottom-0 w-px bg-ink/10 hidden md:block"></div>
        <div class="space-y-10">
          {timeline.map(({ year, text }) => (
            <div class="flex gap-4 md:gap-8 items-start">
              <div class="flex-shrink-0 flex flex-col items-center gap-2 w-10 md:w-12">
                <div class="w-3 h-3 rounded-full bg-primary hidden md:block mt-1"></div>
                <span class="font-bold text-primary text-sm">{year}</span>
              </div>
              <p class="text-muted leading-relaxed text-sm pt-0.5">{text}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- SECCIÓN 5: ロゴの由来 -->
  <section id="logo" class="bg-canvas" style="padding-top:80px;padding-bottom:80px;">
    <div class="logo-section-inner">
      <p class="text-primary font-semibold uppercase mb-4" style="font-size:11px;letter-spacing:0.12em;">OUR LOGO</p>
      <h2 class="font-sans font-bold text-navy mb-4 logo-heading">ロゴの由来</h2>
      <p class="text-muted mb-12 logo-subtitle">
        私たちのロゴには、スペインと日本、ふたつの国のアイデンティティが込められています。
      </p>
      <div class="logo-grid">
        <figure style="margin:0;">
          <img
            src="/branding-supeinclub.webp"
            alt="スペイン倶楽部ロゴの由来 — スペイン語のスペイン（España）と日本語の日本を組み合わせたロゴデザイン"
            width="600"
            height="300"
            loading="lazy"
            style="width:100%;height:auto;border-radius:12px;box-shadow:0 4px 24px rgba(0,0,0,0.08);"
          />
        </figure>
        <div>
          <div class="logo-block">
            <div class="logo-icon">
              <Type size={20} />
            </div>
            <div>
              <h3 class="logo-block-title">スペイン（España）</h3>
              <p class="logo-block-text">「スペイン」は、日本語でスペインを意味する言葉です。カタカナで表記することで、日本語話者にとって親しみやすく、かつスペインらしさを表現しています。</p>
            </div>
          </div>
          <div class="logo-block">
            <div class="logo-icon logo-icon-red">
              <Circle size={20} />
            </div>
            <div>
              <h3 class="logo-block-title">日本の魂、日の丸</h3>
              <p class="logo-block-text">ロゴの「ペ」の文字の上に置かれた赤い点は、日本の国旗「日の丸」を象徴しています。スペイン語の「España」と日本語の「日本」——ふたつの国が、ひとつの文字の中でつながっています。</p>
            </div>
          </div>
          <div class="logo-block logo-block-last">
            <div class="logo-icon">
              <Palette size={20} />
            </div>
            <div>
              <h3 class="logo-block-title">ネイビーとレッド</h3>
              <p class="logo-block-text">ネイビーブルーはスペインの夜空と信頼を、レッドはスペインと日本、両国の国旗の色を表しています。このふたつの色が、私たちのアイデンティティの核心です。</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SECCIÓN 6: 団体概要（key facts — legible y rastreable por IA) -->
  <section id="key-facts" class="py-20 px-4 bg-canvas">
    <div class="max-w-4xl mx-auto">
