      </p>

      <div style="
        max-width:720px;margin:0 auto;
        display:flex;flex-direction:column;gap:12px;
      ">
        {rankings.map(r => (
          <a href={r.url}
             style="
               display:flex;align-items:center;
               gap:16px;
               background:white;
               border:1px solid #e5e7eb;
               border-radius:12px;
               padding:18px 22px;
               text-decoration:none;
               transition:box-shadow 200ms,transform 200ms;
             "
             onmouseover="this.style.boxShadow='0 4px 16px rgba(0,33,71,0.08)';this.style.transform='translateY(-1px)'"
             onmouseout="this.style.boxShadow='';this.style.transform=''">
            <span style="
              font-family:'Work Sans',sans-serif;
              font-size:11px;font-weight:800;
              background:#002147;color:white;
              padding:4px 10px;border-radius:6px;
              flex-shrink:0;letter-spacing:0.05em;
            ">
              CRE
            </span>
            <div style="flex:1;min-width:0;">
              <p style="font-size:15px;font-weight:700;
                         color:#002147;margin:0 0 2px;
                         white-space:nowrap;overflow:hidden;
                         text-overflow:ellipsis;">
                {r.title}
              </p>
              <p style="font-size:12px;color:#9ca3af;margin:0;">
                {r.cityEs} · {r.count}件分析 · {r.date}
              </p>
            </div>
            <span style="color:#C8102E;font-size:18px;
                         flex-shrink:0;">›</span>
          </a>
        ))}
