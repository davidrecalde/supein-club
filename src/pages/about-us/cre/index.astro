---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SEO from '../../../components/SEO.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';

const breadcrumbs = [
  { name: 'ホーム', url: '/' },
  { name: 'スペイン倶楽部について', url: '/about-us/' },
  { name: 'CRE', url: '' },
];

const seoBreadcrumbs = [
  { name: 'ホーム', url: '/' },
  { name: 'スペイン倶楽部について', url: '/about-us/' },
];

const canonical = 'https://supein.club/about-us/cre/';

const dimensions = [
  {
    key: 'reputacion',
    label: '評判スコア',
    weight: '25%',
    icon: '⭐',
    desc: 'Googleユーザーの評価点（1〜5）を統計的に処理した加重スコア。単純平均ではなく、レビュー数と信頼性を考慮した独自の重み付けを適用。'
  },
  {
    key: 'volumen',
    label: 'レビュー数',
    weight: '20%',
    icon: '💬',
    desc: 'Googleに蓄積された総レビュー件数。件数が多いほど統計的信頼性が高く、より安定した評価とみなす。少ない件数での高評価は割引いて評価。'
  },
  {
    key: 'sentimiento',
    label: 'センチメント',
    weight: '20%',
    icon: '🧠',
    desc: 'レビューテキストの感情分析スコア。ポジティブ・ネガティブ・ニュートラルに分類し、レビューの「質」を数値化。星の数だけでは見えない体験の本質を捉える。'
  },
  {
    key: 'perfil_gmb',
    label: 'Googleプロフィール完成度',
    weight: '20%',
    icon: '📍',
    desc: 'Google ビジネスプロフィールの充実度。営業時間・写真・ウェブサイト・電話番号・説明文などの情報が揃っているほど高スコア。運営者の信頼性指標でもある。'
  },
  {
    key: 'visibilidad',
    label: 'オンライン可視性',
    weight: '15%',
    icon: '🌐',
    desc: 'Google検索・マップ上での露出度と被リンク状況。検索結果への表示頻度や知名度を反映。地域内での相対的な認知度を測定する。'
  },
];

const rankings = [
  {
    city: 'バルセロナ',
    cityEs: 'Barcelona',
    title: 'バルセロナ観光スポット人気ランキング TOP10',
    url: '/travel/spain-tours/spain-tour-1week/#cre-バルセロナ観光スポット人気ランキング-top10',
    count: 10,
    date: '2026-06-09',
  },
  {
    city: 'マドリード',
    cityEs: 'Madrid',
    title: 'マドリード観光スポット人気ランキング TOP10',
    url: '/travel/spain-tours/spain-tour-1week/#cre-マドリード観光スポット人気ランキング-top10',
    count: 10,
    date: '2026-06-10',
  },
  {
    city: 'グラナダ',
    cityEs: 'Granada',
    title: 'グラナダ観光スポット人気ランキング TOP10',
    url: '/travel/spain-tours/spain-tour-1week/#cre-グラナダ観光スポット人気ランキング-top10',
    count: 10,
    date: '2026-06-10',
  },
  {
    city: 'セビリア',
    cityEs: 'Sevilla',
    title: 'セビリア観光スポット人気ランキング TOP9',
    url: '/travel/spain-tours/spain-tour-1week/#cre-セビリア観光スポット人気ランキング-top9',
    count: 9,
    date: '2026-06-10',
  },
];

const creSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'CRE — Competitive Reputation Engine',
  alternateName: 'Competitive Reputation Engine by supein.club',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  url: canonical,
  description: 'supein.club独自開発の評判分析エンジン。Google Places APIデータを5次元（評判・レビュー数・センチメント・Googleプロフィール・可視性）で分析し、スペインの観光スポットのCRIスコアを算出する。',
  author: {
    '@type': 'Organization',
    name: 'Club Español en Japón スペイン倶楽部',
    url: 'https://supein.club',
    founder: {
      '@type': 'Person',
      name: 'David Recalde',
      url: 'https://supein.club/about-us/team/david-recalde/',
    },
  },
  creator: {
    '@type': 'Organization',
    name: 'Club Español en Japón スペイン倶楽部',
    url: 'https://supein.club',
  },
  dateCreated: '2026-01-01',
  dateModified: '2026-06-10',
  inLanguage: 'ja',
  featureList: [
    'Google Places APIデータ収集',
    'Google Maps レビューデータ分析',
    'Googleビジネスプロフィール完成度評価',
    'マルチソースデータ統合・正規化',
    '5次元CRIスコア算出',
    'センチメント分析（自然言語処理）',
    '観光スポット・語学学校・レストランランキング生成',
  ],
};
---

<BaseLayout>
  <SEO
    slot="seo"
    title="CRE — Competitive Reputation Engine | supein.club独自の評判分析ツール"
    description="supein.club独自開発のCRE（Competitive Reputation Engine）は、Googleレビュー・評価・センチメント・可視性を5次元で分析しスペイン観光スポットの信頼性スコアを算出します。"
    canonical={canonical}
    breadcrumbs={seoBreadcrumbs}
  />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(creSchema)} />

  <!-- HERO -->
  <section style="background:#002147;padding:72px 0 56px;">
    <div class="page-container">
      <Breadcrumb items={breadcrumbs} dark />
      <div style="display:flex;align-items:center;
                  gap:12px;margin:28px 0 16px;">
        <span style="
          font-family:'Work Sans',sans-serif;
          font-size:13px;font-weight:800;
          letter-spacing:0.12em;
          background:#C8102E;color:white;
          padding:4px 12px;border-radius:4px;
        ">CRE v8</span>
        <span style="font-size:12px;color:rgba(255,255,255,0.4);
                     letter-spacing:0.15em;text-transform:uppercase;">
          by supein.club
        </span>
      </div>
      <h1 style="
        font-family:'Noto Serif JP',serif;
        font-size:clamp(26px,4vw,42px);
        font-weight:700;color:white;
        margin:0 0 20px;line-height:1.3;
        max-width:740px;
      ">
        Competitive Reputation Engine<br>
        <span style="font-size:0.7em;color:rgba(255,255,255,0.7);">
          スペイン倶楽部 独自の評判分析エンジン
        </span>
      </h1>
      <p style="
        font-size:18px;color:rgba(255,255,255,0.7);
        max-width:620px;line-height:1.8;margin:0;
      ">
        Googleのデータを5つの次元で分析し、
        スペインの観光スポット・レストラン・体験の
        信頼性を独自スコア（CRI）で可視化するツールです。
      </p>
    </div>
  </section>

  <!-- QUÉ ES -->
  <section style="background:white;padding:80px 0;">
    <div class="page-container" style="max-width:800px;">
      <p style="font-size:11px;font-weight:600;
                letter-spacing:0.2em;text-transform:uppercase;
                color:#C8102E;margin:0 0 8px;">
        ABOUT CRE
      </p>
      <h2 style="font-family:'Noto Serif JP',serif;
                 font-size:clamp(22px,3vw,30px);
                 font-weight:700;color:#002147;
                 margin:0 0 28px;">
        CREとは何か
      </h2>
      <p style="font-size:17px;color:#374151;
                line-height:1.9;margin:0 0 20px;">
        <strong>CRE（Competitive Reputation Engine）</strong>は、
        スペイン倶楽部（supein.club）が独自に設計・開発した
        マルチソース評判分析エンジンです。
        単一の評価指標に依存するのではなく、
        複数のデータソースから独立して収集した情報を
        固有のアルゴリズムで統合・正規化することで、
        場所やビジネスの「本当の評判」を
        できる限り客観的に数値化します。
      </p>
      <p style="font-size:17px;color:#374151;
                line-height:1.9;margin:0 0 20px;">
        開発の出発点は、日本語でスペインの情報を探す読者が
        直面する課題でした——信頼できる情報源が分散しており、
        複数のプラットフォームの評価を自分で照合しなければ
        全体像が見えない。CREはその照合作業を自動化し、
        「どこで読んでもブレない客観的な品質指標」を
        提供するために作られました。
      </p>
      <p style="font-size:17px;color:#374151;
                line-height:1.9;margin:0;">
        算出される<strong>CRI（Competitive Reputation Index）</strong>は
        0〜100の正規化スコアです。スコアが高いほど、
        複数の独立したデータソースにわたって
        一貫して高い評価・信頼性・可視性が
        確認されていることを示します。
      </p>
    </div>
  </section>

  <!-- FUENTES MÚLTIPLES -->
  <section style="background:white;padding:80px 0;">
    <div class="page-container" style="max-width:860px;">

      <p style="font-size:11px;font-weight:600;
                letter-spacing:0.2em;text-transform:uppercase;
                color:#C8102E;margin:0 0 8px;">
        DATA SOURCES
      </p>
      <h2 style="font-family:'Noto Serif JP',serif;
                 font-size:clamp(22px,3vw,30px);
                 font-weight:700;color:#002147;
                 margin:0 0 16px;">
        複数のデータソースから収集・統合
      </h2>
      <p style="font-size:16px;color:#6b7280;
                max-width:640px;line-height:1.8;
                margin:0 0 40px;">
        CREの強みは、単一プラットフォームへの依存を避け、
        複数の独立したGoogleサービスから
        データを並行収集する点にあります。
        各ソースは異なる側面の「評判」を反映しており、
        組み合わせることで単体では見えない
        全体像が浮かび上がります。
      </p>

      <div style="
        display:grid;
        grid-template-columns:repeat(auto-fit,minmax(260px,1fr));
        gap:16px;
      ">
        {[
          {
            source: "Google Maps / Google Places API",
            icon: "📍",
            badge: "PRIMARY",
            badgeColor: "#002147",
            data: [
              "ユーザー評価点（1〜5星）",
              "総レビュー件数",
              "レビューテキスト（感情分析用）",
              "営業状態（OPERATIONAL / CLOSED）",
              "写真枚数・更新頻度",
            ],
            note: "CRIの評判・ボリューム・センチメント3次元の基盤となる最重要ソース。"
          },
          {
            source: "Google Business Profile（旧 Google My Business）",
            icon: "🏢",
            badge: "SECONDARY",
            badgeColor: "#374151",
            data: [
              "プロフィール情報の完成度",
              "営業時間の登録有無",
              "ウェブサイトURL登録有無",
              "電話番号登録有無",
              "説明文・カテゴリ設定",
            ],
            note: "ビジネスオーナーの情報管理への取り組みを評価。プロフィール完成度次元に反映。"
          },
          {
            source: "オンライン可視性シグナル",
            icon: "🌐",
            badge: "TERTIARY",
            badgeColor: "#6b7280",
            data: [
              "Google検索結果での表示頻度",
              "公式ウェブサイトの有無・応答状態",
              "地域内での相対的知名度",
              "外部からの言及・参照状況",
            ],
            note: "デジタル上での存在感と信頼性を測定。可視性次元に反映。"
          },
        ].map(s => (
          <div style="
            border:1px solid #e5e7eb;
            border-radius:14px;
            padding:22px 24px;
            background:#FAFAF8;
          ">
            <div style="display:flex;align-items:center;
                        gap:10px;margin-bottom:14px;">
              <span style="font-size:20px;">{s.icon}</span>
              <span style={`
                font-size:10px;font-weight:800;
                letter-spacing:0.1em;
                background:${s.badgeColor};
                color:white;padding:2px 8px;
                border-radius:4px;
                font-family:'Work Sans',sans-serif;
              `}>{s.badge}</span>
            </div>
            <p style="font-size:13px;font-weight:700;
                       color:#002147;margin:0 0 12px;
                       line-height:1.4;">
              {s.source}
            </p>
            <ul style="margin:0 0 12px;padding-left:16px;">
              {s.data.map(d => (
                <li style="font-size:13px;color:#6b7280;
                            line-height:1.7;margin-bottom:2px;">
                  {d}
                </li>
              ))}
            </ul>
            <p style="font-size:12px;color:#9ca3af;
                       margin:0;line-height:1.6;
                       border-top:1px solid #e5e7eb;
                       padding-top:10px;">
              {s.note}
            </p>
          </div>
        ))}
      </div>

      <!-- Diagrama de flujo del proceso -->
      <div style="
        margin-top:40px;
        background:#002147;
        border-radius:16px;
        padding:28px 32px;
        color:white;
      ">
        <p style="font-size:11px;font-weight:600;
                  letter-spacing:0.2em;text-transform:uppercase;
                  color:#C8102E;margin:0 0 16px;">
          PROCESSING PIPELINE
        </p>
        <p style="font-size:14px;font-weight:700;
                  color:white;margin:0 0 20px;">
          CRIスコア算出のデータフロー
        </p>
        <div style="
          display:flex;align-items:center;
          flex-wrap:wrap;gap:8px;
          font-size:13px;
        ">
          {[
            "① マルチソース収集",
            "② データクレンジング",
            "③ 正規化（0〜100）",
            "④ 次元別スコア算出",
            "⑤ 重み付け合算",
            "⑥ CRIスコア出力",
          ].map((step, i) => (
            <>
              <span style="
                background:rgba(255,255,255,0.1);
                border:1px solid rgba(255,255,255,0.15);
                padding:6px 14px;border-radius:20px;
                color:rgba(255,255,255,0.9);
                white-space:nowrap;
              ">
                {step}
              </span>
              {i < 5 && (
                <span style="color:#C8102E;font-size:16px;
                             font-weight:700;">›</span>
              )}
            </>
          ))}
        </div>
        <p style="font-size:12px;color:rgba(255,255,255,0.4);
                  margin:16px 0 0;line-height:1.6;">
          各ステップは自動化されており、分析日時点の
          最新データを反映します。
          データ収集から出力まで人手によるスコア操作は
          一切行っていません。
        </p>
      </div>

    </div>
  </section>

  <!-- 5 DIMENSIONES -->
  <section style="background:#FAFAF8;padding:80px 0;">
    <div class="page-container">
      <p style="font-size:11px;font-weight:600;
                letter-spacing:0.2em;text-transform:uppercase;
                color:#C8102E;margin:0 0 8px;text-align:center;">
        METHODOLOGY
      </p>
      <h2 style="font-family:'Noto Serif JP',serif;
                 font-size:clamp(22px,3vw,30px);
                 font-weight:700;color:#002147;
                 margin:0 0 12px;text-align:center;">
        CRIスコアを構成する5つの次元
      </h2>
      <p style="font-size:16px;color:#6b7280;
                text-align:center;max-width:560px;
                margin:0 auto 48px;line-height:1.7;">
        CRIスコアは以下の5つの指標を独自の重み付けで
        合算して算出します。
      </p>

      <div style="
        display:grid;
        grid-template-columns:repeat(auto-fit,minmax(300px,1fr));
        gap:20px;max-width:1000px;margin:0 auto;
      ">
        {dimensions.map(dim => (
          <div style="
            background:white;
            border:1px solid #e5e7eb;
            border-radius:14px;
            padding:24px;
          ">
            <div style="display:flex;align-items:center;
                        gap:12px;margin-bottom:14px;">
              <span style="font-size:24px;">{dim.icon}</span>
              <div>
                <div style="font-size:15px;font-weight:700;
                            color:#002147;">{dim.label}</div>
                <div style="
                  font-size:12px;font-weight:700;
                  color:white;background:#002147;
                  padding:1px 8px;border-radius:20px;
                  display:inline-block;margin-top:2px;
                  font-family:'Work Sans',sans-serif;
                ">
                  重み {dim.weight}
                </div>
              </div>
            </div>
            <p style="font-size:14px;color:#6b7280;
                      line-height:1.7;margin:0;">
              {dim.desc}
            </p>
          </div>
        ))}
      </div>

      <!-- Fórmula visual -->
      <div style="
        max-width:700px;margin:48px auto 0;
        background:white;border:1px solid #e5e7eb;
        border-radius:14px;padding:28px 32px;
        text-align:center;
      ">
        <p style="font-size:12px;font-weight:600;
                  letter-spacing:0.15em;text-transform:uppercase;
                  color:#9ca3af;margin:0 0 16px;">
          CRI スコア算出式
        </p>
        <p style="
          font-family:'Work Sans',sans-serif;
          font-size:14px;color:#374151;
          line-height:2;margin:0;
        ">
          CRI = 評判(25%) + レビュー数(20%) + センチメント(20%)<br>
          + Googleプロフィール(20%) + 可視性(15%)
        </p>
        <p style="font-size:12px;color:#9ca3af;margin:16px 0 0;">
          各次元は0〜100で正規化後、重み付け合算。
          最終スコアは0〜100の範囲で表示。
        </p>
      </div>
    </div>
  </section>

  <!-- FUENTE DE DATOS -->
  <section style="background:white;padding:80px 0;">
    <div class="page-container" style="max-width:800px;">
      <p style="font-size:11px;font-weight:600;
                letter-spacing:0.2em;text-transform:uppercase;
                color:#C8102E;margin:0 0 8px;">
        DATA SOURCE
      </p>
      <h2 style="font-family:'Noto Serif JP',serif;
                 font-size:clamp(22px,3vw,30px);
                 font-weight:700;color:#002147;
                 margin:0 0 28px;">
        データの出所と分析方法
      </h2>

      <div style="display:flex;flex-direction:column;gap:20px;">
        {[
          {
            icon: '📡',
            title: 'データソース',
            text: 'Google Places API・Google Maps・Googleビジネスプロフィール（旧Google My Business）の3つの独立したGoogleサービスからデータを並行収集します。各サービスが提供する異なる側面の情報を統合することで、単一ソースでは得られない多角的な評価が可能になります。'
          },
          {
            icon: '🔄',
            title: '分析タイミング',
            text: '各ランキングページに表示されている「分析日」時点のデータを使用しています。Googleのデータは変動するため、スコアは定期的に更新します。最新スコアと異なる場合があります。'
          },
          {
            icon: '🎯',
            title: '対象の選定基準',
            text: '各都市・カテゴリで「OPERATIONAL（営業中）」のビジネスのうち、一定数以上のレビューを持つ施設を対象とします。新規オープンで件数が少ない施設は対象外になる場合があります。'
          },
          {
            icon: '🤖',
            title: 'センチメント分析',
            text: 'レビューテキストに対して感情分析アルゴリズムを適用し、ポジティブ・ネガティブ・ニュートラルに分類します。テキストが少ない場合は評価点を参考値として使用します。'
          },
          {
            icon: '⚖️',
            title: '中立性について',
            text: 'supein.clubはいかなるビジネスとも広告・スポンサー契約を結んでいません。CREランキングはデータのみに基づいており、金銭的対価による順位操作は一切行っていません。'
          },
        ].map(item => (
          <div style="
            display:flex;gap:16px;align-items:flex-start;
            padding:20px 24px;
            border:1px solid #e5e7eb;border-radius:12px;
            background:#FAFAF8;
          ">
            <span style="font-size:22px;flex-shrink:0;
                         margin-top:2px;">{item.icon}</span>
            <div>
              <p style="font-size:15px;font-weight:700;
                         color:#002147;margin:0 0 6px;">
                {item.title}
              </p>
              <p style="font-size:14px;color:#6b7280;
                         margin:0;line-height:1.7;">
                {item.text}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- PARA QUÉ SIRVE -->
  <section style="background:#002147;padding:80px 0;">
    <div class="page-container" style="max-width:800px;">
      <p style="font-size:11px;font-weight:600;
                letter-spacing:0.2em;text-transform:uppercase;
                color:#C8102E;margin:0 0 8px;text-align:center;">
        VALUE
      </p>
      <h2 style="font-family:'Noto Serif JP',serif;
                 font-size:clamp(22px,3vw,30px);
                 font-weight:700;color:white;
                 margin:0 0 16px;text-align:center;">
        CREがコミュニティに提供する価値
      </h2>
      <p style="font-size:16px;color:rgba(255,255,255,0.65);
