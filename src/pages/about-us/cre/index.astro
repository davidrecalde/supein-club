---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SEO from '../../../components/SEO.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import TOC from '../../../components/TOC.astro';

const breadcrumbs = [
  { name: 'ホーム', url: '/' },
  { name: 'スペイン倶楽部について', url: '/about-us/' },
  { name: 'CRE', url: '' },
];

const seoBreadcrumbs = [
  { name: 'ホーム', url: '/' },
  { name: 'スペイン倶楽部について', url: '/about-us/' },
];

const canonical = 'https://supein.club/about-us/cre/';

const tocHeadings = [
  { depth: 2, slug: 'que-es-cre', text: 'CREとは何か' },
  { depth: 2, slug: 'infografia', text: '仕組みの図解' },
  { depth: 2, slug: 'fuentes-datos', text: '複数のデータソース' },
  { depth: 2, slug: 'dimensiones', text: '5つの次元とスコア算出' },
  { depth: 2, slug: 'metodologia', text: 'データの出所と分析方法' },
  { depth: 2, slug: 'valor', text: 'コミュニティへの提供価値' },
  { depth: 2, slug: 'rankings', text: '公開済みCREランキング' },
];

const dimensions = [
  {
    key: 'reputacion',
    label: '評判スコア',
    weight: '25%',
    icon: '⭐',
    desc: 'Googleユーザーの評価点（1〜5）を統計的に処理した加重スコア。単純平均ではなく、レビュー数と信頼性を考慮した独自の重み付けを適用。'
  },
  {
    key: 'volumen',
    label: 'レビュー数',
    weight: '20%',
    icon: '💬',
    desc: 'Googleに蓄積された総レビュー件数。件数が多いほど統計的信頼性が高く、より安定した評価とみなす。少ない件数での高評価は割引いて評価。'
  },
  {
    key: 'sentimiento',
    label: 'センチメント',
    weight: '20%',
    icon: '🧠',
    desc: 'レビューテキストの感情分析スコア。ポジティブ・ネガティブ・ニュートラルに分類し、レビューの「質」を数値化。星の数だけでは見えない体験の本質を捉える。'
  },
  {
    key: 'perfil_gmb',
    label: 'Googleプロフィール完成度',
    weight: '20%',
    icon: '📍',
    desc: 'Google ビジネスプロフィールの充実度。営業時間・写真・ウェブサイト・電話番号・説明文などの情報が揃っているほど高スコア。運営者の信頼性指標でもある。'
  },
  {
    key: 'visibilidad',
    label: 'オンライン可視性',
    weight: '15%',
    icon: '🌐',
    desc: 'Google検索・マップ上での露出度と被リンク状況。検索結果への表示頻度や知名度を反映。地域内での相対的な認知度を測定する。'
  },
];

const rankings = [
  {
    city: 'バルセロナ',
    cityEs: 'Barcelona',
    title: 'バルセロナ観光スポット人気ランキング TOP10',
    url: '/travel/spain-tours/spain-tour-1week/#cre-バルセロナ観光スポット人気ランキング-top10',
    count: 10,
    date: '2026-06-09',
  },
  {
    city: 'マドリード',
    cityEs: 'Madrid',
    title: 'マドリード観光スポット人気ランキング TOP10',
    url: '/travel/spain-tours/spain-tour-1week/#cre-マドリード観光スポット人気ランキング-top10',
    count: 10,
    date: '2026-06-10',
  },
  {
    city: 'グラナダ',
    cityEs: 'Granada',
    title: 'グラナダ観光スポット人気ランキング TOP10',
    url: '/travel/spain-tours/spain-tour-1week/#cre-グラナダ観光スポット人気ランキング-top10',
    count: 10,
    date: '2026-06-10',
  },
  {
    city: 'セビリア',
    cityEs: 'Sevilla',
    title: 'セビリア観光スポット人気ランキング TOP9',
    url: '/travel/spain-tours/spain-tour-1week/#cre-セビリア観光スポット人気ランキング-top9',
    count: 9,
    date: '2026-06-10',
  },
  {
    city: '東京',
    cityEs: 'Tokio',
    title: '東京スペイン語学校 CREランキング【2026年版】',
    url: '/language/tokyo-spanish-schools/',
    count: 9,
    date: '2026-06-10',
  },
];

const creSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'CRE — Competitive Reputation Engine',
  alternateName: 'Competitive Reputation Engine by supein.club',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  url: canonical,
  image: 'https://supein.club/about-us/cre/',
  description: 'supein.club独自開発の評判分析エンジン。Google Places API・Google Business Profile・可視性シグナルの3ソースからデータを収集し、6ステップのパイプラインで5次元CRIスコアを算出。パイプラインの詳細な図解を掲載。',
  author: {
    '@type': 'Organization',
    name: 'Club Español en Japón スペイン倶楽部',
    url: 'https://supein.club',
    founder: {
      '@type': 'Person',
      name: 'David Recalde',
      url: 'https://supein.club/about-us/team/david-recalde/',
    },
  },
  creator: {
    '@type': 'Organization',
    name: 'Club Español en Japón スペイン倶楽部',
    url: 'https://supein.club',
  },
  dateCreated: '2026-01-01',
  dateModified: '2026-06-10',
  inLanguage: 'ja',
  featureList: [
    'Google Places APIデータ収集',
    'Google Maps レビューデータ分析',
    'Googleビジネスプロフィール完成度評価',
    'マルチソースデータ統合・正規化',
    '5次元CRIスコア算出',
    'センチメント分析（自然言語処理）',
    '観光スポット・語学学校・レストランランキング生成',
  ],
};
---

<BaseLayout>
  <SEO
    slot="seo"
    title="CRE — Competitive Reputation Engine | supein.club独自の評判分析ツール"
    description="supein.club独自開発のCRE（Competitive Reputation Engine）は、Googleレビュー・評価・センチメント・可視性を5次元で分析しスペイン観光スポットの信頼性スコアを算出します。"
    canonical={canonical}
    breadcrumbs={seoBreadcrumbs}
  />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(creSchema)} />

  <!-- HERO -->
  <section style="background:#002147;padding:72px 0 56px;">
    <div class="page-container">
      <Breadcrumb items={breadcrumbs} dark />
      <div style="display:flex;align-items:center;
                  gap:12px;margin:28px 0 16px;">
        <span style="
          font-family:'Work Sans',sans-serif;
          font-size:13px;font-weight:800;
          letter-spacing:0.12em;
          background:#C8102E;color:white;
          padding:4px 12px;border-radius:4px;
        ">CRE v8</span>
        <span style="font-size:12px;color:rgba(255,255,255,0.4);
                     letter-spacing:0.15em;text-transform:uppercase;">
          by supein.club
        </span>
      </div>
      <h1 style="
        font-family:'Noto Serif JP',serif;
        font-size:clamp(26px,4vw,42px);
        font-weight:700;color:white;
        margin:0 0 20px;line-height:1.3;
        max-width:740px;
      ">
        Competitive Reputation Engine<br>
        <span style="font-size:0.7em;color:rgba(255,255,255,0.7);">
          スペイン倶楽部 独自の評判分析エンジン
        </span>
      </h1>
      <p style="
        font-size:18px;color:rgba(255,255,255,0.7);
        max-width:620px;line-height:1.8;margin:0;
      ">
        Googleのデータを5つの次元で分析し、
        スペインの観光スポット・レストラン・体験の
        信頼性を独自スコア（CRI）で可視化するツールです。
      </p>
    </div>
  </section>

  <!-- Content with TOC sidebar -->
  <div class="page-container" style="padding-top:48px;padding-bottom:80px;">
    <div class="content-grid">
      <div class="content-main">

        <details class="toc-mobile-inline">
          <summary>
            <span>目次</span>
            <span class="tmi-chevron" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </summary>
          <ol class="tmi-list">
            {tocHeadings.map((h, i) => (
              <li>
                <a href={'#' + h.slug}>
                  <span class="tmi-num">{i + 1}.</span>
                  {h.text}
                </a>
              </li>
            ))}
          </ol>
        </details>

  <!-- QUÉ ES -->
  <section style="background:white;padding:80px 0;">
    <div class="page-container" style="max-width:800px;">
      <p style="font-size:11px;font-weight:600;
                letter-spacing:0.2em;text-transform:uppercase;
                color:#C8102E;margin:0 0 8px;">
        ABOUT CRE
      </p>
      <h2 id="que-es-cre" style="font-family:'Noto Serif JP',serif;
                 font-size:clamp(22px,3vw,30px);
                 font-weight:700;color:#002147;
                 margin:0 0 28px;">
        CREとは何か
      </h2>
      <p style="font-size:17px;color:#374151;
                line-height:1.9;margin:0 0 20px;">
        <strong>CRE（Competitive Reputation Engine）</strong>は、
        スペイン倶楽部（supein.club）が独自に設計・開発した
        マルチソース評判分析エンジンです。
        単一の評価指標に依存するのではなく、
        複数のデータソースから独立して収集した情報を
        固有のアルゴリズムで統合・正規化することで、
        場所やビジネスの「本当の評判」を
        できる限り客観的に数値化します。
      </p>
      <p style="font-size:17px;color:#374151;
                line-height:1.9;margin:0 0 20px;">
        開発の出発点は、日本語でスペインの情報を探す読者が
        直面する課題でした——信頼できる情報源が分散しており、
        複数のプラットフォームの評価を自分で照合しなければ
        全体像が見えない。CREはその照合作業を自動化し、
        「どこで読んでもブレない客観的な品質指標」を
        提供するために作られました。
      </p>
      <p style="font-size:17px;color:#374151;
                line-height:1.9;margin:0;">
        算出される<strong>CRI（Competitive Reputation Index）</strong>は
        0〜100の正規化スコアです。スコアが高いほど、
        複数の独立したデータソースにわたって
        一貫して高い評価・信頼性・可視性が
        確認されていることを示します。
      </p>
    </div>
  </section>

  <!-- INFOGRAFÍA -->
  <section id="infografia"
           style="background:#002147;padding:72px 0;">
    <div class="page-container">
      <p style="font-size:11px;font-weight:600;
                letter-spacing:0.2em;text-transform:uppercase;
                color:#C8102E;margin:0 0 8px;text-align:center;">
        HOW IT WORKS
      </p>
      <h2 style="font-family:'Noto Serif JP',serif;
                 font-size:clamp(20px,3vw,28px);
                 font-weight:700;color:white;
                 margin:0 0 8px;text-align:center;">
        仕組みの図解
      </h2>
      <p style="font-size:14px;color:rgba(255,255,255,0.5);
                text-align:center;margin:0 0 36px;
                line-height:1.7;">
        データ収集からCRIスコア出力までの
        フルパイプライン
      </p>

      <!-- SVG inline — infografía CRE -->
      <div style="
        max-width:900px;margin:0 auto;
        background:white;border-radius:16px;
        overflow:hidden;
        border:2px solid rgba(255,255,255,0.15);
      ">
        <svg width="100%"
             viewBox="0 0 680 690"
             role="img"
             xmlns="http://www.w3.org/2000/svg"
             style="display:block;">
          <title>CRE — Competitive Reputation Engine パイプライン図解</title>
          <desc>
            データソース（Google Maps、Google Business Profile、
            可視性シグナル）からCRIスコアを算出するまでの
            6ステップパイプラインと5次元スコアの図解。
            supein.club独自開発ツール。
          </desc>

          <defs>
            <marker id="cre-arrow" viewBox="0 0 10 10"
                    refX="8" refY="5"
                    markerWidth="6" markerHeight="6"
                    orient="auto-start-reverse">
              <path d="M2 1L8 5L2 9" fill="none"
                    stroke="context-stroke" stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"/>
            </marker>
          </defs>

          <!-- ── HEADER ── -->
          <rect x="0" y="0" width="680" height="64"
                fill="#002147"/>
          <rect x="0" y="58" width="680" height="4"
                fill="#C8102E"/>
          <text x="32" y="26"
                font-family="'Work Sans',sans-serif"
                font-size="11" font-weight="800"
                letter-spacing="2" fill="#C8102E">CRE</text>
          <text x="66" y="27"
                font-family="'Work Sans',sans-serif"
                font-size="13" font-weight="700"
                fill="white">
            Competitive Reputation Engine
          </text>
          <text x="66" y="44"
                font-family="'Noto Sans JP',sans-serif"
                font-size="11"
                fill="rgba(255,255,255,0.5)">
            マルチソース評判分析エンジン · by supein.club
          </text>
          <rect x="586" y="16" width="62" height="22"
                rx="4" fill="#C8102E"/>
          <text x="617" y="31"
                font-family="'Work Sans',sans-serif"
                font-size="11" font-weight="800"
                text-anchor="middle" fill="white">v8</text>

          <!-- ── COLUMNA 1: FUENTES ── -->
          <text x="40" y="98"
                font-family="'Work Sans',sans-serif"
                font-size="9" font-weight="800"
                letter-spacing="2" fill="#C8102E">
            DATA SOURCES
          </text>

          <!-- Fuente 1 — PRIMARY -->
          <rect x="24" y="108" width="180" height="72"
                rx="8" fill="#FAFAF8"
                stroke="#e5e7eb" stroke-width="0.5"/>
          <rect x="24" y="108" width="4" height="72"
                rx="2" fill="#002147"/>
          <text x="40" y="128"
                font-family="'Work Sans',sans-serif"
                font-size="9" font-weight="800"
                letter-spacing="1" fill="#002147">PRIMARY</text>
          <text x="40" y="146"
                font-family="'Noto Sans JP',sans-serif"
                font-size="12" font-weight="700"
                fill="#002147">Google Maps</text>
          <text x="40" y="162"
                font-family="'Noto Sans JP',sans-serif"
                font-size="11" fill="#6b7280">
            Places API · レビュー
          </text>

          <!-- Fuente 2 — SECONDARY -->
          <rect x="24" y="192" width="180" height="72"
                rx="8" fill="#FAFAF8"
                stroke="#e5e7eb" stroke-width="0.5"/>
          <rect x="24" y="192" width="4" height="72"
                rx="2" fill="#374151"/>
          <text x="40" y="212"
                font-family="'Work Sans',sans-serif"
                font-size="9" font-weight="800"
                letter-spacing="1" fill="#374151">SECONDARY</text>
          <text x="40" y="230"
                font-family="'Noto Sans JP',sans-serif"
                font-size="12" font-weight="700"
                fill="#002147">Google Business</text>
          <text x="40" y="246"
                font-family="'Noto Sans JP',sans-serif"
                font-size="11" fill="#6b7280">
            プロフィール完成度
          </text>

          <!-- Fuente 3 — TERTIARY -->
          <rect x="24" y="276" width="180" height="72"
                rx="8" fill="#FAFAF8"
                stroke="#e5e7eb" stroke-width="0.5"/>
          <rect x="24" y="276" width="4" height="72"
                rx="2" fill="#9ca3af"/>
          <text x="40" y="296"
                font-family="'Work Sans',sans-serif"
                font-size="9" font-weight="800"
                letter-spacing="1" fill="#9ca3af">TERTIARY</text>
          <text x="40" y="314"
                font-family="'Noto Sans JP',sans-serif"
                font-size="12" font-weight="700"
                fill="#002147">可視性シグナル</text>
          <text x="40" y="330"
                font-family="'Noto Sans JP',sans-serif"
                font-size="11" fill="#6b7280">
            オンライン検索露出
          </text>

          <!-- Flechas fuentes → pipeline -->
          <line x1="204" y1="144" x2="240" y2="200"
                stroke="#C8102E" stroke-width="1"
                marker-end="url(#cre-arrow)"
                opacity="0.6"/>
          <line x1="204" y1="228" x2="240" y2="228"
                stroke="#C8102E" stroke-width="1"
                marker-end="url(#cre-arrow)"
                opacity="0.6"/>
          <line x1="204" y1="312" x2="240" y2="258"
                stroke="#C8102E" stroke-width="1"
                marker-end="url(#cre-arrow)"
                opacity="0.6"/>

          <!-- ── COLUMNA 2: PIPELINE ── -->
          <text x="252" y="98"
                font-family="'Work Sans',sans-serif"
                font-size="9" font-weight="800"
                letter-spacing="2" fill="#C8102E">
            PROCESSING PIPELINE
          </text>

          <!-- Step 1 -->
          <rect x="244" y="108" width="172" height="38"
                rx="6" fill="#002147"/>
          <text x="330" y="124"
                font-family="'Work Sans',sans-serif"
                font-size="10" font-weight="700"
                text-anchor="middle" fill="white">
            ① データ収集
          </text>
          <text x="330" y="138"
                font-family="'Noto Sans JP',sans-serif"
                font-size="9" text-anchor="middle"
                fill="rgba(255,255,255,0.55)">
            Multi-source collection
          </text>
          <line x1="330" y1="146" x2="330" y2="158"
                stroke="#C8102E" stroke-width="1.5"
                marker-end="url(#cre-arrow)"/>

          <!-- Step 2 -->
          <rect x="244" y="160" width="172" height="38"
                rx="6" fill="#0a2d52"
                stroke="#1a3d6e" stroke-width="0.5"/>
          <text x="330" y="176"
                font-family="'Work Sans',sans-serif"
                font-size="10" font-weight="700"
                text-anchor="middle" fill="white">
            ② クレンジング
          </text>
          <text x="330" y="190"
                font-family="'Noto Sans JP',sans-serif"
                font-size="9" text-anchor="middle"
                fill="rgba(255,255,255,0.55)">
            Data cleaning
          </text>
          <line x1="330" y1="198" x2="330" y2="210"
                stroke="#C8102E" stroke-width="1.5"
                marker-end="url(#cre-arrow)"/>

          <!-- Step 3 -->
          <rect x="244" y="212" width="172" height="38"
                rx="6" fill="#0a2d52"
                stroke="#1a3d6e" stroke-width="0.5"/>
          <text x="330" y="228"
                font-family="'Work Sans',sans-serif"
                font-size="10" font-weight="700"
                text-anchor="middle" fill="white">
            ③ 正規化（0〜100）
          </text>
          <text x="330" y="242"
                font-family="'Noto Sans JP',sans-serif"
                font-size="9" text-anchor="middle"
                fill="rgba(255,255,255,0.55)">
            Normalization
          </text>
          <line x1="330" y1="250" x2="330" y2="262"
                stroke="#C8102E" stroke-width="1.5"
                marker-end="url(#cre-arrow)"/>

          <!-- Step 4 -->
          <rect x="244" y="264" width="172" height="38"
                rx="6" fill="#0a2d52"
                stroke="#1a3d6e" stroke-width="0.5"/>
          <text x="330" y="280"
                font-family="'Work Sans',sans-serif"
                font-size="10" font-weight="700"
                text-anchor="middle" fill="white">
            ④ 次元スコア算出
          </text>
          <text x="330" y="294"
                font-family="'Noto Sans JP',sans-serif"
                font-size="9" text-anchor="middle"
                fill="rgba(255,255,255,0.55)">
            Dimension scoring
          </text>
          <line x1="330" y1="302" x2="330" y2="314"
                stroke="#C8102E" stroke-width="1.5"
                marker-end="url(#cre-arrow)"/>

          <!-- Step 5 -->
          <rect x="244" y="316" width="172" height="38"
                rx="6" fill="#0a2d52"
                stroke="#1a3d6e" stroke-width="0.5"/>
          <text x="330" y="332"
                font-family="'Work Sans',sans-serif"
                font-size="10" font-weight="700"
                text-anchor="middle" fill="white">
            ⑤ 重み付け合算
          </text>
          <text x="330" y="346"
                font-family="'Noto Sans JP',sans-serif"
                font-size="9" text-anchor="middle"
                fill="rgba(255,255,255,0.55)">
            Weighted aggregation
          </text>
          <line x1="330" y1="354" x2="330" y2="366"
                stroke="#C8102E" stroke-width="1.5"
                marker-end="url(#cre-arrow)"/>

          <!-- Step 6 — Output -->
          <rect x="244" y="368" width="172" height="42"
                rx="6" fill="#C8102E"/>
          <text x="330" y="386"
                font-family="'Work Sans',sans-serif"
                font-size="10" font-weight="800"
                text-anchor="middle" fill="white">
            ⑥ CRI スコア出力
          </text>
          <text x="330" y="401"
                font-family="'Noto Sans JP',sans-serif"
                font-size="9" text-anchor="middle"
                fill="rgba(255,255,255,0.7)">
            Score output
          </text>

          <!-- Flecha pipeline → dimensiones -->
          <line x1="416" y1="228" x2="448" y2="228"
                stroke="#C8102E" stroke-width="1"
                marker-end="url(#cre-arrow)"
