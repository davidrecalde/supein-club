            background:rgba(255,255,255,0.06);
            border:1px solid rgba(255,255,255,0.1);
            border-radius:14px;padding:24px;
          ">
            <span style="font-size:28px;
                         display:block;margin-bottom:12px;">
              {item.icon}
            </span>
            <p style="font-size:15px;font-weight:700;
                       color:white;margin:0 0 8px;">
              {item.title}
            </p>
            <p style="font-size:14px;
                       color:rgba(255,255,255,0.6);
                       margin:0;line-height:1.7;">
              {item.text}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- RANKINGS PUBLICADOS -->
  <section style="background:#FAFAF8;padding:80px 0;">
    <div class="page-container">
      <p style="font-size:11px;font-weight:600;
                letter-spacing:0.2em;text-transform:uppercase;
                color:#C8102E;margin:0 0 8px;text-align:center;">
        RANKINGS
      </p>
      <h2 id="rankings" style="font-family:'Noto Serif JP',serif;
                 font-size:clamp(22px,3vw,30px);
                 font-weight:700;color:#002147;
                 margin:0 0 12px;text-align:center;">
        公開済みCREランキング
      </h2>
      <p style="font-size:15px;color:#6b7280;
                text-align:center;margin:0 auto 40px;
                max-width:500px;line-height:1.7;">
        新しいランキングが追加されるたびにこのページを更新します。
      </p>

      <div style="
        max-width:720px;margin:0 auto;
        display:flex;flex-direction:column;gap:12px;
      ">
        {rankings.map(r => (
          <a href={r.url}
             style="
               display:flex;align-items:center;
               gap:16px;
               background:white;
               border:1px solid #e5e7eb;
               border-radius:12px;
               padding:18px 22px;
               text-decoration:none;
               transition:box-shadow 200ms,transform 200ms;
             "
             onmouseover="this.style.boxShadow='0 4px 16px rgba(0,33,71,0.08)';this.style.transform='translateY(-1px)'"
             onmouseout="this.style.boxShadow='';this.style.transform=''">
            <span style="
              font-family:'Work Sans',sans-serif;
              font-size:11px;font-weight:800;
              background:#002147;color:white;
              padding:4px 10px;border-radius:6px;
              flex-shrink:0;letter-spacing:0.05em;
            ">
              CRE
            </span>
            <div style="flex:1;min-width:0;">
              <p style="font-size:15px;font-weight:700;
                         color:#002147;margin:0 0 2px;
                         white-space:nowrap;overflow:hidden;
                         text-overflow:ellipsis;">
                {r.title}
              </p>
              <p style="font-size:12px;color:#9ca3af;margin:0;">
                {r.cityEs} · {r.count}件分析 · {r.date}
              </p>
            </div>
            <span style="color:#C8102E;font-size:18px;
                         flex-shrink:0;">›</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- DISCLAIMER -->
  <section style="background:white;padding:48px 0;">
    <div class="page-container" style="max-width:700px;">
      <p style="
        font-size:12px;color:#9ca3af;
        line-height:1.8;
        border-top:1px solid #e5e7eb;
        padding-top:24px;
        text-align:center;
      ">
        <span style="
          font-size:10px;font-weight:600;
          letter-spacing:0.1em;
          border:1px solid #e5e7eb;
          padding:1px 6px;border-radius:3px;
          margin-right:8px;color:#9ca3af;
        ">免責事項</span>
        CREスコアはGoogle Places APIのデータに基づく参考値です。
        スコアはデータ取得時点のものであり、
        実際のサービス品質を保証するものではありません。
        supein.clubは掲載施設との広告契約を一切結んでいません。
      </p>
    </div>
  </section>

      </div>

      <aside class="content-sidebar">
        <TOC headings={tocHeadings} />
      </aside>

    </div>
  </div>

</BaseLayout>
