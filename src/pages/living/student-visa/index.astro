---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SEO from '../../../components/SEO.astro';
import ArticleCard from '../../../components/ArticleCard.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import LineBanner from '../../../components/LineBanner.astro';
import RelatedPages from '../../../components/RelatedPages.astro';
import FAQSection from '../../../components/FAQSection.astro';
import ArticleDisclaimer from '../../../components/ArticleDisclaimer.astro';
import AuthorBox from '../../../components/AuthorBox.astro';

const author = await getEntry('authors', 'david-recalde');

const articles = await getCollection('articles', ({ data }) => !data.draft && data.pillar === 'living' && data.cluster === 'student-visa');
const sorted = articles.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const breadcrumbs = [
  { name: 'ホーム', url: '/' },
  { name: 'スペインに住む', url: '/living/' },
  { name: 'スペイン学生ビザ', url: '/living/student-visa/' },
];

const faqItems = [
  { question: 'スペイン学生ビザの有効期間はどれくらいですか？', answer: '在学期間と同じ長さで発給され、最長1年です（王令1155/2024号 第55条）。1年を超えるコースの場合は、コースの継続を証明することで年度ごとに更新できます。' },
  { question: '学生ビザで働くことはできますか？', answer: 'できます。王令1155/2024号 第57条により、学生ビザ保持者は追加の許可申請なしで、週30時間までの就労が自動的に認められています。ただし就労はビザが発給された自治州内に限られ、学業に支障が出ない範囲という条件があります。' },
  { question: '卒業後もスペインに残って仕事を探せますか？', answer: '可能です。ただし条件があります。直近2年以内に取得した（または取得見込みの）高等教育の学位（大学の学位相当、スペイン教育省の資格水準レベル6以上）を持つ場合に限り、最長24ヶ月（更新不可）の求職・起業ビザに切り替えられます（2013年法14号 第17追加規定）。学生ビザの有効期限の60日前から、失効後90日以内に申請する必要があり、審査には20日かかります（期限内に返答がなければ許可されたものとみなされます）。語学学校のみに通っていた場合はこの制度の対象外です。' },
  { question: '学生ビザの審査にはどれくらいかかりますか？', answer: '審査期間は申請先や時期によって変動します。正確な標準処理期間は本記事執筆時点で確認できていないため、申請時に在日スペイン大使館へ直接ご確認ください。余裕を持って、渡航予定の2〜3ヶ月前には申請することをおすすめします。' },
  { question: '語学学校の留学でも学生ビザは必要ですか？', answer: '90日を超えて通学する場合は必要です。90日以内の短期コースであれば、観光目的の滞在として査証なしで渡航できる場合がありますが、入国審査で就学目的を証明できないとトラブルになる可能性があるため、長期的に学ぶ予定がある場合は学生ビザの取得をおすすめします。' },
];
---
<BaseLayout>
  <SEO slot="seo" title="スペイン学生ビザ完全ガイド｜申請条件・就労時間・卒業後の求職ビザ【2025年規則改正対応】" description="スペイン学生ビザの発給期間・必要書類・週30時間までの就労ルール・卒業後の求職ビザ（最長24ヶ月）まで、2025年5月施行の新しい外国人規則（王令1155/2024号）に基づいて詳しく解説します。" canonical="https://supein.club/living/student-visa/" breadcrumbs={breadcrumbs} robots="index, follow" />
  <script
    type="application/ld+json"
    slot="head"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqItems.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: { '@type': 'Answer', text: item.answer },
      })),
    })}
  />
  <section class="bg-navy text-white py-12 px-4">
    <div class="max-w-4xl mx-auto">
      <Breadcrumb items={breadcrumbs} dark />
      <h1 class="font-serif text-3xl md:text-4xl font-bold leading-tight mt-4">スペイン学生ビザ 申請完全ガイド</h1>
      <p class="text-white/80 text-lg mt-3 max-w-2xl">スペイン留学に必要な学生ビザの申請方法と必要書類を分かりやすいステップで解説します。</p>
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-4 py-12">
    <div class="border-l-4 border-primary bg-[#F0F4F8] px-5 py-4 mb-10 text-ink leading-relaxed font-medium rounded-r-lg">
      2025年5月20日施行の王令1155/2024号（旧規則・王令557/2011号を置き換え）に基づく最新情報です。本記事は学生ビザの法的な仕組みに絞って解説しており、留学費用の相場は<a href="/living/study-cost/" class="underline">「スペイン留学費用」</a>、大学留学の出願方法は<a href="/living/university/" class="underline">「スペイン大学留学」</a>、語学学校の選び方は<a href="/living/language-school/" class="underline">「スペイン語学学校」</a>で別途詳しく解説しています。
    </div>

    <h2 id="who-needs-it" class="font-serif font-bold text-navy text-2xl mb-4">学生ビザが必要になるケース</h2>
    <p class="text-muted leading-relaxed mb-8">
      90日を超えてスペインの教育機関（語学学校・大学・専門機関など）に通う場合、学生ビザ（査証）の事前取得が必要です。90日以内の短期コースであれば観光目的の滞在として査証なしで渡航できる場合もありますが、就学が主目的と判断されると入国審査でトラブルになるリスクがあるため、長期の留学を予定している場合は必ず学生ビザを申請してください。
    </p>

    <h2 id="duration" class="font-serif font-bold text-navy text-2xl mb-4">ビザの有効期間</h2>
    <p class="text-muted leading-relaxed mb-8">
      学生ビザは「在学期間と同じ長さ」で発給され、1回あたり最長1年です（王令1155/2024号 第55条1項・5項）。1年を超えるコースに在籍する場合は、コースの継続を証明する書類（在学証明書など）を提出することで、年度ごとに更新できます。
    </p>

    <h2 id="work-rights" class="font-serif font-bold text-navy text-2xl mb-4">学生ビザで働けるか — 週30時間ルール</h2>
    <p class="text-muted leading-relaxed mb-4">
      学生ビザ保持者は、2025年の規則改正により、<strong class="text-navy">追加の許可申請なしで自動的に</strong>就労が認められるようになりました（王令1155/2024号 第57条2項）。ポイントは次のとおりです。
    </p>
    <ul class="list-disc pl-6 text-muted leading-relaxed mb-8 space-y-1">
      <li>就労時間は<strong class="text-navy">週30時間まで</strong></li>
      <li>就労先は、ビザが発給された<strong class="text-navy">自治州（コミュニティ）内</strong>に限られる</li>
      <li>学業に支障が出ない範囲であることが条件</li>
      <li>労働許可証の別途申請は不要（旧規則では必要だった手続きが簡素化された）</li>
    </ul>

    <h2 id="job-search" class="font-serif font-bold text-navy text-2xl mb-4">卒業後の求職・起業ビザ（最長24ヶ月）</h2>
    <p class="text-muted leading-relaxed mb-4">
      スペインで高等教育の学位を取得した（または取得見込みの）学生は、卒業後も現地で求職活動や起業準備を続けるための特別なビザに切り替えることができます。根拠法は王令1155/2024号ではなく、2013年法14号（起業家法）の第17追加規定で、新規則の第190条10項が明示的にこの規定を維持しています。
    </p>
    <div class="overflow-x-auto mb-8">
      <table class="w-full text-sm border-collapse">
        <tbody>
          <tr class="border border-[#E8E8E6]"><td class="p-3 border border-[#E8E8E6] font-semibold text-navy w-1/3">対象者</td><td class="p-3 border border-[#E8E8E6] text-muted">直近2年以内に取得した、またはスペインで取得見込みの高等教育の学位（スペイン資格水準レベル6＝大学の学位相当）を持つ人</td></tr>
          <tr class="border border-[#E8E8E6]"><td class="p-3 border border-[#E8E8E6] font-semibold text-navy">有効期間</td><td class="p-3 border border-[#E8E8E6] text-muted">最長24ヶ月・更新不可</td></tr>
          <tr class="border border-[#E8E8E6]"><td class="p-3 border border-[#E8E8E6] font-semibold text-navy">申請時期</td><td class="p-3 border border-[#E8E8E6] text-muted">学生ビザの有効期限の60日前から、失効後90日以内</td></tr>
          <tr class="border border-[#E8E8E6]"><td class="p-3 border border-[#E8E8E6] font-semibold text-navy">審査期間</td><td class="p-3 border border-[#E8E8E6] text-muted">20日（期限内に返答がなければ許可とみなす「肯定的沈黙」）</td></tr>
        </tbody>
      </table>
    </div>
    <p class="text-muted leading-relaxed mb-8">
      <strong class="text-navy">重要な注意点：</strong>この制度は大学・大学院などの高等教育機関で学位を取得した人が対象で、語学学校のみに通っていた場合は対象外です。このビザで就職先が決まった場合は、<a href="/living/work-visa/" class="text-primary hover:underline">就労ビザ</a>への切り替えが必要になります。
    </p>

    <h2 id="application" class="font-serif font-bold text-navy text-2xl mb-4">申請の基本的な流れ</h2>
    <p class="text-muted leading-relaxed mb-8">
      居住地を管轄する在日スペイン大使館に査証を申請します。一般的に、入学許可書（受け入れ教育機関が発行）、有効なパスポート、滞在期間をカバーする海外旅行保険、経済的な支弁能力を示す書類、証明写真、査証申請書などが必要です。必要書類や手数料、予約方法は時期によって変わるため、申請前に必ず在日スペイン大使館の公式サイトで最新情報を確認してください。
    </p>
  </section>

  <section class="max-w-4xl mx-auto px-4">
    <FAQSection faq={faqItems} />
  </section>

  <section class="max-w-4xl mx-auto px-4">
    <section class="my-10 border-t border-[#E8E8E6] pt-8">
      <h2 class="font-sans font-bold text-xl text-navy mb-4">出典・参考情報</h2>
      <ul class="space-y-2 text-sm">
        <li><a href="https://www.boe.es/buscar/act.php?id=BOE-A-2024-24099" target="_blank" rel="noopener nofollow noreferrer" class="text-primary hover:underline font-medium">王令1155/2024号（スペイン官報 BOE）</a> — 学生ビザを定める第IV編、第55条・第57条</li>
        <li><a href="https://www.boe.es/buscar/act.php?id=BOE-A-2013-10074" target="_blank" rel="noopener nofollow noreferrer" class="text-primary hover:underline font-medium">2013年法14号（スペイン官報 BOE）</a> — 卒業後の求職・起業ビザを定める第17追加規定</li>
        <li><a href="https://www.exteriores.gob.es/Embajadas/tokio/ja/Paginas/index.aspx" target="_blank" rel="noopener nofollow noreferrer" class="text-primary hover:underline font-medium">在日スペイン大使館（外務省公式）</a> — ビザ申請窓口・最新の必要書類</li>
      </ul>
    </section>

    <RelatedPages relatedPages={[
      { title: 'スペインビザ 種類・申請方法', href: '/living/spain-visa/' },
      { title: 'スペイン留学 完全ガイド', href: '/living/study-spain/' },
      { title: 'スペイン留学費用', href: '/living/study-cost/' },
      { title: 'スペイン就労ビザ 完全ガイド', href: '/living/work-visa/' },
      { title: 'スペインでインターンシップをする方法', href: '/living/work-in-spain/internship-spain/' },
    ]} />

    {author && <ArticleDisclaimer />}
    {author && <AuthorBox author={author} />}

    {sorted.length > 0 && (
      <section class="mt-12 border-t border-[#E8E8E6] pt-10">
        <h2 class="font-sans font-bold text-xl text-navy mb-5">関連記事</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {sorted.map((a) => {
            const parts = a.id.replace(/\.(md|mdx)$/, '').split('/');
            const slug = parts[2] ?? a.data.cluster;
            return <ArticleCard title={a.data.title} description={a.data.description} href={`/living/student-visa/${slug}/`} pillar="living" image={a.data.image} imageAlt={a.data.imageAlt} heroImage={a.data.heroImage} heroImageAlt={a.data.heroImageAlt} pubDate={a.data.pubDate} />;
          })}
        </div>
      </section>
    )}
  </section>

  <LineBanner slim />
</BaseLayout>
