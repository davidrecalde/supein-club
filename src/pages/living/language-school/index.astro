---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SEO from '../../../components/SEO.astro';
import ArticleCard from '../../../components/ArticleCard.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import LineBanner from '../../../components/LineBanner.astro';
import RelatedPages from '../../../components/RelatedPages.astro';
import FAQSection from '../../../components/FAQSection.astro';
import ArticleDisclaimer from '../../../components/ArticleDisclaimer.astro';
import AuthorBox from '../../../components/AuthorBox.astro';

const author = await getEntry('authors', 'david-recalde');

const articles = await getCollection('articles', ({ data }) => !data.draft && data.pillar === 'living' && data.cluster === 'language-school');
const sorted = articles.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const breadcrumbs = [
  { name: 'ホーム', url: '/' },
  { name: 'スペインに住む', url: '/living/' },
  { name: 'スペイン語学学校', url: '/living/language-school/' },
];

const delePrices = [
  { level: 'A1', price: '11,000円' },
  { level: 'A2', price: '13,000円' },
  { level: 'B1', price: '15,000円' },
  { level: 'B2', price: '19,000円' },
  { level: 'C1', price: '21,000円' },
  { level: 'C2', price: '25,000円' },
];

const faqItems = [
  { question: 'FEDELE認定校とは何ですか？', answer: 'FEDELE（スペイン語学校連盟）は、スペイン語を外国語として教える学校の業界団体です。加盟校はセルバンテス文化センターの「センター認定制度」が定める最低基準（授業の質・教育体制・設備・情報開示の適切さなど）を満たし、FEDELEの「品質憲章」を遵守し、定期的な査察を受けることが条件になります。加盟校であることは、学校選びの客観的な目安の一つになります。' },
  { question: 'DELEとは何ですか？日本で受験できますか？', answer: 'DELE（スペイン語検定）は、セルバンテス文化センターが学術・行政面を統括する、スペイン語力を公式に証明する資格試験です。A1からC2までの6段階があり、日本では東京・大阪・京都・名古屋・仙台・広島など複数の都市で受験できます（会場・開催レベルは試験回ごとに異なります）。' },
  { question: 'DELEの受験料はいくらですか？', answer: '東京会場・2026年11月実施回の例では、A1が11,000円、A2が13,000円、B1が15,000円、B2が19,000円、C1が21,000円、C2が25,000円です（セルバンテス文化センター東京の公式情報に基づく）。回次や為替・改定により変動するため、受験前に必ず公式サイトで最新の金額を確認してください。' },
  { question: '語学学校はどうやって選べばよいですか？', answer: 'まずFEDELEまたはセルバンテス文化センターの認定を受けているかを確認するのが基本です。そのうえで、コースの時間数・クラス人数・DELE対策の有無・滞在先サポート（寮・ホームステイ）・立地する都市の生活費などを比較して選びます。費用の目安は「スペイン留学費用」で都市別に紹介しています。' },
];
---
<BaseLayout>
  <SEO slot="seo" title="スペインの語学学校の選び方｜FEDELE認定校とDELE試験ガイド【2026年版】" description="スペインの語学学校をFEDELE・セルバンテス文化センターの認定基準から解説。DELE試験の仕組み、日本での受験会場、受験料の目安まで、公式情報に基づいて紹介します。" canonical="https://supein.club/living/language-school/" breadcrumbs={breadcrumbs} robots="index, follow" />
  <script
    type="application/ld+json"
    slot="head"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqItems.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: { '@type': 'Answer', text: item.answer },
      })),
    })}
  />
  <section class="bg-navy text-white py-12 px-4">
    <div class="max-w-4xl mx-auto">
      <Breadcrumb items={breadcrumbs} dark />
      <h1 class="font-serif text-3xl md:text-4xl font-bold leading-tight mt-4">スペイン 語学学校の選び方</h1>
      <p class="text-white/80 text-lg mt-3 max-w-2xl">認定校の見分け方からDELE試験まで、スペイン語を本場で学ぶために知っておきたい情報を解説。</p>
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-4 py-12">
    <div class="border-l-4 border-primary bg-[#F0F4F8] px-5 py-4 mb-10 text-ink leading-relaxed font-medium rounded-r-lg">
      費用の目安は<a href="/living/study-cost/" class="underline">「スペイン留学費用」</a>、90日を超えて通学する場合に必要な学生ビザは<a href="/living/student-visa/" class="underline">「スペイン学生ビザ」</a>で詳しく解説しています。
    </div>

    <h2 id="accreditation" class="font-serif font-bold text-navy text-2xl mb-4">認定校を見分ける — FEDELEとセルバンテス文化センター</h2>
    <p class="text-muted leading-relaxed mb-4">
      スペインには数多くの語学学校がありますが、質を客観的に見極める目安になるのが「FEDELE（スペイン語学校連盟）」と「セルバンテス文化センター」の認定です。
    </p>
    <ul class="list-disc pl-6 text-muted leading-relaxed mb-8 space-y-1">
      <li>FEDELE加盟校は、セルバンテス文化センターの「センター認定制度」が定める基準（授業の質、教育体制、設備、情報開示の適切さなど）を満たしている</li>
      <li>FEDELEの「品質憲章」の遵守に同意し、定期的な査察を受けている</li>
      <li>FEDELE公式サイトによると、加盟校は現在スペイン国内に約100校ある</li>
      <li>多くの認定校がDELE・CCSE（スペイン国籍取得試験）・SIELEの対策コースを提供している</li>
    </ul>

    <h2 id="dele" class="font-serif font-bold text-navy text-2xl mb-4">DELE（スペイン語検定）とは</h2>
    <p class="text-muted leading-relaxed mb-4">
      DELEは、セルバンテス文化センターが学術・行政面を統括する、スペイン語力を公式に証明する国際資格です。A1（入門）からC2（最上級）までの6段階があり、大学出願・就職活動でスペイン語力を証明する際に広く使われています。
    </p>
    <p class="text-muted leading-relaxed mb-4">
      日本では、セルバンテス文化センター東京が試験を主催しており、東京のほか大阪・京都・名古屋・仙台・広島でも受験できます（会場ごとに実施レベルが異なる場合があります。例：仙台はA1のみ、A2は東京・広島のみなど）。
    </p>

    <h2 id="dele-price" class="font-serif font-bold text-navy text-2xl mb-4">DELE受験料の目安（東京会場・2026年11月実施回）</h2>
    <div class="overflow-x-auto mb-4">
      <table class="w-full text-sm border-collapse">
        <thead>
          <tr class="bg-[#F0F4F8] text-navy text-left">
            <th class="p-3 font-semibold border border-[#E8E8E6]">レベル</th>
            <th class="p-3 font-semibold border border-[#E8E8E6]">受験料</th>
          </tr>
        </thead>
        <tbody>
          {delePrices.map((d) => (
            <tr class="border border-[#E8E8E6]">
              <td class="p-3 border border-[#E8E8E6] font-semibold text-navy">{d.level}</td>
              <td class="p-3 border border-[#E8E8E6] text-muted">{d.price}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="text-sm text-muted leading-relaxed mb-8">
      ※ セルバンテス文化センター東京の公式情報に基づく、2026年11月実施回の金額です。回次・為替・改定により変動するため、受験前に必ず公式サイトで最新情報を確認してください。
    </p>

    <h2 id="how-to-choose" class="font-serif font-bold text-navy text-2xl mb-4">学校選びのチェックポイント</h2>
    <ul class="list-disc pl-6 text-muted leading-relaxed mb-8 space-y-1">
      <li>FEDELEまたはセルバンテス文化センターの認定を受けているか</li>
      <li>1クラスの人数（少人数ほど会話量が増える）</li>
      <li>DELE対策コースの有無</li>
      <li>滞在先サポート（学生寮・ホームステイの選択肢）の有無</li>
      <li>立地する都市の生活費（<a href="/living/study-cost/" class="text-primary hover:underline">都市別の目安はこちら</a>）</li>
    </ul>
  </section>

  <section class="max-w-4xl mx-auto px-4">
    <FAQSection faq={faqItems} />
  </section>

  <section class="max-w-4xl mx-auto px-4">
    <section class="my-10 border-t border-[#E8E8E6] pt-8">
      <h2 class="font-sans font-bold text-xl text-navy mb-4">出典・参考情報</h2>
      <ul class="space-y-2 text-sm">
        <li><a href="https://fedele.org/" target="_blank" rel="noopener nofollow noreferrer" class="text-primary hover:underline font-medium">FEDELE（スペイン語学校連盟）公式サイト</a></li>
        <li><a href="https://tokio.cervantes.es/jp/dele_diplomas/" target="_blank" rel="noopener nofollow noreferrer" class="text-primary hover:underline font-medium">セルバンテス文化センター東京 — DELE試験案内</a></li>
      </ul>
    </section>

    <RelatedPages relatedPages={[
      { title: 'スペイン留学 完全ガイド', href: '/living/study-spain/' },
      { title: 'スペイン留学費用', href: '/living/study-cost/' },
      { title: 'スペイン学生ビザ 完全ガイド', href: '/living/student-visa/' },
      { title: 'スペイン大学留学', href: '/living/university/' },
    ]} />

    {author && <ArticleDisclaimer />}
    {author && <AuthorBox author={author} />}

    {sorted.length > 0 && (
      <section class="mt-12 border-t border-[#E8E8E6] pt-10">
        <h2 class="font-sans font-bold text-xl text-navy mb-5">関連記事</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {sorted.map((a) => {
            const parts = a.id.replace(/\.(md|mdx)$/, '').split('/');
            const slug = parts[2] ?? a.data.cluster;
            return <ArticleCard title={a.data.title} description={a.data.description} href={`/living/language-school/${slug}/`} pillar="living" image={a.data.image} imageAlt={a.data.imageAlt} heroImage={a.data.heroImage} heroImageAlt={a.data.heroImageAlt} pubDate={a.data.pubDate} />;
          })}
        </div>
      </section>
    )}
  </section>

  <LineBanner slim />
</BaseLayout>
