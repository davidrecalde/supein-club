---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SEO from '../../../components/SEO.astro';
import ArticleCard from '../../../components/ArticleCard.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import LineBanner from '../../../components/LineBanner.astro';
import RelatedPages from '../../../components/RelatedPages.astro';
import FAQSection from '../../../components/FAQSection.astro';
import ArticleDisclaimer from '../../../components/ArticleDisclaimer.astro';
import AuthorBox from '../../../components/AuthorBox.astro';

const author = await getEntry('authors', 'david-recalde');

const articles = await getCollection('articles', ({ data }) => !data.draft && data.pillar === 'living' && data.cluster === 'spain-visa');
const sorted = articles.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const breadcrumbs = [
  { name: 'ホーム', url: '/' },
  { name: 'スペインに住む', url: '/living/' },
  { name: 'スペインビザ 種類・申請方法', url: '/living/spain-visa/' },
];

const visaTypes = [
  { name: '学生ビザ', target: '語学学校・大学など90日超の留学', duration: '就学期間と同じ（最長1年、更新可）', href: '/living/student-visa/' },
  { name: '求職・起業ビザ（卒業後）', target: '大学等の高等教育修了者（在学中も可）', duration: '最長24ヶ月・更新不可', href: '/living/student-visa/#job-search' },
  { name: '就労ビザ（雇用労働）', target: 'スペイン企業から内定を得た人', duration: '就労契約に連動（更新可）', href: '/living/work-visa/' },
  { name: 'ワーキングホリデー', target: '18〜30歳の日本国籍者', duration: '最長1年（更新不可）', href: '/living/working-holiday/' },
  { name: 'プラクティカス（実務研修）', target: '高等教育修了者・在学者で研修先が決まっている人', duration: '研修協定（convenio）に準じる', href: '/living/work-in-spain/internship-spain/' },
];

const faqItems = [
  { question: 'スペインに90日以内の観光なら査証（ビザ）は必要ですか？', answer: '日本国籍者は、観光・短期訪問目的であればシェンゲン協定により180日間のうち90日まで査証なしで滞在できます。留学・就労・ワーキングホリデーなど90日を超える滞在、または滞在目的が「就学」「就労」である場合は、目的に応じた国内査証（ナショナルビザ／Dビザ）が必要です。' },
  { question: '2025年のスペイン外国人法改正で何が変わりましたか？', answer: '2025年5月20日より、新しい外国人規則（王令1155/2024号）が施行され、2011年の旧規則を全面的に置き換えました。学生ビザの就労可能時間や、就労ビザの審査期間の明文化など、本記事で紹介する情報はすべてこの新規則に基づいています。' },
  { question: 'どのビザを選べばよいか分かりません。', answer: '目的別に選びます。語学学校や大学への留学なら「学生ビザ」、スペイン企業からすでに内定がある場合は「就労ビザ」、18〜30歳で就労経験よりも文化体験を重視するなら「ワーキングホリデー」、大学の学位を活かして実務研修をしたいなら「プラクティカス」が該当します。本記事下部の早見表から各ビザの詳細ページへ進んでください。' },
  { question: 'ビザ申請はどこで行いますか？', answer: '日本国籍者の場合、居住地を管轄する在日スペイン大使館・領事館に査証申請を行います。申請手続きの詳細・必要書類・予約方法は、各ビザの詳細ページおよび在日スペイン大使館の公式サイトで最新情報を確認してください。' },
];
---
<BaseLayout>
  <SEO slot="seo" title="スペインビザ 種類・申請方法【2025年規則改正対応】" description="スペインの査証（ビザ）の種類を目的別に解説。学生ビザ・就労ビザ・ワーキングホリデー・プラクティカスの違いと選び方を、2025年5月施行の新しい外国人規則（王令1155/2024号）に基づいて日本語で紹介します。" canonical="https://supein.club/living/spain-visa/" breadcrumbs={breadcrumbs} robots="index, follow" />
  <script
    type="application/ld+json"
    slot="head"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqItems.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: { '@type': 'Answer', text: item.answer },
      })),
    })}
  />
  <section class="bg-navy text-white py-12 px-4">
    <div class="max-w-4xl mx-auto">
      <Breadcrumb items={breadcrumbs} dark />
      <h1 class="font-serif text-3xl md:text-4xl font-bold leading-tight mt-4">スペインビザ 種類と申請手続き</h1>
      <p class="text-white/80 text-lg mt-3 max-w-2xl">スペインに滞在・住むためのビザの種類と申請方法を目的別にわかりやすく説明します。</p>
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-4 py-12">
    <div class="border-l-4 border-primary bg-[#F0F4F8] px-5 py-4 mb-10 text-ink leading-relaxed font-medium rounded-r-lg">
      本記事は、2025年5月20日に施行された新しい外国人規則「王令1155/2024号」（Real Decreto 1155/2024、旧規則の王令557/2011号を全面置き換え）に基づいています。目的別の詳しい手続きは各ビザの専用ページでも随時この新規則に沿って更新しています。
    </div>

    <h2 id="who-needs-visa" class="font-serif font-bold text-navy text-2xl mb-4">査証（ビザ）が必要なのはどんな場合か</h2>
    <p class="text-muted leading-relaxed mb-4">
      日本国籍者は、シェンゲン協定加盟国への観光・短期訪問目的であれば、180日間のうち合計90日まで査証なしで滞在できます。しかし、次のいずれかに該当する場合は、目的に応じた国内査証（ナショナルビザ／通称「Dビザ」）の事前取得が必要です。
    </p>
    <ul class="list-disc pl-6 text-muted leading-relaxed mb-8 space-y-1">
      <li>90日を超えて滞在する（語学学校の長期コース、大学留学など）</li>
      <li>滞在目的が「就学」である（90日以内でも学生ビザが必要なケースがあります）</li>
      <li>滞在目的が「就労」である（雇用契約の有無を問わず）</li>
      <li>ワーキングホリデー制度を利用する</li>
    </ul>

    <h2 id="visa-types" class="font-serif font-bold text-navy text-2xl mb-4">目的別ビザの種類</h2>
    <p class="text-muted leading-relaxed mb-6">主なビザを対象者・滞在期間で比較すると、次のとおりです。詳しい申請条件は各リンク先で解説しています。</p>
    <div class="overflow-x-auto mb-10">
      <table class="w-full text-sm border-collapse">
        <thead>
          <tr class="bg-[#F0F4F8] text-navy text-left">
            <th class="p-3 font-semibold border border-[#E8E8E6]">ビザ</th>
            <th class="p-3 font-semibold border border-[#E8E8E6]">対象者</th>
            <th class="p-3 font-semibold border border-[#E8E8E6]">滞在期間</th>
          </tr>
        </thead>
        <tbody>
          {visaTypes.map((v) => (
            <tr class="border border-[#E8E8E6]">
              <td class="p-3 border border-[#E8E8E6] font-semibold text-navy"><a href={v.href} class="text-primary hover:underline">{v.name}</a></td>
              <td class="p-3 border border-[#E8E8E6] text-muted">{v.target}</td>
              <td class="p-3 border border-[#E8E8E6] text-muted">{v.duration}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <h2 id="how-to-choose" class="font-serif font-bold text-navy text-2xl mb-4">自分に合うビザの選び方</h2>
    <p class="text-muted leading-relaxed mb-4">状況別に、目指すべきビザの方向性は次のように整理できます。</p>
    <ul class="list-disc pl-6 text-muted leading-relaxed mb-8 space-y-2">
      <li><strong class="text-navy">語学学校・大学に留学したい</strong> → <a href="/living/student-visa/" class="text-primary hover:underline">学生ビザ</a>。卒業後も現地で働きたい場合は、学生ビザから切り替えられる求職ビザ（本記事下部および学生ビザのページで解説）を検討します。</li>
      <li><strong class="text-navy">スペイン企業からすでに内定がある</strong> → <a href="/living/work-visa/" class="text-primary hover:underline">就労ビザ</a>。雇用主が手続きを主導します。</li>
      <li><strong class="text-navy">18〜30歳で、まず現地の空気を知りたい</strong> → <a href="/living/working-holiday/" class="text-primary hover:underline">ワーキングホリデー</a>。就労経験よりも文化体験を重視する制度です。</li>
      <li><strong class="text-navy">大学で学んだ分野の実務経験を積みたい</strong> → <a href="/living/work-in-spain/internship-spain/" class="text-primary hover:underline">プラクティカス（実務研修）</a>。受け入れ先企業が研修協定を提出します。</li>
    </ul>

    <h2 id="application-basics" class="font-serif font-bold text-navy text-2xl mb-4">申請手続きの基本的な流れ</h2>
    <p class="text-muted leading-relaxed mb-4">
      ビザの種類によって詳細は異なりますが、日本国籍者の場合、共通して居住地を管轄する在日スペイン大使館・領事館に査証を申請します。一般的に必要とされる書類には、有効なパスポート、査証申請書、証明写真、滞在目的を裏付ける書類（入学許可書・雇用契約書など）、海外旅行保険、経済的な支弁能力を示す書類、無犯罪証明書（ケースにより）などがあります。具体的な必要書類・手数料・予約方法は、申請するビザの種類と時期によって変わるため、各ビザの詳細ページ、および在日スペイン大使館の公式サイトで最新情報を必ず確認してください。
    </p>
  </section>

  <section class="max-w-4xl mx-auto px-4">
    <FAQSection faq={faqItems} />
  </section>

  <section class="max-w-4xl mx-auto px-4">
    <section class="my-10 border-t border-[#E8E8E6] pt-8">
      <h2 class="font-sans font-bold text-xl text-navy mb-4">出典・参考情報</h2>
      <ul class="space-y-2 text-sm">
        <li><a href="https://www.boe.es/buscar/act.php?id=BOE-A-2024-24099" target="_blank" rel="noopener nofollow noreferrer" class="text-primary hover:underline font-medium">王令1155/2024号（スペイン官報 BOE）</a> — 2025年5月20日施行の現行外国人規則</li>
        <li><a href="https://www.exteriores.gob.es/Embajadas/tokio/ja/Paginas/index.aspx" target="_blank" rel="noopener nofollow noreferrer" class="text-primary hover:underline font-medium">在日スペイン大使館（外務省公式）</a> — ビザ申請の管轄窓口</li>
        <li><a href="https://www.inclusion.gob.es/web/migraciones/" target="_blank" rel="noopener nofollow noreferrer" class="text-primary hover:underline font-medium">スペイン包摂・社会保障・移民省</a> — 外国人・移民政策の所管官庁</li>
      </ul>
    </section>

    <RelatedPages relatedPages={[
      { title: 'スペイン学生ビザ 完全ガイド', href: '/living/student-visa/' },
      { title: 'スペイン就労ビザ 完全ガイド', href: '/living/work-visa/' },
      { title: 'スペイン ワーキングホリデー 完全ガイド', href: '/living/working-holiday/' },
      { title: 'スペインでインターンシップをする方法', href: '/living/work-in-spain/internship-spain/' },
      { title: 'スペイン留学 完全ガイド', href: '/living/study-spain/' },
    ]} />

    {author && <ArticleDisclaimer />}
    {author && <AuthorBox author={author} />}

    {sorted.length > 0 && (
      <section class="mt-12 border-t border-[#E8E8E6] pt-10">
        <h2 class="font-sans font-bold text-xl text-navy mb-5">関連記事</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {sorted.map((a) => {
            const parts = a.id.replace(/\.(md|mdx)$/, '').split('/');
            const slug = parts[2] ?? a.data.cluster;
            return <ArticleCard title={a.data.title} description={a.data.description} href={`/living/spain-visa/${slug}/`} pillar="living" image={a.data.image} imageAlt={a.data.imageAlt} heroImage={a.data.heroImage} heroImageAlt={a.data.heroImageAlt} pubDate={a.data.pubDate} />;
          })}
        </div>
      </section>
    )}
  </section>

  <LineBanner slim />
</BaseLayout>
