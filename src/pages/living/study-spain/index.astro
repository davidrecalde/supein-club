---
import { getCollection } from 'astro:content';
import ArticleLayout from '../../../layouts/ArticleLayout.astro';

const articles = await getCollection('articles', ({ data }) => !data.draft && data.pillar === 'living' && data.cluster === 'study-spain');
const entry = articles[0];

if (!entry) {
  throw new Error('No se encontró el artículo del cluster "study-spain"');
}
---
<ArticleLayout entry={entry} />
