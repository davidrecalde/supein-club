---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SEO from '../../../components/SEO.astro';
import ArticleCard from '../../../components/ArticleCard.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import LineBanner from '../../../components/LineBanner.astro';
import RelatedPages from '../../../components/RelatedPages.astro';
import FAQSection from '../../../components/FAQSection.astro';
import ArticleDisclaimer from '../../../components/ArticleDisclaimer.astro';
import AuthorBox from '../../../components/AuthorBox.astro';

const author = await getEntry('authors', 'david-recalde');

const articles = await getCollection('articles', ({ data }) => !data.draft && data.pillar === 'living' && data.cluster === 'study-spain');
const sorted = articles.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const breadcrumbs = [
  { name: 'ホーム', url: '/' },
  { name: 'スペインに住む', url: '/living/' },
  { name: 'スペイン留学', url: '/living/study-spain/' },
];

const studyPaths = [
  { name: '語学学校', target: 'スペイン語を本格的に学びたい・DELE資格を取りたい', href: '/living/language-school/' },
  { name: '大学・大学院', target: '学位取得・交換留学をしたい', href: '/living/university/' },
  { name: '費用を知る', target: '学費・生活費の相場を先に把握したい', href: '/living/study-cost/' },
  { name: '学生ビザ', target: '申請条件・就労時間・卒業後の求職ビザを知りたい', href: '/living/student-visa/' },
];

const faqItems = [
  { question: 'スペイン留学にはどんな種類がありますか？', answer: '大きく分けて、スペイン語そのものを学ぶ「語学学校」への留学と、学位取得を目的とした「大学・大学院」への留学の2種類があります。語学学校は数週間の短期から1年以上の長期まで柔軟に選べるのに対し、大学留学は入学審査・語学要件があり、より長期的な計画が必要です。' },
  { question: '留学にはビザが必要ですか？', answer: '90日を超えて教育機関に通う場合は学生ビザが必要です。詳しい条件・申請方法は<a href="/living/student-visa/">「スペイン学生ビザ」</a>で解説しています。' },
  { question: '留学の費用はどれくらいかかりますか？', answer: '学校・都市・滞在スタイルによって大きく異なります。語学学校の授業料・生活費の相場は<a href="/living/study-cost/">「スペイン留学費用」</a>で都市別に詳しく紹介しています。' },
  { question: '語学学校と大学、どちらを選べばよいですか？', answer: 'まずスペイン語力を伸ばしたい、短期間で現地の空気を体験したいなら語学学校、将来的に学位やスペインでのキャリアにつなげたいなら大学留学が向いています。大学留学でも入学前に語学学校で語学力を伸ばしてから出願するケースは一般的です。' },
];
---
<BaseLayout>
  <SEO slot="seo" title="スペイン留学 完全ガイド｜目的・費用・手続きの選び方【2026年版】" description="スペイン留学の全体像を解説。語学学校か大学か、費用の相場、学生ビザの条件まで、目的別に迷わず選べるようまとめた入門ガイドです。各トピックの詳細は専用ページでさらに詳しく解説しています。" canonical="https://supein.club/living/study-spain/" breadcrumbs={breadcrumbs} robots="index, follow" />
  <script
    type="application/ld+json"
    slot="head"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqItems.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: { '@type': 'Answer', text: item.answer.replace(/<[^>]+>/g, '') },
      })),
    })}
  />
  <section class="bg-navy text-white py-12 px-4">
    <div class="max-w-4xl mx-auto">
      <Breadcrumb items={breadcrumbs} dark />
      <h1 class="font-serif text-3xl md:text-4xl font-bold leading-tight mt-4">スペイン留学 完全ガイド</h1>
      <p class="text-white/80 text-lg mt-3 max-w-2xl">スペイン留学で人生が変わる。費用・ビザ・学校選びから現地生活まで、留学に必要な情報を網羅。</p>
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-4 py-12">
    <p class="text-muted leading-relaxed mb-10">
      スペイン留学と一口に言っても、目的によって選ぶべき道は大きく異なります。本記事では全体像を整理し、目的別に詳しいガイドへご案内します。費用・ビザ・学校選びなど、各テーマの詳細はそれぞれの専用ページでより深く解説しています。
    </p>

    <h2 id="paths" class="font-serif font-bold text-navy text-2xl mb-4">目的別：次に読むべきガイド</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-10">
      {studyPaths.map((p) => (
        <a href={p.href} class="block bg-white rounded-xl border border-[#E8E8E6] hover:border-primary/30 hover:shadow-sm transition-all p-5">
          <h3 class="font-sans font-bold text-navy mb-1">{p.name}</h3>
          <p class="text-muted text-sm leading-relaxed">{p.target}</p>
        </a>
      ))}
    </div>

    <h2 id="why-spain" class="font-serif font-bold text-navy text-2xl mb-4">なぜスペイン留学が選ばれるのか</h2>
    <p class="text-muted leading-relaxed mb-8">
      スペインは世界で2番目に母語話者が多い言語であるスペイン語を学べるだけでなく、ラテンアメリカを含む4億人以上のスペイン語圏とつながる入口になります。物価は西欧の中では比較的抑えめで、学校の選択肢も語学学校・大学ともに豊富です。マドリード・バルセロナといった大都市から、サラマンカのような歴史ある学生都市まで、学びのスタイルに合わせて滞在都市を選べる点も魅力です。
    </p>

    <h2 id="how-to-choose-city" class="font-serif font-bold text-navy text-2xl mb-4">都市選びの考え方</h2>
    <p class="text-muted leading-relaxed mb-8">
      マドリード・バルセロナは学校の選択肢が多く国際色も豊かですが、生活費はやや高めです。サラマンカ・グラナダ・セビリアなどの地方都市は生活費を抑えられ、落ち着いた環境でスペイン語に集中しやすいのが特徴です。具体的な費用の違いは<a href="/living/study-cost/" class="text-primary hover:underline">「スペイン留学費用」</a>で都市別に比較しています。
    </p>
  </section>

  <section class="max-w-4xl mx-auto px-4">
    <FAQSection faq={faqItems} />
  </section>

  <section class="max-w-4xl mx-auto px-4">
    <section class="my-10 border-t border-[#E8E8E6] pt-8">
      <h2 class="font-sans font-bold text-xl text-navy mb-4">出典・参考情報</h2>
      <ul class="space-y-2 text-sm">
        <li><a href="https://tokio.cervantes.es/" target="_blank" rel="noopener nofollow noreferrer" class="text-primary hover:underline font-medium">セルバンテス文化センター東京（Instituto Cervantes）</a> — スペイン政府認定の公的文化・教育機関</li>
        <li><a href="https://www.sepie.es/" target="_blank" rel="noopener nofollow noreferrer" class="text-primary hover:underline font-medium">スペイン教育国際化事業団（SEPIE）</a> — 高等教育・留学制度を所管する公的機関</li>
      </ul>
    </section>

    <RelatedPages relatedPages={[
      { title: 'スペイン学生ビザ 完全ガイド', href: '/living/student-visa/' },
      { title: 'スペイン留学費用', href: '/living/study-cost/' },
      { title: 'スペイン大学留学', href: '/living/university/' },
      { title: 'スペイン語学学校の選び方', href: '/living/language-school/' },
      { title: 'スペインビザ 種類・申請方法', href: '/living/spain-visa/' },
    ]} />

    {author && <ArticleDisclaimer />}
    {author && <AuthorBox author={author} />}

    {sorted.length > 0 && (
      <section class="mt-12 border-t border-[#E8E8E6] pt-10">
        <h2 class="font-sans font-bold text-xl text-navy mb-5">関連記事</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {sorted.map((a) => {
            const parts = a.id.replace(/\.(md|mdx)$/, '').split('/');
            const slug = parts[2] ?? a.data.cluster;
            return <ArticleCard title={a.data.title} description={a.data.description} href={`/living/study-spain/${slug}/`} pillar="living" image={a.data.image} imageAlt={a.data.imageAlt} heroImage={a.data.heroImage} heroImageAlt={a.data.heroImageAlt} pubDate={a.data.pubDate} />;
          })}
        </div>
      </section>
    )}
  </section>

  <LineBanner slim />
</BaseLayout>
