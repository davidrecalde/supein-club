---
import { getCollection } from 'astro:content';
import ArticleLayout from '../../../layouts/ArticleLayout.astro';

const articles = await getCollection('articles', ({ data }) => !data.draft && data.pillar === 'living' && data.cluster === 'work-in-spain');
const entry = articles.find((a) => a.id.endsWith('/work-in-spain.mdx') || a.id.endsWith('/work-in-spain.md'));

if (!entry) {
  throw new Error('No se encontró el artículo insignia del cluster "work-in-spain"');
}
---
<ArticleLayout entry={entry} />
