---
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import ArticleLayout from '../../../../layouts/ArticleLayout.astro';

export const getStaticPaths: GetStaticPaths = async () => {
  // クラスター名とスラッグが同一の記事（例: cervantes-webinar-experiencias-espana）は
  // /living/{cluster}/ の単独静的ページで配信するため、ここでは除外する
  const flatClusterPages = new Set(['cervantes-webinar-experiencias-espana']);
  const articles = await getCollection('articles', ({ data }) => !data.draft && data.pillar === 'living' && !flatClusterPages.has(data.cluster));
  return articles.map((entry) => {
    const parts = entry.id.replace(/\.(md|mdx)$/, '').split('/');
    return {
      params: { cluster: parts[1], article: parts[2] },
      props: { entry },
    };
  });
};

const { entry } = Astro.props;
---
<ArticleLayout entry={entry} />
