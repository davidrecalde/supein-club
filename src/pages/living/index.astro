---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SEO from '../../components/SEO.astro';
import PillarHero from '../../components/PillarHero.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import LineBanner from '../../components/LineBanner.astro';
import FloatingActions from '../../components/FloatingActions.astro';
import NewsletterForm from '../../components/NewsletterForm.astro';
import ArticleDisclaimer from '../../components/ArticleDisclaimer.astro';
import AuthorBox from '../../components/AuthorBox.astro';
import FAQSection from '../../components/FAQSection.astro';
import { getArticleUrl } from '../../utils/articles';
import { courseSequence } from '../../data/course-sequence';

const author = await getEntry('authors', 'david-recalde');

const livingFaq = [
  {
    question: 'スペイン生活のリアルな話を知りたい場合は？',
    answer: '実際にスペインで暮らす方々へのインタビューシリーズ<a href="/living/i-need-spain/">「I need Spain」</a>で、現地の暮らしぶりを紹介しています。',
  },
  {
    question: 'セルバンテス文化センターのウェビナーとは何ですか？',
    answer: 'スペインでの生活や留学の実体験を語っていただいたウェビナーの内容を<a href="/living/cervantes-webinar-experiencias-espana/">「セルバンテス文化センター ウェビナー」</a>にまとめています。',
  },
  {
    question: 'ビザや留学手続きの詳しいガイドはありますか？',
    answer: 'はい。目的別のビザ一覧は<a href="/living/spain-visa/">「スペインビザ 種類・申請方法」</a>、留学は<a href="/living/study-spain/">「スペイン留学 完全ガイド」</a>、就労は<a href="/living/work-in-spain/">「スペインで働く方法」</a>で詳しく解説しています。',
  },
];

const otherPillars = [
  { href: '/travel/', title: 'スペイン旅行', description: 'バルセロナ・マドリードから南部アンダルシア、離島まで、観光スポットとツアー情報を完全網羅' },
  { href: '/food/', title: 'スペイン料理', description: 'パエリア・タパス・ワインからおすすめのお土産まで、スペインの食文化を写真つきで詳しく解説' },
  { href: '/language/', title: 'スペイン語', description: 'レッスン・語学学校・学習アプリの選び方まで、スペイン語習得に役立つ情報を体系的に紹介' },
  { href: '/culture/', title: 'スペイン文化', description: 'フラメンコ・歴史的建造物・伝統の祭りなど、スペイン文化の奥深い魅力を詳しく紹介します' },
  { href: '/football/', title: 'スペインサッカー', description: 'ラ・リーガの試合結果や移籍情報、代表チーム、バルセロナやレアルの歴史まで深掘り解説します' },
];

const articles = await getCollection('articles', ({ data }) => !data.draft && data.pillar === 'living');
const sorted = articles.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const idNoExt = (a: (typeof sorted)[number]) => a.id.replace(/\.(md|mdx)$/, '');

// カテゴリ分類：クラスターごとにグループ化（新しいクラスターを追加する際は、下記に1行追加すれば自動的に反映される）。
// "guides" だけは複数クラスター（ビザ・留学・就労の9クラスター + internship-spainの
// サブ記事）を1つのカテゴリにまとめるため clusterIds を使う — 他は単一クラスター。
const categories = [
  { id: 'guides', label: 'ガイド', clusterIds: ['spain-visa', 'study-spain', 'student-visa', 'study-cost', 'university', 'language-school', 'work-in-spain', 'work-visa', 'working-holiday'] },
  { id: 'cervantes-webinar-experiencias-espana', label: 'ウェビナー' },
  { id: 'i-need-spain', label: 'インタビュー' },
];

const categoryGroups = categories
  .map((c) => ({
    ...c,
    items: sorted.filter((a) => (c.clusterIds ?? [c.id]).includes(a.data.cluster)),
  }))
  .filter((g) => g.items.length > 0);

const categorizedIds = new Set(categoryGroups.flatMap((g) => g.items.map((a) => a.id)));
const uncategorized = sorted.filter((a) => !categorizedIds.has(a.id));

const categoryAnchors = categoryGroups.map((g) => ({ href: `#${g.id}`, label: g.label }));

const breadcrumbs = [
  { name: 'ホーム', url: '/' },
  { name: 'スペインに住む', url: '/living/' },
];
---
<BaseLayout>
  <SEO
    slot="seo"
    title="スペインに住む 完全ガイド"
    description="スペインでの生活について、留学・就労・ワーキングホリデーなど目的や滞在スタイルに応じて役立つ情報を日本語で幅広く紹介するガイドメディアです。ビザ手続きの流れから滞在費用の目安、語学学校の選び方、実際の現地生活の様子まで詳しく網羅しています。"
    canonical="https://supein.club/living/"
    image="/og/living.webp"
    breadcrumbs={breadcrumbs}
  />
  <script
    type="application/ld+json"
    slot="head"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: livingFaq.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: { '@type': 'Answer', text: item.answer.replace(/<[^>]+>/g, '') },
      })),
    })}
  />
  <PillarHero
    title="スペインに住む"
    description="目的や滞在スタイルによって、必要な準備は大きく変わります——そんなスペインでの生活を日本語でわかりやすくサポートします。"
  />
  <section class="max-w-6xl mx-auto px-5 py-14">
    <p class="text-muted text-base leading-relaxed mb-12 border-l-2 border-primary pl-5">
      スペインでの生活は、目的や滞在スタイルによって必要な準備が大きく異なる、奥深いテーマです。本カテゴリでは、実際にスペインで暮らすために役立つ情報を日本語で幅広くご紹介しています。
    </p>

    {categoryAnchors.length > 0 && (
      <>
        <h2 id="categories" class="font-sans font-bold text-xl text-navy mb-5">カテゴリ</h2>
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-3 mb-12">
          {categoryAnchors.map(({ href, label }) => (
            <a href={href} class="bg-white rounded-lg px-3 py-3 min-h-[44px] flex items-center justify-center text-center border border-[#E8E8E6] hover:border-primary/30 hover:shadow-sm transition-all">
              <span class="font-semibold text-navy text-sm leading-snug block">{label}</span>
            </a>
          ))}
        </div>
      </>
    )}

    {categoryGroups.map((group) => {
      const isNumberedSeries = group.id === 'i-need-spain';
      const isGuides = group.id === 'guides';
      const displayItems = isNumberedSeries
        ? [...group.items].sort((a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf())
        : isGuides
        ? [...group.items].sort((a, b) => courseSequence.livingGuides.indexOf(idNoExt(a)) - courseSequence.livingGuides.indexOf(idNoExt(b)))
        : group.items;
      return (
        <>
          <h2 id={group.id} class="font-sans font-bold text-xl text-navy mb-5">{group.label}</h2>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
            {displayItems.map((a, i) => (
              <ArticleCard title={a.data.title} description={a.data.description} href={getArticleUrl(a)} pillar="living" cluster={a.data.cluster} image={a.data.image} imageAlt={a.data.imageAlt} heroImage={a.data.heroImage} heroImageAlt={a.data.heroImageAlt} pubDate={a.data.pubDate} topicBadge={isGuides ? undefined : group.label} stepBadge={isNumberedSeries ? `第${i + 1}弾` : isGuides ? `GUIDE ${i + 1} / ${courseSequence.livingGuides.length}` : undefined} />
            ))}
          </div>
        </>
      );
    })}

    {uncategorized.length > 0 && (
      <>
        <h2 id="other" class="font-sans font-bold text-xl text-navy mb-5">その他</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {uncategorized.map((a) => (
            <ArticleCard title={a.data.title} description={a.data.description} href={getArticleUrl(a)} pillar="living" cluster={a.data.cluster} image={a.data.image} imageAlt={a.data.imageAlt} heroImage={a.data.heroImage} heroImageAlt={a.data.heroImageAlt} pubDate={a.data.pubDate} />
          ))}
        </div>
      </>
    )}

    {sorted.length === 0 && (
      <p class="text-muted text-center py-12">記事を準備中です。近日公開予定。</p>
    )}
  </section>

  <section class="max-w-6xl mx-auto px-5 pb-14 prose-content">
  <div class="max-w-[780px]">
    <h2 class="font-sans font-bold text-xl text-navy mb-4">このサイトのスペイン生活コンテンツについて</h2>
    <p class="text-muted leading-relaxed mb-6">
      このカテゴリでは、実際にスペインで暮らす方々の声や、現地生活・留学に関するウェビナーの内容に加えて、ビザ・留学・就労の手続き面を2025年5月施行の最新の外国人規則（王令1155/2024号）に基づいて詳しく解説するガイド記事をご紹介しています。
    </p>

    <h2 class="font-sans font-bold text-xl text-navy mb-4">現地で暮らす人々の声を聞くなら</h2>
    <p class="text-muted leading-relaxed mb-6">
      スペインで実際に生活する方々へのインタビューシリーズ<a href="/living/i-need-spain/" class="text-primary underline">「I need Spain」</a>で、現地のリアルな暮らしぶりを紹介しています。
    </p>

    <h2 class="font-sans font-bold text-xl text-navy mb-4">留学・現地生活の実体験を知るなら</h2>
    <p class="text-muted leading-relaxed mb-6">
      セルバンテス文化センターとのウェビナーで語られた留学・現地生活の実体験を<a href="/living/cervantes-webinar-experiencias-espana/" class="text-primary underline">「セルバンテス文化センター ウェビナー」</a>にまとめています。
    </p>

    <NewsletterForm variant="inline" />

    <FAQSection faq={livingFaq} />

    {author && <ArticleDisclaimer />}
    {author && <AuthorBox author={author} />}

    <section class="mt-12 border-t border-[#E8E8E6] pt-10">
      <h2 class="font-sans font-bold text-2xl text-navy mb-2">こちらの記事もおすすめ</h2>
      <p class="text-sm text-gray-500 mb-6">スペインの他のテーマも見てみませんか。</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
        {otherPillars.map((p) => (
          <a href={p.href} class="block bg-white rounded-xl overflow-hidden shadow-[0_2px_8px_rgba(0,33,71,0.07)] border border-[#E8E8E6] hover:shadow-[0_4px_16px_rgba(0,33,71,0.12)] hover:border-primary/20 transition-all p-6">
            <h3 class="font-sans font-bold text-navy text-lg mb-2">{p.title}</h3>
            <p class="text-muted text-sm leading-relaxed">{p.description}</p>
          </a>
        ))}
      </div>
    </section>
  </div>
  </section>

  <LineBanner slim />
  <FloatingActions target="categories" shareUrl="https://supein.club/living/" shareTitle="スペインに住む" />
</BaseLayout>
