---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SEO from '../../components/SEO.astro';
import PillarHero from '../../components/PillarHero.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import LineBanner from '../../components/LineBanner.astro';

const articles = await getCollection('articles', ({ data }) => !data.draft && data.pillar === 'living');
const sorted = articles.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// クラスター名とスラッグが同一の記事は /living/{cluster}/ の単独ページとして配信される
const flatClusterPages = new Set(['cervantes-webinar-experiencias-espana']);

// カテゴリ分類：クラスターごとにグループ化（新しいクラスターを追加する際は、下記に1行追加すれば自動的に反映される）
const categories = [
  { id: 'cervantes-webinar-experiencias-espana', label: 'ウェビナー' },
  { id: 'i-need-spain', label: 'インタビュー' },
];

const categoryGroups = categories
  .map((c) => ({
    ...c,
    items: sorted.filter((a) => a.data.cluster === c.id),
  }))
  .filter((g) => g.items.length > 0);

const categorizedIds = new Set(categoryGroups.flatMap((g) => g.items.map((a) => a.id)));
const uncategorized = sorted.filter((a) => !categorizedIds.has(a.id));

const categoryAnchors = categoryGroups.map((g) => ({ href: `#${g.id}`, label: g.label }));

function cardHref(a: (typeof sorted)[number]) {
  const parts = a.id.replace(/\.(md|mdx)$/, '').split('/');
  const slug = parts[2] ?? a.data.cluster;
  return flatClusterPages.has(a.data.cluster) ? `/living/${a.data.cluster}/` : `/living/${a.data.cluster}/${slug}/`;
}

const breadcrumbs = [
  { name: 'ホーム', url: '/' },
  { name: 'スペインに住む', url: '/living/' },
];
---
<BaseLayout>
  <SEO
    slot="seo"
    title="スペインに住む 完全ガイド | supein.club"
    description="スペインでの生活について、留学・就労・ワーキングホリデーなど目的や滞在スタイルに応じて役立つ情報を日本語で幅広く紹介するガイドメディアです。ビザ手続きの流れから滞在費用の目安、語学学校の選び方、実際の現地生活の様子まで詳しく網羅しています。"
    canonical="https://supein.club/living/"
    breadcrumbs={breadcrumbs}
  />
  <PillarHero
    title="スペインに住む"
    description="目的や滞在スタイルによって、必要な準備は大きく変わります——そんなスペインでの生活を日本語でわかりやすくサポートします。"
  />
  <section class="max-w-6xl mx-auto px-5 py-14">
    <p class="text-muted text-base leading-relaxed mb-12 border-l-2 border-primary pl-5">
      スペインでの生活は、目的や滞在スタイルによって必要な準備が大きく異なる、奥深いテーマです。本カテゴリでは、実際にスペインで暮らすために役立つ情報を日本語で幅広くご紹介しています。
    </p>

    {categoryAnchors.length > 0 && (
      <>
        <h2 class="font-sans font-bold text-xl text-navy mb-5">カテゴリ</h2>
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-3 mb-12">
          {categoryAnchors.map(({ href, label }) => (
            <a href={href} class="bg-white rounded-lg px-3 py-3 min-h-[44px] flex items-center justify-center text-center border border-[#E8E8E6] hover:border-primary/30 hover:shadow-sm transition-all">
              <span class="font-semibold text-navy text-sm leading-snug block">{label}</span>
            </a>
          ))}
        </div>
      </>
    )}

    {categoryGroups.map((group) => {
      const isNumberedSeries = group.id === 'i-need-spain';
      const displayItems = isNumberedSeries
        ? [...group.items].sort((a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf())
        : group.items;
      return (
        <>
          <h2 id={group.id} class="font-sans font-bold text-xl text-navy mb-5">{group.label}</h2>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
            {displayItems.map((a, i) => (
              <ArticleCard title={a.data.title} description={a.data.description} href={cardHref(a)} pillar="living" image={a.data.image} imageAlt={a.data.imageAlt} heroImage={a.data.heroImage} heroImageAlt={a.data.heroImageAlt} pubDate={a.data.pubDate} topicBadge={group.label} stepBadge={isNumberedSeries ? `第${i + 1}弾` : undefined} />
            ))}
          </div>
        </>
      );
    })}

    {uncategorized.length > 0 && (
      <>
        <h2 id="other" class="font-sans font-bold text-xl text-navy mb-5">その他</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {uncategorized.map((a) => (
            <ArticleCard title={a.data.title} description={a.data.description} href={cardHref(a)} pillar="living" image={a.data.image} imageAlt={a.data.imageAlt} heroImage={a.data.heroImage} heroImageAlt={a.data.heroImageAlt} pubDate={a.data.pubDate} />
          ))}
        </div>
      </>
    )}

    {sorted.length === 0 && (
      <p class="text-muted text-center py-12">記事を準備中です。近日公開予定。</p>
    )}
  </section>
  <LineBanner slim />
</BaseLayout>
