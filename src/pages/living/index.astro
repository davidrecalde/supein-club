---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SEO from '../../components/SEO.astro';
import PillarHero from '../../components/PillarHero.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import LineBanner from '../../components/LineBanner.astro';
import AdSlot from '../../components/AdSlot.astro';

const articles = await getCollection('articles', ({ data }) => !data.draft && data.pillar === 'living');
const sorted = articles.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// クラスター名とスラッグが同一の記事は /living/{cluster}/ の単独ページとして配信される
const flatClusterPages = new Set(['cervantes-webinar-experiencias-espana']);
const topicBadges: Record<string, string> = {
  'cervantes-webinar-experiencias-espana': 'ウェビナー',
};

const clusters = [
  { href: '/living/study-spain/', label: 'スペイン留学' },
  { href: '/living/language-school/', label: '語学学校' },
  { href: '/living/university/', label: '大学' },
  { href: '/living/study-cost/', label: '留学費用' },
  { href: '/living/spain-visa/', label: 'ビザ' },
  { href: '/living/student-visa/', label: '学生ビザ' },
  { href: '/living/work-visa/', label: '就労ビザ' },
  { href: '/living/working-holiday/', label: 'ワーホリ' },
  { href: '/living/work-in-spain/', label: 'スペインで働く' },
];

const breadcrumbs = [
  { name: 'ホーム', url: '/' },
  { name: 'スペインに住む', url: '/living/' },
];
---
<BaseLayout>
  <SEO
    slot="seo"
    title="スペインに住む 完全ガイド | supein.club"
    description="スペインでの生活について、目的や滞在スタイルに応じて役立つ情報を日本語で幅広く紹介するガイドメディアです。"
    canonical="https://supein.club/living/"
    breadcrumbs={breadcrumbs}
  />
  <PillarHero
    title="スペインに住む"
    description="目的や滞在スタイルによって、必要な準備は大きく変わります——そんなスペインでの生活を日本語でわかりやすくサポートします。"
  />
  <section class="max-w-6xl mx-auto px-5 py-14">
    <p class="text-muted text-base leading-relaxed mb-12 border-l-2 border-primary pl-5">
      スペインでの生活は、目的や滞在スタイルによって必要な準備が大きく異なる、奥深いテーマです。本カテゴリでは、実際にスペインで暮らすために役立つ情報を日本語で幅広くご紹介しています。
    </p>
    <h2 class="font-sans font-bold text-xl text-navy mb-5">カテゴリ</h2>
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-3 mb-12">
      {clusters.map(({ href, label }) => (
        <a href={href} class="bg-white rounded-lg px-3 py-3 min-h-[44px] flex items-center justify-center text-center border border-[#E8E8E6] hover:border-primary/30 hover:shadow-sm transition-all">
          <span class="font-semibold text-navy text-sm leading-snug block">{label}</span>
        </a>
      ))}
    </div>
    {sorted.length > 0 && (
      <>
        <h2 class="font-sans font-bold text-xl text-navy mb-5">記事一覧</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {sorted.map((a) => {
            const parts = a.id.replace(/\.(md|mdx)$/, '').split('/');
            const slug = parts[2] ?? a.data.cluster;
            const href = flatClusterPages.has(a.data.cluster)
              ? `/living/${a.data.cluster}/`
              : `/living/${a.data.cluster}/${slug}/`;
            return (
              <ArticleCard title={a.data.title} description={a.data.description} href={href} pillar="living" image={a.data.image} imageAlt={a.data.imageAlt} heroImage={a.data.heroImage} heroImageAlt={a.data.heroImageAlt} pubDate={a.data.pubDate} topicBadge={topicBadges[a.data.cluster]} />
            );
          })}
        </div>
      </>
    )}
  </section>
  <section class="max-w-6xl mx-auto px-5 pb-14">
    <AdSlot
      position="pillar-bottom"
      interlinkTitle="スペイン語を独学で始める完全ガイド"
      interlinkUrl="/language/learn-spanish/"
      interlinkPillar="スペイン語"
      interlinkReadingTime={5}
    />
  </section>
  <LineBanner slim />
</BaseLayout>
