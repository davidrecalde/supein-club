---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SEO from '../../../components/SEO.astro';
import ArticleCard from '../../../components/ArticleCard.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import LineBanner from '../../../components/LineBanner.astro';

const articles = await getCollection('articles', ({ data }) => !data.draft && data.pillar === 'living' && data.cluster === 'i-need-spain');
const sorted = articles.sort((a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf());

const breadcrumbs = [
  { name: 'ホーム', url: '/' },
  { name: 'スペインに住む', url: '/living/' },
  { name: 'I need Spain 在スペイン日本人', url: '/living/i-need-spain/' },
];
---
<BaseLayout>
  <SEO slot="seo" title="I need Spain 在スペイン日本人｜スペイン在住日本人インタビュー | supein.club" description="スペインに住む日本人へのインタビューシリーズ「I need Spain 在スペイン日本人」。実際の移住のきっかけや現地での暮らしをリアルな声で紹介します。" canonical="https://supein.club/living/i-need-spain/" breadcrumbs={breadcrumbs} />
  <section class="bg-navy text-white py-12 px-4">
    <div class="max-w-4xl mx-auto">
      <Breadcrumb items={breadcrumbs} dark />
      <h1 class="font-serif text-3xl md:text-4xl font-bold leading-tight mt-4">I need Spain 在スペイン日本人</h1>
      <p class="text-white/80 text-lg mt-3 max-w-2xl">スペインに住む日本人へのインタビューシリーズ。移住のきっかけ、現地での暮らし、文化の違い——一人ひとりのリアルな声を届けます。</p>
    </div>
  </section>
  <section class="max-w-7xl mx-auto px-4 py-12">
    {sorted.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {sorted.map((a, i) => {
          const parts = a.id.replace(/\.(md|mdx)$/, '').split('/');
          const slug = parts[2] ?? a.data.cluster;
          return <ArticleCard title={a.data.title} description={a.data.description} href={`/living/i-need-spain/${slug}/`} pillar="living" image={a.data.image} imageAlt={a.data.imageAlt} heroImage={a.data.heroImage} heroImageAlt={a.data.heroImageAlt} pubDate={a.data.pubDate} stepBadge={`第${i + 1}弾`} />;
        })}
      </div>
    ) : (
      <p class="text-muted text-center py-12">記事を準備中です。近日公開予定。</p>
    )}
  </section>
  <LineBanner slim />
</BaseLayout>
