---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SEO from '../../components/SEO.astro';
import PillarHero from '../../components/PillarHero.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import LineBanner from '../../components/LineBanner.astro';
import AdSlot from '../../components/AdSlot.astro';
import { getArticleUrl } from '../../utils/articles';

const articles = await getCollection('articles', ({ data }) => !data.draft && data.pillar === 'food');
const sorted = articles.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const provinceEntries = await getCollection('spain-map', ({ data }) => data.draft !== true);
const sortedProvinces = [...provinceEntries].sort((a, b) => a.data.provinceJa.localeCompare(b.data.provinceJa, 'ja'));

// カテゴリ分類：クラスターごとにグループ化（新しいクラスターを追加する際は、下記に1行追加すれば自動的に反映される）
const categories = [
  { id: 'spanish-vocabulary', label: 'グルメ語彙' },
];

function toCardItem(a: (typeof sorted)[number]) {
  return {
    title: a.data.title,
    description: a.data.description,
    href: getArticleUrl(a),
    pubDate: a.data.pubDate,
    image: a.data.image,
    imageAlt: a.data.imageAlt,
    heroImage: a.data.heroImage,
    heroImageAlt: a.data.heroImageAlt,
  };
}

const categoryGroups = categories
  .map((c) => ({ ...c, items: sorted.filter((a) => a.data.cluster === c.id).map(toCardItem) }))
  .filter((g) => g.items.length > 0);

const categorizedIds = new Set(categories.flatMap((c) => sorted.filter((a) => a.data.cluster === c.id).map((a) => a.id)));
const uncategorized = sorted.filter((a) => !categorizedIds.has(a.id)).map(toCardItem);

// スペイン美食マップ：ハブページ＋全都道府県のページを1つの長いカテゴリとして表示
const spainMapGroup = {
  id: 'spain-map',
  label: 'スペイン美食マップ',
  items: [
    {
      title: 'スペイン美食マップ｜州別レストラン・バルガイド',
      description: '7つの美食ゾーンで探せるインタラクティブマップ。全都道府県、地方ごとのレストラン・バル情報をまとめています。',
      href: '/food/spain-map/',
      pubDate: new Date('2026-09-07'),
    },
    ...sortedProvinces.map((p) => ({
      title: p.data.title,
      description: p.data.description,
      href: `/food/spain-map/${p.data.province}/`,
      pubDate: p.data.pubDate,
    })),
  ],
};

const allGroups = [...categoryGroups, spainMapGroup];
const categoryAnchors = allGroups.map((g) => ({ href: `#${g.id}`, label: g.label }));

const breadcrumbs = [
  { name: 'ホーム', url: '/' },
  { name: 'スペイン料理', url: '/food/' },
];
---
<BaseLayout>
  <SEO
    slot="seo"
    title="スペイン料理 完全ガイド | supein.club"
    description="スペイン料理・グルメの世界を、地方ごとの個性豊かな食文化とあわせて日本語でわかりやすく紹介するガイドメディアです。"
    canonical="https://supein.club/food/"
    breadcrumbs={breadcrumbs}
  />
  <PillarHero
    title="スペイン料理"
    description="地方ごとに驚くほど多彩な、スペインの食文化の世界へようこそ。"
  />
  <section class="max-w-6xl mx-auto px-5 py-14">
    <p class="text-muted text-base leading-relaxed mb-12 border-l-2 border-primary pl-5">
      スペイン料理・グルメは、地方ごとに驚くほど個性豊かな顔を持つ、奥深いテーマです。本カテゴリでは、そんなスペイン料理の世界を日本語でわかりやすくご紹介しています。
    </p>
    {categoryAnchors.length > 0 && (
      <>
        <h2 class="font-sans font-bold text-xl text-navy mb-5">カテゴリ</h2>
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-3 mb-12">
          {categoryAnchors.map(({ href, label }) => (
            <a href={href} class="bg-white rounded-lg px-3 py-3 min-h-[44px] flex items-center justify-center text-center border border-[#E8E8E6] hover:border-primary/30 hover:shadow-sm transition-all">
              <span class="font-semibold text-navy text-sm leading-snug block">{label}</span>
            </a>
          ))}
        </div>
      </>
    )}

    {categoryGroups.map((group) => (
      <>
        <h2 id={group.id} class="font-sans font-bold text-xl text-navy mb-5">{group.label}</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
          {group.items.map((item) => (
            <ArticleCard title={item.title} description={item.description} href={item.href} pillar="food" image={item.image} imageAlt={item.imageAlt} heroImage={item.heroImage} heroImageAlt={item.heroImageAlt} pubDate={item.pubDate} topicBadge={group.label} />
          ))}
        </div>
      </>
    ))}

    {uncategorized.length > 0 && (
      <>
        <h2 id="other" class="font-sans font-bold text-xl text-navy mb-5">その他</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
          {uncategorized.map((item) => (
            <ArticleCard title={item.title} description={item.description} href={item.href} pillar="food" image={item.image} imageAlt={item.imageAlt} heroImage={item.heroImage} heroImageAlt={item.heroImageAlt} pubDate={item.pubDate} />
          ))}
        </div>
      </>
    )}

    <h2 id={spainMapGroup.id} class="font-sans font-bold text-xl text-navy mb-5">{spainMapGroup.label}</h2>
    <p class="text-muted text-base leading-relaxed mb-8">
      州ごとのグルメガイドと、7つの美食ゾーンで探せるインタラクティブマップへの入り口です。気になる街を選んで、現地のリアルな食文化をのぞいてみてください。
    </p>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {spainMapGroup.items.map((item) => (
        <ArticleCard title={item.title} description={item.description} href={item.href} pillar="food" pubDate={item.pubDate} topicBadge={spainMapGroup.label} />
      ))}
    </div>
  </section>
  <section class="max-w-6xl mx-auto px-5 pb-14">
    <AdSlot
      position="pillar-bottom"
      interlinkTitle="ラ・リーガとは？"
      interlinkUrl="/football/la-liga/"
      interlinkPillar="スペインサッカー"
      interlinkReadingTime={5}
    />
  </section>
  <LineBanner slim />
</BaseLayout>

