---
// Hub /food/ (rediseño del 18 de noviembre de 2026, mockup aprobado por David). Primero el móvil:
// cabecera compacta, 01 la スペイン美食マップ como bloque principal (mapa por comunidades, botón y
// provincias populares), accesos rápidos fijos y bloques en carrusel con flechas (rejilla en
// escritorio): 02 名物料理・食材 (orden de visitas en GA4), 03 バル・レストラン文化, 04 las 10 zonas
// de food-routes, 05 ワイン・歴史・語彙 y el banner a /regions/; después la guía de uso, FAQ y lo de
// siempre. Los artículos salen de la colección (por cluster), así que uno nuevo aparece solo.
import { getCollection, getEntry } from 'astro:content';
import { ArrowRight, ChevronDown, ChevronRight, Map as MapIcon, Star } from 'lucide-astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SEO from '../../components/SEO.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Rail from '../../components/Rail.astro';
import RegionsBanner from '../../components/RegionsBanner.astro';
import LineBanner from '../../components/LineBanner.astro';
import FloatingActions from '../../components/FloatingActions.astro';
import NewsletterForm from '../../components/NewsletterForm.astro';
import ArticleDisclaimer from '../../components/ArticleDisclaimer.astro';
import AuthorBox from '../../components/AuthorBox.astro';
import { getArticleUrl } from '../../utils/articles';
import { cardImage } from '../../utils/images';
import { foodMapPreview } from '../../utils/foodMap';

const SITE = 'https://supein.club';
const canonical = `${SITE}/food/`;
const author = await getEntry('authors', 'david-recalde');
const breadcrumbs = [
  { name: 'ホーム', url: '/' },
  { name: 'スペイン料理', url: canonical },
];

const otherPillars = [
  { href: '/travel/', title: 'スペイン旅行', description: 'バルセロナ・マドリードから南部アンダルシア、離島まで、観光スポットとツアー情報を完全網羅' },
  { href: '/language/', title: 'スペイン語', description: 'レッスン・語学学校・学習アプリの選び方まで、スペイン語習得に役立つ情報を体系的に紹介' },
  { href: '/living/', title: 'スペインに住む', description: '留学・現地での仕事探し・ビザ取得の手続きまで、スペイン生活のリアルな実情を詳しく紹介' },
  { href: '/culture/', title: 'スペイン文化', description: 'フラメンコ・歴史的建造物・伝統の祭りなど、スペイン文化の奥深い魅力を詳しく紹介します' },
  { href: '/football/', title: 'スペインサッカー', description: 'ラ・リーガの試合結果や移籍情報、代表チーム、バルセロナやレアルの歴史まで深掘り解説します' },
];

const foodFaq = [
  { question: 'スペイン料理のコンテンツはどこから見ればいいですか？', answer: 'バルとレストランでの過ごし方をまず知りたい方は<a href="/food/tapas/">「タパス文化完全ガイド」</a>から。地方ごとの食文化を一気に知りたい方は<a href="/food/food-routes/">「地方グルメルート」</a>がおすすめです。' },
  { question: '本場のパエリアについて知りたい場合は？', answer: '歴史・格付け・本場の技法までを<a href="/food/paella/">「パエリア完全ガイド」</a>で詳しく解説しています。' },
  { question: 'ハモン・イベリコの格付けの違いを知りたい場合は？', answer: '等級（ベジョータ・セボ・デ・カンポなど）の違いを<a href="/food/jamon-iberico/">「ハモン・イベリコ完全ガイド」</a>で解説しています。' },
  { question: 'スペインワインの選び方がわかりません。', answer: 'DO・DOCa・クリアンサなどの格付けと、11の主要産地を<a href="/food/spanish-wine/">「スペインワイン完全ガイド」</a>にまとめています。' },
  { question: 'バルでの注文の仕方やマナーを知りたい場合は？', answer: 'カウンターでの注文方法からチップの相場まで、<a href="/food/spain-bar-restaurant/">「バル・レストラン活用ガイド」</a>で解説しています。' },
  { question: '県ごとのおすすめレストランを探すには？', answer: '<a href="/food/spain-map/">「スペイン美食マップ」</a>で地図や17の地方から県を選ぶと、その県の目的別レストランランキング（安くて美味しい店・タパスバル・高級店）と名物料理がわかります。' },
];

// ── Artículos por bloque (cluster); dentro de cada bloque, los principales primero y en orden de visitas ──
const articles = await getCollection('articles', ({ data }) => !data.draft && data.pillar === 'food' && !data.cluster.startsWith('spain-map-'));
const BLOCKS = [
  { id: 'dishes', tag: '名物料理・食材', clusters: ['spanish-desserts', 'paella', 'souvenirs', 'jamon-iberico', 'olive-oil'] },
  { id: 'bar', tag: 'バル・食事', clusters: ['tapas', 'spain-bar-restaurant', 'spain-dining-times'] },
  { id: 'zones', tag: '美食ゾーン', clusters: ['food-routes'] },
  { id: 'more', tag: '', clusters: ['spanish-vocabulary', 'columbian-exchange', 'spanish-wine'] },
] as const;
const MORE_TAG: Record<string, string> = { 'spanish-vocabulary': 'グルメ語彙', 'columbian-exchange': '食の歴史', 'spanish-wine': 'スペインワイン' };
const ZONE_ORDER = ['asturias-cantabria-mar-cantabrico', 'rioja-pais-vasco-vino-pintxos', 'noroeste-marisco-albarino', 'aragon-navarra-ternasco-esparragos', 'centro-asado-vino-tinto', 'este-paella-tapas', 'sur-fritos-flamenco', 'oeste-jamon-iberico', 'islas-canarias-atlantico', 'islas-baleares-mediterraneo'];
const slugOf = (a: (typeof articles)[number]) => a.id.replace(/\.(md|mdx)$/, '').split('/').pop() ?? '';
const isMain = (a: (typeof articles)[number]) => slugOf(a) === a.data.cluster;
const rank = (block: (typeof BLOCKS)[number], a: (typeof articles)[number]) => {
  if (block.id === 'zones') return ZONE_ORDER.indexOf(slugOf(a)) + 1 || 99;
  return (isMain(a) ? 0 : 100) + (block.clusters as readonly string[]).indexOf(a.data.cluster);
};
const toCard = async (a: (typeof articles)[number], tag: string) => {
  const hero = a.data.heroImage && typeof a.data.heroImage !== 'string' ? a.data.heroImage : undefined;
  return { url: getArticleUrl(a), title: a.data.title, short: a.data.title.split('｜')[0], description: a.data.description, tag, img: hero ? await cardImage(hero, a.data.heroImageAlt ?? '') : undefined };
};
const blocks = Object.fromEntries(await Promise.all(BLOCKS.map(async (b) => {
  const list = articles.filter((a) => (b.clusters as readonly string[]).includes(a.data.cluster)).sort((x, y) => rank(b, x) - rank(b, y));
  return [b.id, await Promise.all(list.map((a) => toCard(a, b.tag || MORE_TAG[a.data.cluster] || 'スペイン料理')))];
})));
// Clusters de comida que aún no tienen bloque: van al final de 「もっと知る」 para que nada quede sin enlazar.
const placed = new Set(BLOCKS.flatMap((b) => b.clusters as readonly string[]));
const rest = await Promise.all(articles.filter((a) => !placed.has(a.data.cluster)).map((a) => toCard(a, 'スペイン料理')));
blocks.more = [...blocks.more, ...rest];

// ── Mapa (mismo dibujo que /food/spain-map/, sin enlaces: el bloque entero lleva al mapa) ──
const { svg: mapSvg, bySlug, count: provinceCount } = await foodMapPreview();
const POPULAR = ['madrid', 'barcelona', 'sevilla', 'valencia', 'granada', 'malaga', 'toledo', 'guipuzcoa'].filter((p) => bySlug.has(p)).map((p) => ({ slug: p, name: bySlug.get(p)!.data.provinceJa }));
const articleCount = articles.length;

const SECTIONS = [
  { id: 'map', label: '美食マップ' },
  { id: 'dishes', label: '名物料理' },
  { id: 'bar', label: 'バル・食事' },
  { id: 'zones', label: '美食ゾーン' },
  { id: 'more', label: 'もっと知る' },
];

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'スペイン料理',
  description: '県別のレストランガイド（スペイン美食マップ）、名物料理と食材、バル・レストラン文化、10の美食ゾーン、ワインと食の歴史。',
  url: canonical,
  inLanguage: 'ja',
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: [{ url: '/food/spain-map/', title: 'スペイン美食マップ' }, ...blocks.dishes, ...blocks.bar, ...blocks.zones, ...blocks.more]
      .map((c, i) => ({ '@type': 'ListItem', position: i + 1, url: `${SITE}${c.url}`, name: c.title })),
  },
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: foodFaq.map((item) => ({ '@type': 'Question', name: item.question, acceptedAnswer: { '@type': 'Answer', text: item.answer.replace(/<[^>]+>/g, '') } })),
};
---
<BaseLayout>
  <SEO
    slot="seo"
    title="スペイン料理 完全ガイド"
    description="スペイン料理・グルメの世界を、地方ごとの個性豊かな食文化とあわせて日本語でわかりやすく紹介するガイドメディアです。本場のパエリアやタパスの情報から、県別のレストランガイド、ワインと食の歴史まで。"
    canonical={canonical}
    image="/og/food.webp"
    breadcrumbs={breadcrumbs}
  />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(collectionSchema)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqSchema)} />

  <section class="fd-hero">
    <div class="page-container">
      <Breadcrumb items={breadcrumbs} dark />
      <p class="fd-eyebrow">SPANISH FOOD</p>
      <h1 class="fd-h1">スペイン料理</h1>
      <p class="fd-lead">地方ごとに驚くほど多彩なスペインの食文化を、日本語で。県別のレストランガイドから、名物料理、バルの楽しみ方まで。</p>
      <ul class="fd-stats">
        <li><b>{provinceCount}</b><small>県のグルメガイド</small></li>
        <li><b>{blocks.zones.length}</b><small>美食ゾーン</small></li>
        <li><b>{articleCount}</b><small>特集記事</small></li>
      </ul>
    </div>
  </section>

  <section class="fd-block fd-block--map" id="map">
    <div class="page-container">
      <div class="fd-mapfeat">
        <a class="fd-mapfeat-map" href="/food/spain-map/" aria-label="スペイン美食マップを開く">
          <span class="fd-mapbadge"><Star size={14} />おすすめ</span>
          <Fragment set:html={mapSvg} />
        </a>
        <div class="fd-mapfeat-body">
          <p class="hub-block-eyebrow"><span class="hub-block-num">01</span>スペイン美食マップ</p>
          <h2>地図から県を選んで、<br />レストランを探す</h2>
          <p>{provinceCount}の県それぞれに、安くて美味しい店・タパスバル・高級店のランキングと名物料理のガイドがあります。</p>
          <a class="fd-mapfeat-cta" href="/food/spain-map/"><MapIcon size={20} />美食マップを開く<ArrowRight size={18} /></a>
          <p class="fd-poplab">人気の県</p>
          <ul class="fd-pchips">
            {POPULAR.map((p) => <li><a href={`/food/spain-map/${p.slug}/`}>{p.name}</a></li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <nav class="fd-chips" aria-label="このページの内容">
    <div class="page-container">
      {SECTIONS.map((s, i) => <a href={`#${s.id}`} data-chip={s.id}><i>{String(i + 1).padStart(2, '0')}</i>{s.label}</a>)}
      <a href="#faq" data-chip="faq">FAQ</a>
    </div>
  </nav>

  {[
    { id: 'dishes', num: '02', eyebrow: '名物料理・食材', title: 'スペインの名物料理と食材', hint: 'スワイプして他のガイドを見る', cols: 3, soft: false },
    { id: 'bar', num: '03', eyebrow: 'バル・レストラン文化', title: 'バルとレストランを楽しむ', hint: 'スワイプして続きを見る', cols: 3, soft: true },
    { id: 'zones', num: '04', eyebrow: '10の美食ゾーン', title: '地方の食文化を巡る', lead: '気候や歴史で分けた10のエリアの、7日間のグルメルート。', more: { href: '/food/food-routes/', label: '地方グルメルートの一覧' }, hint: 'スワイプして全10ゾーンを見る', cols: 5, soft: false },
    { id: 'more', num: '05', eyebrow: 'もっと知る', title: 'ワイン・歴史・メニューの言葉', hint: 'スワイプして続きを見る', cols: 3, soft: true },
  ].map((b) => blocks[b.id].length > 0 && (
    <section class:list={['hub-block', 'fd-block', { 'is-soft': b.soft }]} id={b.id}>
      <div class="page-container">
        <div class="hub-block-head">
          <p class="hub-block-eyebrow"><span class="hub-block-num">{b.num}</span>{b.eyebrow}</p>
          <h2>{b.title}</h2>
          {b.lead && <p class="hub-block-lead">{b.lead}</p>}
        </div>
        <Rail label={b.title} hint={b.hint} desktopColumns={b.cols}>
          {blocks[b.id].map((c, i) => (
            <a class:list={['fd-card', { 'is-compact': b.id === 'zones' }]} href={c.url} role="listitem">
              {c.img && <img src={c.img.src} srcset={c.img.srcset} sizes={b.cols === 5 ? '(min-width: 860px) 220px, 62vw' : '(min-width: 860px) 360px, 76vw'} width={c.img.width} height={c.img.height} alt="" loading="lazy" decoding="async" />}
              <span class="fd-card-body">
                {b.id === 'zones' && <span class="fd-card-n">{String(i + 1).padStart(2, '0')}</span>}
                <span class="fd-tag">{c.tag}</span>
                <span class="fd-card-title">{b.id === 'zones' ? c.short : c.title}</span>
                {b.id !== 'zones' && <span class="fd-card-desc">{c.description}</span>}
              </span>
            </a>
          ))}
        </Rail>
        {b.more && <p class="fd-more"><a href={b.more.href}>{b.more.label}<ChevronRight size={16} /></a></p>}
        {b.id === 'more' && <div class="fd-regions"><RegionsBanner /></div>}
      </div>
    </section>
  ))}

  <section class="hub-block fd-block" id="faq">
    <div class="page-container fd-narrow">
      <div class="hub-block-head">
        <p class="hub-block-eyebrow">このサイトのスペイン料理ガイド</p>
        <h2>目的別の読み方</h2>
      </div>
      <div class="fd-guide">
        <p>このカテゴリでは、本場の味や技法を深掘りする名物料理ガイド、バル・レストランでの過ごし方、県ごとのグルメ情報まで、目的別に情報を整理しています。</p>
        <p>スペインは地方ごとに驚くほど個性豊かな食文化を持っています。地域と名物料理の組み合わせをまとめて知りたい方は<a href="/food/food-routes/">「地方グルメルート」</a>から。県単位でもっと詳しく探したい方は<a href="/food/spain-map/">「スペイン美食マップ」</a>をご覧ください。</p>
        <p>本場の技法や格付けまで深掘りしたい方には<a href="/food/paella/">「パエリア完全ガイド」</a>と<a href="/food/jamon-iberico/">「ハモン・イベリコ完全ガイド」</a>がおすすめです。ワイン選びに迷ったら<a href="/food/spanish-wine/">「スペインワイン完全ガイド」</a>も参考にしてください。</p>
        <p>タパスの文化やバルでの注文方法、食事の時間帯の違いなど、現地で戸惑わないための実践ガイドを<a href="/food/tapas/">「タパス文化完全ガイド」</a>と<a href="/food/spain-bar-restaurant/">「バル・レストラン活用ガイド」</a>にまとめています。</p>
      </div>

      <div class="fd-faq">
        <p class="hub-block-eyebrow">よくある質問</p>
        <h2>スペイン料理のFAQ</h2>
        {foodFaq.map((f, i) => (
          <details open={i === 0}>
            <summary><span class="q" aria-hidden="true">Q</span><span>{f.question}</span><ChevronDown size={18} /></summary>
            <p set:html={f.answer} />
          </details>
        ))}
      </div>

      <div data-pagefind-ignore class="fd-newsletter"><NewsletterForm variant="inline" /></div>
      {author && <ArticleDisclaimer />}
      {author && <AuthorBox author={author} />}
    </div>
  </section>

  <section class="page-container fd-related" data-pagefind-ignore>
    <h2 class="font-sans font-bold text-2xl text-navy mb-2">こちらの記事もおすすめ</h2>
    <p class="text-sm text-gray-500 mb-6">スペインの他のテーマも見てみませんか。</p>
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
      {otherPillars.map((p) => (
        <a href={p.href} class="block bg-white rounded-xl overflow-hidden shadow-[0_2px_8px_rgba(0,33,71,0.07)] border border-[#E8E8E6] hover:shadow-[0_4px_16px_rgba(0,33,71,0.12)] hover:border-primary/20 transition-all p-6">
          <h3 class="font-sans font-bold text-navy text-lg mb-2">{p.title}</h3>
          <p class="text-muted text-sm leading-relaxed">{p.description}</p>
        </a>
      ))}
    </div>
  </section>

  <LineBanner slim />
  <FloatingActions target="map" shareUrl={canonical} shareTitle="スペイン料理" />
</BaseLayout>

<script>
  // Accesos rápidos: marca la sección visible.
  const chips = [...document.querySelectorAll<HTMLAnchorElement>('.fd-chips a[data-chip]')];
  const io = new IntersectionObserver((entries) => entries.forEach((e) => {
    if (!e.isIntersecting) return;
    chips.forEach((c) => c.classList.toggle('is-on', c.dataset.chip === e.target.id));
  }), { rootMargin: '-35% 0px -60% 0px' });
  chips.forEach((c) => { const s = document.getElementById(c.dataset.chip!); if (s) io.observe(s); });
</script>

<style is:global>
  .fd-hero { position: relative; overflow: hidden; padding: 22px 0 24px; background: #002147; color: #fff; }
  .fd-hero::before { content: ''; position: absolute; inset: 0; background-image: radial-gradient(rgba(255, 255, 255, .07) 1px, transparent 1px); background-size: 22px 22px; pointer-events: none; }
  .fd-hero .page-container { position: relative; }
  .fd-eyebrow { margin: 14px 0 0; font-size: 12px; font-weight: 700; letter-spacing: .1em; color: #ff8a9a; }
  .fd-h1 { margin: 4px 0 0; font-family: 'Noto Serif JP', serif; font-size: 34px; font-weight: 700; line-height: 1.25; color: #fff; }
  .fd-lead { max-width: 660px; margin: 10px 0 0; font-size: 14px; line-height: 1.8; color: rgba(255, 255, 255, .86); }
  .fd-stats { display: flex; gap: 8px; max-width: 460px; margin: 12px 0 0; padding: 0; list-style: none; }
  .fd-stats li { flex: 1; padding: 8px 4px; border: 1px solid rgba(255, 255, 255, .2); border-radius: 12px; background: rgba(255, 255, 255, .08); text-align: center; }
  .fd-stats b { display: block; font-size: 20px; line-height: 1.2; }
  .fd-stats small { font-size: 11px; color: rgba(255, 255, 255, .7); }

  .fd-block { padding: 34px 0; scroll-margin-top: 56px; --rail-fade: #fff; }
  .fd-block.is-soft { background: #F0F4F8; --rail-fade: #F0F4F8; }
  .fd-block .hub-block-head { margin-bottom: 16px; }
  .fd-block h2 { word-break: auto-phrase; }
  .fd-block--map { padding: 20px 0 30px; background: #FAFAF8; }
  .fd-mapfeat { overflow: hidden; border: 1px solid #E3E8EF; border-radius: 20px; background: #fff; box-shadow: 0 18px 40px -22px rgba(0, 33, 71, .45); }
  .fd-mapfeat-map { position: relative; display: block; padding: 14px 12px 8px; background: #F0F4F8; }
  .fd-mapfeat-map > svg { display: block; width: 100%; height: auto; }
  .fd-mapfeat-map path { stroke: #fff; stroke-width: .7; transition: filter .15s; }
  .fd-mapfeat-map:hover path { filter: brightness(.95); }
  .fd-mapfeat-map rect { fill: none; stroke: #9ca3af; stroke-dasharray: 2, 2; }
  .fd-mapbadge { position: absolute; top: 12px; left: 14px; z-index: 1; display: inline-flex; align-items: center; gap: 6px; padding: 5px 11px; border-radius: 999px; background: #C8102E; color: #fff; font-size: 11.5px; font-weight: 700; }
  .fd-mapfeat-body { padding: 18px 18px 20px; }
  .fd-mapfeat-body h2 { margin: 0; font-size: 22px; font-weight: 700; line-height: 1.4; color: #002147; }
  .fd-mapfeat-body > p:not(.hub-block-eyebrow):not(.fd-poplab) { margin: 6px 0 0; font-size: 14px; line-height: 1.8; color: #4b5563; }
  .fd-mapfeat-cta { display: flex; align-items: center; justify-content: center; gap: 8px; min-height: 52px; margin-top: 14px; border-radius: 12px; background: #C8102E; color: #fff; font-size: 16px; font-weight: 700; text-decoration: none; box-shadow: 0 10px 20px -10px rgba(200, 16, 46, .8); }
  .fd-mapfeat-cta:hover { background: #A00D24; color: #fff; }
  .fd-poplab { margin: 16px 0 0; font-size: 12px; font-weight: 700; color: #5A6B80; }
  .fd-pchips { display: flex; flex-wrap: wrap; gap: 6px; margin: 8px 0 0; padding: 0; list-style: none; }
  .fd-pchips li { margin: 0; }
  .fd-pchips a { display: inline-flex; align-items: center; min-height: 36px; padding: 0 12px; border: 1.5px solid #E3E8EF; border-radius: 999px; background: #fff; font-size: 13px; font-weight: 700; color: #002147; text-decoration: none; }
  .fd-pchips a:hover { border-color: #002147; }

  /* Justo debajo de la cabecera fija de la web (Navigation: 64 px + 3 px de borde). */
