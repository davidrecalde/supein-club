---
import { getCollection, getEntry } from 'astro:content';
import heroSpainMap from '../../assets/hero/hero-spain-map.webp';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SEO from '../../components/SEO.astro';
import PillarHero from '../../components/PillarHero.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import LineBanner from '../../components/LineBanner.astro';
import FloatingActions from '../../components/FloatingActions.astro';
import RegionCTA from '../../components/RegionCTA.astro';
import NewsletterForm from '../../components/NewsletterForm.astro';
import ArticleDisclaimer from '../../components/ArticleDisclaimer.astro';
import AuthorBox from '../../components/AuthorBox.astro';
import FAQSection from '../../components/FAQSection.astro';
import { getArticleUrl } from '../../utils/articles';

const author = await getEntry('authors', 'david-recalde');

const otherPillars = [
  { href: '/travel/', title: 'スペイン旅行', description: 'バルセロナ・マドリードから南部アンダルシア、離島まで、観光スポットとツアー情報を完全網羅' },
  { href: '/language/', title: 'スペイン語', description: 'レッスン・語学学校・学習アプリの選び方まで、スペイン語習得に役立つ情報を体系的に紹介' },
  { href: '/living/', title: 'スペインに住む', description: '留学・現地での仕事探し・ビザ取得の手続きまで、スペイン生活のリアルな実情を詳しく紹介' },
  { href: '/culture/', title: 'スペイン文化', description: 'フラメンコ・歴史的建造物・伝統の祭りなど、スペイン文化の奥深い魅力を詳しく紹介します' },
  { href: '/football/', title: 'スペインサッカー', description: 'ラ・リーガの試合結果や移籍情報、代表チーム、バルセロナやレアルの歴史まで深掘り解説します' },
];

const articles = await getCollection('articles', ({ data }) => !data.draft && data.pillar === 'food');
const sorted = articles.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// カテゴリ分類：クラスターをテーマごとにグループ化。新しいクラスターを
// 追加する際は、既存カテゴリに合うものがあれば clusters に追記し、なければ
// 新しいカテゴリを1行追加する（該当カテゴリがないクラスターは自動的に
// 「その他」に入る）。
const categories = [
  { id: 'food-routes', label: '地方グルメルート', clusters: ['food-routes'] },
  { id: 'iconic-dishes', label: '名物料理・食材ガイド', clusters: ['paella', 'jamon-iberico', 'souvenirs', 'spanish-desserts', 'olive-oil'] },
  { id: 'food-history', label: '食の歴史', clusters: ['columbian-exchange'] },
  { id: 'spanish-wine', label: 'スペインワイン', clusters: ['spanish-wine'] },
  { id: 'dining-culture', label: 'バル・レストラン文化', clusters: ['tapas', 'spain-bar-restaurant', 'spain-dining-times'] },
  { id: 'spanish-vocabulary', label: 'グルメ語彙', clusters: ['spanish-vocabulary'] },
];

function toCardItem(a: (typeof sorted)[number]) {
  return {
    title: a.data.title,
    description: a.data.description,
    href: getArticleUrl(a),
    pubDate: a.data.pubDate,
    image: a.data.image,
    imageAlt: a.data.imageAlt,
    heroImage: a.data.heroImage,
    heroImageAlt: a.data.heroImageAlt,
  };
}

const categoryGroups = categories
  .map((c) => ({ ...c, items: sorted.filter((a) => c.clusters.includes(a.data.cluster)).map(toCardItem) }))
  .filter((g) => g.items.length > 0);

const isSpainMapRanking = (cluster: string) => cluster.startsWith('spain-map-');

const categorizedIds = new Set(categories.flatMap((c) => sorted.filter((a) => c.clusters.includes(a.data.cluster)).map((a) => a.id)));
const uncategorized = sorted.filter((a) => !categorizedIds.has(a.id) && !isSpainMapRanking(a.data.cluster)).map(toCardItem);

// スペイン美食マップ：都道府県別の探索は /food/spain-map/ に一本化されている
// （インタラクティブマップ + 7つの美食ゾーン + 各県ページが自身の3つの
// ランキング記事=the-best-restaurants/cheap-restaurants/tapas-barsに
// リンクする独自ハブになっている）。ここでは重複を避けるため、そのハブ
// ページへの単一カードのみを表示する（都道府県カードを1枚ずつ並べない）。
const spainMapGroup = {
  id: 'spain-map',
  label: 'スペイン美食マップ',
  items: [
    {
      title: 'スペイン美食マップ｜州別レストラン・バルガイド',
      description: '7つの美食ゾーンで探せるインタラクティブマップ。全都道府県、地方ごとのレストラン・バル情報をまとめています。',
      href: '/food/spain-map/',
      pubDate: new Date('2026-09-07'),
      heroImage: heroSpainMap,
      heroImageAlt: 'スペインの自治州別マップ',
    },
  ],
};

const categoryAnchors = [
  ...categoryGroups.map((g) => ({ href: `#${g.id}`, label: g.label })),
  { href: '/food/spain-map/', label: spainMapGroup.label },
];

const breadcrumbs = [
  { name: 'ホーム', url: '/' },
  { name: 'スペイン料理', url: '/food/' },
];

const foodFaq = [
  {
    question: 'スペイン料理のコンテンツはどこから見ればいいですか？',
    answer: 'バルとレストランでの過ごし方をまず知りたい方は<a href="/food/tapas/">「タパス文化完全ガイド」</a>から。地方ごとの食文化を一気に知りたい方は<a href="/food/food-routes/">「地方グルメルート」</a>がおすすめです。',
  },
  {
    question: '本場のパエリアについて知りたい場合は？',
    answer: '歴史・格付け・本場の技法までを<a href="/food/paella/">「パエリア完全ガイド」</a>で詳しく解説しています。',
  },
  {
    question: 'ハモン・イベリコの格付けの違いを知りたい場合は？',
    answer: '等級（ベジョータ・セボ・デ・カンポなど）の違いを<a href="/food/jamon-iberico/">「ハモン・イベリコ完全ガイド」</a>で解説しています。',
  },
  {
    question: 'スペインワインの選び方がわかりません。',
    answer: 'DO・DOCa・クリアンサなどの格付けと、11の主要産地を<a href="/food/spanish-wine/">「スペインワイン完全ガイド」</a>にまとめています。',
  },
  {
    question: 'バルでの注文の仕方やマナーを知りたい場合は？',
    answer: 'カウンターでの注文方法からチップの相場まで、<a href="/food/spain-bar-restaurant/">「バル・レストラン活用ガイド」</a>で解説しています。',
  },
  {
    question: '県ごとのおすすめレストランを探すには？',
    answer: '7つの美食ゾーンから探せるインタラクティブマップを<a href="/food/spain-map/">「スペイン美食マップ」</a>に用意しています。気になる県を選ぶと、その県の定番料理やおすすめレストランが確認できます。',
  },
];
---
<BaseLayout>
  <SEO
    slot="seo"
    title="スペイン料理 完全ガイド"
    description="スペイン料理・グルメの世界を、地方ごとの個性豊かな食文化とあわせて日本語でわかりやすく紹介するガイドメディアです。本場のパエリアやタパスの情報から、日本国内で楽しめるおすすめのスペイン料理店の紹介まで、レシピや現地の食文化の背景を含めて幅広いテーマを網羅しています。"
    canonical="https://supein.club/food/"
    image="/og/food.webp"
    breadcrumbs={breadcrumbs}
  />
  <script
    type="application/ld+json"
    slot="head"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: foodFaq.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: { '@type': 'Answer', text: item.answer.replace(/<[^>]+>/g, '') },
      })),
    })}
  />
  <PillarHero
    title="スペイン料理"
    description="地方ごとに驚くほど多彩な、スペインの食文化の世界へようこそ。"
  />
  <section class="max-w-6xl mx-auto px-5 py-14">
    <p class="text-muted text-base leading-relaxed mb-12 border-l-2 border-primary pl-5">
      スペイン料理・グルメは、地方ごとに驚くほど個性豊かな顔を持つ、奥深いテーマです。本カテゴリでは、そんなスペイン料理の世界を日本語でわかりやすくご紹介しています。
    </p>
    {categoryAnchors.length > 0 && (
      <>
        <h2 id="categories" class="font-sans font-bold text-xl text-navy mb-5">カテゴリ</h2>
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-3 mb-12">
          {categoryAnchors.map(({ href, label }) => (
            <a href={href} class="bg-white rounded-lg px-3 py-3 min-h-[44px] flex items-center justify-center text-center border border-[#E8E8E6] hover:border-primary/30 hover:shadow-sm transition-all">
              <span class="font-semibold text-navy text-sm leading-snug block">{label}</span>
            </a>
          ))}
        </div>
      </>
    )}

    <RegionCTA />

    {categoryGroups.map((group) => (
      <>
        <h2 id={group.id} class="font-sans font-bold text-xl text-navy mb-5">{group.label}</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
          {group.items.map((item) => (
            <ArticleCard title={item.title} description={item.description} href={item.href} pillar="food" image={item.image} imageAlt={item.imageAlt} heroImage={item.heroImage} heroImageAlt={item.heroImageAlt} pubDate={item.pubDate} topicBadge={group.label} />
          ))}
        </div>
      </>
    ))}

    {uncategorized.length > 0 && (
      <>
        <h2 id="other" class="font-sans font-bold text-xl text-navy mb-5">その他</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
          {uncategorized.map((item) => (
            <ArticleCard title={item.title} description={item.description} href={item.href} pillar="food" image={item.image} imageAlt={item.imageAlt} heroImage={item.heroImage} heroImageAlt={item.heroImageAlt} pubDate={item.pubDate} />
          ))}
        </div>
      </>
    )}

    <h2 id={spainMapGroup.id} class="font-sans font-bold text-xl text-navy mb-5">
      <a href="/food/spain-map/" class="hover:text-primary transition-colors">{spainMapGroup.label}</a>
    </h2>
    <p class="text-muted text-base leading-relaxed mb-8">
      州ごとのグルメガイドと、7つの美食ゾーンで探せるインタラクティブマップへの入り口です。気になる街を選んで、現地のリアルな食文化をのぞいてみてください。
    </p>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
      {spainMapGroup.items.map((item) => (
        <ArticleCard title={item.title} description={item.description} href={item.href} pillar="food" heroImage={item.heroImage} heroImageAlt={item.heroImageAlt} pubDate={item.pubDate} topicBadge={spainMapGroup.label} />
      ))}
    </div>

  </section>

  <section class="max-w-6xl mx-auto px-5 pb-14 prose-content">
  <div class="max-w-[780px]">
    <h2 class="font-sans font-bold text-xl text-navy mb-4">このサイトのスペイン料理コンテンツについて</h2>
    <p class="text-muted leading-relaxed mb-6">
      このカテゴリでは、本場の味や技法を深掘りする名物料理ガイド、バル・レストランでの過ごし方、県ごとのグルメ情報まで、目的別に情報を整理しています。まず何から見ればいいか迷ったら、下記の各セクションをご覧ください。
    </p>

    <h2 class="font-sans font-bold text-xl text-navy mb-4">地方ごとの食文化を知るなら</h2>
    <p class="text-muted leading-relaxed mb-6">
      スペインは地方ごとに驚くほど個性豊かな食文化を持っています。地域と名物料理の組み合わせをまとめて知りたい方は<a href="/food/food-routes/" class="text-primary underline">「地方グルメルート」</a>から。県単位でもっと詳しく探したい方は<a href="/food/spain-map/" class="text-primary underline">「スペイン美食マップ」</a>をご覧ください。
    </p>

    <h2 class="font-sans font-bold text-xl text-navy mb-4">名物料理を深く知るなら</h2>
    <p class="text-muted leading-relaxed mb-6">
      本場の技法や格付けまで深掘りしたい方には<a href="/food/paella/" class="text-primary underline">「パエリア完全ガイド」</a>と<a href="/food/jamon-iberico/" class="text-primary underline">「ハモン・イベリコ完全ガイド」</a>がおすすめです。ワイン選びに迷ったら<a href="/food/spanish-wine/" class="text-primary underline">「スペインワイン完全ガイド」</a>も参考にしてください。
    </p>

    <h2 class="font-sans font-bold text-xl text-navy mb-4">バル・レストランでの過ごし方</h2>
    <p class="text-muted leading-relaxed mb-6">
      タパスの文化やバルでの注文方法、食事の時間帯の違いなど、現地で戸惑わないための実践ガイドを<a href="/food/tapas/" class="text-primary underline">「タパス文化完全ガイド」</a>と<a href="/food/spain-bar-restaurant/" class="text-primary underline">「バル・レストラン活用ガイド」</a>にまとめています。
    </p>

    <NewsletterForm variant="inline" />

    <FAQSection faq={foodFaq} />

    {author && <ArticleDisclaimer />}
    {author && <AuthorBox author={author} />}

    <section class="mt-12 border-t border-[#E8E8E6] pt-10">
      <h2 class="font-sans font-bold text-2xl text-navy mb-2">こちらの記事もおすすめ</h2>
      <p class="text-sm text-gray-500 mb-6">スペインの他のテーマも見てみませんか。</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
        {otherPillars.map((p) => (
          <a href={p.href} class="block bg-white rounded-xl overflow-hidden shadow-[0_2px_8px_rgba(0,33,71,0.07)] border border-[#E8E8E6] hover:shadow-[0_4px_16px_rgba(0,33,71,0.12)] hover:border-primary/20 transition-all p-6">
            <h3 class="font-sans font-bold text-navy text-lg mb-2">{p.title}</h3>
            <p class="text-muted text-sm leading-relaxed">{p.description}</p>
          </a>
        ))}
      </div>
    </section>
  </div>
  </section>

  <LineBanner slim />
  <FloatingActions target="categories" shareUrl="https://supein.club/food/" shareTitle="スペイン料理" />
</BaseLayout>

