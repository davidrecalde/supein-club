---
// Hub /food/spain-map/ (rediseño del 17 de noviembre de 2026, mockup aprobado por David). Primero el
// móvil: mapa arriba (cada provincia con el color de su comunidad; al tocarla, tarjeta con su nombre y
// enlace a la guía), accesos rápidos fijos y bloques numerados como /language/: 01 las 17 comunidades
// en banners horizontales con foto y botones de sus provincias, 02 las 10 zonas gastronómicas con la
// foto de su artículo (carrusel con flechas en el móvil, 2 columnas en escritorio), 03 banner al hub
// de regiones; después el FAQ y lo de siempre (newsletter, autor, artículos relacionados).
import { getCollection } from 'astro:content';
import { ArrowRight, ChevronDown, Hand, X } from 'lucide-astro';
import heroSpainMap from '../../../assets/hero/hero-spain-map.webp';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SEO from '../../../components/SEO.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import Rail from '../../../components/Rail.astro';
import RegionsBanner from '../../../components/RegionsBanner.astro';
import LineBanner from '../../../components/LineBanner.astro';
import NewsletterForm from '../../../components/NewsletterForm.astro';
import RelatedPages from '../../../components/RelatedPages.astro';
import ArticleDisclaimer from '../../../components/ArticleDisclaimer.astro';
import AuthorBox from '../../../components/AuthorBox.astro';
import ArticleCard from '../../../components/ArticleCard.astro';
import FloatingActions from '../../../components/FloatingActions.astro';
import { communityColorMap } from '../../../data/spainCommunities';
import { MAP_COMMUNITIES } from '../../../data/spainMapCommunities';
import { PROVINCES } from '../../../data/provinces';
import { getArticleUrl } from '../../../utils/articles';
import { cardImage } from '../../../utils/images';
import { communityMap } from '../../../utils/spainMap';

const SITE = 'https://supein.club';
const canonical = `${SITE}/food/spain-map/`;
const breadcrumbs = [
  { name: 'ホーム', url: '/' },
  { name: 'スペイン料理', url: '/food/' },
  { name: 'スペイン美食マップ', url: canonical },
];

const faq = [
  {
    question: '「スペイン美食マップ」の使い方は？',
    answer: '地図の県をタップすると、その県の名前とグルメガイドへのリンクが表示されます。地図の下では、17の地方ごとに県のボタンを並べています。行き先が決まっていない場合は、「10の美食ゾーン」から地域ごとの食文化を先に読んでみるのもおすすめです。',
  },
  {
    question: '10の美食ゾーンとは何ですか？',
    answer: 'スペインを食文化の似た10のエリア（北部・バスク＆リオハ・北西部・アラゴン＆ナバラ・中部・東部・南部・西部・カナリア諸島・バレアレス諸島）に分け、それぞれの郷土料理やワイン・お酒の文化を紹介する特集記事です。県ごとの詳細なレストラン情報だけでなく、地域全体の食文化の背景を知りたい方におすすめです。',
  },
  {
    question: '県ごとのガイドには何が載っていますか？',
    answer: '目的別のレストランランキング（安くて美味しい店・タパスバル・高級店）、名物料理、エリア別の案内、レストランマップ、近隣の県へのリンクです。',
  },
];

const authors = await getCollection('authors');
const author = authors.find((a) => (a.data.slug ?? a.id.replace(/\.(md|mdx)$/, '')) === 'david-recalde')!;

// ── Provincias y comunidades ──
const provinces = await getCollection('spain-map', ({ data }) => data.draft !== true);
const bySlug = new Map(provinces.map((p) => [p.data.province, p]));
const rankingCount = (await getCollection('articles', ({ data }) => !data.draft && data.cluster.startsWith('spain-map-'))).length;
const communities = await Promise.all(MAP_COMMUNITIES.map(async (c) => {
  const photo = bySlug.get(c.photo)?.data.heroImage;
  return {
    ...c,
    color: communityColorMap[c.slug]?.flagColor ?? '#002147',
    img: photo ? await cardImage(photo, '') : undefined,
    items: c.provinces.filter((p) => bySlug.has(p)).map((p) => ({ slug: p, name: bySlug.get(p)!.data.provinceJa })),
  };
}));
const mapProvinces = Object.fromEntries(communities.flatMap((c) => c.items.map((p) => [
  PROVINCES[p.slug]?.code,
  { slug: p.slug, name: p.name, community: c.name, color: communityColorMap[c.slug]?.mapColor ?? '#ccc' },
])));
const mapSvg = communityMap(mapProvinces);

// ── 10 zonas gastronómicas (artículos de food-routes) ──
const ZONES = [
  { color: '#2D6A4F', title: '北部：シードルと魚介の道', provinces: 'アストゥリアス · カンタブリア', summary: 'シードル文化のアストゥリアスから、アンチョビの産地カンタブリアまで。', href: '/food/food-routes/asturias-cantabria-mar-cantabrico/' },
  { color: '#8E44AD', title: 'バスク・リオハ：ピンチョスとワインの道', provinces: 'バスク · リオハ', summary: '美食の街サン・セバスティアンのピンチョス文化から、名門ワイン産地リオハまで。', href: '/food/food-routes/rioja-pais-vasco-vino-pintxos/' },
  { color: '#1B4F72', title: '北西部：マリスコとアルバリーニョ', provinces: 'ガリシア', summary: 'タコ料理をはじめとする新鮮な魚介と、アルバリーニョワインの産地。', href: '/food/food-routes/noroeste-marisco-albarino/' },
  { color: '#B7950B', title: 'アラゴン・ナバラ：仔羊と野菜の道', provinces: 'アラゴン · ナバラ', summary: 'テルナスコとテルエル生ハムから、ナバラのホワイトアスパラガスまで。', href: '/food/food-routes/aragon-navarra-ternasco-esparragos/' },
  { color: '#002147', title: '中部：アサードと赤ワイン', provinces: 'マドリード · カスティーリャ・イ・レオン', summary: 'じっくり焼き上げるアサードと、力強い赤ワインの産地リベラ・デル・ドゥエロ。', href: '/food/food-routes/centro-asado-vino-tinto/' },
  { color: '#E67E22', title: '東部：地中海の食文化', provinces: 'バレンシア · カタルーニャ', summary: '稲作文化が育んだ米料理の発祥地から、市場文化が根付くバルセロナまで。', href: '/food/food-routes/este-paella-tapas/' },
  { color: '#C0392B', title: '南部：揚げ物とシェリー酒', provinces: 'アンダルシア', summary: '冷製スープ・ガスパチョの発祥地から、シェリー酒の産地ヘレスまで。', href: '/food/food-routes/sur-fritos-flamenco/' },
  { color: '#27AE60', title: '西部：イベリコ生ハムとチーズの道', provinces: 'エストレマドゥーラ · カスティーリャ・ラ・マンチャ', summary: 'イベリコ豚の放牧地デエサから、ケソ・マンチェゴとサフランの産地まで。', href: '/food/food-routes/oeste-jamon-iberico/' },
  { color: '#2980B9', title: 'カナリア諸島：火山の恵み', provinces: 'カナリア諸島', summary: '火山の大地が育んだしわしわポテトから、島の伝統食ゴフィオまで。', href: '/food/food-routes/islas-canarias-atlantico/' },
  { color: '#16A085', title: 'バレアレス諸島：地中海の恵み', provinces: 'バレアレス諸島', summary: '生ソーセージのソブラサーダから、渦巻き状のパン菓子エンサイマダまで。', href: '/food/food-routes/islas-baleares-mediterraneo/' },
];
const allArticles = await getCollection('articles', ({ data }) => !data.draft);
const byUrl = new Map(allArticles.map((a) => [getArticleUrl(a), a]));
const zones = await Promise.all(ZONES.map(async (z) => {
  const hero = byUrl.get(z.href)?.data.heroImage;
  return { ...z, img: hero && typeof hero !== 'string' ? await cardImage(hero, '') : undefined };
}));


// こちらの記事もおすすめ: los últimos artículos de food (sin spain-dining-times ni japan-map).
const relatedFoodArticles = allArticles
  .filter((a) => a.data.pillar === 'food' && !['spain-dining-times', 'japan-map'].includes(a.data.cluster) && !a.data.cluster.startsWith('spain-map-'))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'スペイン美食マップ',
  description: '17の地方・52の県のグルメガイドと、10の美食ゾーンの特集記事。',
  url: canonical,
  inLanguage: 'ja',
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: communities.flatMap((c) => c.items).map((p, i) => ({ '@type': 'ListItem', position: i + 1, url: `${SITE}/food/spain-map/${p.slug}/`, name: `${p.name}のグルメガイド` })),
  },
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({ '@type': 'Question', name: item.question, acceptedAnswer: { '@type': 'Answer', text: item.answer } })),
};
---
<BaseLayout title="スペイン美食マップ">
  <SEO
    slot="seo"
    title="スペイン美食マップ — 味で旅するスペイン"
    description="50県・10の美食ゾーンに分けて探す、本場スペインのグルメ体験マップです。スペイン倶楽部が現地情報をもとに厳選したレストラン・バルを、バスクのピンチョスからアンダルシアのガスパチョまで、地方色豊かな食文化や歴史的な背景とあわせて詳しく紹介します。"
    canonical={canonical}
    breadcrumbs={breadcrumbs}
    authorName={author.data.name}
    authorUrl={`https://supein.club/about-us/team/${author.data.slug ?? 'david-recalde'}/`}
    image={heroSpainMap.src}
  />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(collectionSchema)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqSchema)} />

  <section class="sm-hero" id="spain-map">
    <div class="page-container sm-hero-grid">
      <div>
        <Breadcrumb items={breadcrumbs} dark />
        <p class="sm-eyebrow">SPANISH FOOD MAP</p>
        <h1 class="sm-h1">スペイン美食マップ<span>味で旅するスペイン</span></h1>
        <p class="sm-lead">17の地方が育てた、驚くほど違う食文化。地図や地方から県を選ぶと、その県のレストランランキングと名物料理がわかります。</p>
        <ul class="sm-stats">
          <li><b>{provinces.length}</b><small>県・自治都市</small></li>
          <li><b>17</b><small>地方</small></li>
          <li><b>{rankingCount}</b><small>ランキング</small></li>
        </ul>
      </div>
      <div>
        <div class="sm-mapcard">
          <Fragment set:html={mapSvg} />
          <p class="sm-maphint"><Hand size={16} />県をタップして選ぶ</p>
        </div>
        <div class="sm-pick" data-pick hidden>
          <span class="sm-pick-dot" data-pick-dot></span>
          <span class="sm-pick-text"><b data-pick-name></b><small data-pick-community></small></span>
          <a class="sm-pick-go" data-pick-link href="/food/spain-map/">ガイドを見る<ArrowRight size={16} /></a>
          <button type="button" class="sm-pick-x" data-pick-close aria-label="閉じる"><X size={18} /></button>
        </div>
      </div>
    </div>
  </section>

  <nav class="sm-chips" aria-label="このページの内容">
    <div class="page-container">
      <a href="#communities" data-chip="communities"><i>01</i>地方から探す</a>
      <a href="#zones" data-chip="zones"><i>02</i>美食ゾーン</a>
      <a href="#regions" data-chip="regions"><i>03</i>地方ガイド</a>
      <a href="#faq" data-chip="faq">FAQ</a>
    </div>
  </nav>

  <section class="hub-block sm-block" id="communities">
    <div class="page-container">
      <div class="hub-block-head">
        <p class="hub-block-eyebrow"><span class="hub-block-num">01</span>地方から探す</p>
        <h2>17の地方と{provinces.length}の県</h2>
        <p class="hub-block-lead">地方を選んで、県のボタンからグルメガイドへ。</p>
      </div>
      <nav class="sm-jump" aria-label="地方へ移動">
        {communities.map((c) => <a href={`#c-${c.slug}`}>{c.name}</a>)}
      </nav>
      <div class="sm-coms">
        {communities.map((c) => (
          <article class="sm-com" id={`c-${c.slug}`}>
            <div class="sm-com-img">
              {c.img && <img src={c.img.src} srcset={c.img.srcset} sizes="(min-width: 860px) 220px, 34vw" width={c.img.width} height={c.img.height} alt="" loading="lazy" decoding="async" />}
            </div>
            <div class="sm-com-body">
              <h3 class="sm-com-head">
                {c.flags.map((f) => <img class="sm-flag" src={`/images/flags/${f}.webp`} alt="" width="24" height="16" loading="lazy" />)}
                <span>{c.name}</span>
                <small>{c.items.length}県</small>
              </h3>
              <p class="sm-com-food">{c.food}</p>
              <ul class="sm-pchips">
                {c.items.map((p) => <li><a href={`/food/spain-map/${p.slug}/`} style={`--cc:${c.color}`}>{p.name}</a></li>)}
              </ul>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="hub-block sm-block is-soft" id="zones">
    <div class="page-container">
      <div class="hub-block-head">
        <p class="hub-block-eyebrow"><span class="hub-block-num">02</span>10の美食ゾーン</p>
        <h2>10の美食ゾーンで探す</h2>
        <p class="hub-block-lead">気候や歴史、名物料理の共通点で分けた10のエリア。地域ごとの食文化と食べ歩きのルートを紹介します。</p>
      </div>
      <Rail label="10の美食ゾーン" hint="スワイプして全10ゾーンを見る" desktopColumns={2}>
        {zones.map((z, i) => (
          <a class="sm-zone" href={z.href} role="listitem" style={`--zc:${z.color}`}>
            {z.img && <img src={z.img.src} srcset={z.img.srcset} sizes="(min-width: 860px) 560px, 80vw" width={z.img.width} height={z.img.height} alt="" loading="lazy" decoding="async" />}
            <span class="sm-zone-body">
              <span class="sm-zone-n">{String(i + 1).padStart(2, '0')}</span>
              <span class="sm-zone-title">{z.title}</span>
              <span class="sm-zone-prov">{z.provinces}</span>
              <span class="sm-zone-sum">{z.summary}</span>
              <span class="sm-zone-more">記事を読む<ArrowRight size={16} /></span>
            </span>
          </a>
        ))}
      </Rail>
    </div>
  </section>

  <section class="hub-block sm-block" id="regions">
    <div class="page-container">
      <RegionsBanner eyebrow="03 地方ガイド" />
    </div>
  </section>

  <section class="hub-block sm-block is-soft" id="faq">
    <div class="page-container sm-narrow">
      <div class="hub-block-head">
        <p class="hub-block-eyebrow">よくある質問</p>
        <h2>スペイン美食マップのFAQ</h2>
      </div>
      <div class="sm-faq">
        {faq.map((f, i) => (
          <details open={i === 0}>
            <summary><span class="q" aria-hidden="true">Q</span><span>{f.question}</span><ChevronDown size={18} /></summary>
            <p>{f.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <div class="page-container sm-narrow sm-end">
    <div data-pagefind-ignore><NewsletterForm variant="inline" /></div>
    <RelatedPages
      relatedPages={[
        { title: 'スペインの食事時間ガイド', href: '/food/spain-dining-times/' },
        { title: '日本のスペイン料理店マップ', href: '/food/japan-map/' },
      ]}
    />
    <ArticleDisclaimer />
    <AuthorBox author={author} />
  </div>
  {relatedFoodArticles.length > 0 && (
    <section class="page-container sm-related" data-pagefind-ignore>
      <h2 class="font-sans font-bold text-2xl text-navy mb-2">こちらの記事もおすすめ</h2>
      <p class="text-sm text-gray-500 mb-6">同じテーマのおすすめ記事です。</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
        {relatedFoodArticles.map((a) => (
          <ArticleCard
            title={a.data.title}
            description={a.data.description}
            href={getArticleUrl(a)}
            pillar={a.data.pillar}
            cluster={a.data.cluster}
            image={a.data.image}
            imageAlt={a.data.imageAlt}
            heroImage={a.data.heroImage}
            heroImageAlt={a.data.heroImageAlt}
            pubDate={a.data.pubDate}
          />
        ))}
      </div>
    </section>
  )}

  <LineBanner slim />
  <FloatingActions target="spain-map" shareUrl={canonical} shareTitle="スペイン美食マップ" />
</BaseLayout>

<script>
  // Mapa: el primer toque en un県 muestra su nombre y el enlace (sin saltar de página por un toque impreciso).
  const pick = document.querySelector<HTMLElement>('[data-pick]');
  const links = [...document.querySelectorAll<SVGAElement>('.sm-mapcard a')];
  const clear = () => links.forEach((l) => l.classList.remove('is-sel'));
  links.forEach((a) => a.addEventListener('click', (e) => {
    if (!pick) return;
    e.preventDefault();
    clear();
    a.classList.add('is-sel');
    pick.querySelector('[data-pick-name]')!.textContent = a.dataset.name ?? '';
    pick.querySelector('[data-pick-community]')!.textContent = a.dataset.community ?? '';
    pick.querySelector<HTMLElement>('[data-pick-dot]')!.style.background = a.querySelector('path')?.style.fill ?? '';
    pick.querySelector<HTMLAnchorElement>('[data-pick-link]')!.href = a.getAttribute('href') ?? '/food/spain-map/';
    pick.hidden = false;
  }));
  pick?.querySelector('[data-pick-close]')?.addEventListener('click', () => { pick.hidden = true; clear(); });

  // Accesos rápidos: marca la sección visible.
  const chips = [...document.querySelectorAll<HTMLAnchorElement>('.sm-chips a[data-chip]')];
  const io = new IntersectionObserver((entries) => entries.forEach((e) => {
    if (!e.isIntersecting) return;
    chips.forEach((c) => c.classList.toggle('is-on', c.dataset.chip === e.target.id));
  }), { rootMargin: '-35% 0px -60% 0px' });
  chips.forEach((c) => { const s = document.getElementById(c.dataset.chip!); if (s) io.observe(s); });
</script>

<style is:global>
  .sm-hero { position: relative; overflow: hidden; padding: 22px 0 26px; background: #002147; color: #fff; }
  .sm-hero::before { content: ''; position: absolute; inset: 0; background-image: radial-gradient(rgba(255, 255, 255, .07) 1px, transparent 1px); background-size: 22px 22px; pointer-events: none; }
  .sm-hero-grid { position: relative; display: grid; grid-template-columns: minmax(0, 1fr); gap: 16px; }
  .sm-eyebrow { margin: 14px 0 0; font-size: 12px; font-weight: 700; letter-spacing: .1em; color: #ff8a9a; }
  .sm-h1 { margin: 4px 0 0; font-family: 'Noto Serif JP', serif; font-size: 34px; font-weight: 700; line-height: 1.25; color: #fff; }
  .sm-h1 span { display: block; margin-top: 4px; font-family: 'Noto Sans JP', sans-serif; font-size: 15px; letter-spacing: .08em; color: rgba(255, 255, 255, .78); }
  .sm-lead { margin: 10px 0 0; font-size: 14px; line-height: 1.8; color: rgba(255, 255, 255, .86); }
  .sm-stats { display: flex; gap: 8px; margin: 12px 0 0; padding: 0; list-style: none; }
  .sm-stats li { flex: 1; padding: 8px 4px; border: 1px solid rgba(255, 255, 255, .2); border-radius: 12px; background: rgba(255, 255, 255, .08); text-align: center; }
  .sm-stats b { display: block; font-size: 20px; line-height: 1.2; }
  .sm-stats small { font-size: 11px; color: rgba(255, 255, 255, .7); }
  .sm-mapcard { position: relative; padding: 12px 10px 10px; border-radius: 18px; background: #fff; }
  .sm-mapcard > svg { display: block; width: 100%; height: auto; }
  .sm-mapcard path { stroke: #fff; stroke-width: .7; cursor: pointer; transition: filter .15s; }
  .sm-mapcard a:hover path, .sm-mapcard a:focus-visible path { filter: brightness(.86); }
  .sm-mapcard a.is-sel path { stroke: #002147; stroke-width: 1.8; }
  .sm-mapcard rect { fill: none; stroke: #9ca3af; stroke-dasharray: 2, 2; }
  .sm-maphint { display: flex; align-items: center; justify-content: center; gap: 6px; margin: 6px 0 0; font-size: 12px; color: #5A6B80; }
  .sm-pick { display: flex; align-items: center; gap: 10px; margin-top: 10px; padding: 10px 10px 10px 14px; border: 1px solid rgba(255, 255, 255, .2); border-radius: 14px; background: #001530; }
  .sm-pick[hidden] { display: none; }
  .sm-pick-dot { flex: none; width: 12px; height: 12px; border-radius: 50%; }
  .sm-pick-text { flex: 1; min-width: 0; }
  .sm-pick-text b { display: block; font-size: 15px; }
  .sm-pick-text small { font-size: 11.5px; color: rgba(255, 255, 255, .7); }
  .sm-pick-go { display: inline-flex; align-items: center; gap: 6px; padding: 9px 12px; border-radius: 10px; background: #C8102E; color: #fff; font-size: 13px; font-weight: 700; white-space: nowrap; text-decoration: none; }
  .sm-pick-x { padding: 4px; border: 0; background: none; color: rgba(255, 255, 255, .7); cursor: pointer; }

  /* Justo debajo de la cabecera fija de la web (Navigation: 64 px + 3 px de borde). */
  .sm-chips { position: sticky; top: 67px; z-index: 30; border-bottom: 1px solid #E3E8EF; background: rgba(250, 250, 248, .96); backdrop-filter: blur(6px); }
  .sm-chips .page-container { display: flex; gap: 8px; padding-top: 10px; padding-bottom: 10px; overflow-x: auto; scrollbar-width: none; }
