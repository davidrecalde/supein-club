---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SEO from '../../../components/SEO.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import TOC from '../../../components/TOC.astro';
import LineBanner from '../../../components/LineBanner.astro';
import NewsletterForm from '../../../components/NewsletterForm.astro';
import RelatedPages from '../../../components/RelatedPages.astro';
import FAQSection from '../../../components/FAQSection.astro';
import ArticleDisclaimer from '../../../components/ArticleDisclaimer.astro';
import AuthorBox from '../../../components/AuthorBox.astro';
import ArticleCard from '../../../components/ArticleCard.astro';
import SpainMapSVG from '../../../components/SpainMapSVG.astro';
import { communityColorMap } from '../../../data/spainCommunities';
import { getArticleUrl } from '../../../utils/articles';
import { Waves, Fish, UtensilsCrossed, Sun, Flame, Leaf, Anchor } from 'lucide-astro';

const faq = [
  {
    question: '「スペイン美食マップ」の使い方は？',
    answer: '地図上の各県をクリックすると、その県のレストラン・バルガイドのページに移動します。地図下の凡例から自治州名をクリックすると、その州に属する県のボタン一覧までジャンプできます。気になる街が決まっていない場合は、「7つの美食ゾーン」から地域ごとの特色を先に読んでみるのもおすすめです。',
  },
  {
    question: '7つの美食ゾーンとは何ですか？',
    answer: 'スペインを食文化の似た7つのエリア（北部・北西部・中部・東部・南部・西部・島々）に分け、それぞれの郷土料理やワイン・お酒の文化を紹介する特集記事です。県ごとの詳細なレストラン情報だけでなく、地域全体の食文化の背景を知りたい方におすすめです。',
  },
];

const faqJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: faq.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: { '@type': 'Answer', text: item.answer },
      })),
    },
  ],
});

const canonical = 'https://supein.club/food/spain-map/';
const breadcrumbs = [
  { name: 'ホーム', url: '/' },
  { name: 'スペイン料理', url: '/food/' },
  { name: 'スペイン美食マップ', url: '' },
];

const authors = await getCollection('authors');
const author = authors.find((a) => (a.data.slug ?? a.id.replace(/\.(md|mdx)$/, '')) === 'david-recalde')!;
const pubDate = new Date('2026-09-08');
const readingTime = 6;

// こちらの記事もおすすめ: 同じ food pillar の最新記事。spain-dining-times と
// japan-map は上の RelatedPages で既に案内しているので、ここでは重複を避ける。
const foodArticles = await getCollection('articles', ({ data }) =>
  !data.draft && data.pillar === 'food' && !['spain-dining-times', 'japan-map'].includes(data.cluster)
);
const relatedFoodArticles = foodArticles
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);

const tocHeadings = [
  { depth: 2, slug: 'interactive-map', text: 'インタラクティブマップ' },
  { depth: 2, slug: 'culinary-zones',  text: '7つの美食ゾーン' },
];

const entries = await getCollection('spain-map', ({ data }) => data.draft !== true);
const guideMap = new Map(entries.map((e) => [e.data.province.toLowerCase(), e]));

function hasGuide(provinceName: string) {
  const slug = provinceName.toLowerCase().replace(/\s+/g, '-').replace(/[áàä]/g, 'a').replace(/[éèê]/g, 'e').replace(/[íìî]/g, 'i').replace(/[óòô]/g, 'o').replace(/[úùû]/g, 'u').replace(/[ñ]/g, 'n');
  return guideMap.has(slug) ? guideMap.get(slug) : null;
}

// 州別マップの色分け・グループ分けと合わせた、自治州別の県ボタン一覧
// （色はSpainMapSVG.astroの凡例・塗り分けと同一）
const provinceBySlug: Record<string, string> = {
  alicante: 'アリカンテ', albacete: 'アルバセテ', almeria: 'アルメリア', avila: 'アビラ',
  barcelona: 'バルセロナ', badajoz: 'バダホス', vizcaya: 'ビスカヤ', burgos: 'ブルゴス',
  'la-coruna': 'ア・コルーニャ', cadiz: 'カディス', caceres: 'カセレス', ceuta: 'セウタ',
  cordoba: 'コルドバ', 'ciudad-real': 'シウダ・レアル', castellon: 'カステジョン', cuenca: 'クエンカ',
  'las-palmas': 'ラス・パルマス', gerona: 'ヘローナ', granada: 'グラナダ', guadalajara: 'グアダラハラ',
  huelva: 'ウエルバ', huesca: 'ウエスカ', jaen: 'ハエン', lerida: 'リェイダ',
  leon: 'レオン', 'la-rioja': 'ラ・リオハ', lugo: 'ルーゴ', madrid: 'マドリード',
  malaga: 'マラガ', melilla: 'メリリャ', murcia: 'ムルシア', navarra: 'ナバラ',
  asturias: 'アストゥリアス', orense: 'オウレンセ', palencia: 'パレンシア', 'islas-baleares': 'バレアレス諸島',
  pontevedra: 'ポンテベドラ', cantabria: 'カンタブリア', salamanca: 'サラマンカ', sevilla: 'セビリア',
  segovia: 'セゴビア', soria: 'ソリア', guipuzcoa: 'ギプスコア', teruel: 'テルエル',
  'santa-cruz-de-tenerife': 'テネリフェ', toledo: 'トレド', tarragona: 'タラゴナ', valencia: 'バレンシア',
  valladolid: 'バリャドリード', alava: 'アラバ', zaragoza: 'サラゴサ', zamora: 'サモラ',
};

// flagColor se obtiene de src/data/spainCommunities.ts (misma paleta que la
// leyenda y el relleno del mapa SVG) — single source of truth para que los
// tres puntos (botón, leyenda, mapa) queden vinculados visualmente.
// Ordenadas de más a menos provincias para que, al emparejarse de 2 en 2 en
// la retícula, los bloques de tamaño similar queden uno junto al otro.
const communities = [
  { slug: 'castilla-y-leon', name: 'カスティーリャ・イ・レオン', flags: ['/images/flags/castilla-y-leon.webp'], provinces: ['avila', 'burgos', 'leon', 'palencia', 'salamanca', 'segovia', 'soria', 'valladolid', 'zamora'] },
  { slug: 'andalucia', name: 'アンダルシア', flags: ['/images/flags/andalucia.webp'], provinces: ['almeria', 'cadiz', 'cordoba', 'granada', 'huelva', 'jaen', 'malaga', 'sevilla'] },
  { slug: 'castilla-la-mancha', name: 'カスティーリャ・ラ・マンチャ', flags: ['/images/flags/castilla-la-mancha.webp'], provinces: ['albacete', 'ciudad-real', 'cuenca', 'guadalajara', 'toledo'] },
  { slug: 'catalunya', name: 'カタルーニャ', flags: ['/images/flags/catalunya.webp'], provinces: ['barcelona', 'gerona', 'lerida', 'tarragona'] },
  { slug: 'galicia', name: 'ガリシア', flags: ['/images/flags/galicia.webp'], provinces: ['la-coruna', 'lugo', 'orense', 'pontevedra'] },
  { slug: 'valencia', name: 'バレンシア州', flags: ['/images/flags/valencia.webp'], provinces: ['alicante', 'castellon', 'valencia'] },
  { slug: 'pais-vasco', name: 'バスク地方', flags: ['/images/flags/pais-vasco.webp'], provinces: ['vizcaya', 'guipuzcoa', 'alava'] },
  { slug: 'aragon', name: 'アラゴン', flags: ['/images/flags/aragon.webp'], provinces: ['huesca', 'teruel', 'zaragoza'] },
  { slug: 'extremadura', name: 'エストレマドゥーラ', flags: ['/images/flags/extremadura.webp'], provinces: ['badajoz', 'caceres'] },
  { slug: 'canarias', name: 'カナリア諸島', flags: ['/images/flags/canarias.webp'], provinces: ['las-palmas', 'santa-cruz-de-tenerife'] },
  { slug: 'ceuta-melilla', name: 'セウタ・メリリャ（自治都市）', flags: ['/images/flags/ceuta.webp', '/images/flags/melilla.webp'], provinces: ['ceuta', 'melilla'] },
  { slug: 'asturias', name: 'アストゥリアス', flags: ['/images/flags/asturias.webp'], provinces: ['asturias'] },
  { slug: 'baleares', name: 'バレアレス諸島', flags: ['/images/flags/baleares.webp'], provinces: ['islas-baleares'] },
  { slug: 'cantabria', name: 'カンタブリア', flags: ['/images/flags/cantabria.webp'], provinces: ['cantabria'] },
  { slug: 'la-rioja', name: 'ラ・リオハ', flags: ['/images/flags/la-rioja.webp'], provinces: ['la-rioja'] },
  { slug: 'madrid', name: 'マドリード州', flags: ['/images/flags/madrid.webp'], provinces: ['madrid'] },
  { slug: 'murcia', name: 'ムルシア', flags: ['/images/flags/murcia.webp'], provinces: ['murcia'] },
  { slug: 'navarra', name: 'ナバラ', flags: ['/images/flags/navarra.webp'], provinces: ['navarra'] },
];

type Zone = {
  color: string;
  icon: any;
  title: string;
  provincias: string;
  summary: string;
  href: string;
};

const zones: Zone[] = [
  {
    color: '#2D6A4F',
    icon: Waves,
    title: '北部：ピンチョスとシードルの道',
    provincias: 'バスク · カンタブリア · アストゥリアス',
    summary: '美食の街サン・セバスティアンのピンチョス文化から、アストゥリアスのシードルまで。',
    href: '/food/food-routes/norte-pinchos-sidra/',
  },
  {
    color: '#1B4F72',
    icon: Fish,
    title: '北西部：マリスコとアルバリーニョ',
    provincias: 'ガリシア · ナバラ',
    summary: 'タコ料理をはじめとする新鮮な魚介と、アルバリーニョワインの産地。',
    href: '/food/food-routes/noroeste-marisco-albarino/',
  },
  {
    color: '#002147',
    icon: UtensilsCrossed,
    title: '中部：アサードと赤ワイン',
    provincias: 'マドリード · カスティーリャ・イ・レオン',
    summary: 'じっくり焼き上げるアサードと、力強い赤ワインの産地リベラ・デル・ドゥエロ。',
    href: '/food/food-routes/centro-asado-vino-tinto/',
  },
  {
    color: '#E67E22',
    icon: Sun,
    title: '東部：地中海の食文化',
    provincias: 'バレンシア · カタルーニャ',
    summary: '稲作文化が育んだ米料理の発祥地から、市場文化が根付くバルセロナまで。',
    href: '/food/food-routes/este-paella-tapas/',
  },
  {
    color: '#C0392B',
    icon: Flame,
    title: '南部：揚げ物とシェリー酒',
    provincias: 'アンダルシア',
    summary: '冷製スープ・ガスパチョの発祥地から、シェリー酒の産地ヘレスまで。',
    href: '/food/food-routes/sur-fritos-flamenco/',
  },
  {
    color: '#27AE60',
    icon: Leaf,
    title: '西部：イベリコ生ハムの道',
    provincias: 'エストレマドゥーラ · ラ・リオハ',
    summary: 'イベリコ豚の放牧地デエサから、名門ワイン産地ラ・リオハまで。',
    href: '/food/food-routes/oeste-jamon-iberico/',
  },
  {
    color: '#2980B9',
    icon: Anchor,
    title: '島々：火山と地中海の味',
    provincias: 'カナリア諸島 · バレアレス諸島',
    summary: '火山の大地が育んだカナリア諸島と、地中海に浮かぶバレアレス諸島の食文化。',
    href: '/food/food-routes/islas-volcan-mediterraneo/',
  },
];
---
<BaseLayout title="スペイン美食マップ | supein.club">
  <SEO
    slot="seo"
    title="スペイン美食マップ — 味で旅するスペイン | supein.club"
    description="50県・7つの美食ゾーンに分けて探す、本場スペインのグルメ体験マップです。スペイン倶楽部が現地情報をもとに厳選したレストラン・バルを、バスクのピンチョスからアンダルシアのガスパチョまで、地方色豊かな食文化や歴史的な背景とあわせて詳しく紹介します。"
    canonical={canonical}
    breadcrumbs={breadcrumbs}
    authorName={author.data.name}
    authorUrl={`https://supein.club/about-us/team/${author.data.slug ?? 'david-recalde'}/`}
  />
  <script type="application/ld+json" slot="head" set:html={faqJsonLd} />

  <!-- Hero -->
  <section class="bg-navy text-white relative" style="padding:64px 0;">
    <div class="absolute top-0 left-0 right-0 h-[3px] bg-primary"></div>
    <div class="container">
      <div style="margin-bottom:20px;">
        <Breadcrumb items={breadcrumbs} dark={true} />
      </div>
      <p class="text-primary font-bold tracking-widest" style="font-size:11px; text-transform:uppercase; margin-bottom:12px;">SPANISH FOOD MAP</p>
      <h1 class="font-serif font-bold text-white" style="font-size:clamp(28px,5vw,48px); margin-bottom:24px; line-height:1.25;">
        スペイン美食マップ — 味で旅するスペイン
      </h1>
      <div style="display:flex; align-items:center; flex-wrap:wrap; gap:16px; margin-bottom:32px;">
        <a
          href={`/about-us/team/${author.data.slug ?? 'david-recalde'}/`}
          style="display:flex; align-items:center; gap:10px; text-decoration:none;"
        >
          {author.data.avatar && (
            <img
              src={author.data.avatar}
              alt={author.data.name}
              width="32"
              height="32"
              style="width:32px; height:32px; border-radius:50%; object-fit:cover; border:2px solid rgba(255,255,255,0.3);"
            />
          )}
          <span style="font-size:14px; font-weight:600; color:rgba(255,255,255,0.85);">
            {author.data.nameJa ?? author.data.name}
          </span>
        </a>
        <span style="color:rgba(255,255,255,0.25);">|</span>
        <time datetime={pubDate.toISOString()} style="font-size:13px; color:rgba(255,255,255,0.6);">
          {pubDate.toLocaleDateString('ja-JP', { year: 'numeric', month: 'long', day: 'numeric' })}
        </time>
        <span style="color:rgba(255,255,255,0.25);">|</span>
        <span style="font-size:13px; color:rgba(255,255,255,0.6);">約{readingTime}分</span>
      </div>
      <p class="text-white/80" style="font-size:18px; max-width:640px; line-height:1.8;">
        50省・7つの美食ゾーンで探す、本場スペインのグルメ体験。<br />
        スペイン倶楽部が厳選したレストラン・バルマップ。
      </p>
    </div>
  </section>

  <!-- Content with TOC sidebar -->
  <div class="page-container" style="padding-top:48px; padding-bottom:80px;">
    <div class="border-l-4 border-navy bg-[#F0F4F8] px-5 py-4 mb-8 text-ink leading-relaxed font-medium rounded-r-lg max-w-3xl">
      スペインは17の自治州によって、驚くほど異なる食文化を育んできました。北部のピンチョス文化から南部のガスパチョまで——この美食マップでは、県ごとのレストラン・バルガイドと地域別のグルメルートを1つにまとめてご紹介します。
    </div>
    <div class="content-grid">

      <div class="content-main">

        <details class="toc-mobile-inline">
          <summary>
            <span>目次</span>
            <span class="tmi-chevron" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </summary>
          <ol class="tmi-list">
            {tocHeadings.map((h, i) => (
              <li>
                <a href={'#' + h.slug}>
                  <span class="tmi-num">{i + 1}.</span>
                  {h.text}
                </a>
              </li>
            ))}
          </ol>
        </details>

        <!-- Interactive SVG Map -->
        <section id="interactive-map" class="msec">
          <p class="text-primary font-bold tracking-widest" style="font-size:11px; text-transform:uppercase; margin-bottom:8px;">INTERACTIVE MAP</p>
          <h2 class="font-serif font-bold text-navy" style="font-size:clamp(24px,3vw,36px); margin-bottom:12px;">スペイン州別マップ</h2>
          <p class="text-muted" style="font-size:16px; max-width:680px; line-height:1.7; margin-bottom:40px;">
            州をクリックして、それぞれのレストランマップと詳細ガイドへ。
          </p>
          <SpainMapSVG />

          <div class="community-list">
            {communities.map((c) => (
              <div class="community-block" id={`community-${c.slug}`}>
                <div class="community-heading">
                  <span class="community-flags">
                    {c.flags.map((flag) => (
                      <img src={flag} alt={`${c.name}の旗`} class="community-flag" width="48" height="48" loading="lazy" />
                    ))}
                  </span>
                  <span class="community-name">{c.name}</span>
                </div>
                <div class="community-buttons">
                  {c.provinces.map((slug) => (
                    <a href={`/food/spain-map/${slug}/`} class="province-button" style={`border-left-color: ${communityColorMap[c.slug].flagColor};`}>
                      {provinceBySlug[slug]}
                    </a>
                  ))}
                </div>
              </div>
            ))}
          </div>

          <a
            href="https://linktr.ee/supeinclub"
            target="_blank"
            rel="noopener nofollow noreferrer"
            class="linktree-banner"
          >
            <div>
              <p class="linktree-banner-title">全50県のマップをスマホに保存</p>
              <p class="linktree-banner-text">すべてのレストラン・バルマップを1つのリンクにまとめました。スマートフォンのホーム画面やブックマークに保存しておけば、スペイン旅行中や外出先でもすぐにアクセスできます。</p>
            </div>
            <span class="linktree-banner-cta">Linktreeで見る →</span>
          </a>
        </section>

        <!-- 7 Zonas Culinarias -->
        <section id="culinary-zones" class="msec">
          <p class="text-primary font-bold tracking-widest" style="font-size:11px; text-transform:uppercase; margin-bottom:8px;">RUTAS DE SABOR</p>
          <h2 class="font-serif font-bold text-navy" style="font-size:clamp(24px,3vw,36px); margin-bottom:12px;">7つの美食ゾーンで探す</h2>
          <p class="text-muted" style="font-size:16px; max-width:680px; line-height:1.7; margin-bottom:48px;">
            スペインは地域によって料理文化がまったく異なります。<br />
            まずあなたが好きな味のゾーンから、詳しい記事で読んでみましょう。
          </p>

          <div class="zones-grid">
            {zones.map((zone) => {
              const Icon = zone.icon;
              return (
                <a href={zone.href} class="zone-card" style={`border-left-color: ${zone.color};`}>
                  <div class="zone-header">
                    <div class="zone-icon" style={`color: ${zone.color};`}>
                      <Icon size={22} />
                    </div>
                    <div>
                      <h3 class="text-navy font-bold" style="font-size:17px; margin:0 0 4px;">{zone.title}</h3>
                      <div class="province-chips">
                        {zone.provincias.split(' · ').map((p) => (
                          <span class="province-chip">{p}</span>
                        ))}
                      </div>
                    </div>
                  </div>

                  <p class="text-muted" style="font-size:14px; margin:12px 0 0; line-height:1.6;">{zone.summary}</p>

                  <span class="zone-read-more">記事を読む →</span>
                </a>
              );
            })}
          </div>
        </section>

        <section class="msec msec--last">
          <NewsletterForm variant="inline" />
        </section>

        <RelatedPages
          relatedPages={[
            { title: 'スペインの食事時間ガイド', href: '/food/spain-dining-times/' },
            { title: '日本のスペイン料理店マップ', href: '/food/japan-map/' },
          ]}
        />

        <FAQSection faq={faq} />

        <ArticleDisclaimer />
        <AuthorBox author={author} />

        {relatedFoodArticles.length > 0 && (
          <section class="mt-12 border-t border-[#E8E8E6] pt-10">
            <h2 class="font-sans font-bold text-2xl text-navy mb-2">こちらの記事もおすすめ</h2>
            <p class="text-sm text-gray-500 mb-6">同じテーマのおすすめ記事です。</p>
            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
              {relatedFoodArticles.map((a) => (
                <ArticleCard
                  title={a.data.title}
                  description={a.data.description}
                  href={getArticleUrl(a)}
                  pillar={a.data.pillar}
                  cluster={a.data.cluster}
                  image={a.data.image}
                  imageAlt={a.data.imageAlt}
                  heroImage={a.data.heroImage?.src}
                  heroImageAlt={a.data.heroImageAlt}
                  pubDate={a.data.pubDate}
                />
              ))}
            </div>
          </section>
        )}

      </div>

      <aside class="content-sidebar">
        <TOC headings={tocHeadings} />
      </aside>

    </div>
  </div>

  <LineBanner slim />
</BaseLayout>

<style>
  /* Sections inside content-main */
  .msec {
    padding-top: 48px;
    padding-bottom: 48px;
    border-bottom: 1px solid var(--color-border);
  }
  .msec:first-child {
    padding-top: 0;
  }
  .msec--last,
  .msec:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  /* Community button grid (colors match SpainMapSVG legend).
     Grid real (no column-count) para que los bloques queden alineados
     por fila; el array communities ya viene ordenado de mayor a menor
     nº de provincias para que bloques de tamaño similar caigan en la
     misma fila visual. */
  .community-list {
    margin-top: 40px;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 32px;
    align-items: start;
  }
  .community-block {
