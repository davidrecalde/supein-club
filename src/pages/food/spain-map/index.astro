  { color: '#B8A898', name: 'カスティーリャ・ラ・マンチャ', provinces: ['albacete', 'ciudad-real', 'cuenca', 'guadalajara', 'toledo'] },
  { color: '#C49A6C', name: 'バレンシア州', provinces: ['alicante', 'castellon', 'valencia'] },
  { color: '#6B8FA8', name: 'ガリシア', provinces: ['la-coruna', 'lugo', 'orense', 'pontevedra'] },
