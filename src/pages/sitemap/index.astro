  {
    label: 'プレスルーム',
    href: '/newsroom/',
    links: [
      { label: 'プレスキット', href: '/newsroom/press-kit/' },
      { label: '8周年記念イベント', href: '/newsroom/2026-05-30-8th-anniversary-spain-food-wine-event/' },
      { label: 'パエリア＆タパスフェスティバル', href: '/newsroom/2026-06-05-paella-tapas-festival-hibiya/' },
    ],
  },
  {
    label: 'スペイン倶楽部とは',
    href: '/about-us/',
    links: [
      { label: 'チームメンバー', href: '/about-us/team/' },
      { label: 'スポンサーシップ', href: '/about/sponsorship/' },
      { label: 'お問い合わせ', href: '/contact/' },
      { label: 'プライバシーポリシー', href: '/privacy/' },
      { label: '利用規約', href: '/terms/' },
