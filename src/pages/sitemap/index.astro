  },
  {
    label: 'コミュニティ',
    href: '/community/',
    links: [
      { label: 'イベント・アジェンダ', href: '/events/' },
      { label: 'スポンサー', href: '/sponsors/' },
      { label: 'ニュースレター', href: '/newsletter/' },
