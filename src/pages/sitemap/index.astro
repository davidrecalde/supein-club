  {
    label: 'スペインに住む',
    href: '/living/',
    links: [
      { label: 'スペイン留学', href: '/living/study-spain/' },
      { label: '語学学校', href: '/living/language-school/' },
      { label: '大学留学', href: '/living/university/' },
      { label: '留学費用', href: '/living/study-cost/' },
