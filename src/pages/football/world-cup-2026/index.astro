---
import { getCollection } from 'astro:content';
import ArticleLayout from '../../../layouts/ArticleLayout.astro';

const articles = await getCollection('articles', ({ data }) => !data.draft && data.pillar === 'football' && data.cluster === 'world-cup-2026');
const entry = articles[0];

if (!entry) {
  throw new Error('No se encontró el artículo del cluster "world-cup-2026"');
}
---
<ArticleLayout entry={entry} />
