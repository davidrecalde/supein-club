---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SEO from '../../../components/SEO.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import ArticleCard from '../../../components/ArticleCard.astro';
import NewsletterForm from '../../../components/NewsletterForm.astro';
import FloatingActions from '../../../components/FloatingActions.astro';
import LineBanner from '../../../components/LineBanner.astro';
import { regions, type RegionConfig } from '../../../config/regions';
import { getArticleUrl } from '../../../utils/articles';
import { communityColorMap } from '../../../data/spainCommunities';

export async function getStaticPaths() {
  return regions.map((region) => ({
    params: { region: region.slug },
    props: { region },
  }));
}

interface Props {
  region: RegionConfig;
}

const { region } = Astro.props;

const provinces = await getCollection(
  'spain-map',
  (entry) => entry.data.draft !== true && entry.data.region === region.spainMapLabel
);
const sortedProvinces = [...provinces].sort((a, b) => a.data.provinceJa.localeCompare(b.data.provinceJa, 'ja'));

const regionArticles = await getCollection(
  'articles',
  (entry) => !entry.data.draft && entry.data.region === region.slug
);

const byPillar = (pillar: string) => regionArticles.filter((a) => a.data.pillar === pillar);
const foodArticles = byPillar('food');
const footballArticles = byPillar('football');
const livingArticles = byPillar('living');
const travelArticles = byPillar('travel');
const cultureArticles = byPillar('culture');

const breadcrumbs = [
  { name: 'ホーム', url: '/' },
  { name: 'スペインの地方', url: '/regions/' },
  { name: region.label, url: `/regions/${region.slug}/` },
];

const canonical = `https://supein.club/regions/${region.slug}/`;
const accentColor = communityColorMap[region.communitySlug]?.flagColor ?? '#C8102E';

const regionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `${region.label}地方`,
  description: region.intro.slice(0, 150),
  url: canonical,
  about: {
    '@type': 'AdministrativeArea',
    name: region.label,
  },
};

const sections = [
  {
    id: 'food',
    label: '料理',
    items: [
      ...sortedProvinces.map((p) => ({
        title: p.data.title,
        description: p.data.description,
        href: `/food/spain-map/${p.data.province}/`,
        pubDate: p.data.pubDate,
      })),
      ...foodArticles.map((a) => ({
        title: a.data.title,
        description: a.data.description,
        href: getArticleUrl(a),
        pubDate: a.data.pubDate,
        heroImage: a.data.heroImage,
        heroImageAlt: a.data.heroImageAlt,
      })),
    ],
  },
  {
    id: 'football',
    label: 'サッカー',
    items: footballArticles.map((a) => ({
      title: a.data.title,
      description: a.data.description,
      href: getArticleUrl(a),
      pubDate: a.data.pubDate,
      heroImage: a.data.heroImage,
      heroImageAlt: a.data.heroImageAlt,
    })),
  },
  {
    id: 'living',
    label: '暮らし',
    items: livingArticles.map((a) => ({
      title: a.data.title,
      description: a.data.description,
      href: getArticleUrl(a),
      pubDate: a.data.pubDate,
      heroImage: a.data.heroImage,
      heroImageAlt: a.data.heroImageAlt,
    })),
  },
  {
    id: 'travel',
    label: '旅行',
    items: travelArticles.map((a) => ({
      title: a.data.title,
      description: a.data.description,
      href: getArticleUrl(a),
      pubDate: a.data.pubDate,
      heroImage: a.data.heroImage,
      heroImageAlt: a.data.heroImageAlt,
    })),
  },
  {
    id: 'culture',
    label: '文化',
    items: cultureArticles.map((a) => ({
      title: a.data.title,
      description: a.data.description,
      href: getArticleUrl(a),
      pubDate: a.data.pubDate,
      heroImage: a.data.heroImage,
      heroImageAlt: a.data.heroImageAlt,
    })),
  },
];
---
<BaseLayout>
  <SEO
    slot="seo"
    title={region.h1 + ' | supein.club'}
    description={region.intro.slice(0, 150)}
    canonical={canonical}
    breadcrumbs={breadcrumbs}
  />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(regionSchema)} />

  <header style={`background:#002147;padding:56px 0 48px;position:relative;border-top:4px solid ${accentColor};`}>
    <div class="max-w-6xl mx-auto px-5">
      <Breadcrumb items={breadcrumbs} dark />
      <div style="display:flex;align-items:center;gap:16px;margin:20px 0 16px;">
        <img
          src={`/images/flags/${region.communitySlug}.webp`}
          alt={`${region.label}の旗`}
          width="48"
          height="48"
          style="width:48px;height:48px;object-fit:cover;border-radius:6px;border:1px solid rgba(255,255,255,.25);flex-shrink:0;"
        />
        <h1 style="font-family:'Lora','Noto Serif JP',serif;font-size:clamp(22px,4vw,34px);font-weight:700;color:white;line-height:1.4;max-width:680px;margin:0;">
          {region.h1}
        </h1>
      </div>
      <div style="display:flex;flex-wrap:wrap;gap:10px;margin-top:24px;">
        <div style="background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.14);border-radius:8px;padding:10px 16px;">
          <span style="display:block;font-size:10px;color:rgba(255,255,255,.5);text-transform:uppercase;letter-spacing:.06em;margin-bottom:3px;">州都</span>
          <span style="font-family:'Lora',serif;font-weight:700;font-size:16px;color:white;">{region.capital}</span>
        </div>
        <div style="background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.14);border-radius:8px;padding:10px 16px;">
          <span style="display:block;font-size:10px;color:rgba(255,255,255,.5);text-transform:uppercase;letter-spacing:.06em;margin-bottom:3px;">県の数</span>
          <span style="font-family:'Lora',serif;font-weight:700;font-size:16px;color:white;">{region.provinceCount}県</span>
        </div>
        <div style="background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.14);border-radius:8px;padding:10px 16px;">
          <span style="display:block;font-size:10px;color:rgba(255,255,255,.5);text-transform:uppercase;letter-spacing:.06em;margin-bottom:3px;">人口</span>
          <span style="font-family:'Lora',serif;font-weight:700;font-size:16px;color:white;">{region.population}</span>
        </div>
        <div style="background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.14);border-radius:8px;padding:10px 16px;">
          <span style="display:block;font-size:10px;color:rgba(255,255,255,.5);text-transform:uppercase;letter-spacing:.06em;margin-bottom:3px;">代表的な文化</span>
          <span style="font-family:'Lora',serif;font-weight:700;font-size:16px;color:white;">{region.culturalHighlight}</span>
        </div>
      </div>
    </div>
  </header>

  <section class="max-w-6xl mx-auto px-5 py-14">
    <p class="text-muted text-base leading-relaxed mb-12 max-w-3xl">{region.intro}</p>

    {sections.map((section) => (
      <div class="mb-12">
        <div class="flex items-baseline justify-between gap-3 border-b-2 border-navy pb-2 mb-5">
          <h2 class="font-sans font-bold text-xl text-navy">{region.label}の{section.label}</h2>
          <a href={`/${section.id}/`} class="text-sm text-muted hover:text-primary whitespace-nowrap">{section.id === 'food' ? 'スペイン料理ガイドへ' : section.id === 'football' ? 'スペインサッカーガイドへ' : section.id === 'living' ? 'スペインに住むガイドへ' : section.id === 'travel' ? 'スペイン旅行ガイドへ' : 'スペイン文化ガイドへ'} →</a>
        </div>
        {section.items.length > 0 ? (
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {section.items.map((item) => (
              <ArticleCard
                title={item.title}
                description={item.description}
                href={item.href}
                pillar={section.id}
                heroImage={item.heroImage}
                heroImageAlt={item.heroImageAlt}
                pubDate={item.pubDate}
              />
            ))}
          </div>
        ) : (
          <div class="border border-dashed border-[#D8D5CE] rounded-xl p-6 text-center text-muted text-sm bg-[repeating-linear-gradient(135deg,#FAFAF8_0px,#FAFAF8_10px,#F5F4F1_10px,#F5F4F1_20px)]">
            <span class="inline-block text-[10.5px] font-semibold text-[#8A6D2F] bg-[#EFE7D8] px-2.5 py-0.5 rounded-full mb-2">近日公開</span>
            <br />{region.label}の{section.label}に関する記事を準備中です。
          </div>
        )}
      </div>
    ))}
  </section>

  <section class="max-w-6xl mx-auto px-5 pb-14 prose-content">
    <div class="max-w-[780px]">
      <NewsletterForm variant="inline" />
    </div>
  </section>

  <LineBanner slim />
  <FloatingActions shareUrl={canonical} shareTitle={`${region.label}地方完全ガイド`} />
</BaseLayout>
