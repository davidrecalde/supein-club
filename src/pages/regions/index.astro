---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SEO from '../../components/SEO.astro';
import PillarHero from '../../components/PillarHero.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import NewsletterForm from '../../components/NewsletterForm.astro';
import FloatingActions from '../../components/FloatingActions.astro';
import LineBanner from '../../components/LineBanner.astro';
import { regions } from '../../config/regions';
import { communityColorMap } from '../../data/spainCommunities';

const breadcrumbs = [
  { name: 'ホーム', url: '/' },
  { name: 'スペインの地方', url: '/regions/' },
];

const regionsSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'スペインの地方',
  description: 'アンダルシア、カタルーニャ、バスクなど、スペインの地方ごとに料理・サッカー・暮らし・旅の情報をまとめたガイド',
  url: 'https://supein.club/regions/',
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: regions.map((r, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: `https://supein.club/regions/${r.slug}/`,
      name: r.label,
    })),
  },
};
---
<BaseLayout>
  <SEO
    slot="seo"
    title="スペインの地方完全ガイド｜地方ごとの料理・サッカー・暮らし | supein.club"
    description="アンダルシア、カタルーニャ、バスクなど、スペインの地方ごとに料理・サッカー・現地の暮らし・旅の情報をまとめて紹介します。"
    canonical="https://supein.club/regions/"
    breadcrumbs={breadcrumbs}
  />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(regionsSchema)} />

  <PillarHero
    title="スペインの地方"
    description="ひとつの国の中に、驚くほど違う顔を持つ地方の数々。料理・サッカー・現地の暮らしという切り口から、地方ごとにスペインを探ってみませんか。"
  />

  <section class="max-w-6xl mx-auto px-5 py-14">
    <Breadcrumb items={breadcrumbs} />
    <p class="text-muted text-base leading-relaxed my-8 border-l-2 border-primary pl-5 max-w-3xl">
      スペインは17の自治州からなり、それぞれが独自の言語・食文化・気候・歴史を持っています。本ページでは、すでに記事のある地方から順に、料理・サッカー・暮らし・旅・文化という切り口でまとめてご紹介しています。まだ準備中の地方も、記事の公開に合わせて今後追加していきます。
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {regions.map((r) => {
        const color = communityColorMap[r.communitySlug]?.flagColor ?? '#002147';
        return (
          <a
            href={`/regions/${r.slug}/`}
            class="block bg-white rounded-xl overflow-hidden shadow-[0_2px_8px_rgba(0,33,71,0.07)] border border-[#E8E8E6] hover:shadow-[0_4px_16px_rgba(0,33,71,0.12)] transition-all p-6"
            style={`border-left: 4px solid ${color};`}
          >
            <div class="flex items-center gap-3 mb-3">
              <img
                src={`/images/flags/${r.communitySlug}.webp`}
                alt={`${r.label}の旗`}
                width="36"
                height="36"
                loading="lazy"
                style="width:36px;height:36px;object-fit:cover;border-radius:4px;border:1px solid #E8E8E6;flex-shrink:0;"
              />
              <h2 class="font-sans font-bold text-navy text-lg">{r.label}</h2>
            </div>
            <span class="inline-block text-xs font-semibold px-2.5 py-0.5 rounded-full mb-3" style={`background:${color}1A;color:${color};`}>
              {r.provinceCount}県
            </span>
            <p class="text-muted text-sm leading-relaxed">{r.culturalHighlight} — 州都: {r.capital}</p>
          </a>
        );
      })}
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-5 pb-14 prose-content">
    <div class="max-w-[780px]">
      <NewsletterForm variant="inline" />
    </div>
  </section>

  <LineBanner slim />
  <FloatingActions shareUrl="https://supein.club/regions/" shareTitle="スペインの地方" />
</BaseLayout>
