---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SEO from '../components/SEO.astro';
import ArticleCard from '../components/ArticleCard.astro';
import SoccerBall from '../components/icons/SoccerBall.astro';
import { Plane, UtensilsCrossed, MessageCircle, Home, Book, Send, Mail } from 'lucide-astro';
import { getArticleUrl } from '../utils/articles';
import illustration404 from '../assets/illustrations/404.webp';

const allArticles = await getCollection('articles', ({ data }) => !data.draft);
const recentArticles = allArticles
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const pillars = [
  { href: '/travel/', Icon: Plane, title: 'スペイン旅行', desc: 'バルセロナ・マドリードから南部アンダルシア、離島まで' },
  { href: '/food/', Icon: UtensilsCrossed, title: 'スペイン料理', desc: 'パエリア・タパス・ワインからおすすめのお土産まで' },
  { href: '/language/', Icon: MessageCircle, title: 'スペイン語', desc: '独学・教室・学習アプリまで、体系的に学べる情報を紹介' },
  { href: '/living/', Icon: Home, title: 'スペインに住む', desc: '留学・現地での仕事探し・ビザ取得の手続きまで' },
  { href: '/culture/', Icon: Book, title: 'スペイン文化', desc: 'フラメンコ・歴史的建造物・伝統の祭りなど' },
  { href: '/football/', Icon: SoccerBall, title: 'スペインサッカー', desc: 'ラ・リーガの試合結果や移籍情報、クラブの歴史まで' },
];
---

<BaseLayout>
  <SEO
    slot="seo"
    title="ページが見つかりません | supein.club"
    description="お探しのページは見つかりませんでした。スペイン倶楽部のコンテンツをご覧ください。"
    canonical="https://supein.club/page-not-found/"
    robots="noindex, follow"
  />

  <!-- ═══════ HERO：イラスト中心、フラットな明るい背景 ═══════ -->
  <section class="bg-canvas pt-8 pb-8 px-5">
    <div class="max-w-2xl mx-auto flex flex-col items-center text-center">
      <Image
        src={illustration404}
        alt="地図を見て迷っている二人のイラスト"
        width={380}
        class="w-full max-w-[380px] h-auto drop-shadow-[0_16px_26px_rgba(0,33,71,0.15)]"
      />

      <p class="font-sans font-extrabold text-navy leading-none mt-3" style="font-size:clamp(44px,7vw,60px); letter-spacing:-1.5px;">404</p>
      <h1 class="font-sans font-semibold text-ink mt-1.5" style="font-size:clamp(21px,3vw,27px);">Parece que nos hemos perdido.</h1>
      <p class="text-muted mt-1.5" style="font-size:16px;">ページが見つかりません。</p>

      <div class="flex items-center gap-2.5 mt-4" aria-hidden="true">
        <span class="w-7 h-px bg-[#E8E8E6]"></span>
        <span class="w-1.5 h-1.5 rounded-full bg-primary"></span>
        <span class="w-7 h-px bg-[#E8E8E6]"></span>
      </div>

      <div class="flex flex-wrap items-center justify-center gap-3 mt-5">
        <a
          href="/"
          class="inline-flex items-center gap-2 justify-center bg-primary hover:bg-[#a00d24] text-white font-bold px-7 py-3.5 rounded-lg transition-colors text-sm"
        >
          <Home size={18} />
          ホームへ戻る
        </a>
        <a
          href="/contact/"
          class="inline-flex items-center gap-2 justify-center bg-white border border-[#E8E8E6] hover:border-primary hover:text-primary text-navy font-semibold px-7 py-3.5 rounded-lg transition-colors text-sm"
        >
          <Send size={16} />
          お問い合わせ
        </a>
      </div>
    </div>
  </section>

  <!-- ═══════ 6つのテーマから探し直す ═══════ -->
  <section class="bg-white py-16 px-5">
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-10">
        <p class="text-primary text-xs font-semibold uppercase tracking-[0.2em] mb-2">Explore</p>
        <h2 class="font-serif font-bold text-navy" style="font-size:clamp(21px,2.6vw,27px);">行き先を選び直す</h2>
        <p class="text-muted text-sm leading-relaxed mt-2.5">スペインにまつわる6つのテーマから、興味のあるカテゴリへどうぞ。</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-5">
        {pillars.map(({ href, Icon, title, desc }) => (
          <a
            href={href}
            class="group flex items-start gap-3.5 p-5 bg-white border border-[#E8E8E6] rounded-xl shadow-[0_2px_10px_rgba(0,33,71,0.05)] hover:shadow-[0_8px_22px_rgba(0,33,71,0.11)] hover:border-primary/35 transition-all"
          >
            <span class="flex-shrink-0 w-11 h-11 rounded-full bg-[#FCEBEE] text-primary flex items-center justify-center group-hover:bg-primary group-hover:text-white transition-colors">
              <Icon size={21} />
            </span>
            <span>
              <span class="block font-sans font-bold text-navy text-sm mb-1">{title}</span>
              <span class="block text-muted text-xs leading-relaxed">{desc}</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════ 最新の記事 ═══════ -->
  {recentArticles.length > 0 && (
    <section class="bg-canvas py-16 px-5">
      <div class="max-w-5xl mx-auto">
        <div class="text-center mb-9">
          <p class="text-primary text-xs font-semibold uppercase tracking-[0.2em] mb-2">Latest Articles</p>
          <h2 class="font-serif font-bold text-navy" style="font-size:clamp(21px,2.6vw,27px);">最新の記事をご覧ください</h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {recentArticles.map((article) => (
            <ArticleCard
              title={article.data.title}
              description={article.data.description}
              href={getArticleUrl(article)}
              pillar={article.data.pillar}
              image={article.data.image}
              imageAlt={article.data.imageAlt}
              heroImage={article.data.heroImage}
              heroImageAlt={article.data.heroImageAlt}
              pubDate={article.data.pubDate}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ═══════ お問い合わせ ═══════ -->
  <section class="bg-navy-deep py-14 px-5 text-center">
    <div class="max-w-lg mx-auto">
      <p class="text-white/70 text-base leading-relaxed mb-5">
        お探しのコンテンツが見つからない場合は、お気軽にお問い合わせください。
      </p>
      <div class="flex flex-wrap items-center justify-center gap-3">
        <a
          href="/contact/"
          class="inline-flex items-center gap-2 justify-center bg-primary hover:bg-[#a00d24] text-white font-bold px-6 py-3 rounded-lg transition-colors text-sm"
        >
          <Send size={16} />
          お問い合わせ
        </a>
        <a
          href="/newsletter/"
          class="inline-flex items-center gap-2 justify-center bg-white/[0.06] hover:bg-white/[0.12] border border-white/20 text-white font-semibold px-6 py-3 rounded-lg transition-colors text-sm"
        >
          <Mail size={16} />
          ニュースレター登録
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
