---
import BaseLayout from '../layouts/BaseLayout.astro';
import SEO from '../components/SEO.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { Home, Plane, UtensilsCrossed, MessageCircle, Newspaper, Mail, Send, Users } from 'lucide-astro';
import { getCollection } from 'astro:content';

const allArticles = await getCollection('articles', ({ data }) => !data.draft);
const recentArticles = allArticles
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const suggestions = [
  { Icon: Plane, label: 'スペイン旅行', desc: 'バルセロナ、マドリード、アンダルシア', url: '/travel/' },
  { Icon: UtensilsCrossed, label: 'スペイン料理', desc: 'パエリア、タパス、スペインワイン', url: '/food/' },
  { Icon: MessageCircle, label: 'スペイン語', desc: '学習リソース・レッスン情報', url: '/language/' },
  { Icon: Newspaper, label: 'ニュースルーム', desc: 'スペイン倶楽部の最新ニュース', url: '/newsroom/' },
  { Icon: Mail, label: 'ニュースレター', desc: 'スペインの最新情報を無料配信', url: '/newsletter/' },
  { Icon: Users, label: 'チームについて', desc: 'スペイン倶楽部の創設者たち', url: '/about-us/' },
];
---

<BaseLayout title="ページが見つかりません | supein.club">
  <SEO
    slot="seo"
    title="ページが見つかりません | supein.club"
    description="お探しのページは見つかりませんでした。スペイン倶楽部のコンテンツをご覧ください。"
    canonical="https://supein.club/page-not-found/"
    robots="noindex, follow"
  />

  <!-- HERO navy con disculpa -->
  <section style="background:#002147;padding:80px 0 64px;text-align:center;">
    <div class="page-container" style="max-width:640px;">

      <p style="
        font-family:'Work Sans',sans-serif;
        font-size:clamp(80px,15vw,140px);
        font-weight:800;
        color:rgba(200,16,46,0.25);
        line-height:1;
        margin:0 0 8px;
        letter-spacing:-4px;
      ">404</p>

      <h1 style="
        font-family:'Noto Serif JP',serif;
        font-size:clamp(22px,4vw,32px);
        font-weight:700;
        color:white;
        margin:0 0 16px;
        line-height:1.4;
      ">
        ページが見つかりませんでした
      </h1>

      <p style="
        font-size:17px;
        color:rgba(255,255,255,0.65);
        line-height:1.8;
        margin:0 0 32px;
      ">
        申し訳ありません。お探しのページは移動または
        削除された可能性があります。<br>
        下記のコンテンツからお探しの情報が見つかるかもしれません。
      </p>

      <a href="/"
         style="
           display:inline-flex;
           align-items:center;
           gap:10px;
           background:#C8102E;
           color:white;
           text-decoration:none;
           padding:14px 28px;
           border-radius:10px;
           font-size:16px;
           font-weight:600;
           transition:opacity 200ms;
         "
         onmouseover="this.style.opacity='0.85'"
         onmouseout="this.style.opacity='1'">
        <Home size={18} />
        ホームへ戻る
      </a>

    </div>
  </section>

  <!-- SECCIÓN: Últimos artículos -->
  {recentArticles.length > 0 && (
    <section style="background:#FAFAF8;padding:72px 0;">
      <div class="page-container">
        <p style="
          font-size:11px;font-weight:600;
          letter-spacing:0.2em;text-transform:uppercase;
          color:#C8102E;margin:0 0 8px;text-align:center;
        ">LATEST ARTICLES</p>
        <h2 style="
          font-family:'Noto Serif JP',serif;
          font-size:clamp(20px,3vw,26px);
          font-weight:700;color:#002147;
          margin:0 0 36px;text-align:center;
        ">
          最新の記事をご覧ください
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl mx-auto">
          {recentArticles.map((article) => {
            const parts = article.id.replace(/\.(md|mdx)$/, '').split('/');
            const slug = parts[2] ?? article.data.cluster;
            return (
              <ArticleCard
                title={article.data.title}
                description={article.data.description}
                href={`/${article.data.pillar}/${article.data.cluster}/${slug}/`}
                pillar={article.data.pillar}
                image={article.data.image}
                imageAlt={article.data.imageAlt}
                heroImage={article.data.heroImage}
                heroImageAlt={article.data.heroImageAlt}
                pubDate={article.data.pubDate}
              />
            );
          })}
        </div>
      </div>
    </section>
  )}

  <!-- SECCIÓN: Navegación sugerida -->
  <section style="background:white;padding:72px 0;">
    <div class="page-container">
      <p style="
        font-size:11px;font-weight:600;
        letter-spacing:0.2em;text-transform:uppercase;
        color:#C8102E;margin:0 0 8px;text-align:center;
      ">EXPLORE</p>
      <h2 style="
        font-family:'Noto Serif JP',serif;
        font-size:clamp(20px,3vw,26px);
        font-weight:700;color:#002147;
        margin:0 0 36px;text-align:center;
      ">
        他のコンテンツを探す
      </h2>

      <div style="
        display:grid;
        grid-template-columns:repeat(auto-fit,minmax(200px,1fr));
        gap:14px;max-width:860px;margin:0 auto;
      ">
        {suggestions.map(({ Icon, label, desc, url }) => (
          <a href={url}
             style="
               display:flex;align-items:center;gap:14px;
               padding:16px 20px;
               border:1px solid #e5e7eb;border-radius:12px;
               text-decoration:none;background:#FAFAF8;
               transition:border-color 200ms,background 200ms;
             "
             onmouseover="this.style.borderColor='#C8102E';this.style.background='white'"
             onmouseout="this.style.borderColor='#e5e7eb';this.style.background='#FAFAF8'">
            <div style="
              width:44px;height:44px;border-radius:9999px;
              background:#FCEBEE;color:#C8102E;
              display:flex;align-items:center;justify-content:center;
              flex-shrink:0;
            ">
              <Icon size={20} />
            </div>
            <div>
              <p style="font-size:14px;font-weight:700;
                         color:#002147;margin:0 0 2px;">
                {label}
              </p>
              <p style="font-size:12px;color:#9ca3af;margin:0;">
                {desc}
              </p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- SECCIÓN: Contacto -->
  <section style="background:#002147;padding:56px 0;text-align:center;">
    <div class="page-container" style="max-width:560px;">
      <p style="font-size:16px;color:rgba(255,255,255,0.7);
                margin:0 0 20px;line-height:1.7;">
        お探しのコンテンツが見つからない場合は、
        お気軽にお問い合わせください。
      </p>
      <div style="display:flex;gap:12px;
                  justify-content:center;flex-wrap:wrap;">
        <a href="/contact/"
           style="
             display:inline-flex;align-items:center;gap:8px;
             background:#C8102E;color:white;
             text-decoration:none;padding:12px 24px;
             border-radius:8px;font-size:14px;
             font-weight:600;transition:opacity 200ms;
           "
           onmouseover="this.style.opacity='0.85'"
           onmouseout="this.style.opacity='1'">
          <Send size={16} />
          お問い合わせ
        </a>
        <a href="/newsletter/"
           style="
             display:inline-flex;align-items:center;gap:8px;
             background:rgba(255,255,255,0.1);
             color:white;text-decoration:none;
             padding:12px 24px;border-radius:8px;
             font-size:14px;font-weight:600;
             border:1px solid rgba(255,255,255,0.2);
             transition:opacity 200ms;
           "
           onmouseover="this.style.opacity='0.85'"
           onmouseout="this.style.opacity='1'">
          <Mail size={16} />
          ニュースレター登録
        </a>
      </div>
    </div>
  </section>

</BaseLayout>
