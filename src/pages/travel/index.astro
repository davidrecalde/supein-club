---
// Hub /travel/ (rediseño del 18 de noviembre de 2026, mockup aprobado por David): «planifica tu
// viaje», muy fotográfico y primero el móvil. Cabecera con foto y 「目的から探す」; 01 TOP5 de GA4
// (src/data/hubPicks.ts); accesos rápidos fijos; 02 destinos (guía + restaurantes del mapa
// gastronómico + región); 03 la ruta Gaudí numerada; 04 los 4 pasos para un primer viaje; 05 mapa
// gastronómico y /regions/. Debajo, guía de lectura, FAQ y lo de siempre. Un artículo de viaje que
// no esté en ningún bloque aparece en 「その他の旅行ガイド」. Los clics se miden con hub_card_click.
import { getCollection, getEntry, type CollectionEntry } from 'astro:content';
import { getImage } from 'astro:assets';
import { ChevronRight, Clock, Compass, Landmark, Luggage, MapPin, Route, Utensils, Wallet } from 'lucide-astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SEO from '../../components/SEO.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Rail from '../../components/Rail.astro';
import HubCrossCard from '../../components/HubCrossCard.astro';
import HubFaq from '../../components/HubFaq.astro';
import HubClickTracking from '../../components/HubClickTracking.astro';
import LineBanner from '../../components/LineBanner.astro';
import FloatingActions from '../../components/FloatingActions.astro';
import NewsletterForm from '../../components/NewsletterForm.astro';
import ArticleDisclaimer from '../../components/ArticleDisclaimer.astro';
import AuthorBox from '../../components/AuthorBox.astro';
import heroPhoto from '../../assets/hero/vista-aerea-sagrada-familia.webp';
import regionsPhoto from '../../assets/hero/banner-regiones-espana-mobile.webp';
import { TRAVEL_TOP } from '../../data/hubPicks';
import { getArticleUrl } from '../../utils/articles';
import { cardImage } from '../../utils/images';
import { foodMapPreview } from '../../utils/foodMap';

type Article = CollectionEntry<'articles'>;
const SITE = 'https://supein.club';
const canonical = `${SITE}/travel/`;
const author = await getEntry('authors', 'david-recalde');
const breadcrumbs = [
  { name: 'ホーム', url: '/' },
  { name: 'スペイン旅行', url: canonical },
];

const otherPillars = [
  { href: '/food/', title: 'スペイン料理', description: 'パエリア・タパス・ワインから郷土料理まで、スペインの食文化を写真つきで詳しく解説' },
  { href: '/language/', title: 'スペイン語', description: 'レッスン・語学学校・学習アプリの選び方まで、スペイン語習得に役立つ情報を体系的に紹介' },
  { href: '/living/', title: 'スペインに住む', description: '留学・現地での仕事探し・ビザ取得の手続きまで、スペイン生活のリアルな実情を詳しく紹介' },
  { href: '/culture/', title: 'スペイン文化', description: 'フラメンコ・歴史的建造物・伝統の祭りなど、スペイン文化の奥深い魅力を詳しく紹介します' },
  { href: '/football/', title: 'スペインサッカー', description: 'ラ・リーガの試合結果や移籍情報、代表チーム、バルセロナやレアルの歴史まで深掘り解説します' },
];

const travelFaq = [
  { question: 'スペイン旅行のコンテンツはどこから見ればいいですか？', answer: '初めての方は「初めてのスペイン旅行」の4つのステップの順に読むのがおすすめです。行き先が決まっている方は<a href="/travel/barcelona/">「バルセロナ観光完全ガイド」</a>や<a href="/travel/madrid/">「マドリード観光完全ガイド」</a>から見てください。' },
  { question: 'バルセロナ観光の見どころを知りたい場合は？', answer: 'サグラダ・ファミリアやガウディ建築を中心に<a href="/travel/barcelona/">「バルセロナ観光完全ガイド」</a>で詳しく解説しています。ガウディ建築は「ガウディ建築ルート」の8つのガイドを順に読むと全体がつながります。' },
  { question: 'マドリード観光の見どころを知りたい場合は？', answer: '美術館巡りから王宮、サラマンカ地区まで<a href="/travel/madrid/">「マドリード観光完全ガイド」</a>にまとめています。' },
  { question: '短期間でスペインを効率よく回るモデルコースはありますか？', answer: '1週間での周遊モデルコースを<a href="/travel/spain-tours/spain-tour-1week/">「スペイン1週間ツアー完全ガイド」</a>で紹介しています。' },
  { question: '一人旅の予算の目安を知りたい場合は？', answer: '航空券・宿泊・食費などの実際の費用感を<a href="/travel/travel-cost/spain-budget-solo/">「スペイン一人旅の予算完全ガイド」</a>にまとめています。' },
  { question: 'スペインらしいお土産選びに迷ったら？', answer: '伝統工芸品や地域ブランドを地域別に<a href="/travel/souvenirs/">「スペインお土産完全ガイド」</a>で紹介しています。食べ物のお土産は<a href="/food/souvenirs/">「食べ物・グルメ編」</a>へ。' },
];

// ── Artículos ──
const articles = await getCollection('articles', ({ data }) => !data.draft && data.pillar === 'travel');
const idOf = (a: Article) => a.id.replace(/\.(md|mdx)$/, '');
const byId = new Map(articles.map((a) => [idOf(a), a]));
const placed = new Set<string>();
const take = (id: string) => { const a = byId.get(id); if (a) placed.add(id); return a; };
const minutesOf = (a: Article) => a.data.readingTime ?? Math.max(3, Math.round((a.body?.length ?? 0) / 600));
const heroOf = (a: Article) => (a.data.heroImage && typeof a.data.heroImage !== 'string' ? a.data.heroImage : undefined);
const card = async (a: Article, title = a.data.title) => {
  const hero = heroOf(a);
  return { url: getArticleUrl(a), title, description: a.data.description, minutes: minutesOf(a), img: hero ? await cardImage(hero, '') : undefined };
};
const TAG: Record<string, string> = { souvenirs: 'お土産', barcelona: 'バルセロナ', madrid: 'マドリード', segovia: 'セゴビア', 'spain-tours': 'ツアー', 'travel-cost': '旅行費用', 'spain-travel-basics': '旅行準備' };
const tagOf = (a: Article) => (a.data.tags.includes('バルセロナ建築') ? 'ガウディ建築' : TAG[a.data.cluster] ?? 'スペイン旅行');

// 01 TOP5 (GA4)
const top = await Promise.all(TRAVEL_TOP.ids.map((id) => byId.get(id)).filter((a): a is Article => !!a).map(async (a) => ({ ...(await card(a)), tag: tagOf(a) })));

// 02 Destinos: guía de la ciudad + restaurantes de su provincia + su región
const DEST = [
  { id: 'travel/barcelona/barcelona', name: 'バルセロナ', tag: 'ガウディ建築と地中海の街', province: 'barcelona', food: 'バルセロナ県のレストラン', region: 'cataluna', regionName: 'カタルーニャ地方' },
  { id: 'travel/madrid/madrid', name: 'マドリード', tag: '美術館と王宮の首都', province: 'madrid', food: 'マドリードのレストラン', region: 'madrid', regionName: 'マドリード地方' },
  { id: 'travel/segovia/segovia', name: 'セゴビア', tag: 'ローマ水道橋の古都・マドリードから日帰り', province: 'segovia', food: 'セゴビア県のレストラン', region: 'castilla-y-leon', regionName: 'カスティーリャ・イ・レオン地方' },
];
const dest = (await Promise.all(DEST.map(async (d) => { const a = take(d.id); return a ? { ...d, ...(await card(a)) } : undefined; }))).filter((d) => !!d);
const regionsImg = await getImage({ src: regionsPhoto, width: 640, format: 'webp', quality: 72 });

// 03 Ruta Gaudí (orden de lectura); otro artículo de Barcelona nuevo se añade al final
const GAUDI: Array<[string, string]> = [
  ['travel/barcelona/sagrada-familia-guide', 'サグラダ・ファミリア完全ガイド'],
  ['travel/barcelona/sagrada-familia-facades-towers', 'ファサードと塔の意味を読み解く'],
  ['travel/barcelona/sagrada-familia-jesus-tower-completed', 'イエスの塔が完成'],
  ['travel/barcelona/casa-batllo-guide', 'カサ・バトリョ「骨の家」'],
  ['travel/barcelona/casa-mila-guide', 'カサ・ミラ（ラ・ペドレラ）'],
  ['travel/barcelona/park-guell-guide', 'グエル公園'],
  ['travel/barcelona/gaudi-hidden-gems', '知る人ぞ知るガウディ建築5選'],
  ['travel/barcelona/barcelona-modernisme-architects', 'ガウディ以外のモデルニスモ建築'],
];
const gaudiList = [
  ...GAUDI.map(([id, short]) => [take(id), short] as const),
  ...articles.filter((a) => a.data.cluster === 'barcelona' && !placed.has(idOf(a)) && !GAUDI.some(([id]) => id === idOf(a))).map((a) => [take(idOf(a)), a.data.title.split('｜')[0]] as const),
].filter((g): g is readonly [Article, string] => !!g[0]);
const gaudi = await Promise.all(gaudiList.map(([a, short]) => card(a, short)));

// 04 Primer viaje en 4 pasos
const foodSouvenirs = await getEntry('articles', 'food/souvenirs/souvenirs');
const STEPS = [
  { title: '基本情報を知る', sub: '時差・ビザ・通貨・治安', ids: ['travel/spain-travel-basics/spain-travel-basics'] },
  { title: 'モデルコースを決める', sub: '1週間の周遊か、ツアーか', ids: ['travel/spain-tours/spain-tour-1week', 'travel/spain-tours/budget-spain-tours'] },
  { title: '予算を立てる', sub: '航空券・宿・食費の目安', ids: ['travel/travel-cost/spain-budget-solo'] },
  { title: 'お土産を選ぶ', sub: '工芸品から食べ物まで', ids: ['travel/souvenirs/souvenirs'] },
];
const steps = await Promise.all(STEPS.map(async (s, i) => {
  const list = await Promise.all(s.ids.map(take).filter((a): a is Article => !!a).map((a) => card(a)));
  if (i === 3 && foodSouvenirs && !foodSouvenirs.data.draft) list.push(await card(foodSouvenirs));
  return { ...s, list };
}));
const quick = {
  course: byId.get('travel/spain-tours/spain-tour-1week'),
  budget: byId.get('travel/travel-cost/spain-budget-solo'),
  basics: byId.get('travel/spain-travel-basics/spain-travel-basics'),
};

// Artículos de viaje que todavía no tienen bloque
const rest = await Promise.all(articles.filter((a) => !placed.has(idOf(a))).map(async (a) => ({ ...(await card(a)), tag: tagOf(a) })));

// 05 Mapa gastronómico
const { svg: mapSvg, count: provinceCount } = await foodMapPreview();

// Cabecera
const [heroSm, heroLg] = await Promise.all([640, 1200].map((width) => getImage({ src: heroPhoto, width, format: 'webp', quality: 70 })));

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'スペイン旅行',
  description: 'バルセロナ・マドリード・セゴビアの観光ガイド、ガウディ建築、モデルコース、旅行の予算とお土産まで、スペイン旅行の計画に役立つガイド。',
  url: canonical,
  inLanguage: 'ja',
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: [...new Map([...top, ...dest, ...gaudi, ...steps.flatMap((s) => s.list), ...rest].map((c) => [c.url, c])).values()]
      .map((c, i) => ({ '@type': 'ListItem', position: i + 1, url: `${SITE}${c.url}`, name: c.title })),
  },
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: travelFaq.map((item) => ({ '@type': 'Question', name: item.question, acceptedAnswer: { '@type': 'Answer', text: item.answer.replace(/<[^>]+>/g, '') } })),
};
---
<BaseLayout>
  <SEO
    slot="seo"
    title="スペイン旅行 完全ガイド"
    description="バルセロナ・マドリードから穴場スポットまで、スペイン旅行の計画に役立つ情報を網羅。ツアー会社の比較・ホテル選びのコツ・費用相場・ベストシーズン・都市別のモデルコースまで、日本語でわかりやすく紹介する旅行ガイドメディアです。写真や体験談も豊富に掲載しています。"
    canonical={canonical}
    image="/og/travel.webp"
    breadcrumbs={breadcrumbs}
  />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(collectionSchema)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqSchema)} />

  <section class="tv-hero">
    <img class="tv-hero-bg" src={heroLg.src} srcset={`${heroSm.src} 640w, ${heroLg.src} 1200w`} sizes="100vw" width={heroLg.attributes.width} height={heroLg.attributes.height} alt="" fetchpriority="high" decoding="async" />
    <div class="page-container">
      <Breadcrumb items={breadcrumbs} dark />
      <p class="tv-eyebrow">SPAIN TRAVEL</p>
      <h1 class="tv-h1">スペイン旅行</h1>
      <p class="tv-lead">ガウディ建築のバルセロナから古都セゴビアまで。行き先選びから予算、お土産まで、旅の計画はこのページから。</p>
    </div>
  </section>
  <div class="page-container">
    <nav class="tv-goals" aria-label="目的から探す" data-hub-block="goals">
      <p>目的から探す</p>
      <div>
        <a href="#dest"><MapPin size={22} /><span>行き先</span></a>
        <a href="#gaudi"><Landmark size={22} /><span>見どころ</span></a>
        {quick.course && <a href={getArticleUrl(quick.course)}><Route size={22} /><span>モデル<br />コース</span></a>}
        {quick.budget && <a href={getArticleUrl(quick.budget)}><Wallet size={22} /><span>予算</span></a>}
        {quick.basics && <a href={getArticleUrl(quick.basics)}><Luggage size={22} /><span>準備</span></a>}
      </div>
    </nav>
  </div>

  <section class="tv-block tv-block--top" id="top" data-hub-block="top">
    <div class="page-container">
      <div class="hub-block-head">
        <p class="hub-block-eyebrow"><span class="hub-block-num">01</span>よく読まれている記事</p>
        <h2>いま読まれている<br class="tv-br" />スペイン旅行ガイド</h2>
        <p class="hub-block-lead">過去90日の閲覧数ランキング。</p>
      </div>
      <ol class="tv-rank">
        {top.map((c, i) => (
          <li>
            <a class:list={['tv-rk', { 'is-first': i === 0 }]} href={c.url}>
              <span class="tv-rk-n">{i + 1}</span>
              {c.img && <img src={c.img.src} srcset={c.img.srcset} sizes={i === 0 ? '(min-width: 860px) 620px, 92vw' : '96px'} width={c.img.width} height={c.img.height} alt="" loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />}
              <span class="tv-rk-b">
                <span class="tv-tag">{c.tag}</span>
                <span class="tv-rk-t">{c.title}</span>
                <span class="tv-meta"><Clock size={13} />約{c.minutes}分で読める</span>
              </span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <nav class="tv-chips" aria-label="このページの内容">
    <div class="page-container">
      <a href="#top" data-chip="top"><i>01</i>人気記事</a>
      <a href="#dest" data-chip="dest"><i>02</i>行き先</a>
      <a href="#gaudi" data-chip="gaudi"><i>03</i>ガウディ建築</a>
      <a href="#steps" data-chip="steps"><i>04</i>旅の準備</a>
      <a href="#cross" data-chip="cross"><i>05</i>グルメ・地方</a>
      <a href="#faq" data-chip="faq">FAQ</a>
    </div>
  </nav>

  <section class="hub-block tv-block" id="dest" data-hub-block="dest">
    <div class="page-container">
      <div class="hub-block-head">
        <p class="hub-block-eyebrow"><span class="hub-block-num">02</span>行き先から選ぶ</p>
        <h2>都市ごとに、観光・グルメ・地方まで</h2>
        <p class="hub-block-lead">観光ガイドだけでなく、その街のレストランや地方の文化にもすぐ移動できます。</p>
      </div>
      <Rail label="行き先から選ぶ" hint="スワイプして他の行き先を見る" desktopColumns={4}>
        {dest.map((d) => (
          <div class="tv-dest" role="listitem">
            <a class="tv-dest-img" href={d.url}>
              {d.img && <img src={d.img.src} srcset={d.img.srcset} sizes="(min-width: 860px) 270px, 80vw" width={d.img.width} height={d.img.height} alt="" loading="lazy" decoding="async" />}
              <span class="tv-dest-cap"><b>{d.name}</b><small>{d.tag}</small></span>
            </a>
            <a class="tv-dest-l" href={d.url}><Landmark size={18} /><span>{d.name}観光ガイド</span><ChevronRight size={16} /></a>
            <a class="tv-dest-l" href={`/food/spain-map/${d.province}/`}><Utensils size={18} /><span>{d.food}</span><ChevronRight size={16} /></a>
            <a class="tv-dest-l" href={`/regions/${d.region}/`}><Compass size={18} /><span>{d.regionName}</span><ChevronRight size={16} /></a>
          </div>
        ))}
        <a class="tv-dest tv-dest-more" href="/regions/" role="listitem">
          <img src={regionsImg.src} width={regionsImg.attributes.width} height={regionsImg.attributes.height} alt="" loading="lazy" decoding="async" />
          <span class="tv-dest-more-b">
            <small><Compass size={15} />地方ガイド</small>
            <b>17の地方から<br />次の行き先を探す</b>
            <span class="tv-btn-w">地方ガイドを見る<ChevronRight size={16} /></span>
          </span>
        </a>
      </Rail>
    </div>
  </section>

  {gaudi.length > 0 && (
    <section class="hub-block tv-block is-soft" id="gaudi" data-hub-block="gaudi">
      <div class="page-container">
        <div class="hub-block-head tv-head-more">
          <div>
            <p class="hub-block-eyebrow"><span class="hub-block-num">03</span>ガウディ建築ルート</p>
            <h2>バルセロナのガウディ建築を<br class="tv-br" />{gaudi.length}つのガイドで巡る</h2>
            <p class="hub-block-lead">1から順に読むと、サグラダ・ファミリアからモデルニスモ全体までつながります。</p>
          </div>
          <a class="tv-more" href="/travel/barcelona/">バルセロナ観光完全ガイド<ChevronRight size={16} /></a>
        </div>
        <Rail label="ガウディ建築ルート" hint="スワイプして次のスポットへ" desktopColumns={4}>
          {gaudi.map((c, i) => (
            <a class="tv-stop" href={c.url} role="listitem">
              <span class="tv-stop-line"><span class="tv-stop-n">{i + 1}</span></span>
              {c.img && <img src={c.img.src} srcset={c.img.srcset} sizes="(min-width: 860px) 270px, 58vw" width={c.img.width} height={c.img.height} alt="" loading="lazy" decoding="async" />}
              <span class="tv-stop-t">{c.title}</span>
              <span class="tv-meta"><Clock size={13} />約{c.minutes}分</span>
            </a>
          ))}
        </Rail>
      </div>
    </section>
  )}

  <section class="hub-block tv-block" id="steps" data-hub-block="steps">
    <div class="page-container">
      <div class="hub-block-head">
        <p class="hub-block-eyebrow"><span class="hub-block-num">04</span>初めてのスペイン旅行</p>
        <h2>4つのステップで旅の準備</h2>
        <p class="hub-block-lead">この順番に読めば、出発までに必要なことがひと通りわかります。</p>
      </div>
      <ol class="tv-steps">
        {steps.map((s, i) => (
          <li class="tv-st">
            <span class="tv-st-n" aria-hidden="true">STEP<b>{i + 1}</b></span>
            <div class="tv-st-b">
              <h3>{s.title}</h3>
              <p>{s.sub}</p>
              {s.list.map((c) => (
                <a class="tv-st-a" href={c.url}>
                  {c.img && <img src={c.img.src} srcset={c.img.srcset} sizes="80px" width={c.img.width} height={c.img.height} alt="" loading="lazy" decoding="async" />}
                  <span><b>{c.title}</b><small><Clock size={12} />約{c.minutes}分</small></span>
                </a>
              ))}
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {rest.length > 0 && (
    <section class="hub-block tv-block" id="more" data-hub-block="more">
      <div class="page-container">
        <div class="hub-block-head">
          <p class="hub-block-eyebrow">もっと読む</p>
          <h2>その他の旅行ガイド</h2>
        </div>
        <Rail label="その他の旅行ガイド" hint="スワイプして続きを見る" desktopColumns={3}>
          {rest.map((c) => (
            <a class="tv-card" href={c.url} role="listitem">
              {c.img && <img src={c.img.src} srcset={c.img.srcset} sizes="(min-width: 860px) 360px, 76vw" width={c.img.width} height={c.img.height} alt="" loading="lazy" decoding="async" />}
              <span class="tv-card-b"><span class="tv-tag">{c.tag}</span><span class="tv-rk-t">{c.title}</span><span class="tv-meta"><Clock size={13} />約{c.minutes}分で読める</span></span>
            </a>
          ))}
        </Rail>
      </div>
    </section>
  )}

  <section class="hub-block tv-block is-soft" id="cross" data-hub-block="cross">
    <div class="page-container">
      <div class="hub-block-head">
        <p class="hub-block-eyebrow"><span class="hub-block-num">05</span>旅をもっと楽しむ</p>
        <h2>旅先のグルメと地方の文化も</h2>
      </div>
      <div class="tv-pair">
