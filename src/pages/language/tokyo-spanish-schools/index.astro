---
import { getCollection } from 'astro:content';
import ArticleLayout from '../../../layouts/ArticleLayout.astro';

const articles = await getCollection('articles', ({ data }) => !data.draft && data.pillar === 'language' && data.cluster === 'tokyo-spanish-schools');
const entry = articles[0];

if (!entry) {
  throw new Error('No se encontró el artículo del cluster "tokyo-spanish-schools"');
}
---
<ArticleLayout entry={entry} />
