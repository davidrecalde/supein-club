---
// Hub /language/: hub general de la sección スペイン語, con el curso A1-C2 como centro
// (docs/language/plan-hub-embudo.md, punto 9). Desde el 15 de noviembre de 2026 solo bloques con banner:
// 01 curso, 02 conjugador, 03 補助教材 (hub 勉強法), 04 スペイン語学校 (hub de escuelas) y 05 DELE (hub DELE).
// 「スペイン語 勉強法」 es del hub 勉強法 (src/pages/language/learn-spanish/study-methods/): aquí no se repite.
import { getCollection, getEntry, type CollectionEntry } from 'astro:content';
import { getImage } from 'astro:assets';
import { ClipboardCheck, Map as MapIcon } from 'lucide-astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SEO from '../../components/SEO.astro';
import PillarHero from '../../components/PillarHero.astro';
import LineBanner from '../../components/LineBanner.astro';
import FloatingActions from '../../components/FloatingActions.astro';
import FAQSection from '../../components/FAQSection.astro';
import NewsletterForm from '../../components/NewsletterForm.astro';
import ArticleDisclaimer from '../../components/ArticleDisclaimer.astro';
import AuthorBox from '../../components/AuthorBox.astro';
import CourseLevels from '../../components/course/CourseLevels.astro';
import CourseContinue from '../../components/course/CourseContinue.astro';
import { getArticleUrl } from '../../utils/articles';
import { SCHOOLS_HUB_URL, STUDY_HUB_URL } from '../../data/language-hubs';
import heroStudy from '../../assets/hero/hero-study-methods.webp';
import { ABOUT_COURSE_URL, CAST_URL, COURSE_LEVELS, COURSE_URL, TOTAL_UNITS, WELCOME_URL, levelUrl } from '../../data/course';
import { getAllUnits, isCourseVisible } from '../../utils/units';

type Article = CollectionEntry<'articles'>;

const author = await getEntry('authors', 'david-recalde');
const courseVisible = await isCourseVisible();
const firstUnit = (await getAllUnits())[0];

const LEVEL_TEST_URL = '/language/learn-spanish/level-test/';
const CONJUGATION_URL = '/language/learn-spanish/verb-conjugation/';
const DELE_URL = '/language/learn-spanish/dele/';

const otherPillars = [
  { href: '/travel/', title: 'スペイン旅行', description: 'バルセロナ・マドリードから南部アンダルシア、離島まで、観光スポットとツアー情報を完全網羅' },
  { href: '/food/', title: 'スペイン料理', description: 'パエリア・タパス・ワインからおすすめのお土産まで、スペインの食文化を写真つきで詳しく解説' },
  { href: '/living/', title: 'スペインに住む', description: '留学・現地での仕事探し・ビザ取得の手続きまで、スペイン生活のリアルな実情を詳しく紹介' },
  { href: '/culture/', title: 'スペイン文化', description: 'フラメンコ・歴史的建造物・伝統の祭りなど、スペイン文化の奥深い魅力を詳しく紹介します' },
  { href: '/football/', title: 'スペインサッカー', description: 'ラ・リーガの試合結果や移籍情報、代表チーム、バルセロナやレアルの歴史まで深掘り解説します' },
];

const articles = await getCollection('articles', ({ data }) => !data.draft && data.pillar === 'language');
const idNoExt = (a: Article) => a.id.replace(/.(md|mdx)$/, '');
const byId = (id: string) => articles.find((a) => idNoExt(a) === `language/${id}`);

// Imágenes de los botones y banners (480 y 800 px): las de sus artículos, y la del hub 勉強法.
const responsive = async (src: ImageMetadata, alt: string) => {
  const [small, large] = await Promise.all([480, 800].map((width) => getImage({ src, width, format: 'webp', quality: 75 })));
  return { src: large.src, srcset: `${small.src} 480w, ${large.src} 800w`, width: Number(large.attributes.width), height: Number(large.attributes.height), alt };
};
const cardImage = async (a?: Article) => {
  const src = a?.data.heroImage;
  if (!a || !src || typeof src === 'string') return undefined;
  return responsive(src, a.data.heroImageAlt ?? '');
};
const conjugator = byId('learn-spanish/verb-conjugation');
const [levelTestImg, roadmapImg, deleImg, conjugatorImg, schoolsImg, studyImg] = await Promise.all([
  cardImage(byId('learn-spanish/level-test')),
  cardImage(byId('learn-spanish/index')),
  cardImage(byId('learn-spanish/dele-difficulty-guide')),
  cardImage(conjugator),
  cardImage(byId('spanish-schools-in-japan/spanish-schools-in-japan')),
  responsive(heroStudy, 'スペイン語の勉強法（発音・単語・リスニング・読解）のイメージ'),
]);
// Simulacros: la última unidad de cada nivel (review-dele-*), con su ilustración.
const mockExams = (await getAllUnits())
  .filter((u) => u.data.slug.startsWith('review-dele'))
  .map((u) => ({ unit: u.data.unit, level: u.data.level, url: u.data.url, shortTitle: u.data.shortTitle, img: u.data.image?.src.replace(/.webp$/, '-480.webp'), alt: u.data.image?.alt ?? '' }));

const anchors = [
  { href: '#start', label: 'はじめる' },
  ...(courseVisible ? [{ href: '#course', label: '無料コース' }] : []),
  { href: '#tools', label: '活用ツール' },
  { href: '#materials', label: '補助教材' },
  { href: '#schools', label: 'スペイン語学校' },
  { href: '#dele', label: 'DELE対策' },
];

const breadcrumbs = [
  { name: 'ホーム', url: '/' },
  { name: 'スペイン語', url: '/language/' },
];

// Fecha de actualización visible (regla de /language/) y dateModified del schema: último cambio de contenido
// del hub (bloque 04 スペイン語学校, 14 de noviembre de 2026). Solo cambia con «HAZ FRESHNESS».
const UPDATED = '2026-11-14';
const updatedLabel = new Intl.DateTimeFormat('ja-JP', { year: 'numeric', month: 'long', day: 'numeric' }).format(new Date(UPDATED));

// ItemList: lo que la página enlaza, en su orden (salidas del curso, niveles y artículos).
const levelItems = courseVisible ? COURSE_LEVELS.map((l) => ({ url: levelUrl(l.code), name: `${l.code} ${l.name}` })) : [];
const listed = [
  { url: COURSE_URL, name: 'スペイン語学習ロードマップ' },
  { url: LEVEL_TEST_URL, name: 'スペイン語レベルチェックテスト' },
  ...levelItems,
  ...(conjugator ? [{ url: getArticleUrl(conjugator), name: conjugator.data.title }] : []),
  { url: STUDY_HUB_URL, name: 'スペイン語の勉強法' },
  { url: SCHOOLS_HUB_URL, name: 'スペイン語学校' },
  { url: DELE_URL, name: 'DELE（スペイン語検定）' },
];
const languageSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'スペイン語を学ぶ',
  description: 'A1〜C2の無料スペイン語コース、レベルチェック、DELE対策、勉強法のガイドとスペイン語学校の情報',
  url: 'https://supein.club/language/',
  inLanguage: 'ja',
  dateModified: UPDATED,
  about: { '@type': 'Thing', name: 'スペイン語学習' },
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: listed.map((item, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: `https://supein.club${item.url}`,
      name: item.name,
    })),
  },
};

// Curso gratuito A1-C2: sin Offer ni hasCourseInstance (no hay precio ni fechas que marcar).
// Solo se marca cuando el bloque del curso es visible (ver isCourseVisible).
const courseSchema = {
  '@context': 'https://schema.org',
  '@type': 'Course',
  '@id': 'https://supein.club/language/#course',
  name: `スペイン語コース（A1〜C2・全${TOTAL_UNITS}ユニット）`,
  description: 'セルバンテス学院の基準（A1 Acceso〜C2 Maestría）に沿った、日本人のための無料スペイン語コース。登録不要で、自分のペースで進められます。',
  url: 'https://supein.club/language/',
  inLanguage: 'ja',
  isAccessibleForFree: true,
  provider: { '@id': 'https://supein.club/#organization' },
  about: { '@type': 'Language', name: 'スペイン語', alternateName: 'es' },
  hasPart: COURSE_LEVELS.map((l) => ({
    '@type': 'CreativeWork',
    name: `${l.code} ${l.name}`,
    url: `https://supein.club${levelUrl(l.code)}`,
  })),
};

// FAQ (16-11-2026): la web y el curso. 「勉強法・独学」 son del hub 勉強法; 「教室」, del hub de escuelas;
// 「DELE」, del hub DELE; 「習得時間・どのレベル」, de la hoja de ruta.
const languageFaq = [
  {
    question: 'スペイン倶楽部のスペイン語コースは無料ですか？',
    answer: `はい、無料で、登録も不要です。入門（A1）から最上級（C2）までの全${TOTAL_UNITS}ユニットを、自分のペースで進められます。進み具合はこのブラウザに保存されます。`,
  },
  {
    question: 'まったくの初心者でも使えますか？',
    answer: `使えます。まったく初めての方は<a href="${firstUnit?.data.url ?? COURSE_URL}">ユニット1「発音と読み方」</a>から始めましょう。少し勉強したことがある方は、<a href="${LEVEL_TEST_URL}">レベルチェック</a>を受けると、どのユニットから始めればいいかがわかります。`,
  },
  {
    question: 'スペインのスペイン語と中南米のスペイン語、どちらを学べますか？',
    answer: `コースの例文はスペインのスペイン語を基準にし、中南米の言い方は違いがあるときに添えています。<a href="${WELCOME_URL}">学習設定</a>で、中南米の言い方を先に表示することもできます。国による違いは<a href="/language/learn-spanish/spanish-in-latin-america/">「中南米スペイン語とは？」</a>で説明しています。`,
  },
  {
    question: 'スマートフォンでも学べますか？',
    answer: '学べます。音声やミニテストもスマートフォンで使えます。ただし進み具合はブラウザごとに保存されるため、別の端末やブラウザに切り替えると引き継がれません。',
  },
  {
    question: '動詞の活用形をすぐに調べたいときは？',
    answer: `<a href="${CONJUGATION_URL}">スペイン語動詞活用表</a>で、よく使う動詞の全時制の活用を確認できます。それぞれの時制は、それを学ぶコースのユニットにつながっています。`,
  },
  {
    question: 'コースの内容は誰が作っていますか？',
    answer: `構成と内容はスペイン倶楽部の創設者 David Recalde が決め、スペイン語と日本語の両方をネイティブが確認してから公開しています。AIの使い方も含めて<a href="${ABOUT_COURSE_URL}">「このコースができるまで」</a>で公開しています。`,
  },
];
---
<BaseLayout>
  <SEO
    slot="seo"
    title="スペイン語学習サイト｜無料・登録不要の入門〜上級コース（A1〜C2）"
    description="日本人のための無料スペイン語学習サイト。登録不要で、入門（A1）から最上級（C2）までのコースとレベルチェックで、発音・文法・単語を順番に学べます。動詞の活用表、勉強法、スペイン語学校、DELEの情報もまとめています。"
    canonical="https://supein.club/language/"
    image="/og/language.webp"
    breadcrumbs={breadcrumbs}
  />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(languageSchema)} />
  {courseVisible && <script type="application/ld+json" slot="head" set:html={JSON.stringify(courseSchema)} />}
  <script
    type="application/ld+json"
    slot="head"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: languageFaq.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: { '@type': 'Answer', text: item.answer.replace(/<[^>]+>/g, '') },
      })),
    })}
  />
  <PillarHero
    title="スペイン語を学ぶ"
    description="A1〜C2の無料コース、DELE対策、勉強法、スペイン語学校。今のレベルを確かめて、次に学ぶことを見つけましょう。"
    breadcrumbs={breadcrumbs}
  />
  <section class="max-w-6xl mx-auto px-5 pt-14 pb-12">
    <p class="text-ink text-base leading-relaxed mb-3 border-l-2 border-primary pl-5 max-w-[780px]">
      スペイン倶楽部のスペイン語ページでは、セルバンテス学院の基準（A1 Acceso〜C2 Maestría）に沿った<strong>無料のスペイン語コース（全{TOTAL_UNITS}ユニット）</strong>を中心に、DELE対策、勉強法のガイド、スペイン語学校の情報をまとめています。コースは登録不要で、進み具合はこのブラウザに保存されます。
    </p>
    <p class="text-xs text-muted pl-5 mb-10">更新日：<time datetime={UPDATED}>{updatedLabel}</time></p>

    <nav id="categories" aria-label="このページの内容" class="grid grid-cols-2 md:grid-cols-6 gap-3 mb-12">
      {anchors.map(({ href, label }) => (
        <a href={href} class="bg-white rounded-lg px-3 py-3 min-h-[44px] flex items-center justify-center text-center border border-[#E8E8E6] hover:border-primary/30 hover:shadow-sm transition-all">
          <span class="font-semibold text-navy text-sm leading-snug block">{label}</span>
        </a>
      ))}
    </nav>

    <h2 id="start" class="font-sans font-bold text-xl text-navy mb-5">はじめる</h2>
    <CourseContinue />
    <div class="hub-start-grid">
      <a href={COURSE_URL} class="hub-start-card has-image is-primary">
        {roadmapImg && (
          <span class="hub-start-img"><img src={roadmapImg.src} srcset={roadmapImg.srcset} sizes="(min-width: 768px) 560px, 100vw" width={roadmapImg.width} height={roadmapImg.height} alt={roadmapImg.alt} decoding="async" /></span>
        )}
        <span class="hub-start-body">
          <span class="hub-start-head">
            <span class="hub-start-icon"><MapIcon size={24} aria-hidden="true" /></span>
            <span class="hub-start-title">スペイン語学習ロードマップ</span>
          </span>
          <span class="hub-start-desc">6つのレベルの意味、学習時間の目安、全{TOTAL_UNITS}ユニットの順番を1ページで確認できます。</span>
          <span class="hub-start-cta">ロードマップを見る →</span>
        </span>
      </a>
      <a href={LEVEL_TEST_URL} class="hub-start-card has-image is-primary">
        {levelTestImg && (
          <span class="hub-start-img"><img src={levelTestImg.src} srcset={levelTestImg.srcset} sizes="(min-width: 768px) 560px, 100vw" width={levelTestImg.width} height={levelTestImg.height} alt={levelTestImg.alt} decoding="async" /></span>
        )}
        <span class="hub-start-body">
          <span class="hub-start-head">
            <span class="hub-start-icon"><ClipboardCheck size={24} aria-hidden="true" /></span>
            <span class="hub-start-title">自分のレベルをチェック</span>
          </span>
          <span class="hub-start-desc">A1〜C2・全60問・登録不要。今のレベルと、どのユニットから始めればいいかがわかります。</span>
          <span class="hub-start-cta">レベルチェックを受ける →</span>
        </span>
      </a>
    </div>
  </section>

  {courseVisible && (
    <section class="hub-block is-course" id="course" aria-labelledby="course-title">
      <div class="max-w-6xl mx-auto px-5">
        <div class="hub-block-head">
          <p class="hub-block-eyebrow"><span class="hub-block-num">01</span>無料コース</p>
          <h2 id="course-title">スペイン語コース（A1〜C2・全{TOTAL_UNITS}ユニット）</h2>
          <p class="hub-block-lead">無料・登録不要。セルバンテス学院の6つのレベルに沿って、ユニット1から順番に進めます。各レベルの目次から、そのレベルの全ユニットと文法まとめ・単語・学習計画に進めます。前回開いたユニットには印がつきます。</p>
          <p class="course-links">
            <a href={WELCOME_URL}>学習設定（地域・ペース・例文の数）</a>
            <a href={CAST_URL}>登場人物</a>
            <a href={ABOUT_COURSE_URL}>このコースができるまで</a>
          </p>
        </div>
        <CourseLevels />
        {mockExams.length > 0 && (
          <div class="hub-mock">
            <h3 class="hub-sub">模擬試験（各レベルの最終ユニット）</h3>
            <p class="hub-mock-lead">各レベルの最後のユニットは、DELEの形式に沿った総復習と模擬試験です。レベルの仕上げに力を試しましょう。</p>
            <ol class="hub-mock-grid is-large">
              {mockExams.map((u) => (
                <li class={`lv-${u.level}`}>
                  <a class="unit-tile" href={u.url}>
                    <span class="unit-tile-img">{u.img && <img src={u.img} width="480" height="270" alt={u.alt} loading="lazy" decoding="async" />}</span>
                    <span class="unit-tile-num">ユニット{u.unit}</span>
                    <span class="unit-tile-title">{u.shortTitle}</span>
                  </a>
                </li>
              ))}
            </ol>
          </div>
        )}
      </div>
    </section>
  )}

  <section class="hub-block is-tools" id="tools" aria-labelledby="tools-title">
    <div class="max-w-6xl mx-auto px-5">
      <div class="hub-block-head">
        <p class="hub-block-eyebrow"><span class="hub-block-num">02</span>スペイン語 動詞の活用ツール</p>
        <h2 id="tools-title">動詞の活用を全時制で調べる</h2>
        <p class="hub-block-lead">よく使う動詞の活用を、全時制の早見表で調べられます。コースと並行して使えるツールです。</p>
      </div>
      {conjugator && (
        <a href={getArticleUrl(conjugator)} class="hub-feature">
          {conjugatorImg && (
            <span class="hub-feature-img"><img src={conjugatorImg.src} srcset={conjugatorImg.srcset} sizes="(min-width: 768px) 600px, 100vw" width={conjugatorImg.width} height={conjugatorImg.height} alt={conjugatorImg.alt} loading="lazy" decoding="async" /></span>
          )}
          <span class="hub-feature-body">
            <span class="hub-feature-badge">ツール</span>
            <span class="hub-feature-title">スペイン語 動詞の活用ツール（53動詞・全時制）</span>
            <span class="hub-feature-desc">原形でも活用形（fui、hice など）でも入力できる検索、全時制の早見表、よく使う53動詞の活用ページ。各時制は、それを学ぶコースのユニットにつながっています。</span>
            <span class="hub-feature-cta">活用を調べる →</span>
          </span>
        </a>
      )}
    </div>
  </section>

  <section class="hub-block is-materials" id="materials" aria-labelledby="materials-title">
    <div class="max-w-6xl mx-auto px-5">
      <div class="hub-block-head">
        <p class="hub-block-eyebrow"><span class="hub-block-num">03</span>補助教材</p>
        <h2 id="materials-title">補助教材・学習リソース</h2>
        <p class="hub-block-lead">発音・単語・リスニング・読解の練習法、学習計画の立て方、学習リソースをまとめた勉強法のページです。</p>
      </div>
      <a href={STUDY_HUB_URL} class="hub-feature">
        {studyImg && (
          <span class="hub-feature-img"><img src={studyImg.src} srcset={studyImg.srcset} sizes="(min-width: 768px) 600px, 100vw" width={studyImg.width} height={studyImg.height} alt={studyImg.alt} loading="lazy" decoding="async" /></span>
        )}
        <span class="hub-feature-body">
          <span class="hub-feature-badge">勉強法</span>
          <span class="hub-feature-title">スペイン語の勉強法のページへ</span>
          <span class="hub-feature-desc">発音・単語・リスニング・読解の練習法、学習計画の立て方、アプリや映画などの学習リソース。独学・教室・アプリ・留学の4つの学び方の比較もまとめています。</span>
          <span class="hub-feature-cta">勉強法を見る →</span>
        </span>
      </a>
    </div>
  </section>

  <section class="hub-block is-schools" id="schools" aria-labelledby="schools-title">
    <div class="max-w-6xl mx-auto px-5">
      <div class="hub-block-head">
        <p class="hub-block-eyebrow"><span class="hub-block-num">04</span>スペイン語学校</p>
        <h2 id="schools-title">スペイン語学校・教室</h2>
        <p class="hub-block-lead">先生と話して学びたい人のために、日本で通えるスペイン語教室と、スペイン留学の語学学校の情報をまとめています。</p>
      </div>
      <a href={SCHOOLS_HUB_URL} class="hub-feature">
        {schoolsImg && (
          <span class="hub-feature-img"><img src={schoolsImg.src} srcset={schoolsImg.srcset} sizes="(min-width: 768px) 600px, 100vw" width={schoolsImg.width} height={schoolsImg.height} alt={schoolsImg.alt} loading="lazy" decoding="async" /></span>
        )}
        <span class="hub-feature-body">
          <span class="hub-feature-badge">スペイン語学校</span>
          <span class="hub-feature-title">スペイン語学校のページへ</span>
          <span class="hub-feature-desc">東京・横浜・大阪・京都のスペイン語教室を、口コミなどの客観データで比較したガイドと、スペイン留学で通う語学学校のガイドをまとめています。</span>
          <span class="hub-feature-cta">スペイン語学校を見る →</span>
        </span>
      </a>
    </div>
  </section>

  <section class="hub-block is-dele" id="dele" aria-labelledby="dele-title">
    <div class="max-w-6xl mx-auto px-5">
      <div class="hub-block-head">
        <p class="hub-block-eyebrow"><span class="hub-block-num">05</span>DELE対策</p>
