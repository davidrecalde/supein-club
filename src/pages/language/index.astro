---
import { getCollection, getEntry, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SEO from '../../components/SEO.astro';
import PillarHero from '../../components/PillarHero.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import LineBanner from '../../components/LineBanner.astro';
import BackToCategoriesButton from '../../components/BackToCategoriesButton.astro';
import FAQSection from '../../components/FAQSection.astro';
import NewsletterForm from '../../components/NewsletterForm.astro';
import ArticleDisclaimer from '../../components/ArticleDisclaimer.astro';
import AuthorBox from '../../components/AuthorBox.astro';
import { getArticleUrl } from '../../utils/articles';
import { courseSequence } from '../../data/course-sequence';

type Article = CollectionEntry<'articles'>;

const author = await getEntry('authors', 'david-recalde');

const otherPillars = [
  { href: '/travel/', title: 'スペイン旅行', description: 'バルセロナ・マドリードから南部アンダルシア、離島まで、観光スポットとツアー情報を完全網羅' },
  { href: '/food/', title: 'スペイン料理', description: 'パエリア・タパス・ワインからおすすめのお土産まで、スペインの食文化を写真つきで詳しく解説' },
  { href: '/living/', title: 'スペインに住む', description: '留学・現地での仕事探し・ビザ取得の手続きまで、スペイン生活のリアルな実情を詳しく紹介' },
  { href: '/culture/', title: 'スペイン文化', description: 'フラメンコ・歴史的建造物・伝統の祭りなど、スペイン文化の奥深い魅力を詳しく紹介します' },
  { href: '/football/', title: 'スペインサッカー', description: 'ラ・リーガの試合結果や移籍情報、代表チーム、バルセロナやレアルの歴史まで深掘り解説します' },
];

const articles = await getCollection('articles', ({ data }) => !data.draft && data.pillar === 'language');

const slugOf = (a: Article) => a.id.replace(/\.(md|mdx)$/, '').split('/').pop();

// --- learn-spanish：はじめに / A1-C2 / DELE / その他 に分類 ---
const learnSpanish = articles.filter((a) => a.data.cluster === 'learn-spanish');
// 「スペイン語学校」セクション（otherClusters）は学校ランキング専用。
// spanish-apps はクラスターが分かれているだけで学校ではないため、その他に分類する。
const otherClusters = articles
  .filter((a) => a.data.cluster !== 'learn-spanish' && slugOf(a) !== 'spanish-apps')
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const isDele = (a: Article) =>
  a.id.includes('learn-spanish/dele/') || slugOf(a) === 'dele-vs-seiken' || slugOf(a) === 'dele-b1-tips';

const introRoles = ['pilar', 'onboarding', 'diagnostico'];
// 例外：zipf-law-methodology.mdx は articleRole "puente" のままだが、
// はじめにグループに分類する（その他には出さない）。
const isIntro = (a: Article) =>
  !isDele(a) && (introRoles.includes(a.data.articleRole ?? '') || slugOf(a) === 'zipf-law-methodology');

const isLevel = (a: Article) => !isDele(a) && !isIntro(a) && !!a.data.level;

const introArticles = learnSpanish.filter(isIntro);
const levelArticles = learnSpanish.filter(isLevel);
const deleArticles = learnSpanish.filter(isDele);
const otherArticles = learnSpanish
  .filter((a) => !isDele(a) && !isIntro(a) && !isLevel(a))
  .concat(articles.filter((a) => slugOf(a) === 'spanish-apps'));

// A1-C2バッジ：記事の役割から軽量なテーマラベルを導出（スキーマに新規フィールドは追加しない）
const roleBadgeLabels: Record<string, string> = {
  'spoke-gramatica': '文法',
  'spoke-vocabulario': '語彙',
  'spoke-pronunciacion': '発音',
  'spoke-plan': '学習計画',
};
const roleBadge = (a: Article): string | undefined => {
  if (slugOf(a) === 'subjunctive') return '文法'; // 例外：b1/subjunctive.mdx は articleRole "puente"
  return roleBadgeLabels[a.data.articleRole ?? ''];
};

// STEP/DELE バッジ：course-sequence.ts の位置から算出（はじめに・A1-C2・DELEのみ）
const idNoExt = (a: Article) => a.id.replace(/\.(md|mdx)$/, '');
const stepBadge = (a: Article): string | undefined => {
  const id = idNoExt(a);
  const stepIndex = courseSequence.step.indexOf(id);
  if (stepIndex !== -1) return `STEP ${stepIndex + 1} / ${courseSequence.step.length}`;
  const deleIndex = courseSequence.dele.indexOf(id);
  if (deleIndex !== -1) return `DELE ${deleIndex + 1} / ${courseSequence.dele.length}`;
  return undefined;
};

// はじめに: zipf-law-methodology → pilar(index) → diagnostico(level-test)
const introPriority = (a: Article) =>
  slugOf(a) === 'zipf-law-methodology' ? -1 : introRoles.indexOf(a.data.articleRole ?? '');
introArticles.sort((a, b) => introPriority(a) - introPriority(b));

// A1-C2: レベル順、レベル内は hub-nivel → 文法 → 語彙 → 発音 → 学習計画 → puente
const levelOrder = ['a1', 'a2', 'b1', 'b2', 'c1', 'c2'];
const levelLabels: Record<string, string> = { a1: 'A1', a2: 'A2', b1: 'B1', b2: 'B2', c1: 'C1', c2: 'C2' };
const roleOrder = ['hub-nivel', 'spoke-gramatica', 'spoke-vocabulario', 'spoke-pronunciacion', 'spoke-plan', 'puente'];

const levelGroups = levelOrder
  .map((level) => ({
    level,
    label: levelLabels[level],
    items: levelArticles
      .filter((a) => a.data.level === level)
      .sort((a, b) => {
        const ai = roleOrder.indexOf(a.data.articleRole ?? '');
        const bi = roleOrder.indexOf(b.data.articleRole ?? '');
        return (ai === -1 ? roleOrder.length : ai) - (bi === -1 ? roleOrder.length : bi);
      }),
  }))
  .filter((g) => g.items.length > 0);

// カテゴリ内のレベル/DELE/その他/学校アンカーピル（新規ページなし、既存の見出しidへジャンプ）
const levelAnchors = [
  ...levelGroups.map((g) => ({ href: `#${g.level}`, label: g.label })),
  ...(deleArticles.length > 0 ? [{ href: '#dele', label: 'DELE' }] : []),
  ...(otherArticles.length > 0 ? [{ href: '#other', label: '学習リソース' }] : []),
  ...(otherClusters.length > 0 ? [{ href: '#schools', label: 'スペイン語学校' }] : []),
];

// DELE: hub-dele → prep-dele(a1→c2) → info-dele → dele-vs-seiken → dele-b1-tips
const delePriority = (a: Article) => {
  if (a.data.articleRole === 'hub-dele') return 0;
  if (a.data.articleRole === 'prep-dele') return 1;
  if (a.data.articleRole === 'info-dele') return 2;
  if (slugOf(a) === 'dele-vs-seiken') return 3;
  if (slugOf(a) === 'dele-b1-tips') return 4;
  return 5;
};
deleArticles.sort((a, b) => {
  const pa = delePriority(a);
  const pb = delePriority(b);
  if (pa !== pb) return pa - pb;
  if (pa === 1) return levelOrder.indexOf(a.data.level ?? '') - levelOrder.indexOf(b.data.level ?? '');
  return 0;
});

// その他: 公開日の新しい順
otherArticles.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const breadcrumbs = [
  { name: 'ホーム', url: '/' },
  { name: 'スペイン語', url: '/language/' },
];

const allLanguageArticles = [...introArticles, ...levelGroups.flatMap((g) => g.items), ...deleArticles, ...otherArticles, ...otherClusters];

const languageSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'スペイン語',
  description: 'スペイン語学習に関する独学法・教室・アプリ・DELE対策の情報',
  url: 'https://supein.club/language/',
  about: {
    '@type': 'Thing',
    name: 'スペイン語学習',
  },
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: allLanguageArticles.map((a, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: `https://supein.club${getArticleUrl(a)}`,
      name: a.data.title,
    })),
  },
};

const languageFaq = [
  {
    question: 'このサイトのスペイン語学習コンテンツはどこから見ればいいですか？',
    answer: 'ゼロから体系的に学びたい方は<a href="/language/learn-spanish/">「スペイン語学習ロードマップ」</a>から始めるのがおすすめです。CEFRレベル（A1〜C2）ごとの学習パスが整理されています。',
  },
  {
    question: '動詞の活用形を素早く確認したい場合は？',
    answer: 'レッスン形式ではなく、活用表だけをすぐに調べられる<a href="/language/learn-spanish/verb-conjugation/">「スペイン語動詞活用表」</a>にまとめています。',
  },
  {
    question: 'DELEと西検、どちらを受けるべきか比較はありますか？',
    answer: '難易度・費用・国際的な認知度などの観点から<a href="/language/learn-spanish/dele-vs-seiken/">「DELEと西検、どちらを受けるべき？」</a>で詳しく比較しています。',
  },
  {
    question: '東京でスペイン語教室を探すには？',
    answer: 'CRE客観データに基づく学校ランキングを<a href="/language/tokyo-spanish-schools/">「東京のスペイン語学校おすすめ」</a>にまとめています。',
  },
  {
    question: 'スペイン語学習アプリのおすすめはどこで見られますか？',
    answer: '目的別（総合・会話・語彙）のアプリ比較を<a href="/language/spanish-apps/">「スペイン語アプリ おすすめ比較」</a>で紹介しています。',
  },
  {
    question: '独学と教室、どちらを選べばいいですか？',
    answer: '継続のしやすさや予算を重視するなら独学、発音や会話練習にすぐフィードバックが欲しいなら教室が向いています。教室を検討する場合は東京の学校ランキングもあわせてご覧ください。',
  },
];
---
<BaseLayout>
  <SEO
    slot="seo"
    title="スペイン語 勉強法・教室・アプリ完全ガイド | supein.club"
    description="スペイン語の独学勉強法からDELE試験対策、東京のスペイン語教室比較、学習アプリの選び方まで。CEFRレベル別（A1〜C2）の学習ロードマップと動詞活用表など、日本語話者向けに実用的な情報を網羅しています。"
    canonical="https://supein.club/language/"
    breadcrumbs={breadcrumbs}
  />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(languageSchema)} />
  <script
    type="application/ld+json"
    slot="head"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: languageFaq.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: { '@type': 'Answer', text: item.answer.replace(/<[^>]+>/g, '') },
      })),
    })}
  />
  <PillarHero
    title="スペイン語"
    description="独学、教室、オンラインレッスン——あなたに合ったスペイン語学習法を見つけるためのガイドが揃っています。"
  />
  <section class="max-w-6xl mx-auto px-5 py-14">
    <p class="text-muted text-base leading-relaxed mb-12 border-l-2 border-primary pl-5">
      スペイン語学習には、独学での勉強法から、教室・オンラインレッスンの活用まで、自分に合ったスタイルを選ぶことが上達の近道です。基礎文法や日常会話フレーズ、学習アプリ・参考書の選び方まで、幅広いトピックで役立つ情報をまとめています。
    </p>
    <h2 id="categories" class="font-sans font-bold text-xl text-navy mb-5">カテゴリ</h2>
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-3 mb-12">
      {levelAnchors.map(({ href, label }) => (
        <a href={href} class="bg-white rounded-lg px-3 py-3 min-h-[44px] flex items-center justify-center text-center border border-[#E8E8E6] hover:border-primary/30 hover:shadow-sm transition-all">
          <span class="font-semibold text-navy text-sm leading-snug block">{label}</span>
        </a>
      ))}
    </div>

    {introArticles.length > 0 && (
      <>
        <h2 class="font-sans font-bold text-xl text-navy mb-5">はじめに</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
          {introArticles.map((a) => (
            <ArticleCard title={a.data.title} description={a.data.description} href={getArticleUrl(a)} pillar="language" cluster={a.data.cluster} image={a.data.image} imageAlt={a.data.imageAlt} heroImage={a.data.heroImage} heroImageAlt={a.data.heroImageAlt} pubDate={a.data.pubDate} stepBadge={stepBadge(a)} />
          ))}
        </div>
      </>
    )}

    {levelGroups.map((group) => (
      <>
        <h2 id={group.level} class="font-sans font-bold text-xl text-navy mb-5">{group.label}</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
          {group.items.map((a) => (
            <ArticleCard title={a.data.title} description={a.data.description} href={getArticleUrl(a)} pillar="language" cluster={a.data.cluster} image={a.data.image} imageAlt={a.data.imageAlt} heroImage={a.data.heroImage} heroImageAlt={a.data.heroImageAlt} pubDate={a.data.pubDate} topicBadge={roleBadge(a)} stepBadge={stepBadge(a)} />
          ))}
        </div>
      </>
    ))}

    {deleArticles.length > 0 && (
      <>
        <h2 id="dele" class="font-sans font-bold text-xl text-navy mb-5">DELE</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
          {deleArticles.map((a) => (
            <ArticleCard title={a.data.title} description={a.data.description} href={getArticleUrl(a)} pillar="language" cluster={a.data.cluster} image={a.data.image} imageAlt={a.data.imageAlt} heroImage={a.data.heroImage} heroImageAlt={a.data.heroImageAlt} pubDate={a.data.pubDate} stepBadge={stepBadge(a)} />
          ))}
        </div>
      </>
    )}

    {otherArticles.length > 0 && (
      <>
        <h2 id="other" class="font-sans font-bold text-xl text-navy mb-5">学習リソース</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
          {otherArticles.map((a) => (
            <ArticleCard title={a.data.title} description={a.data.description} href={getArticleUrl(a)} pillar="language" cluster={a.data.cluster} image={a.data.image} imageAlt={a.data.imageAlt} heroImage={a.data.heroImage} heroImageAlt={a.data.heroImageAlt} pubDate={a.data.pubDate} topicBadge="学習リソース" />
          ))}
        </div>
      </>
    )}

    {otherClusters.length > 0 && (
      <>
        <h2 id="schools" class="font-sans font-bold text-xl text-navy mb-5">スペイン語学校</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
          {otherClusters.map((a) => (
            <ArticleCard title={a.data.title} description={a.data.description} href={getArticleUrl(a)} pillar="language" cluster={a.data.cluster} image={a.data.image} imageAlt={a.data.imageAlt} heroImage={a.data.heroImage} heroImageAlt={a.data.heroImageAlt} pubDate={a.data.pubDate} topicBadge="スペイン語学校" />
          ))}
        </div>
      </>
    )}
  </section>

  <section class="max-w-6xl mx-auto px-5 pb-14 prose-content">
  <div class="max-w-[780px]">
    <h2 class="font-sans font-bold text-xl text-navy mb-4">このサイトのスペイン語コンテンツについて</h2>
    <p class="text-muted leading-relaxed mb-6">
      このカテゴリでは、ゼロから体系的に学びたい方向けのCEFRレベル別ロードマップ（A1〜C2）、DELE受験対策、東京のスペイン語教室の比較、学習アプリの選び方まで、目的別に情報を整理しています。まず何から手をつければいいか迷ったら、下記の各セクションをご覧ください。
    </p>

    <h2 class="font-sans font-bold text-xl text-navy mb-4">文法の基礎を確認するなら</h2>
    <p class="text-muted leading-relaxed mb-6">
      レベル別に体系立てて学びたい方は<a href="/language/learn-spanish/a1/grammar/" class="text-primary underline">「スペイン語A1文法まとめ」</a>から。動詞の活用形をレッスンではなくすぐに調べたい方は<a href="/language/learn-spanish/verb-conjugation/" class="text-primary underline">「スペイン語動詞活用表」</a>にまとめています。
    </p>

    <h2 class="font-sans font-bold text-xl text-navy mb-4">DELEか西検か迷ったら</h2>
    <p class="text-muted leading-relaxed mb-6">
      スペイン語の代表的な資格試験には、セルバンテス学院が運営する国際資格DELEと、日本国内向けの西検（実用スペイン語技能検定）があります。難易度・費用・国際的な認知度の違いは<a href="/language/learn-spanish/dele-vs-seiken/" class="text-primary underline">「DELEと西検、どちらを受けるべき？」</a>で比較しています。
    </p>

    <h2 class="font-sans font-bold text-xl text-navy mb-4">東京でスペイン語教室を探すなら</h2>
    <p class="text-muted leading-relaxed mb-6">
      独学だけでなく教室やオンラインレッスンの活用を検討している方には、CRE客観データに基づく学校ランキングをまとめた<a href="/language/tokyo-spanish-schools/" class="text-primary underline">「東京のスペイン語学校おすすめ」</a>が参考になります。
    </p>

    <h2 class="font-sans font-bold text-xl text-navy mb-4">学習アプリを活用するなら</h2>
    <p class="text-muted leading-relaxed mb-6">
      スキマ時間の学習には、目的別（総合・会話・語彙）にまとめた<a href="/language/spanish-apps/" class="text-primary underline">「スペイン語アプリ おすすめ比較」</a>をご覧ください。
    </p>

    <NewsletterForm variant="inline" />

    <FAQSection faq={languageFaq} />

    {author && <ArticleDisclaimer />}
    {author && <AuthorBox author={author} />}

    <section class="mt-12 border-t border-[#E8E8E6] pt-10">
      <h2 class="font-sans font-bold text-2xl text-navy mb-2">こちらの記事もおすすめ</h2>
      <p class="text-sm text-gray-500 mb-6">スペインの他のテーマも見てみませんか。</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
        {otherPillars.map((p) => (
          <a href={p.href} class="block bg-white rounded-xl overflow-hidden shadow-[0_2px_8px_rgba(0,33,71,0.07)] border border-[#E8E8E6] hover:shadow-[0_4px_16px_rgba(0,33,71,0.12)] hover:border-primary/20 transition-all p-6">
            <h3 class="font-sans font-bold text-navy text-lg mb-2">{p.title}</h3>
            <p class="text-muted text-sm leading-relaxed">{p.description}</p>
          </a>
        ))}
      </div>
    </section>
  </div>
  </section>

  <LineBanner slim />
  <BackToCategoriesButton />
</BaseLayout>
