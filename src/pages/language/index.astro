---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SEO from '../../components/SEO.astro';
import PillarHero from '../../components/PillarHero.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import LineBanner from '../../components/LineBanner.astro';
import AdSlot from '../../components/AdSlot.astro';
import { getArticleUrl } from '../../utils/articles';
import { courseSequence } from '../../data/course-sequence';

type Article = CollectionEntry<'articles'>;

const articles = await getCollection('articles', ({ data }) => !data.draft && data.pillar === 'language');

// --- カテゴリ：clusterごとに件数を数え、記事があるものだけ表示 ---
const clusterLabels: Record<string, string> = {
  'learn-spanish': 'スペイン語勉強',
  'spanish-grammar': '文法',
  'pronunciation': '発音',
  'self-study': '独学',
  'lessons-tokyo': '東京の教室',
  'online-lessons': 'オンライン',
  'lesson-price': 'レッスン料金',
  'spanish-phrases': 'フレーズ',
  'spanish-apps': 'アプリ',
  'spanish-books': '教材本',
};

const clusterCounts = new Map<string, number>();
for (const a of articles) {
  clusterCounts.set(a.data.cluster, (clusterCounts.get(a.data.cluster) ?? 0) + 1);
}

const clusters = Object.keys(clusterLabels)
  .filter((cluster) => (clusterCounts.get(cluster) ?? 0) > 0)
  .map((cluster) => ({
    href: `/language/${cluster}/`,
    label: clusterLabels[cluster],
  }));

// --- learn-spanish：はじめに / A1-C2 / DELE / その他 に分類 ---
const learnSpanish = articles.filter((a) => a.data.cluster === 'learn-spanish');
const otherClusters = articles
  .filter((a) => a.data.cluster !== 'learn-spanish')
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const slugOf = (a: Article) => a.id.replace(/\.(md|mdx)$/, '').split('/').pop();

const isDele = (a: Article) =>
  a.id.includes('learn-spanish/dele/') || slugOf(a) === 'dele-vs-seiken' || slugOf(a) === 'dele-b1-tips';

const introRoles = ['pilar', 'onboarding', 'diagnostico'];
const isIntro = (a: Article) => !isDele(a) && introRoles.includes(a.data.articleRole ?? '');

const isLevel = (a: Article) => !isDele(a) && !isIntro(a) && !!a.data.level;

const introArticles = learnSpanish.filter(isIntro);
const levelArticles = learnSpanish.filter(isLevel);
const deleArticles = learnSpanish.filter(isDele);
const otherArticles = learnSpanish.filter((a) => !isDele(a) && !isIntro(a) && !isLevel(a));

// A1-C2バッジ：記事の役割から軽量なテーマラベルを導出（スキーマに新規フィールドは追加しない）
const roleBadgeLabels: Record<string, string> = {
  'spoke-gramatica': '文法',
  'spoke-vocabulario': '語彙',
  'spoke-pronunciacion': '発音',
  'spoke-plan': '学習計画',
};
const roleBadge = (a: Article): string | undefined => {
  if (slugOf(a) === 'subjunctive') return '文法'; // 例外：b1/subjunctive.mdx は articleRole "puente"
  return roleBadgeLabels[a.data.articleRole ?? ''];
};

// STEP/DELE バッジ：course-sequence.ts の位置から算出（はじめに・A1-C2・DELEのみ）
const idNoExt = (a: Article) => a.id.replace(/\.(md|mdx)$/, '');
const stepBadge = (a: Article): string | undefined => {
  const id = idNoExt(a);
  const stepIndex = courseSequence.step.indexOf(id);
  if (stepIndex !== -1) return `STEP ${stepIndex + 1} / ${courseSequence.step.length}`;
  const deleIndex = courseSequence.dele.indexOf(id);
  if (deleIndex !== -1) return `DELE ${deleIndex + 1} / ${courseSequence.dele.length}`;
  return undefined;
};

// はじめに: pilar → onboarding(start-here) → diagnostico(level-test)
introArticles.sort((a, b) => introRoles.indexOf(a.data.articleRole ?? '') - introRoles.indexOf(b.data.articleRole ?? ''));

// A1-C2: レベル順、レベル内は hub-nivel → 文法 → 語彙 → 発音 → 学習計画 → puente
const levelOrder = ['a1', 'a2', 'b1', 'b2', 'c1', 'c2'];
const levelLabels: Record<string, string> = { a1: 'A1', a2: 'A2', b1: 'B1', b2: 'B2', c1: 'C1', c2: 'C2' };
const roleOrder = ['hub-nivel', 'spoke-gramatica', 'spoke-vocabulario', 'spoke-pronunciacion', 'spoke-plan', 'puente'];

const levelGroups = levelOrder
  .map((level) => ({
    level,
    label: levelLabels[level],
    items: levelArticles
      .filter((a) => a.data.level === level)
      .sort((a, b) => {
        const ai = roleOrder.indexOf(a.data.articleRole ?? '');
        const bi = roleOrder.indexOf(b.data.articleRole ?? '');
        return (ai === -1 ? roleOrder.length : ai) - (bi === -1 ? roleOrder.length : bi);
      }),
  }))
  .filter((g) => g.items.length > 0);

// DELE: hub-dele → prep-dele(a1→c2) → info-dele → dele-vs-seiken → dele-b1-tips
const delePriority = (a: Article) => {
  if (a.data.articleRole === 'hub-dele') return 0;
  if (a.data.articleRole === 'prep-dele') return 1;
  if (a.data.articleRole === 'info-dele') return 2;
  if (slugOf(a) === 'dele-vs-seiken') return 3;
  if (slugOf(a) === 'dele-b1-tips') return 4;
  return 5;
};
deleArticles.sort((a, b) => {
  const pa = delePriority(a);
  const pb = delePriority(b);
  if (pa !== pb) return pa - pb;
  if (pa === 1) return levelOrder.indexOf(a.data.level ?? '') - levelOrder.indexOf(b.data.level ?? '');
  return 0;
});

// その他: 公開日の新しい順
otherArticles.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const breadcrumbs = [
  { name: 'ホーム', url: '/' },
  { name: 'スペイン語', url: '/language/' },
];
---
<BaseLayout>
  <SEO
    slot="seo"
    title="スペイン語 勉強法・教室・アプリ完全ガイド | supein.club"
    description="スペイン語の独学勉強法から東京の教室・オンラインレッスンまで。初心者から上級者向けの学習リソースを網羅。"
    canonical="https://supein.club/language/"
    breadcrumbs={breadcrumbs}
  />
  <PillarHero
    title="スペイン語"
    description="独学、教室、オンラインレッスン——あなたに合ったスペイン語学習法を見つけるためのガイドが揃っています。"
  />
  <section class="max-w-5xl mx-auto px-5 py-14">
    <h2 class="font-sans font-bold text-xl text-navy mb-5">カテゴリ</h2>
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-3 mb-12">
      {clusters.map(({ href, label }) => (
        <a href={href} class="bg-white rounded-lg px-3 py-3 min-h-[44px] flex items-center justify-center text-center border border-[#E8E8E6] hover:border-primary/30 hover:shadow-sm transition-all">
          <span class="font-semibold text-navy text-xs leading-snug block">{label}</span>
        </a>
      ))}
    </div>
    <div class="mb-10">
      <AdSlot
        position="pillar-mid"
        interlinkTitle="スペイン語を独学で始める完全ガイド"
        interlinkUrl="/language/learn-spanish/"
        interlinkPillar="スペイン語"
        interlinkReadingTime={5}
      />
    </div>

    {introArticles.length > 0 && (
      <>
        <h2 class="font-sans font-bold text-xl text-navy mb-5">はじめに</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
          {introArticles.map((a) => (
            <ArticleCard title={a.data.title} description={a.data.description} href={getArticleUrl(a)} pillar="language" image={a.data.image} imageAlt={a.data.imageAlt} heroImage={a.data.heroImage} heroImageAlt={a.data.heroImageAlt} pubDate={a.data.pubDate} stepBadge={stepBadge(a)} />
          ))}
        </div>
      </>
    )}

    {levelGroups.map((group) => (
      <>
        <h2 class="font-sans font-bold text-xl text-navy mb-5">{group.label}</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
          {group.items.map((a) => (
            <ArticleCard title={a.data.title} description={a.data.description} href={getArticleUrl(a)} pillar="language" image={a.data.image} imageAlt={a.data.imageAlt} heroImage={a.data.heroImage} heroImageAlt={a.data.heroImageAlt} pubDate={a.data.pubDate} topicBadge={roleBadge(a)} stepBadge={stepBadge(a)} />
          ))}
        </div>
      </>
    ))}

    {deleArticles.length > 0 && (
      <>
        <h2 class="font-sans font-bold text-xl text-navy mb-5">DELE</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
          {deleArticles.map((a) => (
            <ArticleCard title={a.data.title} description={a.data.description} href={getArticleUrl(a)} pillar="language" image={a.data.image} imageAlt={a.data.imageAlt} heroImage={a.data.heroImage} heroImageAlt={a.data.heroImageAlt} pubDate={a.data.pubDate} stepBadge={stepBadge(a)} />
          ))}
        </div>
      </>
    )}

    {otherArticles.length > 0 && (
      <>
        <h2 class="font-sans font-bold text-xl text-navy mb-5">その他</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
          {otherArticles.map((a) => (
            <ArticleCard title={a.data.title} description={a.data.description} href={getArticleUrl(a)} pillar="language" image={a.data.image} imageAlt={a.data.imageAlt} heroImage={a.data.heroImage} heroImageAlt={a.data.heroImageAlt} pubDate={a.data.pubDate} />
          ))}
        </div>
      </>
    )}

    {otherClusters.length > 0 && (
      <>
        <h2 class="font-sans font-bold text-xl text-navy mb-5">スペイン語学校</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {otherClusters.map((a) => (
            <ArticleCard title={a.data.title} description={a.data.description} href={getArticleUrl(a)} pillar="language" image={a.data.image} imageAlt={a.data.imageAlt} heroImage={a.data.heroImage} heroImageAlt={a.data.heroImageAlt} pubDate={a.data.pubDate} />
          ))}
        </div>
      </>
    )}
  </section>
  <LineBanner />
</BaseLayout>
