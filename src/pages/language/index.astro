---
// Hub /language/: guía de 勉強法 con el curso A1-C2 como centro
// (docs/language/plan-hub-embudo.md, punto 9). Arriba solo las salidas del
// curso (test de nivel, hoja de ruta, seis niveles); después, cómo estudiar,
// herramientas, DELE, recursos y escuelas.
import { getCollection, getEntry, type CollectionEntry } from 'astro:content';
import { getImage } from 'astro:assets';
import { ClipboardCheck, Map as MapIcon } from 'lucide-astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SEO from '../../components/SEO.astro';
import PillarHero from '../../components/PillarHero.astro';
import HubCard from '../../components/HubCard.astro';
import LineBanner from '../../components/LineBanner.astro';
import FloatingActions from '../../components/FloatingActions.astro';
import FAQSection from '../../components/FAQSection.astro';
import NewsletterForm from '../../components/NewsletterForm.astro';
import ArticleDisclaimer from '../../components/ArticleDisclaimer.astro';
import AuthorBox from '../../components/AuthorBox.astro';
import CourseLevels from '../../components/course/CourseLevels.astro';
import CourseContinue from '../../components/course/CourseContinue.astro';
import { getArticleUrl } from '../../utils/articles';
import { courseSequence } from '../../data/course-sequence';
import { ABOUT_COURSE_URL, CAST_URL, COURSE_LEVELS, COURSE_URL, TOTAL_UNITS, WELCOME_URL, levelUrl } from '../../data/course';
import { getAllUnits, isCourseVisible } from '../../utils/units';

type Article = CollectionEntry<'articles'>;

const author = await getEntry('authors', 'david-recalde');
const courseVisible = await isCourseVisible();
const firstUnit = (await getAllUnits())[0];

const LEVEL_TEST_URL = '/language/learn-spanish/level-test/';
const CONJUGATION_URL = '/language/learn-spanish/verb-conjugation/';
const DELE_URL = '/language/dele/';

const otherPillars = [
  { href: '/travel/', title: 'スペイン旅行', description: 'バルセロナ・マドリードから南部アンダルシア、離島まで、観光スポットとツアー情報を完全網羅' },
  { href: '/food/', title: 'スペイン料理', description: 'パエリア・タパス・ワインからおすすめのお土産まで、スペインの食文化を写真つきで詳しく解説' },
  { href: '/living/', title: 'スペインに住む', description: '留学・現地での仕事探し・ビザ取得の手続きまで、スペイン生活のリアルな実情を詳しく紹介' },
  { href: '/culture/', title: 'スペイン文化', description: 'フラメンコ・歴史的建造物・伝統の祭りなど、スペイン文化の奥深い魅力を詳しく紹介します' },
  { href: '/football/', title: 'スペインサッカー', description: 'ラ・リーガの試合結果や移籍情報、代表チーム、バルセロナやレアルの歴史まで深掘り解説します' },
];

const articles = await getCollection('articles', ({ data }) => !data.draft && data.pillar === 'language');
const idNoExt = (a: Article) => a.id.replace(/\.(md|mdx)$/, '');
const slugOf = (a: Article) => idNoExt(a).split('/').pop() ?? '';
const byId = (id: string) => articles.find((a) => idNoExt(a) === `language/learn-spanish/${id}`);

// --- Clasificación de los artículos del hub ---
// Las páginas de nivel (hub, gramática, vocabulario, plan, subjuntivo) se
// enlazan desde las tarjetas de los seis niveles, no como tarjetas sueltas.
const learnSpanish = articles.filter((a) => a.data.cluster === 'learn-spanish');
const isDele = (a: Article) => idNoExt(a).includes('learn-spanish/dele/') || a.data.articleRole === 'info-dele' || slugOf(a) === 'dele-vs-seiken';
const isLevelPage = (a: Article) => !isDele(a) && !!a.data.level;
const TOP_IDS = ['index', 'level-test'];
const TOOL_IDS = ['verb-conjugation', 'pronunciation-for-japanese', 'zipf-law-methodology', 'spanish-vs-japanese', 'how-to-make-study-plan'];

const tools = TOOL_IDS.map(byId).filter((a): a is Article => !!a);

// DELE: primero la secuencia DELE (course-sequence.ts), después las guías.
const deleOrder = (a: Article) => {
  const i = courseSequence.dele.indexOf(idNoExt(a));
  return i === -1 ? courseSequence.dele.length : i;
};
const deleArticles = learnSpanish.filter(isDele).sort((a, b) => deleOrder(a) - deleOrder(b));
// El bloque DELE del hub es un único botón al hub DELE (src/pages/language/dele/index.astro), que reúne todas las páginas DELE.
// Imágenes de los botones grandes, las de sus artículos: レベルチェック, ロードマップ y DELE (dele-difficulty-guide).
const cardImage = async (a?: Article) => {
  const src = a?.data.heroImage;
  if (!a || !src || typeof src === 'string') return undefined;
  const [small, large] = await Promise.all([480, 800].map((width) => getImage({ src, width, format: 'webp', quality: 75 })));
  return { src: large.src, srcset: `${small.src} 480w, ${large.src} 800w`, width: Number(large.attributes.width), height: Number(large.attributes.height), alt: a.data.heroImageAlt ?? '' };
};
const [levelTestImg, roadmapImg, deleImg, conjugatorImg] = await Promise.all([cardImage(byId('level-test')), cardImage(byId('index')), cardImage(byId('dele-difficulty-guide')), cardImage(byId('verb-conjugation'))]);
// El conjugador (la página más visitada del hub) va destacado al principio del bloque 03; el resto de herramientas, en tarjetas.
const conjugator = byId('verb-conjugation');
const otherTools = tools.filter((a) => a !== conjugator);
// Simulacros: la última unidad de cada nivel (review-dele-*), con su ilustración.
const mockExams = (await getAllUnits())
  .filter((u) => u.data.slug.startsWith('review-dele'))
  .map((u) => ({ unit: u.data.unit, level: u.data.level, url: u.data.url, shortTitle: u.data.shortTitle, img: u.data.image?.src.replace(/\.webp$/, '-480.webp'), alt: u.data.image?.alt ?? '' }));

// Recursos: el resto de learn-spanish (nada se queda sin enlace) + la comparativa de apps.
const resources = learnSpanish
  .filter((a) => !isDele(a) && !isLevelPage(a) && !TOP_IDS.includes(idNoExt(a).replace('language/learn-spanish/', '')) && !tools.includes(a))
  .concat(articles.filter((a) => slugOf(a) === 'spanish-apps'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Escuelas: clusters propios de ranking (sin spanish-apps), con la página madre primero.
const schools = articles
  .filter((a) => a.data.cluster !== 'learn-spanish' && slugOf(a) !== 'spanish-apps')
  .sort((a, b) => (slugOf(b) === 'spanish-schools-in-japan' ? 1 : 0) - (slugOf(a) === 'spanish-schools-in-japan' ? 1 : 0) || b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const anchors = [
  { href: '#start', label: 'はじめる' },
  ...(courseVisible ? [{ href: '#course', label: '無料コース' }] : []),
  { href: '#dele', label: 'DELE対策' },
  { href: '#materials', label: '補助教材' },
  { href: '#methods', label: '勉強法' },
];

const breadcrumbs = [
  { name: 'ホーム', url: '/' },
  { name: 'スペイン語', url: '/language/' },
];

// ItemList: lo que la página enlaza, en su orden (salidas del curso, niveles y artículos).
const levelItems = courseVisible ? COURSE_LEVELS.map((l) => ({ url: levelUrl(l.code), name: `${l.code} ${l.name}` })) : [];
const listed = [
  { url: COURSE_URL, name: 'スペイン語学習ロードマップ' },
  { url: LEVEL_TEST_URL, name: 'スペイン語レベルチェックテスト' },
  ...levelItems,
  ...tools.map((a) => ({ url: getArticleUrl(a), name: a.data.title })),
  { url: DELE_URL, name: 'DELE（スペイン語検定）' },
  ...[...resources, ...schools].map((a) => ({ url: getArticleUrl(a), name: a.data.title })),
];
const languageSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'スペイン語の勉強法',
  description: 'スペイン語の独学の始め方、学び方の比較、A1〜C2の無料コース、DELE対策、学習リソースとスペイン語学校の情報',
  url: 'https://supein.club/language/',
  inLanguage: 'ja',
  about: { '@type': 'Thing', name: 'スペイン語学習' },
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: listed.map((item, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: `https://supein.club${item.url}`,
      name: item.name,
    })),
  },
};

// Curso gratuito A1-C2: sin Offer ni hasCourseInstance (no hay precio ni fechas que marcar).
// Solo se marca cuando el bloque del curso es visible (ver isCourseVisible).
const courseSchema = {
  '@context': 'https://schema.org',
  '@type': 'Course',
  '@id': 'https://supein.club/language/#course',
  name: `スペイン語コース（A1〜C2・全${TOTAL_UNITS}ユニット）`,
  description: 'セルバンテス学院の基準（A1 Acceso〜C2 Maestría）に沿った、日本人のための無料スペイン語コース。登録不要で、自分のペースで進められます。',
  url: 'https://supein.club/language/',
  inLanguage: 'ja',
  isAccessibleForFree: true,
  provider: { '@id': 'https://supein.club/#organization' },
  about: { '@type': 'Language', name: 'スペイン語', alternateName: 'es' },
  hasPart: COURSE_LEVELS.map((l) => ({
    '@type': 'CreativeWork',
    name: `${l.code} ${l.name}`,
    url: `https://supein.club${levelUrl(l.code)}`,
  })),
};

const methods = [
  {
    name: '無料コースで独学',
    who: '費用をかけずに、自分のペースで始めたい人',
    pro: 'A1〜C2の順番が決まっていて、各ユニットのミニテストで理解を確かめられる',
    con: '会話の相手はいないので、話す練習は別に用意する',
    href: COURSE_URL,
    link: '学習ロードマップ',
  },
  {
    name: 'スペイン語教室・オンラインレッスン',
    who: '会話を練習したい人、質問しながら進めたい人',
    pro: '先生からその場で発音や表現を直してもらえる',
    con: '受講料と、通う・予約する時間がかかる',
    href: '/language/spanish-schools-in-japan/',
    link: '日本のスペイン語教室',
  },
  {
    name: '学習アプリ',
    who: 'スキマ時間に単語やフレーズに触れたい人',
    pro: '1回数分から、毎日続けやすい',
    con: 'アプリだけでは、文法を体系的に理解するのが難しい',
    href: '/language/spanish-apps/',
    link: 'スペイン語アプリ比較',
  },
  {
    name: 'スペイン留学',
    who: '短期間で集中して伸ばしたい人',
    pro: '授業の外でも、毎日スペイン語を使う環境にいられる',
    con: '費用と準備が必要。基礎を日本で固めておくと、現地の授業を活かしやすい',
    href: '/living/study-spain/',
    link: 'スペイン留学ガイド',
  },
];

const languageFaq = [
  {
    question: 'スペイン語は独学でも身につきますか？',
    answer: `文法・単語・読む力は、順番どおりに学べば独学でも十分に伸ばせます。このサイトの<a href="${COURSE_URL}">無料コース（A1〜C2・全${TOTAL_UNITS}ユニット）</a>は登録不要で、各ユニットのミニテストで理解を確かめながら進められます。話す力には相手が必要なので、<a href="/language/spanish-schools-in-japan/">スペイン語教室やオンラインレッスン</a>との組み合わせがおすすめです。`,
  },
  {
    question: 'スペイン語の勉強は何から始めればいいですか？',
    answer: `少しでも勉強したことがあるなら、まず<a href="${LEVEL_TEST_URL}">レベルチェック</a>を受けてください。結果と一緒に、どのユニットから始めればいいかがわかります。まったく初めての方は、<a href="${firstUnit?.data.url ?? COURSE_URL}">ユニット1「発音と読み方」</a>から始めましょう。`,
  },
  {
    question: '1日にどのくらい勉強すればいいですか？',
    answer: `まとめて長時間よりも、毎日20分ほどを続けるほうが定着します。週に何ユニット進めるかは<a href="${WELCOME_URL}">学習設定</a>で選べます。レベルごとの学習時間の目安は<a href="${COURSE_URL}">学習ロードマップ</a>にまとめています。`,
  },
  {
    question: '動詞の活用形をすぐに調べたいときは？',
    answer: `<a href="${CONJUGATION_URL}">スペイン語動詞活用表</a>で、よく使う動詞の全時制の活用を確認できます。それぞれの時制は、それを学ぶコースのユニットにつながっています。`,
  },
  {
    question: 'DELEと西検、どちらを受けるべきですか？',
    answer: '国際的に通用する資格がほしいならDELE、日本国内の大学や就職での評価を重視するなら西検が候補になります。違いは<a href="/language/learn-spanish/dele-vs-seiken/">「DELEと西検、どちらを受けるべき？」</a>で詳しく比較しています。',
  },
  {
    question: 'スペイン語教室はどこで探せますか？',
    answer: '東京・横浜・大阪・京都の学校を、口コミなどの客観データで比較した<a href="/language/spanish-schools-in-japan/">「日本のスペイン語教室完全ガイド」</a>にまとめています。',
  },
];
---
<BaseLayout>
  <SEO
    slot="seo"
    title="スペイン語の勉強法｜独学の始め方と教室・アプリ・留学の選び方"
    description="スペイン語の勉強法を、独学の始め方から教室・アプリ・留学との比較までまとめました。無料のレベルチェックで今の力を確かめ、A1〜C2の無料コースで発音・文法・単語を順番に学べます。"
    canonical="https://supein.club/language/"
    image="/og/language.webp"
    breadcrumbs={breadcrumbs}
  />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(languageSchema)} />
  {courseVisible && <script type="application/ld+json" slot="head" set:html={JSON.stringify(courseSchema)} />}
  <script
    type="application/ld+json"
    slot="head"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: languageFaq.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: { '@type': 'Answer', text: item.answer.replace(/<[^>]+>/g, '') },
      })),
    })}
  />
  <PillarHero
    title="スペイン語の勉強法"
    description="独学の始め方、学び方の比較、A1〜C2の無料コース。今のレベルを確かめて、次に学ぶことを見つけましょう。"
  />
  <section class="max-w-6xl mx-auto px-5 pt-14 pb-12">
    <p class="text-ink text-base leading-relaxed mb-10 border-l-2 border-primary pl-5 max-w-[780px]">
      スペイン語の勉強法でいちばん大切なのは、<strong>今のレベルを知ること</strong>、<strong>発音から順番に学ぶこと</strong>、<strong>毎日少しずつ続けること</strong>の3つです。スペイン倶楽部では、セルバンテス学院の基準（A1 Acceso〜C2 Maestría）に沿った<strong>無料のスペイン語コース（全{TOTAL_UNITS}ユニット）</strong>を用意しました。登録は不要で、進み具合はこのブラウザに保存されます。
    </p>

    <nav id="categories" aria-label="このページの内容" class="grid grid-cols-2 md:grid-cols-5 gap-3 mb-12">
      {anchors.map(({ href, label }) => (
        <a href={href} class="bg-white rounded-lg px-3 py-3 min-h-[44px] flex items-center justify-center text-center border border-[#E8E8E6] hover:border-primary/30 hover:shadow-sm transition-all">
          <span class="font-semibold text-navy text-sm leading-snug block">{label}</span>
        </a>
      ))}
    </nav>

    <h2 id="start" class="font-sans font-bold text-xl text-navy mb-5">はじめる</h2>
    <CourseContinue />
    <div class="hub-start-grid">
      <a href={COURSE_URL} class="hub-start-card has-image is-primary">
        {roadmapImg && (
          <span class="hub-start-img"><img src={roadmapImg.src} srcset={roadmapImg.srcset} sizes="(min-width: 768px) 560px, 100vw" width={roadmapImg.width} height={roadmapImg.height} alt={roadmapImg.alt} decoding="async" /></span>
        )}
        <span class="hub-start-body">
          <span class="hub-start-head">
            <span class="hub-start-icon"><MapIcon size={24} aria-hidden="true" /></span>
            <span class="hub-start-title">スペイン語学習ロードマップ</span>
          </span>
          <span class="hub-start-desc">6つのレベルの意味、学習時間の目安、全{TOTAL_UNITS}ユニットの順番を1ページで確認できます。</span>
          <span class="hub-start-cta">ロードマップを見る →</span>
        </span>
      </a>
      <a href={LEVEL_TEST_URL} class="hub-start-card has-image is-primary">
        {levelTestImg && (
          <span class="hub-start-img"><img src={levelTestImg.src} srcset={levelTestImg.srcset} sizes="(min-width: 768px) 560px, 100vw" width={levelTestImg.width} height={levelTestImg.height} alt={levelTestImg.alt} decoding="async" /></span>
        )}
        <span class="hub-start-body">
          <span class="hub-start-head">
            <span class="hub-start-icon"><ClipboardCheck size={24} aria-hidden="true" /></span>
            <span class="hub-start-title">自分のレベルをチェック</span>
          </span>
          <span class="hub-start-desc">A1〜C2・最大36問・登録不要。今のレベルと、どのユニットから始めればいいかがすぐにわかります。</span>
          <span class="hub-start-cta">レベルチェックを受ける →</span>
        </span>
      </a>
    </div>
  </section>

  {courseVisible && (
    <section class="hub-block is-course" id="course" aria-labelledby="course-title">
      <div class="max-w-6xl mx-auto px-5">
        <div class="hub-block-head">
          <p class="hub-block-eyebrow"><span class="hub-block-num">01</span>無料コース</p>
          <h2 id="course-title">スペイン語コース（A1〜C2・全{TOTAL_UNITS}ユニット）</h2>
          <p class="hub-block-lead">無料・登録不要。セルバンテス学院の6つのレベルに沿って、ユニット1から順番に進めます。各レベルの目次から、そのレベルの全ユニットと文法まとめ・単語・学習計画に進めます。前回開いたユニットには印がつきます。</p>
          <p class="course-links">
            <a href={WELCOME_URL}>学習設定（地域・ペース・例文の数）</a>
            <a href={CAST_URL}>登場人物</a>
            <a href={ABOUT_COURSE_URL}>このコースができるまで</a>
          </p>
        </div>
        <CourseLevels />
        {mockExams.length > 0 && (
          <div class="hub-mock">
            <h3 class="hub-sub">模擬試験（各レベルの最終ユニット）</h3>
            <p class="hub-mock-lead">各レベルの最後のユニットは、DELEの形式に沿った総復習と模擬試験です。レベルの仕上げに力を試しましょう。</p>
            <ol class="hub-mock-grid is-large">
              {mockExams.map((u) => (
                <li class={`lv-${u.level}`}>
                  <a class="unit-tile" href={u.url}>
                    <span class="unit-tile-img">{u.img && <img src={u.img} width="480" height="270" alt={u.alt} loading="lazy" decoding="async" />}</span>
                    <span class="unit-tile-num">ユニット{u.unit}</span>
                    <span class="unit-tile-title">{u.shortTitle}</span>
                  </a>
                </li>
              ))}
            </ol>
          </div>
        )}
      </div>
    </section>
  )}

  <section class="hub-block is-dele" id="dele" aria-labelledby="dele-title">
    <div class="max-w-6xl mx-auto px-5">
      <div class="hub-block-head">
        <p class="hub-block-eyebrow"><span class="hub-block-num">02</span>DELE対策</p>
        <h2 id="dele-title">DELE（スペイン語検定）の準備</h2>
      </div>
      <a href={DELE_URL} class="hub-feature">
        {deleImg && (
          <span class="hub-feature-img"><img src={deleImg.src} srcset={deleImg.srcset} sizes="(min-width: 768px) 600px, 100vw" width={deleImg.width} height={deleImg.height} alt={deleImg.alt} loading="lazy" decoding="async" /></span>
        )}
        <span class="hub-feature-body">
          <span class="hub-feature-badge">DELE</span>
          <span class="hub-feature-title">DELE（スペイン語検定）のページへ</span>
          <span class="hub-feature-desc">セルバンテス学院が実施する、スペイン語の国際的な公式資格です。A1〜C2のレベル別ガイド、難易度、日程と費用、面接対策、独学の方法、コースの模擬試験まで、DELEの情報を1か所にまとめています。</span>
          <span class="hub-feature-cta">DELEのページを見る →</span>
        </span>
      </a>
    </div>
  </section>

  <section class="hub-block is-materials" id="materials" aria-labelledby="materials-title">
    <div class="max-w-6xl mx-auto px-5">
      <div class="hub-block-head">
        <p class="hub-block-eyebrow"><span class="hub-block-num">03</span>補助教材</p>
        <h2 id="materials-title">補助教材・学習リソース</h2>
        <p class="hub-block-lead">コースと並行して使えるツールや学習ガイド、コースの外でスペイン語に触れるためのページ、先生と話す練習ができるスペイン語学校の情報です。</p>
      </div>
      {conjugator && (
        <a href={getArticleUrl(conjugator)} class="hub-feature">
          {conjugatorImg && (
            <span class="hub-feature-img"><img src={conjugatorImg.src} srcset={conjugatorImg.srcset} sizes="(min-width: 768px) 600px, 100vw" width={conjugatorImg.width} height={conjugatorImg.height} alt={conjugatorImg.alt} loading="lazy" decoding="async" /></span>
          )}
          <span class="hub-feature-body">
            <span class="hub-feature-badge">ツール</span>
            <span class="hub-feature-title">スペイン語 動詞の活用ツール（53動詞・全時制）</span>
            <span class="hub-feature-desc">原形でも活用形（fui、hice など）でも入力できる検索、全時制の早見表、よく使う53動詞の活用ページ。各時制は、それを学ぶコースのユニットにつながっています。</span>
            <span class="hub-feature-cta">活用を調べる →</span>
          </span>
        </a>
      )}
      <h3 id="tools" class="hub-sub">ツールと学習ガイド</h3>
      <div class="hub-card-grid">
        {otherTools.map((a) => (
          <HubCard title={a.data.title} href={getArticleUrl(a)} heroImage={a.data.heroImage} heroImageAlt={a.data.heroImageAlt} image={a.data.image} imageAlt={a.data.imageAlt} badge="学習ガイド" />
        ))}
      </div>
      <h3 id="resources" class="hub-sub">学習リソース</h3>
      <div class="hub-card-grid">
        {resources.map((a) => (
          <HubCard title={a.data.title} href={getArticleUrl(a)} heroImage={a.data.heroImage} heroImageAlt={a.data.heroImageAlt} image={a.data.image} imageAlt={a.data.imageAlt} badge="学習リソース" />
        ))}
      </div>
      <h3 id="schools" class="hub-sub">スペイン語学校</h3>
      <div class="hub-card-grid">
        {schools.map((a) => (
          <HubCard title={a.data.title} href={getArticleUrl(a)} heroImage={a.data.heroImage} heroImageAlt={a.data.heroImageAlt} image={a.data.image} imageAlt={a.data.imageAlt} badge="スペイン語学校" />
        ))}
      </div>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-5 py-14">
    <div class="max-w-[780px] prose-content">
      <h2 id="methods" class="font-sans font-bold text-xl text-navy mb-4">スペイン語の勉強法：4つの学び方を比較</h2>
      <p class="text-ink leading-relaxed mb-5">
        どれか1つが正解というわけではありません。目的と使える時間に合わせて選び、組み合わせるのがいちばんの近道です。たとえば、文法と単語はコースで独学し、話す練習は教室やオンラインレッスンで、という分け方がよく合います。
      </p>
    </div>
    <div class="hub-methods-wrap mb-12">
      <table class="hub-methods">
        <thead>
          <tr>
            <th scope="col">学び方</th>
            <th scope="col">向いている人</th>
            <th scope="col">強み</th>
            <th scope="col">気をつけたい点</th>
          </tr>
        </thead>
        <tbody>
          {methods.map((m) => (
            <tr>
              <th scope="row">
                {m.name}
                <a href={m.href}>{m.link} →</a>
              </th>
              <td>{m.who}</td>
              <td>{m.pro}</td>
              <td>{m.con}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="max-w-[780px] prose-content mb-12">
      <h2 id="steps" class="font-sans font-bold text-xl text-navy mb-4">独学でスペイン語を始める5つのステップ</h2>
      <ol class="hub-steps">
        <li>
          <strong>今のレベルを確かめる。</strong>
          <a href={LEVEL_TEST_URL}>レベルチェック</a>は、A1から順にレベルごとの6問に答え、合格しなかったレベルで終わります。結果の画面に、始めるユニットが表示されます。
        </li>
        <li>
          <strong>発音から始める。</strong>
          スペイン語は書いてあるとおりに読める言語です。まったく初めてなら{firstUnit ? <a href={firstUnit.data.url}>ユニット1「{firstUnit.data.shortTitle}」</a> : 'ユニット1'}で母音とアクセントのルールを覚え、日本人がつまずきやすい音は<a href="/language/learn-spanish/pronunciation-for-japanese/">日本人のための発音ガイド</a>で練習しましょう。
        </li>
        <li>
          <strong>続けられるペースを決める。</strong>
          毎日20分ほどを目安に、週に何ユニット進めるかを<a href={WELCOME_URL}>学習設定</a>で選べます。スペインと中南米の言い方の違いを表示するかどうかも、ここで決められます。
        </li>
        <li>
          <strong>ミニテストで確かめて、復習する。</strong>
          各ユニットの最後に10問のミニテストがあり、7問正解で「完了」になります。間違えたところは、そのユニットの説明に戻って確認しましょう。
        </li>
        <li>
          <strong>レベルの最後に力を試す。</strong>
          各レベルの最後のユニットは、DELEの形式に沿った総復習と模擬試験です。本番の試験を受けるなら、<a href={DELE_URL}>DELEのページ</a>でレベルごとの内容と日程を確認できます。
        </li>
      </ol>
    </div>

  </section>

  <section class="max-w-6xl mx-auto px-5 pb-14 prose-content">
  <div class="max-w-[780px]">
    {courseVisible && (
      <>
        <h2 class="font-sans font-bold text-xl text-navy mb-4">このコースについて</h2>
        <p class="text-muted leading-relaxed mb-6">
          コースの例文には、スペイン語を学ぶ日本人とスペイン人の<a href={CAST_URL} class="text-primary underline">登場人物</a>が登場します。誰が内容を決め、どこでAIを使い、公開前にネイティブが何を確認しているのかは<a href={ABOUT_COURSE_URL} class="text-primary underline">「このコースができるまで」</a>で公開しています。
        </p>
      </>
    )}

    <NewsletterForm variant="inline" />

    <FAQSection faq={languageFaq} />

    {author && <ArticleDisclaimer />}
    {author && <AuthorBox author={author} />}

    <section class="mt-12 border-t border-[#E8E8E6] pt-10">
      <h2 class="font-sans font-bold text-2xl text-navy mb-2">こちらの記事もおすすめ</h2>
      <p class="text-sm text-gray-500 mb-6">スペインの他のテーマも見てみませんか。</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
        {otherPillars.map((p) => (
          <a href={p.href} class="block bg-white rounded-xl overflow-hidden shadow-[0_2px_8px_rgba(0,33,71,0.07)] border border-[#E8E8E6] hover:shadow-[0_4px_16px_rgba(0,33,71,0.12)] hover:border-primary/20 transition-all p-6">
            <h3 class="font-sans font-bold text-navy text-lg mb-2">{p.title}</h3>
            <p class="text-muted text-sm leading-relaxed">{p.description}</p>
          </a>
        ))}
      </div>
    </section>
  </div>
  </section>

  <LineBanner slim />
  <FloatingActions target="categories" shareUrl="https://supein.club/language/" shareTitle="スペイン語の勉強法" />
</BaseLayout>
