---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SEO from '../../../components/SEO.astro';
import CoursePageHeader from '../../../components/course/CoursePageHeader.astro';
import { ABOUT_COURSE_URL, CAST_URL, COURSE_URL } from '../../../data/course';
import { getAllUnits, hasPage, isCourseVisible } from '../../../utils/units';

// Como el resto del curso, solo existe en producción cuando ya hay una unidad publicada.
export async function getStaticPaths() {
  return (await isCourseVisible()) ? [{ params: { index: undefined } }] : [];
}

const cast = await getCollection('cast');
const units = await getAllUnits();
const appearances = (id: string) => units.filter((u) => u.data.cast.some((c) => c.id === id));

const siteUrl = 'https://supein.club';
const portrait = (id: string) => `/images/course/cast/${id}.webp`;
const canonical = `${siteUrl}${CAST_URL}`;
const title = 'スペイン語コースの登場人物｜ミナ・ケンタ・ユイ・ダニエル・カルメン先生';
const description = 'スペイン倶楽部のスペイン語コースに登場する5人のプロフィール。旅行者のミナ、仕事で使うケンタ、留学生のユイ、ネイティブのダニエル、カルメン先生の出身・仕事・趣味・スペイン語を学ぶ理由と目標を紹介します。';
const breadcrumbs = [
  { name: 'ホーム', url: '/' },
  { name: 'スペイン語', url: '/language/' },
  { name: 'コース', url: COURSE_URL },
  { name: '登場人物', url: canonical },
];
// Personajes ficticios: ItemList con nombre y descripción, nunca schema Person.
const itemList = {
  '@type': 'ItemList',
  '@id': `${canonical}#cast`,
  name: 'スペイン語コースの登場人物',
  itemListElement: cast.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.data.name, description: c.data.bio, image: `${siteUrl}${portrait(c.id)}` })),
};
---
<BaseLayout title={title}>
  <SEO slot="seo" title={title} description={description} canonical={canonical} breadcrumbs={breadcrumbs} extraGraph={[itemList]} />

  <CoursePageHeader breadcrumbs={breadcrumbs}>
    <h1 class="course-page-title">スペイン語コースの登場人物</h1>
  </CoursePageHeader>

  <section class="page-container py-10">
    <p class="cast-page-intro">
      このコースの例文や会話は、5人の登場人物の状況に沿って書いています。初級ではミナとケンタ、中級ではユイ、上級ではカルメン先生が中心になり、ダニエルはすべてのレベルでニュアンスや地域による違いを説明します。登場人物はすべて架空の人物で、イラストはAIで生成したイメージです。
    </p>

    <ul class="cast-cards">
      {cast.map((c) => {
        const list = appearances(c.id);
        return (
          <li class="cast-card" id={c.id}>
            <img class="cast-portrait" src={portrait(c.id)} width="640" height="640" alt={`${c.data.name}のイラスト`} loading="lazy" decoding="async" style={`border-color:${c.data.color}`} />
            <div>
              <h2>{c.data.name} <span lang="es">{c.data.nameEs}</span></h2>
              <p class="cast-card-meta">{c.data.age}歳・{c.data.from}・{c.data.role}</p>
              <p>{c.data.bio}</p>
              {c.data.profile && (
                <dl class="cast-profile">
                  <dt>出身</dt><dd>{c.data.profile.birthplace}</dd>
                  <dt>住まい</dt><dd>{c.data.profile.home}</dd>
                  <dt>仕事・学業</dt><dd>{c.data.profile.occupation}</dd>
                  <dt>学歴</dt><dd>{c.data.profile.education}</dd>
                  <dt>趣味</dt><dd>{c.data.profile.hobbies.join('、')}</dd>
                  <dt>性格</dt><dd>{c.data.profile.personality}</dd>
                  <dt>スペイン語との関わり</dt><dd>{c.data.profile.whySpanish}</dd>
                  <dt>目標</dt><dd>{c.data.profile.goal}</dd>
                </dl>
              )}
              <p class="cast-card-meta">レベル：{c.data.levels.join('・')}　場面：{c.data.arcs.join('、')}</p>
              {list.length > 0 && (
                <details class="cast-card-units">
                  <summary>登場するユニット（{list.length}）</summary>
                  <ul>
                    {list.map((u) => (
                      <li>
                        {hasPage(u) ? <a href={u.data.url}>ユニット{u.data.unit} {u.data.shortTitle}</a> : <span>ユニット{u.data.unit} {u.data.shortTitle}（準備中）</span>}
                      </li>
                    ))}
                  </ul>
                </details>
              )}
            </div>
          </li>
        );
      })}
    </ul>

    <p class="cast-page-footer"><a href={ABOUT_COURSE_URL}>このコースの作り方</a></p>
  </section>
</BaseLayout>
