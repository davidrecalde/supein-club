---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SEO from '../components/SEO.astro';
import ArticleCard from '../components/ArticleCard.astro';
import LineBanner from '../components/LineBanner.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import { Plane, UtensilsCrossed, MessageCircle, Home, Book } from 'lucide-astro';
import SoccerBall from '../components/icons/SoccerBall.astro';
import { getArticleUrl } from '../utils/articles';
import travelCardImg from '../assets/cards/travel.webp';
import foodCardImg from '../assets/cards/food.webp';
import languageCardImg from '../assets/cards/language.webp';
import livingCardImg from '../assets/cards/living.webp';
import cultureCardImg from '../assets/cards/culture.webp';
import footballCardImg from '../assets/cards/football.webp';

const allArticles = await getCollection('articles', ({ data }) => !data.draft);

// 最新記事：全6カテゴリの多様性を保つため、各パイラーの最新記事を1本ずつ選ぶ
// （単純な日付順だと特定のパイラーの記事が続けて並んでしまうため）
const pillarOrder = ['travel', 'food', 'language', 'living', 'culture', 'football'] as const;
const recentArticles = pillarOrder
  .map((p) =>
    allArticles
      .filter((a) => a.data.pillar === p)
      .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())[0]
  )
  .filter((a) => a !== undefined)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// 特集記事：articles コレクションの featured: true から選出（編集部のおすすめ）
const featuredArticle = allArticles
  .filter((a) => a.data.featured)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())[0];

const pillarLabels: Record<string, string> = {
  travel: 'スペイン旅行',
  food: 'スペイン料理',
  language: 'スペイン語',
  living: 'スペインに住む',
  culture: 'スペイン文化',
  football: 'スペインサッカー',
};

const featuredHeroSrc =
  typeof featuredArticle?.data.heroImage === 'string'
    ? featuredArticle.data.heroImage
    : featuredArticle?.data.heroImage?.src;

const pillars = [
  { href: '/travel/', Icon: Plane, title: 'スペイン旅行', desc: 'バルセロナ・マドリードから離島まで、観光・ツアー情報を完全網羅', image: travelCardImg },
  { href: '/food/', Icon: UtensilsCrossed, title: 'スペイン料理', desc: 'パエリア・タパス・ワイン・お土産まで、スペインの食文化を完全解説', image: foodCardImg },
  { href: '/language/', Icon: MessageCircle, title: 'スペイン語', desc: 'レッスン・学校・アプリなど、学習法を完全網羅で紹介します', image: languageCardImg },
  { href: '/living/', Icon: Home, title: 'スペインに住む', desc: '留学・仕事・ビザなど、スペイン生活のリアルな実情を紹介', image: livingCardImg },
  { href: '/culture/', Icon: Book, title: 'スペイン文化', desc: 'フラメンコ・歴史・伝統など、文化の魅力を詳しく紹介します', image: cultureCardImg },
  { href: '/football/', Icon: SoccerBall, title: 'スペインサッカー', desc: 'ラ・リーガ、代表、バルセロナなど日本語で深掘り解説します', image: footballCardImg },
];

const breadcrumbs = [{ name: 'ホーム', url: '/' }];
---
<BaseLayout title="スペイン倶楽部 | 日本人向けスペイン情報・旅行・文化メディア">
  <SEO
    slot="seo"
    title="スペイン倶楽部 | 日本人向けスペイン情報・旅行・文化メディア"
    description="スペインの旅行・観光・ツアー、料理・ワイン・お土産、スペイン語学習、留学・ビザ・生活、文化・歴史まで日本語で紹介するスペイン倶楽部の公式サイト。"
    canonical="https://supein.club/"
    breadcrumbs={breadcrumbs}
  />
  <Fragment slot="head">
    <meta name="keywords" content="スペイン旅行,スペイン料理,スペイン語,スペイン文化,スペイン倶楽部,Club Español en Japón,スペイン情報,日本語スペイン" />
    <meta name="author" content="David Recalde" />
    <link rel="author" href="https://supein.club/about-us/team/david-recalde/" />
    <meta http-equiv="content-language" content="ja" />
  </Fragment>

  <!-- Hero: solid navy + subtle dot pattern -->
  <section
    class="bg-navy text-white relative overflow-hidden"
    style="background-image: radial-gradient(circle, rgba(255,255,255,0.07) 1.5px, transparent 1.5px), radial-gradient(circle, rgba(200,16,46,0.12) 1.5px, transparent 1.5px); background-size: 28px 28px, 64px 64px; background-position: 0 0, 14px 14px;"
  >
    <div class="relative max-w-6xl mx-auto px-5 py-24 lg:py-32">
      <p class="text-primary text-base font-semibold uppercase tracking-widest mb-5">
        スペインのすべてが、ここに
      </p>
      <h1 class="font-sans font-bold text-3xl md:text-4xl lg:text-5xl xl:text-6xl leading-tight mb-6">
        スペインの旅行・料理・文化、もっと知りたくなる。
      </h1>
      <p class="text-white/75 text-lg md:text-xl leading-relaxed mb-10 max-w-xl">
        旅行・観光・料理・スペイン語・文化・生活——スペインに関するすべてを、日本語でわかりやすくお届けします。
      </p>
      <div class="flex flex-col sm:flex-row gap-3">
        <a
          href="/travel/"
          class="inline-flex items-center justify-center bg-primary hover:bg-[#a00d24] text-white font-bold px-7 py-3.5 rounded-lg transition-colors text-sm"
        >
          スペイン旅行を計画する
        </a>
        <a
          href="/language/"
          class="inline-flex items-center justify-center border border-white/30 hover:border-white/60 text-white font-semibold px-7 py-3.5 rounded-lg transition-colors text-sm"
        >
          スペイン語を学ぶ
        </a>
      </div>
    </div>
  </section>

  <!-- Category pillars -->
  <section class="py-20 px-5 bg-canvas">
    <div class="max-w-6xl mx-auto">
      <div class="flex items-center gap-3 mb-4">
        <span class="font-serif text-xl text-primary/40">01</span>
        <span class="h-px w-8 bg-navy/15"></span>
        <span class="text-primary text-lg font-semibold uppercase tracking-widest">カテゴリ</span>
      </div>
      <h2 class="font-sans font-bold text-3xl text-navy mb-10">スペインの気になるテーマから</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {pillars.map(({ href, Icon, title, desc, image }) => (
          <a
            href={href}
            class="group relative block aspect-square rounded-xl overflow-hidden shadow-[0_2px_8px_rgba(0,33,71,0.07)] border border-[#E8E8E6] hover:shadow-[0_4px_16px_rgba(0,33,71,0.12)] hover:border-primary/20 transition-all"
          >
            <img
              src={image.src}
              alt=""
              loading="lazy"
              class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            />
            <div
              class="absolute inset-0"
              style="background: linear-gradient(to bottom, rgba(255,255,255,0) 0%, rgba(255,255,255,0) 58%, rgba(255,255,255,0.9) 80%, #ffffff 93%);"
            ></div>
            <div class="relative h-full flex flex-col justify-end p-6">
              <div class="w-14 h-14 rounded-full bg-white flex items-center justify-center mb-3 text-primary shadow-md group-hover:bg-primary group-hover:text-white transition-colors">
                <Icon size={26} />
              </div>
              <h3 class="font-sans font-bold text-navy text-lg mb-1 group-hover:text-primary transition-colors">
                {title}
              </h3>
              <p class="text-muted text-base leading-relaxed">{desc}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Latest articles -->
  {recentArticles.length > 0 && (
    <section class="py-20 px-5 bg-white border-t border-[#E8E8E6]">
      <div class="max-w-6xl mx-auto">
        <div class="flex items-center gap-3 mb-4">
          <span class="font-serif text-xl text-primary/40">02</span>
          <span class="h-px w-8 bg-navy/15"></span>
          <span class="text-primary text-lg font-semibold uppercase tracking-widest">新着</span>
        </div>
        <h2 class="font-sans font-bold text-3xl text-navy mb-10">スペインの最新記事</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {recentArticles.map((article) => (
            <ArticleCard
              title={article.data.title}
              description={article.data.description}
              href={getArticleUrl(article)}
              pillar={article.data.pillar}
              image={article.data.image}
              imageAlt={article.data.imageAlt}
              heroImage={article.data.heroImage}
              heroImageAlt={article.data.heroImageAlt}
              pubDate={article.data.pubDate}
            />
          ))}
        </div>
        <div class="mt-10 text-center">
          <a href="/articles/" class="inline-flex items-center gap-2 text-primary font-semibold text-sm hover:underline underline-offset-4">
            すべての記事を見る →
          </a>
        </div>
      </div>
    </section>
  )}

  <!-- Featured article -->
  {featuredArticle && (
    <section class="py-20 px-5 bg-canvas border-t border-[#E8E8E6]">
      <div class="max-w-6xl mx-auto">
        <div class="flex items-center gap-3 mb-4">
          <span class="font-serif text-xl text-primary/40">03</span>
          <span class="h-px w-8 bg-navy/15"></span>
          <span class="text-primary text-lg font-semibold uppercase tracking-widest">特集</span>
        </div>
        <h2 class="font-sans font-bold text-3xl text-navy mb-10">編集部が選ぶ、スペインの注目記事</h2>
        <a
          href={getArticleUrl(featuredArticle)}
          class="group grid grid-cols-1 md:grid-cols-2 gap-0 bg-white rounded-xl overflow-hidden shadow-[0_2px_8px_rgba(0,33,71,0.07)] border border-[#E8E8E6] hover:shadow-[0_4px_16px_rgba(0,33,71,0.12)] hover:border-primary/20 transition-all"
        >
          {featuredHeroSrc && (
            <div class="overflow-hidden aspect-[16/9] md:aspect-auto md:h-full">
              <img
                src={featuredHeroSrc}
                alt={featuredArticle.data.heroImageAlt || featuredArticle.data.title}
                loading="lazy"
                class="w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-[400ms]"
              />
            </div>
          )}
          <div class="p-8 md:p-10 flex flex-col justify-center">
            <span class="inline-block text-xs font-semibold px-2.5 py-0.5 rounded-full bg-[#FCEBEE] text-primary mb-4 self-start">
              {pillarLabels[featuredArticle.data.pillar] ?? featuredArticle.data.pillar}
            </span>
            <h3 class="font-sans font-bold text-navy text-2xl leading-snug mb-4 group-hover:text-primary transition-colors">
              {featuredArticle.data.title}
            </h3>
            <p class="text-muted text-base leading-relaxed mb-6">{featuredArticle.data.description}</p>
            <span class="inline-flex items-center gap-2 text-primary font-semibold text-sm">
              記事を読む →
            </span>
          </div>
        </a>
      </div>
    </section>
  )}

  <!-- About section (medio de comunicación cultural — origen de comunidad se cuenta en /about-us/) -->
  <section class="py-20 px-5 bg-navy text-white">
    <div class="max-w-4xl mx-auto text-center">
      <p class="text-primary text-base font-semibold uppercase tracking-widest mb-4">スペイン倶楽部とは</p>
      <h2 class="font-sans font-bold text-3xl mb-5">日本語で伝える、スペインのカルチャーメディア</h2>
      <p class="text-white/70 text-lg leading-relaxed mb-10 max-w-2xl mx-auto">
        スペイン倶楽部は、旅行・観光・グルメ・スペイン語・文化・生活を通じて、日本語でスペインの本当の姿を伝えるカルチャーメディアです。
      </p>
      <div class="flex items-stretch justify-center flex-wrap gap-0 max-w-2xl mx-auto mb-10">
        <div class="flex-1 min-w-[110px] text-center px-6 border-r border-white/10">
          <p class="text-sm font-semibold tracking-widest uppercase text-primary mb-1.5">創設</p>
          <p class="font-serif text-xl font-bold text-white">2018年</p>
        </div>
        <div class="flex-1 min-w-[110px] text-center px-6 border-r border-white/10">
          <p class="text-sm font-semibold tracking-widest uppercase text-primary mb-1.5">拠点</p>
          <p class="font-serif text-xl font-bold text-white">東京</p>
        </div>
        <div class="flex-1 min-w-[110px] text-center px-6 border-r border-white/10">
          <p class="text-sm font-semibold tracking-widest uppercase text-primary mb-1.5">言語</p>
          <p class="font-serif text-xl font-bold text-white">日本語</p>
        </div>
        <div class="flex-1 min-w-[110px] text-center px-6">
          <p class="text-sm font-semibold tracking-widest uppercase text-primary mb-1.5">掲載記事数</p>
          <p class="font-serif text-xl font-bold text-white">{allArticles.length}本</p>
        </div>
      </div>
      <a
        href="/about-us/"
        class="inline-flex items-center justify-center border border-white/30 hover:border-white/60 text-white font-bold px-7 py-3.5 rounded-lg transition-colors text-sm"
      >
        クラブの詳細を見る
      </a>
    </div>
  </section>

  <!-- Newsletter (slim, two-column) -->
  <section class="py-14 px-5 bg-canvas">
    <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-10 items-center">
      <div>
        <p class="text-primary text-base font-semibold uppercase tracking-widest mb-3">ニュースレター</p>
        <h2 class="font-sans font-bold text-2xl text-navy mb-3">スペインの最新情報をメールで</h2>
        <ul class="space-y-1.5 text-muted text-lg">
          <li>旅行・料理・文化・語学の情報を月2回お届け</li>
          <li>編集部が厳選した記事をいち早くチェック</li>
          <li>登録・配信停止はいつでも無料</li>
        </ul>
      </div>
      <div>
        <NewsletterForm variant="inline" />
      </div>
    </div>
  </section>

  <!-- LINE Banner -->
  <LineBanner slim />
</BaseLayout>
