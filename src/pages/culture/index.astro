<script>
  // 「今月のスペイン」: el HTML trae el mes de la compilación; aquí se pone el mes real del lector.
  type Month = { n: number; url: string; headline: string; minutes: number; src: string; srcset: string; label: string; nextLine: string };
  const box = document.querySelector<HTMLElement>('.cu-now');
  const data: Month[] = JSON.parse(document.getElementById('cu-months')?.textContent || '[]');
  const month = new Date().getMonth() + 1;
  const cur = data.find((m) => m.n === month);
  if (box && cur && Number(box.dataset.now) !== month) {
    const nxt = data[(data.indexOf(cur) + 1) % data.length];
    box.dataset.now = String(month);
    box.querySelectorAll<HTMLAnchorElement>('[data-now-link]').forEach((a) => { a.href = cur.url; });
    const img = box.querySelector<HTMLImageElement>('[data-now-img]');
    if (img && cur.src) { img.srcset = cur.srcset; img.src = cur.src; }
    box.querySelector('[data-now-n]')!.textContent = String(cur.n);
    box.querySelector('[data-now-title]')!.textContent = cur.headline;
    box.querySelector('[data-now-min]')!.textContent = `約${cur.minutes}分で読める`;
    const next = box.querySelector<HTMLAnchorElement>('[data-next-link]');
    if (next && nxt) { next.href = nxt.url; next.querySelector('[data-next-line]')!.textContent = nxt.nextLine; }
    document.querySelectorAll<HTMLElement>('.cu-mon').forEach((t) => t.classList.toggle('is-now', Number(t.dataset.month) === month));
  }
  // El carrusel del calendario arranca en el mes actual (si hay que desplazarse).
  const track = document.querySelector<HTMLElement>('.cu-cal .rail-track');
  const tile = document.querySelector<HTMLElement>('.cu-mon.is-now');
  if (track && tile && track.scrollWidth > track.clientWidth) track.scrollLeft = tile.offsetLeft - track.offsetLeft - 2;

  // Accesos rápidos: marca la sección visible.
  const chips = [...document.querySelectorAll<HTMLAnchorElement>('.cu-chips a[data-chip]')];
  const io = new IntersectionObserver((entries) => entries.forEach((e) => {
    if (!e.isIntersecting) return;
    chips.forEach((c) => c.classList.toggle('is-on', c.dataset.chip === e.target.id));
  }), { rootMargin: '-35% 0px -60% 0px' });
  chips.forEach((c) => { const s = document.getElementById(c.dataset.chip!); if (s) io.observe(s); });
</script>

