---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SEO from '../../components/SEO.astro';
import PillarHero from '../../components/PillarHero.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import LineBanner from '../../components/LineBanner.astro';
import FloatingActions from '../../components/FloatingActions.astro';
import RegionCTA from '../../components/RegionCTA.astro';
import NewsletterForm from '../../components/NewsletterForm.astro';
import ArticleDisclaimer from '../../components/ArticleDisclaimer.astro';
import AuthorBox from '../../components/AuthorBox.astro';
import { getArticleUrl } from '../../utils/articles';

const author = await getEntry('authors', 'david-recalde');

const otherPillars = [
  { href: '/travel/', title: 'スペイン旅行', description: 'バルセロナ・マドリードから南部アンダルシア、離島まで、観光スポットとツアー情報を完全網羅' },
  { href: '/food/', title: 'スペイン料理', description: 'パエリア・タパス・ワインからおすすめのお土産まで、スペインの食文化を写真つきで詳しく解説' },
  { href: '/language/', title: 'スペイン語', description: 'レッスン・語学学校・学習アプリの選び方まで、スペイン語習得に役立つ情報を体系的に紹介' },
  { href: '/living/', title: 'スペインに住む', description: '留学・現地での仕事探し・ビザ取得の手続きまで、スペイン生活のリアルな実情を詳しく紹介' },
  { href: '/football/', title: 'スペインサッカー', description: 'ラ・リーガの試合結果や移籍情報、代表チーム、バルセロナやレアルの歴史まで深掘り解説します' },
];

const articles = await getCollection('articles', ({ data }) => !data.draft && data.pillar === 'culture');
const sorted = articles.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const clusters = [
  { href: '/culture/flamenco/', label: 'フラメンコ' },
  { href: '/culture/history/', label: 'スペインの歴史' },
  { href: '/culture/traditions/', label: '伝統と祭り' },
  { href: '/culture/facts/', label: '基本情報' },
];

const breadcrumbs = [
  { name: 'ホーム', url: '/' },
  { name: 'スペイン文化', url: '/culture/' },
];
---
<BaseLayout>
  <SEO
    slot="seo"
    title="スペイン文化 完全ガイド | supein.club"
    description="スペイン文化の世界を、地域ごとの多彩な個性とあわせて日本語でわかりやすく紹介する入門ガイドです。フラメンコや歴史的建造物、各地の伝統的な祭り、豊かな食文化、地方ごとの言語や習慣の違い、芸術や建築の魅力まで幅広いテーマを取り上げて紹介しています。"
    canonical="https://supein.club/culture/"
    image="/og/culture.webp"
    breadcrumbs={breadcrumbs}
  />
  <PillarHero
    title="スペイン文化"
    description="地域ごとに驚くほど多彩な、情熱的なスペイン文化の世界をわかりやすく紹介します。"
  />
  <section class="max-w-6xl mx-auto px-5 py-14">
    <p class="text-muted text-base leading-relaxed mb-12 border-l-2 border-primary pl-5">
      スペイン文化は、地域ごとに驚くほど多彩な顔を持つ、奥深いテーマです。本カテゴリでは、そんなスペイン文化の世界を日本語でわかりやすくご紹介しています。
    </p>
    <h2 id="categories" class="font-sans font-bold text-xl text-navy mb-5">カテゴリ</h2>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-12">
      {clusters.map(({ href, label }) => (
        <a href={href} class="bg-white rounded-lg px-3 py-3 min-h-[44px] flex items-center justify-center text-center border border-[#E8E8E6] hover:border-primary/30 hover:shadow-sm transition-all">
          <span class="font-semibold text-navy text-sm leading-snug block">{label}</span>
        </a>
      ))}
    </div>
    <RegionCTA />

    {sorted.length > 0 && (
      <>
        <h2 class="font-sans font-bold text-xl text-navy mb-5">記事一覧</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {sorted.map((a) => (
            <ArticleCard title={a.data.title} description={a.data.description} href={getArticleUrl(a)} pillar="culture" image={a.data.image} imageAlt={a.data.imageAlt} heroImage={a.data.heroImage} heroImageAlt={a.data.heroImageAlt} pubDate={a.data.pubDate} />
          ))}
        </div>
      </>
    )}
  </section>

  <section class="max-w-6xl mx-auto px-5 pb-14 prose-content">
  <div class="max-w-[780px]">
    <NewsletterForm variant="inline" />

    {author && <ArticleDisclaimer />}
    {author && <AuthorBox author={author} />}

    <section class="mt-12 border-t border-[#E8E8E6] pt-10">
      <h2 class="font-sans font-bold text-2xl text-navy mb-2">こちらの記事もおすすめ</h2>
      <p class="text-sm text-gray-500 mb-6">スペインの他のテーマも見てみませんか。</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
        {otherPillars.map((p) => (
          <a href={p.href} class="block bg-white rounded-xl overflow-hidden shadow-[0_2px_8px_rgba(0,33,71,0.07)] border border-[#E8E8E6] hover:shadow-[0_4px_16px_rgba(0,33,71,0.12)] hover:border-primary/20 transition-all p-6">
            <h3 class="font-sans font-bold text-navy text-lg mb-2">{p.title}</h3>
            <p class="text-muted text-sm leading-relaxed">{p.description}</p>
          </a>
        ))}
      </div>
    </section>
  </div>
  </section>

  <LineBanner slim />
  <FloatingActions target="categories" shareUrl="https://supein.club/culture/" shareTitle="スペイン文化" />
</BaseLayout>
