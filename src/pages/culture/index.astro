---
// Hub /culture/ (rediseño del 18 de noviembre de 2026, mockup aprobado por David): «la España del
// año», calendario + revista, primero el móvil. Cabecera con 「今月のスペイン」 (el mes de la
// compilación en el HTML; un script pone el mes real del lector con los datos de los 12 meses que
// van en la página), accesos rápidos fijos, 01 calendario de 12 meses (carrusel que arranca en el
// mes actual), 02 revista de芸能 e historia (CULTURE_PICK de src/data/hubPicks.ts), 03 línea de 9
// épocas que enlaza a los capítulos del 歴史年表, 04 cultura por regiones. Debajo, guía, FAQ y lo de
// siempre. Un artículo de cultura que no esté en ningún bloque aparece en 「その他の文化ガイド」.
import { getCollection, getEntry, type CollectionEntry } from 'astro:content';
import { Calendar, ChevronRight, Clock, Compass, TrendingUp } from 'lucide-astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SEO from '../../components/SEO.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Rail from '../../components/Rail.astro';
import HubCrossCard from '../../components/HubCrossCard.astro';
import HubFaq from '../../components/HubFaq.astro';
import HubClickTracking from '../../components/HubClickTracking.astro';
import LineBanner from '../../components/LineBanner.astro';
import FloatingActions from '../../components/FloatingActions.astro';
import NewsletterForm from '../../components/NewsletterForm.astro';
import ArticleDisclaimer from '../../components/ArticleDisclaimer.astro';
import AuthorBox from '../../components/AuthorBox.astro';
import regionsPhoto from '../../assets/hero/banner-regiones-espana-mobile.webp';
import { CULTURE_PICK } from '../../data/hubPicks';
import { getArticleUrl } from '../../utils/articles';
import { cardImage } from '../../utils/images';

type Article = CollectionEntry<'articles'>;
const SITE = 'https://supein.club';
const canonical = `${SITE}/culture/`;
const author = await getEntry('authors', 'david-recalde');
const breadcrumbs = [
  { name: 'ホーム', url: '/' },
  { name: 'スペイン文化', url: canonical },
];

const otherPillars = [
  { href: '/travel/', title: 'スペイン旅行', description: 'バルセロナ・マドリードから南部アンダルシア、離島まで、観光スポットとツアー情報を完全網羅' },
  { href: '/food/', title: 'スペイン料理', description: 'パエリア・タパス・ワインからおすすめのお土産まで、スペインの食文化を写真つきで詳しく解説' },
  { href: '/language/', title: 'スペイン語', description: 'レッスン・語学学校・学習アプリの選び方まで、スペイン語習得に役立つ情報を体系的に紹介' },
  { href: '/living/', title: 'スペインに住む', description: '留学・現地での仕事探し・ビザ取得の手続きまで、スペイン生活のリアルな実情を詳しく紹介' },
  { href: '/football/', title: 'スペインサッカー', description: 'ラ・リーガの試合結果や移籍情報、代表チーム、バルセロナやレアルの歴史まで深掘り解説します' },
];

const cultureFaq = [
  { question: 'スペインの祭りについて知りたい場合は？', answer: '「12か月の祭りカレンダー」から月を選ぶと、その月の祭りの日程と見どころがわかります。年間の主要な祭りを一覧で知りたい方は<a href="/culture/traditions/">「スペインの祭り完全ガイド」</a>から。' },
  { question: 'フラメンコについて知りたい場合は？', answer: '起源や歌・ギター・踊りの3要素、タブラオでの鑑賞マナーまで<a href="/culture/flamenco/">「フラメンコ完全ガイド」</a>で解説しています。' },
  { question: 'サルスエラとは何ですか？', answer: 'スペイン独自の音楽劇サルスエラの歴史と魅力を<a href="/culture/zarzuela/">「サルスエラとは」</a>で紹介しています。' },
  { question: 'スペインの歴史を概観したい場合は？', answer: '旧石器時代から現代までの流れを<a href="/culture/history/spain-history-timeline/">「スペインの歴史年表」</a>にまとめています。このページの「歴史を旅する」から、気になる時代の章へ直接移動できます。' },
];

// ── Artículos ──
const articles = await getCollection('articles', ({ data }) => !data.draft && data.pillar === 'culture');
const idOf = (a: Article) => a.id.replace(/\.(md|mdx)$/, '');
const slugOf = (a: Article) => idOf(a).split('/').pop() ?? '';
const byId = new Map(articles.map((a) => [idOf(a), a]));
const placed = new Set<string>();
const take = (id: string) => { const a = byId.get(id); if (a) placed.add(id); return a; };
const minutesOf = (a: Article) => a.data.readingTime ?? Math.max(3, Math.round((a.body?.length ?? 0) / 600));
const heroOf = (a: Article) => (a.data.heroImage && typeof a.data.heroImage !== 'string' ? a.data.heroImage : undefined);
const card = async (a: Article) => {
  const hero = heroOf(a);
  return { url: getArticleUrl(a), title: a.data.title, description: a.data.description, minutes: minutesOf(a), img: hero ? await cardImage(hero, '') : undefined };
};

// 01 Calendario: el artículo principal de cada mes (cluster = slug)
const MONTHS = [
  { cluster: 'january-festivals', fest: 'レジェス・マゴス', headline: 'レジェス・マゴスのパレードとタンボラーダ' },
  { cluster: 'february-festivals', fest: 'カーニバル', headline: 'カディスとテネリフェのカーニバル' },
  { cluster: 'march-festivals', fest: 'ファジャス祭', headline: 'バレンシアのファジャス祭' },
  { cluster: 'april-festivals', fest: '聖週間とフェリア', headline: '聖週間セマナ・サンタとセビリアの春祭り' },
  { cluster: 'may-festivals', fest: 'パティオ祭り', headline: 'コルドバのパティオ祭りとサン・イシドロ祭' },
  { cluster: 'june-festivals', fest: 'サン・フアンの火祭り', headline: 'コルプス・クリスティとサン・フアンの火祭り' },
  { cluster: 'july-festivals', fest: 'サン・フェルミン祭', headline: 'パンプローナのサン・フェルミン祭' },
  { cluster: 'august-festivals', fest: 'ラ・トマティーナ', headline: 'フェリア・デ・マラガとラ・トマティーナ' },
  { cluster: 'september-festivals', fest: 'ラ・メルセ祭', headline: 'ワイン収穫祭とバルセロナのラ・メルセ祭' },
  { cluster: 'october-festivals', fest: 'エル・ピラール祭', headline: 'エル・ピラール祭とスペイン国家の日' },
  { cluster: 'november-festivals', fest: 'カスタニャーダ・マゴスト', headline: '焼き栗のカスタニャーダ・マゴストと諸聖人の日' },
  { cluster: 'december-festivals', fest: 'クリスマスと大晦日', headline: 'クリスマスマーケットと大晦日の12粒のブドウ' },
];
const months = (await Promise.all(MONTHS.map(async (m, i) => {
  const a = articles.find((x) => x.data.cluster === m.cluster && slugOf(x) === m.cluster);
  if (!a) return undefined;
  placed.add(idOf(a));
  return { ...m, n: i + 1, label: `${i + 1}月`, ...(await card(a)) };
}))).filter((m) => !!m);
// Mes de la compilación en hora de Japón; el script de abajo lo corrige al mes real del lector.
const buildMonth = new Date(Date.now() + 9 * 3600e3).getUTCMonth() + 1;
const nowIdx = Math.max(0, months.findIndex((m) => m.n === buildMonth));
const now = months[nowIdx];
const next = months[(nowIdx + 1) % months.length];
const monthData = months.map((m) => ({ n: m.n, url: m.url, headline: `${m.label}の祭り：${m.headline}`, minutes: m.minutes, src: m.img?.src ?? '', srcset: m.img?.srcset ?? '', label: m.label, nextLine: `${m.label} ${m.fest}` }));

// 02 Revista: el artículo que más retiene en grande y el resto de芸能・歴史・祭り
const pick = take(CULTURE_PICK);
const feature = pick ? await card(pick) : undefined;
const DEEP: Array<[string, string]> = [
  ['culture/flamenco/flamenco', 'フラメンコ'],
  ['culture/history/spain-history-timeline', '歴史'],
  ['culture/traditions/traditions', '祭り'],
  ['culture/zarzuela/zarzuela', 'サルスエラ'],
];
const deep = await Promise.all(DEEP.filter(([id]) => id !== CULTURE_PICK).map(([id, tag]) => [take(id), tag] as const)
  .filter((d): d is readonly [Article, string] => !!d[0]).map(async ([a, tag]) => ({ ...(await card(a)), tag })));

// 03 Historia: 9 épocas → capítulos (## ) del 歴史年表, con el mismo id que pone Astro (github-slugger)
const history = byId.get('culture/history/spain-history-timeline');
const slug = (s: string) => s.trim().toLowerCase().replace(/[^\p{L}\p{M}\p{N}_\- ]/gu, '').replace(/ /g, '-');
const chapters = (history?.body ?? '').split('\n').filter((l) => /^## /.test(l)).map((l) => slug(l.slice(3)));
const ERAS = [
  { years: '〜前3世紀', name: '先史時代', sub: 'アルタミラ洞窟と古代文明' },
  { years: '前218年〜', name: 'ローマ支配', sub: '約700年のヒスパニア属州' },
  { years: '5世紀〜', name: '西ゴート王国', sub: 'ゲルマン系国家の時代' },
  { years: '711〜1492年', name: 'イスラムとレコンキスタ', sub: '約780年にわたる攻防' },
  { years: '1492年〜', name: '黄金期と大航海時代', sub: '世界帝国への道' },
  { years: '1700年〜', name: 'ブルボン朝', sub: '大帝国の没落' },
  { years: '1808〜1898年', name: '近代の混乱', sub: '独立戦争から米西戦争まで' },
  { years: '1936〜1975年', name: '内戦とフランコ独裁', sub: '20世紀の激動' },
  { years: '1975年〜', name: '民主化とEU加盟', sub: '現代スペインへ' },
];
const historyUrl = history ? getArticleUrl(history) : '/culture/history/';
const eras = ERAS.map((e, i) => ({ ...e, href: chapters[i] ? `${historyUrl}#${chapters[i]}` : historyUrl }));

// 04 Regiones: el día de la Comunitat Valenciana (y futuros días autonómicos)
const regionDays = articles.filter((a) => a.data.tags.includes('自治州の日') && !placed.has(idOf(a)));
regionDays.forEach((a) => placed.add(idOf(a)));
const regionDay = regionDays[0];

// Artículos de cultura que todavía no tienen bloque
const rest = await Promise.all(articles.filter((a) => !placed.has(idOf(a))).map(card));

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'スペイン文化',
  description: 'スペインの12か月の祭り、フラメンコとサルスエラ、旧石器時代から現代までの歴史、地方の祝日を紹介するガイド。',
  url: canonical,
  inLanguage: 'ja',
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: [...months, ...(feature ? [feature] : []), ...deep, ...(regionDay ? [{ url: getArticleUrl(regionDay), title: regionDay.data.title }] : []), ...rest]
      .map((c, i) => ({ '@type': 'ListItem', position: i + 1, url: `${SITE}${c.url}`, name: c.title })),
  },
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: cultureFaq.map((item) => ({ '@type': 'Question', name: item.question, acceptedAnswer: { '@type': 'Answer', text: item.answer.replace(/<[^>]+>/g, '') } })),
};
---
<BaseLayout>
  <SEO
    slot="seo"
    title="スペイン文化 完全ガイド"
    description="スペイン文化の世界を、地域ごとの多彩な個性とあわせて日本語でわかりやすく紹介する入門ガイドです。フラメンコや歴史的建造物、各地の伝統的な祭り、豊かな食文化、地方ごとの言語や習慣の違い、芸術や建築の魅力まで幅広いテーマを取り上げて紹介しています。"
    canonical={canonical}
    image="/og/culture.webp"
    breadcrumbs={breadcrumbs}
  />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(collectionSchema)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqSchema)} />

  <section class="cu-hero">
    <div class="page-container cu-hero-in">
      <div>
        <Breadcrumb items={breadcrumbs} dark />
        <p class="cu-eyebrow">SPANISH CULTURE</p>
        <h1 class="cu-h1">スペイン文化</h1>
        <p class="cu-lead">祭り、フラメンコ、サルスエラ、そして2000年の歴史。季節ごとに表情を変えるスペインの文化を、日本語で。</p>
        <div class="cu-stats">
          <a href="#cal"><b>{months.length}</b><small>か月の祭りガイド</small></a>
          <a href="#deep"><b>2</b><small>伝統芸能</small></a>
          <a href="#hist"><b>{eras.length}</b><small>歴史の時代</small></a>
        </div>
      </div>
      {now && (
        <div class="cu-now" data-hub-block="now" data-now={now.n}>
          <a class="cu-now-card" href={now.url} data-now-link>
            {now.img && <img src={now.img.src} srcset={now.img.srcset} sizes="(min-width: 860px) 580px, 92vw" width={now.img.width} height={now.img.height} alt="" fetchpriority="high" decoding="async" data-now-img />}
            <span class="cu-now-k"><Calendar size={15} />今月のスペイン</span>
            <span class="cu-now-m"><span data-now-n>{now.n}</span><small>月</small></span>
          </a>
          <a class="cu-now-t" href={now.url} data-now-link data-now-title>{now.label}の祭り：{now.headline}</a>
          <span class="cu-now-meta"><Clock size={13} /><span data-now-min>約{now.minutes}分で読める</span></span>
          {next && (
            <a class="cu-now-next" href={next.url} data-next-link>
              <span><small>来月</small><span data-next-line>{next.label} {next.fest}</span></span>
              <ChevronRight size={18} />
            </a>
          )}
        </div>
      )}
    </div>
  </section>
  <script type="application/json" id="cu-months" set:html={JSON.stringify(monthData)} />

  <nav class="cu-chips" aria-label="このページの内容">
    <div class="page-container">
      <a href="#cal" data-chip="cal"><i>01</i>祭りカレンダー</a>
      <a href="#deep" data-chip="deep"><i>02</i>深く知る</a>
      <a href="#hist" data-chip="hist"><i>03</i>歴史</a>
      <a href="#region" data-chip="region"><i>04</i>地方の文化</a>
      <a href="#faq" data-chip="faq">FAQ</a>
    </div>
  </nav>

  <section class="hub-block cu-block" id="cal" data-hub-block="calendar">
    <div class="page-container">
      <div class="hub-block-head cu-head-more">
        <div>
          <p class="hub-block-eyebrow"><span class="hub-block-num">01</span>12か月の祭りカレンダー</p>
          <h2>月を選んで、スペインの祭りへ</h2>
          <p class="hub-block-lead">月ごとに日程と見どころを詳しく解説。旅行の時期選びにも。</p>
        </div>
        <a class="cu-more" href="/culture/traditions/">年間カレンダーで見る<ChevronRight size={16} /></a>
      </div>
      <div class="cu-cal">
        <Rail label="12か月の祭りカレンダー" hint="スワイプして他の月を見る" desktopColumns={6}>
          {months.map((m) => (
            <a class:list={['cu-mon', { 'is-now': m.n === now?.n }]} href={m.url} role="listitem" data-month={m.n}>
              {m.img && <img src={m.img.src} srcset={m.img.srcset} sizes="(min-width: 860px) 180px, 40vw" width={m.img.width} height={m.img.height} alt="" loading="lazy" decoding="async" />}
              <span class="cu-mon-badge">今月</span>
              <span class="cu-mon-n">{m.label}</span>
              <span class="cu-mon-f">{m.fest}</span>
            </a>
          ))}
        </Rail>
      </div>
    </div>
  </section>

  <section class="hub-block cu-block is-soft" id="deep" data-hub-block="deep">
    <div class="page-container">
      <div class="hub-block-head">
        <p class="hub-block-eyebrow"><span class="hub-block-num">02</span>スペイン文化を深く知る</p>
        <h2>芸能と歴史を、じっくり読む</h2>
      </div>
      <div class="cu-mag">
        {feature && (
          <a class="cu-mag-f" href={feature.url}>
            {feature.img && <img src={feature.img.src} srcset={feature.img.srcset} sizes="(min-width: 860px) 640px, 92vw" width={feature.img.width} height={feature.img.height} alt="" loading="lazy" decoding="async" />}
            <span class="cu-mag-fb">
              <span class="cu-pick"><TrendingUp size={14} />いちばん長く読まれている記事</span>
              <span class="cu-mag-ft">{feature.title}</span>
              <span class="cu-mag-fd">{feature.description}</span>
              <span class="cu-meta"><Clock size={13} />約{feature.minutes}分で読める</span>
            </span>
          </a>
        )}
        <div class="cu-mag-l">
          {deep.map((c) => (
            <a class="cu-mag-i" href={c.url}>
              {c.img && <img src={c.img.src} srcset={c.img.srcset} sizes="(min-width: 860px) 170px, 104px" width={c.img.width} height={c.img.height} alt="" loading="lazy" decoding="async" />}
              <span><span class="cu-tag">{c.tag}</span><b>{c.title}</b><span class="cu-meta"><Clock size={13} />約{c.minutes}分</span></span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="hub-block cu-block" id="hist" data-hub-block="history">
    <div class="page-container">
      <div class="hub-block-head cu-head-more">
        <div>
          <p class="hub-block-eyebrow"><span class="hub-block-num">03</span>歴史を旅する</p>
          <h2>2000年の歴史を、時代から選ぶ</h2>
          <p class="hub-block-lead">時代をタップすると「スペインの歴史年表」のその章に移動します。</p>
        </div>
        <a class="cu-more" href={historyUrl}>歴史年表を読む<ChevronRight size={16} /></a>
      </div>
      <Rail label="スペインの歴史の時代" hint="スワイプして時代を進む" desktopColumns={9}>
        {eras.map((e, i) => (
          <a class="cu-era" href={e.href} role="listitem">
            <span class="cu-era-dot">{i + 1}</span>
            <span class="cu-era-y">{e.years}</span>
            <span class="cu-era-n">{e.name}</span>
            <span class="cu-era-s">{e.sub}</span>
          </a>
        ))}
      </Rail>
    </div>
  </section>

  {rest.length > 0 && (
    <section class="hub-block cu-block" id="more" data-hub-block="more">
      <div class="page-container">
        <div class="hub-block-head">
          <p class="hub-block-eyebrow">もっと読む</p>
          <h2>その他の文化ガイド</h2>
        </div>
        <Rail label="その他の文化ガイド" hint="スワイプして続きを見る" desktopColumns={3}>
          {rest.map((c) => (
            <a class="cu-card" href={c.url} role="listitem">
              {c.img && <img src={c.img.src} srcset={c.img.srcset} sizes="(min-width: 860px) 360px, 76vw" width={c.img.width} height={c.img.height} alt="" loading="lazy" decoding="async" />}
              <span><b>{c.title}</b><span class="cu-meta"><Clock size={13} />約{c.minutes}分で読める</span></span>
            </a>
          ))}
        </Rail>
      </div>
    </section>
  )}

  <section class="hub-block cu-block is-soft" id="region" data-hub-block="region">
    <div class="page-container">
      <div class="hub-block-head">
        <p class="hub-block-eyebrow"><span class="hub-block-num">04</span>地方から見る文化</p>
        <h2>祝日と祭りを、地方ごとに</h2>
      </div>
      <div class="cu-pair">
        {regionDay && (
          <HubCrossCard href={getArticleUrl(regionDay)} eyebrow="自治州の日" title={regionDay.data.title.split('｜')[0]} text={regionDay.data.description} minutes={minutesOf(regionDay)} image={heroOf(regionDay)} variant="white">
            <Calendar slot="icon" size={15} />
          </HubCrossCard>
        )}
        <HubCrossCard href="/regions/" eyebrow="地方ガイド" title="17の地方の文化を知る" text="祭り・料理・サッカー・暮らしを地方ごとにまとめています。" cta="地方ガイドを見る" image={regionsPhoto}>
          <Compass slot="icon" size={15} />
        </HubCrossCard>
      </div>
    </div>
  </section>

  <section class="hub-block cu-block" id="faq">
    <div class="page-container cu-narrow">
      <div class="hub-block-head">
        <p class="hub-block-eyebrow">このサイトのスペイン文化ガイド</p>
        <h2>目的別の読み方</h2>
      </div>
      <div class="cu-guide">
        <p>このカテゴリでは、フラメンコやサルスエラといった芸術、スペインの歴史、年間を通じた伝統的な祭りまで、日本語で幅広くご紹介しています。</p>
        <p>スペインを代表する芸術について深く知りたい方は<a href="/culture/flamenco/">「フラメンコ完全ガイド」</a>と<a href="/culture/zarzuela/">「サルスエラとは」</a>をご覧ください。</p>
        <p>ローマ時代から現代までの流れは<a href={historyUrl}>「スペインの歴史年表」</a>で、時代ごとの出来事とともに解説しています。</p>
        <p>年間の主要な祭りを一覧で知りたい方は<a href="/culture/traditions/">「スペインの祭り完全ガイド」</a>から。月ごとの日程と見どころは、上の「12か月の祭りカレンダー」から各月のガイドへ進めます。</p>
      </div>
      <div class="cu-faq"><HubFaq items={cultureFaq} title="スペイン文化のFAQ" /></div>
      <div data-pagefind-ignore class="cu-newsletter"><NewsletterForm variant="inline" /></div>
      {author && <ArticleDisclaimer />}
      {author && <AuthorBox author={author} />}
    </div>
  </section>

