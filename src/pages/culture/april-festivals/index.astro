---
import { getCollection } from 'astro:content';
import ArticleLayout from '../../../layouts/ArticleLayout.astro';

const articles = await getCollection('articles', ({ data }) => !data.draft && data.pillar === 'culture' && data.cluster === 'april-festivals');
const entry = articles.find((a) => a.id.replace(/\.(md|mdx)$/, '').split('/').pop() === 'april-festivals');

if (!entry) {
  throw new Error('No se encontró el artículo insignia del cluster "april-festivals"');
}
---
<ArticleLayout entry={entry} />
